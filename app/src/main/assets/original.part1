on:"Kedy \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442 \u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438; kde \u2014 \u043E \u043C\u0435\u0441\u0442\u0435."}]},{id:"a1-06",level:"A1",title:"\u041D\u0430\u0439\u0434\u0438 \u0434\u043E\u0440\u043E\u0433\u0443",location:"\u0421\u0442\u0430\u0440\u044B\u0439 \u0433\u043E\u0440\u043E\u0434",scene:"\u041D\u0438\u043D\u0430 \u0436\u0434\u0451\u0442 \u0443 \u0448\u043A\u043E\u043B\u044B, \u0430 \u041C\u0430\u0442\u0435\u0439 \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442 \u043F\u0443\u0442\u044C. \u041D\u0430\u0439\u0434\u0438 \u043D\u0443\u0436\u043D\u044B\u0439 \u043F\u043E\u0432\u043E\u0440\u043E\u0442 \u0438 \u043D\u0435 \u043F\u0435\u0440\u0435\u043F\u0443\u0442\u0430\u0439 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443 \u0441\u043E \u0441\u0442\u0430\u043D\u0446\u0438\u0435\u0439.",goal:"\u0421\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0442\u044C \u043E \u043C\u0435\u0441\u0442\u043E\u043D\u0430\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0438 \u0438 \u043F\u043E\u043D\u0438\u043C\u0430\u0442\u044C \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0435 \u0443\u043A\u0430\u0437\u0430\u043D\u0438\u044F.",grammar:{title:"\u0413\u0434\u0435 \u0438 \u043A\u0443\u0434\u0430: \u043F\u0435\u0440\u0432\u044B\u0435 \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u044B",body:"Kde? \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \xAB\u0433\u0434\u0435?\xBB, \u0430 Kam? \u2014 \xAB\u043A\u0443\u0434\u0430?\xBB. \u0414\u043B\u044F \u0432\u043E\u043F\u0440\u043E\u0441\u0430 \u043E \u043C\u0435\u0441\u0442\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 Kde je stanica? \u2014 \xAB\u0413\u0434\u0435 \u0441\u0442\u0430\u043D\u0446\u0438\u044F?\xBB. \u041D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F v\u013Eavo \u0438 vpravo \u043E\u0437\u043D\u0430\u0447\u0430\u044E\u0442 \xAB\u043D\u0430\u043B\u0435\u0432\u043E/\u0441\u043B\u0435\u0432\u0430\xBB \u0438 \xAB\u043D\u0430\u043F\u0440\u0430\u0432\u043E/\u0441\u043F\u0440\u0430\u0432\u0430\xBB: \u0442\u043E\u0447\u043D\u044B\u0439 \u043F\u0435\u0440\u0435\u0432\u043E\u0434 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u0433\u043B\u0430\u0433\u043E\u043B\u0430. Rovno \u2014 \xAB\u043F\u0440\u044F\u043C\u043E\xBB. \u0412\u0435\u0436\u043B\u0438\u0432\u044B\u0435 \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438 \u0447\u0430\u0441\u0442\u043E \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442\u0441\u044F \u0441 Cho\u010Fte: Cho\u010Fte rovno. \u0424\u043E\u0440\u043C\u0430 cho\u010Fte \u043C\u043E\u0436\u0435\u0442 \u043E\u0431\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F \u0438 \u043A \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u043C \u043B\u044E\u0434\u044F\u043C, \u0438 \u0432\u0435\u0436\u043B\u0438\u0432\u043E \u043A \u043E\u0434\u043D\u043E\u043C\u0443. Bl\xEDzko \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \xAB\u0431\u043B\u0438\u0437\u043A\u043E\xBB, \u010Faleko \u2014 \xAB\u0434\u0430\u043B\u0435\u043A\u043E\xBB. \u0421\u0440\u0430\u0432\u043D\u0438 Stanica je v\u013Eavo (\xAB\u0441\u0442\u0430\u043D\u0446\u0438\u044F \u0441\u043B\u0435\u0432\u0430\xBB) \u0438 Cho\u010Fte v\u013Eavo (\xAB\u0438\u0434\u0438\u0442\u0435 \u043D\u0430\u043B\u0435\u0432\u043E\xBB). \u0412 \u044D\u0442\u043E\u043C \u0437\u0430\u0434\u0430\u043D\u0438\u0438 \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0439, \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u044E\u0442 \u043E \u043C\u0435\u0441\u0442\u0435 \u0438\u043B\u0438 \u043E \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0438, \u0437\u0430\u0442\u0435\u043C \u0432\u044B\u0431\u0438\u0440\u0430\u0439 \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440.",examples:[{sk:"Kde je stanica?",ru:"\u0413\u0434\u0435 \u0441\u0442\u0430\u043D\u0446\u0438\u044F?"},{sk:"Cho\u010Fte rovno.",ru:"\u0418\u0434\u0438\u0442\u0435 \u043F\u0440\u044F\u043C\u043E."},{sk:"\u0160kola je vpravo.",ru:"\u0428\u043A\u043E\u043B\u0430 \u0441\u043F\u0440\u0430\u0432\u0430."}]},words:[{sk:"stanica",ru:"\u0441\u0442\u0430\u043D\u0446\u0438\u044F; \u0432\u043E\u043A\u0437\u0430\u043B",example:"Stanica je bl\xEDzko.",translation:"\u0412\u043E\u043A\u0437\u0430\u043B \u0431\u043B\u0438\u0437\u043A\u043E."},{sk:"zast\xE1vka",ru:"\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430",example:"Zast\xE1vka je tu.",translation:"\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 \u0437\u0434\u0435\u0441\u044C."},{sk:"ulica",ru:"\u0443\u043B\u0438\u0446\u0430",example:"T\xE1to ulica je tich\xE1.",translation:"\u042D\u0442\u0430 \u0443\u043B\u0438\u0446\u0430 \u0442\u0438\u0445\u0430\u044F."},{sk:"n\xE1mestie",ru:"\u043F\u043B\u043E\u0449\u0430\u0434\u044C",example:"N\xE1mestie je ve\u013Ek\xE9.",translation:"\u041F\u043B\u043E\u0449\u0430\u0434\u044C \u0431\u043E\u043B\u044C\u0448\u0430\u044F."},{sk:"v\u013Eavo",ru:"\u0441\u043B\u0435\u0432\u0430; \u043D\u0430\u043B\u0435\u0432\u043E",example:"\u0160kola je v\u013Eavo.",translation:"\u0428\u043A\u043E\u043B\u0430 \u0441\u043B\u0435\u0432\u0430."},{sk:"vpravo",ru:"\u0441\u043F\u0440\u0430\u0432\u0430; \u043D\u0430\u043F\u0440\u0430\u0432\u043E",example:"Cho\u010Fte vpravo.",translation:"\u0418\u0434\u0438\u0442\u0435 \u043D\u0430\u043F\u0440\u0430\u0432\u043E."},{sk:"rovno",ru:"\u043F\u0440\u044F\u043C\u043E",example:"Cho\u010Fte rovno.",translation:"\u0418\u0434\u0438\u0442\u0435 \u043F\u0440\u044F\u043C\u043E."},{sk:"bl\xEDzko",ru:"\u0431\u043B\u0438\u0437\u043A\u043E",example:"Mesto je bl\xEDzko.",translation:"\u0413\u043E\u0440\u043E\u0434 \u0431\u043B\u0438\u0437\u043A\u043E."},{sk:"\u010Faleko",ru:"\u0434\u0430\u043B\u0435\u043A\u043E",example:"Dom je \u010Faleko.",translation:"\u0414\u043E\u043C \u0434\u0430\u043B\u0435\u043A\u043E."},{sk:"kde",ru:"\u0433\u0434\u0435",example:"Kde je Nina?",translation:"\u0413\u0434\u0435 \u041D\u0438\u043D\u0430?"}],exercises:[{type:"choice",prompt:"\u041A\u0430\u043A \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C \xAB\u0413\u0434\u0435 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430?\xBB?",options:["Kde je zast\xE1vka?","Kedy je zast\xE1vka?","Kto je zast\xE1vka?","Ko\u013Eko je zast\xE1vka?"],answer:"Kde je zast\xE1vka?",explanation:"\u041E \u043C\u0435\u0441\u0442\u043E\u043D\u0430\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0438 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u044E\u0442 \u0441\u043B\u043E\u0432\u043E\u043C kde."},{type:"cloze",prompt:"\u0412\u0441\u0442\u0430\u0432\u044C \u0441\u043B\u043E\u0432\u043E \xAB\u043F\u0440\u044F\u043C\u043E\xBB.",options:["rovno","zajtra","desa\u0165","pros\xEDm"],answer:"rovno",explanation:"Rovno \u2014 \u043F\u0440\u044F\u043C\u043E. Cho\u010Fte \u2014 \u0432\u0435\u0436\u043B\u0438\u0432\u0430\u044F \u0444\u043E\u0440\u043C\u0430 \xAB\u0438\u0434\u0438\u0442\u0435\xBB.",sk:"Cho\u010Fte _____.",ru:"\u0418\u0434\u0438\u0442\u0435 \u043F\u0440\u044F\u043C\u043E."},{type:"choice",prompt:"\u0427\u0442\u043E \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 Kam?",options:["\u041A\u0443\u0434\u0430?","\u0413\u0434\u0435?","\u041A\u043E\u0433\u0434\u0430?","\u041A\u0442\u043E?"],answer:"\u041A\u0443\u0434\u0430?",explanation:"Kam \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442 \u043E \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F."},{type:"typing",prompt:"\u041D\u0430\u043F\u0438\u0448\u0438 \u043F\u043E-\u0441\u043B\u043E\u0432\u0430\u0446\u043A\u0438 \xAB\u043D\u0430\u043B\u0435\u0432\u043E\xBB \u043E\u0434\u043D\u0438\u043C \u0441\u043B\u043E\u0432\u043E\u043C.",answer:"v\u013Eavo",explanation:"\u0412 \u0441\u043B\u043E\u0432\u0435 v\u013Eavo \u043D\u0443\u0436\u043D\u0430 \u043C\u044F\u0433\u043A\u0430\u044F \u013E."},{type:"listening",prompt:"\u0421 \u043A\u0430\u043A\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0448\u043A\u043E\u043B\u0430?",options:["\u0421\u043F\u0440\u0430\u0432\u0430","\u0421\u043B\u0435\u0432\u0430","\u0417\u0430 \u0432\u043E\u043A\u0437\u0430\u043B\u043E\u043C","\u041D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u0438"],answer:"\u0421\u043F\u0440\u0430\u0432\u0430",explanation:"\u0428\u043A\u043E\u043B\u0430 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F vpravo \u2014 \u0441\u043F\u0440\u0430\u0432\u0430.",audio:"Cho\u010Fte rovno. \u0160kola je vpravo."},{type:"order",prompt:"\u0421\u043E\u0431\u0435\u0440\u0438 \xAB\u0418\u0437\u0432\u0438\u043D\u0438\u0442\u0435, \u0433\u0434\u0435 \u0432\u043E\u043A\u0437\u0430\u043B?\xBB, \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 Prep\xE1\u010Dte.",answer:["Prep\xE1\u010Dte,","kde","je","stanica?"],explanation:"Prep\xE1\u010Dte \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u0435\u0442 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u0432\u0435\u0436\u043B\u0438\u0432\u043E, \u0437\u0430\u0442\u0435\u043C \u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u0432\u043E\u043F\u0440\u043E\u0441 \u043E \u043C\u0435\u0441\u0442\u0435."},{type:"reading",prompt:"\u0427\u0442\u043E \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0434\u0430\u043B\u0435\u043A\u043E?",options:["\u0428\u043A\u043E\u043B\u0430","\u0412\u043E\u043A\u0437\u0430\u043B","\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430","\u041F\u043B\u043E\u0449\u0430\u0434\u044C"],answer:"\u0428\u043A\u043E\u043B\u0430",explanation:"\u0428\u043A\u043E\u043B\u0430 \u043E\u043F\u0438\u0441\u0430\u043D\u0430 \u0441\u043B\u043E\u0432\u043E\u043C \u010Faleko.",text:"Stanica je bl\xEDzko. Zast\xE1vka je v\u013Eavo. \u0160kola je \u010Faleko. Nina \u010Dak\xE1 na n\xE1mest\xED."},{type:"choice",prompt:"\u0422\u044B \u0443\u0441\u043B\u044B\u0448\u0430\u043B Cho\u010Fte v\u013Eavo. \u0427\u0442\u043E \u043D\u0443\u0436\u043D\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C?",options:["\u041F\u043E\u0439\u0442\u0438 \u043D\u0430\u043B\u0435\u0432\u043E","\u041F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u044C \u043D\u0430\u043F\u0440\u0430\u0432\u043E","\u041E\u0441\u0442\u0430\u0442\u044C\u0441\u044F \u043D\u0430 \u043C\u0435\u0441\u0442\u0435","\u041F\u0440\u0438\u0439\u0442\u0438 \u0437\u0430\u0432\u0442\u0440\u0430"],answer:"\u041F\u043E\u0439\u0442\u0438 \u043D\u0430\u043B\u0435\u0432\u043E",explanation:"V\u013Eavo \u043F\u0440\u0438 \u0433\u043B\u0430\u0433\u043E\u043B\u0435 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \xAB\u043D\u0430\u043B\u0435\u0432\u043E\xBB."}]},{id:"a1-07",level:"A1",title:"\u041F\u043E\u043A\u0443\u043F\u043A\u0438 \u043D\u0430 \u0440\u044B\u043D\u043A\u0435",location:"\u0420\u044B\u043D\u043E\u043A",scene:"\u041D\u0438\u043D\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u043F\u0438\u0441\u043E\u043A \u043F\u043E\u043A\u0443\u043F\u043E\u043A. \u041D\u0430\u0439\u0434\u0438 \u043D\u0443\u0436\u043D\u044B\u0435 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u044B \u0438 \u0432\u044B\u0431\u0435\u0440\u0438 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0443\u044E \u0441\u0443\u043C\u043A\u0443 \u0434\u043B\u044F \u0434\u043E\u0440\u043E\u0433\u0438.",goal:"\u041E\u043F\u0438\u0441\u044B\u0432\u0430\u0442\u044C \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B \u0438 \u0441\u043E\u0433\u043B\u0430\u0441\u043E\u0432\u044B\u0432\u0430\u0442\u044C \u043F\u0440\u043E\u0441\u0442\u044B\u0435 \u043F\u0440\u0438\u043B\u0430\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0435.",grammar:{title:"\u0420\u043E\u0434 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u0438 \u043F\u0440\u0438\u043B\u0430\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E",body:"\u041F\u0440\u0438\u043B\u0430\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u043C\u0435\u043D\u044F\u0435\u0442 \u0444\u043E\u0440\u043C\u0443 \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C. \u0412 \u043F\u0440\u043E\u0441\u0442\u043E\u0439 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0439 \u0444\u043E\u0440\u043C\u0435 \u0441\u0440\u0430\u0432\u043D\u0438 mal\xFD obchod \u2014 \xAB\u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\xBB, mal\xE1 ta\u0161ka \u2014 \xAB\u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F \u0441\u0443\u043C\u043A\u0430\xBB, mal\xE9 jablko \u2014 \xAB\u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0435 \u044F\u0431\u043B\u043E\u043A\u043E\xBB. \u0422\u0438\u043F\u0438\u0447\u043D\u044B\u0435 \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u044F \u0437\u0434\u0435\u0441\u044C -\xFD, -\xE1, -\xE9; \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u0443 \u043F\u0440\u0438\u043B\u0430\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E ve\u013Ek\xFD \u0444\u043E\u0440\u043C\u044B \u0432\u044B\u0433\u043B\u044F\u0434\u044F\u0442 \u043A\u0430\u043A ve\u013Ek\xFD, ve\u013Ek\xE1, ve\u013Ek\xE9. \u042D\u0442\u043E \u043C\u043E\u0434\u0435\u043B\u0438 \u0434\u043B\u044F \u0438\u043C\u0435\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E \u0447\u0438\u0441\u043B\u0430, \u0430 \u043D\u0435 \u0434\u043B\u044F \u0432\u0441\u0435\u0445 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0439. \u041F\u043E\u0441\u043B\u0435 chcem \u0444\u043E\u0440\u043C\u0430 \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u043C: Chcem mal\xFA ta\u0161ku. \u0423 \u043D\u0435\u043E\u0434\u0443\u0448\u0435\u0432\u043B\u0451\u043D\u043D\u043E\u0433\u043E \u043C\u0443\u0436\u0441\u043A\u043E\u0433\u043E \u0440\u043E\u0434\u0430 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F Chcem mal\xFD syr. \u0427\u0442\u043E\u0431\u044B \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0446\u0435\u043D\u0443, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 Ko\u013Eko to stoj\xED? \u0421\u043B\u043E\u0432\u043E cena \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \xAB\u0446\u0435\u043D\u0430\xBB, \u0430 drah\xFD \u0438 lacn\xFD \u2014 \xAB\u0434\u043E\u0440\u043E\u0433\u043E\u0439\xBB \u0438 \xAB\u0434\u0435\u0448\u0451\u0432\u044B\u0439\xBB.",examples:[{sk:"mal\xFD obchod",ru:"\u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u043C\u0430\u0433\u0430\u0437\u0438\u043D"},{sk:"mal\xE1 ta\u0161ka",ru:"\u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F \u0441\u0443\u043C\u043A\u0430"},{sk:"Chcem ve\u013Ek\xE9 jablko.",ru:"\u042F \u0445\u043E\u0447\u0443 \u0431\u043E\u043B\u044C\u0448\u043E\u0435 \u044F\u0431\u043B\u043E\u043A\u043E."}]},words:[{sk:"obchod",ru:"\u043C\u0430\u0433\u0430\u0437\u0438\u043D",example:"Obchod je otvoren\xFD.",translation:"\u041C\u0430\u0433\u0430\u0437\u0438\u043D \u043E\u0442\u043A\u0440\u044B\u0442."},{sk:"potraviny",ru:"\u043F\u0440\u043E\u0434\u0443\u043A\u0442\u044B \u043F\u0438\u0442\u0430\u043D\u0438\u044F",example:"Kupujem potraviny.",translation:"\u042F \u043F\u043E\u043A\u0443\u043F\u0430\u044E \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u044B."},{sk:"jablko",ru:"\u044F\u0431\u043B\u043E\u043A\u043E",example:"Jablko je \u010Derven\xE9.",translation:"\u042F\u0431\u043B\u043E\u043A\u043E \u043A\u0440\u0430\u0441\u043D\u043E\u0435."},{sk:"syr",ru:"\u0441\u044B\u0440",example:"Tento syr je dobr\xFD.",translation:"\u042D\u0442\u043E\u0442 \u0441\u044B\u0440 \u0432\u043A\u0443\u0441\u043D\u044B\u0439."},{sk:"cena",ru:"\u0446\u0435\u043D\u0430",example:"Cena je n\xEDzka.",translation:"\u0426\u0435\u043D\u0430 \u043D\u0438\u0437\u043A\u0430\u044F."},{sk:"drah\xFD",ru:"\u0434\u043E\u0440\u043E\u0433\u043E\u0439 \u043F\u043E \u0446\u0435\u043D\u0435",example:"Tento syr je drah\xFD.",translation:"\u042D\u0442\u043E\u0442 \u0441\u044B\u0440 \u0434\u043E\u0440\u043E\u0433\u043E\u0439."},{sk:"lacn\xFD",ru:"\u0434\u0435\u0448\u0451\u0432\u044B\u0439",example:"Chlieb je lacn\xFD.",translation:"\u0425\u043B\u0435\u0431 \u0434