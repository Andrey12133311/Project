          .sq-city-svg { font-family: "Trebuchet MS", Arial, sans-serif; }
          .sq-map-pin { cursor: pointer; outline: none; }
          .sq-pin-inner { transform-origin: 0px 0px; transition: transform .18s ease; }
          .sq-map-pin:hover .sq-pin-inner, .sq-map-pin:focus-visible .sq-pin-inner { transform: translateY(-4px) scale(1.08); }
          .sq-map-pin:focus-visible .sq-focus-ring { opacity: 1; }
          .sq-focus-ring { opacity: 0; }
          .sq-active-ring { transform-origin: 0px 0px; animation: sq-map-beacon 3s ease-in-out infinite; }
          .sq-city-tram { animation: sq-map-tram 9s ease-in-out infinite alternate; }
          .sq-river-glint { animation: sq-map-water 5s ease-in-out infinite alternate; }
          .sq-river-glint-late { animation-delay: -2.5s; }
          .sq-city-cloud { animation: sq-map-cloud 25s ease-in-out infinite alternate; }
          @keyframes sq-map-tram { from { transform: translate(0px, 0px); } to { transform: translate(28px, 14px); } }
          @keyframes sq-map-water { from { opacity: .2; transform: translateX(-3px); } to { opacity: .7; transform: translateX(5px); } }
          @keyframes sq-map-cloud { from { transform: translateX(0); } to { transform: translateX(15px); } }
          @keyframes sq-map-beacon { 0%, 100% { opacity: .22; transform: scale(1); } 50% { opacity: .08; transform: scale(1.18); } }
          @media (max-width: 600px) {
            .sq-pin-inner { transform: scale(1.34); }
            .sq-map-pin:hover .sq-pin-inner, .sq-map-pin:focus-visible .sq-pin-inner { transform: translateY(-3px) scale(1.4); }
          }
          @media (max-width: 430px) {
            .sq-pin-inner { transform: scale(1.65); }
            .sq-map-pin:hover .sq-pin-inner, .sq-map-pin:focus-visible .sq-pin-inner { transform: translateY(-3px) scale(1.72); }
          }
          @media (prefers-reduced-motion: reduce) {
            .sq-active-ring, .sq-city-tram, .sq-river-glint, .sq-city-cloud { animation: none; }
            .sq-pin-inner { transition: none; }
          }
