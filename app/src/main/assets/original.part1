@media(max-width:360px){.topbar{padding:0 12px}.brand{font-size:20px}.brand-symbol{width:32px;height:32px}.top-stats{gap:8px}.top-stats>span{font-size:10px}.brand small{font-size:5.2px;letter-spacing:1.1px}.main-content{padding-left:12px;padding-right:12px}.chapter-tab strong{font-size:7px}.page-intro h1{font-size:24px}.mission-row small{max-width:155px}.mission-row .stars{gap:1px}.map-heading h2{font-size:13px}.map-badge{display:none}.phrase-block{font-size:22px}.exercise-inner{padding-left:17px;padding-right:17px}.result-metrics{gap:19px}}
