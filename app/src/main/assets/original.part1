/* Reading contrast: preserve the quiet palette without fading instructional text. */
:root{--muted:#756980}.page-intro .muted,.section-title>p:last-child{color:#82718d}.sidebar nav>button,.sidebar-settings{color:#79678a}.sidebar nav>button{font-size:13px}.chapter-tab strong{font-size:12px}.chapter-tab small{color:#8f7a9e}.mission-goal{color:#7f6c8e;font-size:12px}.location-label,.mission-info{color:#9781a5}.mentor-line strong{color:#81628f}.mentor-line p span{color:#9a80a8}.daily-heading strong{color:#6a755e}.daily-heading div>span{color:#859174}.mission-row strong{font-size:12px}.mission-row small{color:#8e779e}.grammar-content>p,.brief-rule>p{color:#705b81}.grammar-example span{color:#897097}.grammar-example strong{color:#4e3b60}.brief-words strong{color:#71508a}.brief-words span{color:#92779f}.story-text{color:#79598c}.learning-goal{color:#6f8359}.word-translation{color:#8e6da2}.word-card>.small{color:#8d779c}.word-example{color:#63526f}.word-card>.text-button{color:#806099}.reading-block p,.transcript{color:#655076}.self-check>label{color:#7c6090}.model-answer>p{color:#745987}.answer-explanation p{color:#778268}.has-error .answer-explanation p{color:#917463}.answer-explanation strong{color:#5b794b}.has-error .answer-explanation strong{color:#9a6a50}.settings-card>p{color:#8b729b}.settings-card>p.small{color:#917a9e}.practice-card p{color:#8e759e}.note-strip p{color:#897496}.workshop-card h3{color:#665074}.session-result>p:not(.eyebrow){color:#9875ac}.typing-task>label,.field-label{color:#8b6c9e}.exercise-kind{color:#9169ab}.phrase-block{color:#6d488b}.mission-top .eyebrow{color:#9a7caa}.chapter-tab.active strong{color:#62497d}.grammar-heading strong{color:#644f75}.dictionary-grid .small{line-height:1.8}
@media(max-width:1200px){.chapter-tab strong{font-size:10px}.mission-goal{font-size:11px}}
@media(max-width:740px){.chapter-tab strong{font-size:9px}.mission-row strong{font-size:12px}}
@media(max-width:560px){.chapter-tab strong{font-size:8px}.mission-goal{font-size:12px}.mission-row strong{font-size:11px}.brief-words span{font-size:12px}.brief-rule>p{font-size:14px}.grammar-content>p{font-size:13px}.grammar-example span{font-size:11px}}
.session-result h2{color:#735186}.session-result>p:not(.eyebrow){color:#7b628b}.result-metrics strong{color:#88669c}.result-metrics span{color:#927a9e}.self-check h3{color:#79578f}.writing-task>.small,.speaking-task>.small,.model-answer>p.small{color:#887095}.answer-footer>.small{color:#8e769c}.listen-block .small{color:#8b709a}.brief-start>.small{color:#927a9f}.settings-field,.switch-label small{color:#897194}.section-heading>span{color:#8f7a9e}.sources-box{color:#8c769a}.lesson-brief .eyebrow,.exercise-kind>.mini-badge{color:#8c6da1}
.context-details{background:#f4eefb;border:1px solid #e4d7f1;border-radius:13px;margin:0 0 23px;overflow:hidden}.context-details summary{cursor:pointer;font-size:12px;font-weight:600;color:#86629f;padding:16px;list-style:inside}.context-details summary>svg{margin:0 8px -3px 0}.context-details p{font-size:14px;line-height:1.95;color:#705480;white-space:pre-line;padding:0 19px 20px}
.load-more{text-align:center;margin:28px 0}.load-more .small{margin-top:13px;color:#9278a0}
