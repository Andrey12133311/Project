. \u0417\u043D\u0430\u043A \u043D\u0430\u0434 \xE1, \xE9, \xED, \xF3, \xFA, \xFD \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0434\u043E\u043B\u0433\u043E\u0442\u0443: \u0437\u0432\u0443\u043A \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u0434\u043E\u043B\u044C\u0448\u0435, \u0430 \u043D\u0435 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u0441 \u0443\u0434\u0430\u0440\u0435\u043D\u0438\u0435\u043C. \u0423\u0434\u0430\u0440\u0435\u043D\u0438\u0435 \u043E\u0431\u044B\u0447\u043D\u043E \u043F\u0430\u0434\u0430\u0435\u0442 \u043D\u0430 \u043F\u0435\u0440\u0432\u044B\u0439 \u0441\u043B\u043E\u0433 \u0441\u043B\u043E\u0432\u0430. \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u0432 \u0441\u043B\u043E\u0432\u0435 dobr\xFD \u0443\u0434\u0430\u0440\u043D\u044B\u0439 \u043F\u0435\u0440\u0432\u044B\u0439 \u0441\u043B\u043E\u0433, \u0445\u043E\u0442\u044F \xFD \u0434\u043E\u043B\u0433\u0438\u0439. \u0414\u043E\u043B\u0433\u043E\u0442\u0430 \u043C\u043E\u0436\u0435\u0442 \u043C\u0435\u043D\u044F\u0442\u044C \u0441\u043C\u044B\u0441\u043B: mala \u2014 \xAB\u043E\u043D\u0430 \u0438\u043C\u0435\u043B\u0430\xBB, mal\xE1 \u2014 \xAB\u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F\xBB. \u0411\u0443\u043A\u0432\u044B \u010F, \u0165, \u0148 \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0430\u044E\u0442 \u043C\u044F\u0433\u043A\u0438\u0435 \u0441\u043E\u0433\u043B\u0430\u0441\u043D\u044B\u0435. \u0421\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0435 ch \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442 \u043E\u0434\u0438\u043D \u0437\u0432\u0443\u043A, \u0431\u043B\u0438\u0437\u043A\u0438\u0439 \u0440\u0443\u0441\u0441\u043A\u043E\u043C\u0443 \xAB\u0445\xBB. \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0441\u043B\u0443\u0448\u0430\u0439 \u0441\u043B\u043E\u0432\u043E, \u0437\u0430\u0442\u0435\u043C \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0439 \u0435\u0433\u043E \u0446\u0435\u043B\u0438\u043A\u043E\u043C, \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044F \u0434\u043E\u043B\u0433\u043E\u0442\u0443.",examples:[{sk:"\u0161kola",ru:"\u0448\u043A\u043E\u043B\u0430"},{sk:"mal\xE1 kniha",ru:"\u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F \u043A\u043D\u0438\u0433\u0430"},{sk:"To je moje meno.",ru:"\u042D\u0442\u043E \u043C\u043E\u0451 \u0438\u043C\u044F."}]},words:[{sk:"slovo",ru:"\u0441\u043B\u043E\u0432\u043E",example:"To je nov\xE9 slovo.",translation:"\u042D\u0442\u043E \u043D\u043E\u0432\u043E\u0435 \u0441\u043B\u043E\u0432\u043E."},{sk:"veta",ru:"\u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435",example:"T\xE1to veta je kr\xE1tka.",translation:"\u042D\u0442\u043E \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0435."},{sk:"jazyk",ru:"\u044F\u0437\u044B\u043A",example:"Sloven\u010Dina je jazyk.",translation:"\u0421\u043B\u043E\u0432\u0430\u0446\u043A\u0438\u0439 \u2014 \u044D\u0442\u043E \u044F\u0437\u044B\u043A."},{sk:"p\xEDsmeno",ru:"\u0431\u0443\u043A\u0432\u0430",example:"Toto je p\xEDsmeno A.",translation:"\u042D\u0442\u043E \u0431\u0443\u043A\u0432\u0430 A."},{sk:"meno",ru:"\u0438\u043C\u044F",example:"Moje meno je Andrej.",translation:"\u041C\u0435\u043D\u044F \u0437\u043E\u0432\u0443\u0442 \u0410\u043D\u0434\u0440\u0435\u0439."},{sk:"mesto",ru:"\u0433\u043E\u0440\u043E\u0434",example:"Bratislava je mesto.",translation:"\u0411\u0440\u0430\u0442\u0438\u0441\u043B\u0430\u0432\u0430 \u2014 \u0433\u043E\u0440\u043E\u0434."},{sk:"\u0161kola",ru:"\u0448\u043A\u043E\u043B\u0430",example:"Tu je \u0161kola.",translation:"\u0417\u0434\u0435\u0441\u044C \u0448\u043A\u043E\u043B\u0430."},{sk:"kniha",ru:"\u043A\u043D\u0438\u0433\u0430",example:"To je moja kniha.",translation:"\u042D\u0442\u043E \u043C\u043E\u044F \u043A\u043D\u0438\u0433\u0430."},{sk:"\u010Dlovek",ru:"\u0447\u0435\u043B\u043E\u0432\u0435\u043A",example:"Tam je \u010Dlovek.",translation:"\u0422\u0430\u043C \u0447\u0435\u043B\u043E\u0432\u0435\u043A."},{sk:"de\u0148",ru:"\u0434\u0435\u043D\u044C",example:"Dnes je pekn\xFD de\u0148.",translation:"\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0434\u0435\u043D\u044C."}],exercises:[{type:"choice",prompt:"\u041A\u0430\u043A\u043E\u0439 \u0440\u0443\u0441\u0441\u043A\u0438\u0439 \u0437\u0432\u0443\u043A \u0431\u043B\u0438\u0436\u0435 \u0432\u0441\u0435\u0433\u043E \u043A \u0441\u043B\u043E\u0432\u0430\u0446\u043A\u043E\u0439 \u0431\u0443\u043A\u0432\u0435 \u010D?",options:["\u0447","\u0446","\u0448","\u043A"],answer:"\u0447",explanation:"\u0411\u0443\u043A\u0432\u0430 \u010D \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442 \u0437\u0432\u0443\u043A, \u0431\u043B\u0438\u0437\u043A\u0438\u0439 \u0440\u0443\u0441\u0441\u043A\u043E\u043C\u0443 \xAB\u0447\xBB."},{type:"choice",prompt:"\u0427\u0442\u043E \u043E\u0431\u044B\u0447\u043D\u043E \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0437\u043D\u0430\u043A \u043D\u0430\u0434 \xE1 \u0438\u043B\u0438 \xED?",options:["\u0414\u043E\u043B\u0433\u043E\u0442\u0443 \u0433\u043B\u0430\u0441\u043D\u043E\u0433\u043E","\u0412\u0441\u0435\u0433\u0434\u0430 \u0443\u0434\u0430\u0440\u0435\u043D\u0438\u0435","\u041C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435 \u0447\u0438\u0441\u043B\u043E","\u041C\u044F\u0433\u043A\u043E\u0441\u0442\u044C \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u0441\u043E\u0433\u043B\u0430\u0441\u043D\u043E\u0433\u043E"],answer:"\u0414\u043E\u043B\u0433\u043E\u0442\u0443 \u0433\u043B\u0430\u0441\u043D\u043E\u0433\u043E",explanation:"\u0414\u043E\u043B\u0433\u0430\u044F \u0433\u043B\u0430\u0441\u043D\u0430\u044F \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u0434\u043E\u043B\u044C\u0448\u0435. \u0423\u0434\u0430\u0440\u0435\u043D\u0438\u0435 \u0438 \u0434\u043E\u043B\u0433\u043E\u0442\u0430 \u2014 \u0440\u0430\u0437\u043D\u044B\u0435 \u043F\u0440\u0438\u0437\u043D\u0430\u043A\u0438."},{type:"choice",prompt:"\u041D\u0430 \u043A\u0430\u043A\u043E\u0439 \u0441\u043B\u043E\u0433 \u043E\u0431\u044B\u0447\u043D\u043E \u043F\u0430\u0434\u0430\u0435\u0442 \u0443\u0434\u0430\u0440\u0435\u043D\u0438\u0435 \u0432 \u0441\u043B\u043E\u0432\u0430\u0446\u043A\u043E\u043C \u0441\u043B\u043E\u0432\u0435?",options:["\u041D\u0430 \u043F\u0435\u0440\u0432\u044B\u0439","\u041D\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439","\u0412\u0441\u0435\u0433\u0434\u0430 \u043D\u0430 \u0434\u043E\u043B\u0433\u0438\u0439","\u0412\u0441\u0435\u0433\u0434\u0430 \u043D\u0430 \u0432\u0442\u043E\u0440\u043E\u0439"],answer:"\u041D\u0430 \u043F\u0435\u0440\u0432\u044B\u0439",explanation:"\u041E\u0441\u043D\u043E\u0432\u043D\u043E\u0435 \u0441\u043B\u043E\u0432\u0435\u0441\u043D\u043E\u0435 \u0443\u0434\u0430\u0440\u0435\u043D\u0438\u0435 \u043E\u0431\u044B\u0447\u043D\u043E \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043D\u0430 \u043F\u0435\u0440\u0432\u043E\u043C \u0441\u043B\u043E\u0433\u0435."},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0435 \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u0438\u0435 \u0441\u043B\u043E\u0432\u0430 \xAB\u0448\u043A\u043E\u043B\u0430\xBB.",options:["\u0161kola","skola","scola","\u0161k\xF3la"],answer:"\u0161kola",explanation:"\u0412 \u0441\u043B\u043E\u0432\u0435 \u0161kola \u043D\u0443\u0436\u043D\u0430 \u0431\u0443\u043A\u0432\u0430 \u0161; \u0434\u043E\u043B\u0433\u043E\u0439 \xF3 \u0437\u0434\u0435\u0441\u044C \u043D\u0435\u0442.",sk:"To je _____.",ru:"\u042D\u0442\u043E \u0448\u043A\u043E\u043B\u0430."},{type:"typing",prompt:"\u041D\u0430\u043F\u0438\u0448\u0438 \u043F\u043E-\u0441\u043B\u043E\u0432\u0430\u0446\u043A\u0438 \u0441\u043B\u043E\u0432\u043E \xAB\u043A\u043D\u0438\u0433\u0430\xBB.",answer:"kniha",explanation:"\u041A\u043D\u0438\u0433\u0430 \u2014 kniha. \u0412 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435 \u043F\u0438\u0448\u0435\u0442\u0441\u044F h, \u0430 \u043D\u0435 ch."},{type:"listening",prompt:"\u041F\u043E\u0441\u043B\u0443\u0448\u0430\u0439 \u0441\u043B\u043E\u0432\u043E. \u041A\u0430\u043A \u043E\u043D\u043E \u043F\u0438\u0448\u0435\u0442\u0441\u044F?",options:["de\u0148","dom","dva","dar"],answer:"de\u0148",explanation:"\u0412 \u0441\u043B\u043E\u0432\u0435 de\u0148 \u043A\u043E\u043D\u0435\u0447\u043D\u0430\u044F \u0148 \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u043C\u044F\u0433\u043A\u0438\u0439 \u0441\u043E\u0433\u043B\u0430\u0441\u043D\u044B\u0439.",audio:"de\u0148"},{type:"order",prompt:"\u0421\u043E\u0431\u0435\u0440\u0438 \xAB\u042D\u0442\u043E \u043C\u043E\u0451 \u0438\u043C\u044F\xBB, \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 To.",answer:["To","je","moje","meno."],explanation:"To je moje meno. \u0421\u043B\u043E\u0432\u043E meno \u0441\u0440\u0435\u0434\u043D\u0435\u0433\u043E \u0440\u043E\u0434\u0430, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 moje."},{type:"reading",prompt:"\u0427\u0442\u043E \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0443 \u041D\u0438\u043D\u044B?",options:["\u041A\u043D\u0438\u0433\u0430","\u0411\u0438\u043B\u0435\u0442","\u041A\u043B\u044E\u0447","\u041A\u043E\u0444\u0435"],answer:"\u041A\u043D\u0438\u0433\u0430",explanation:"\u0412 \u0442\u0435\u043A\u0441\u0442\u0435 \u0441\u043A\u0430\u0437\u0430\u043D\u043E Nina m\xE1 knihu \u2014 \u0443 \u041D\u0438\u043D\u044B \u0435\u0441\u0442\u044C \u043A\u043D\u0438\u0433\u0430.",text:"To je Nina. Nina m\xE1 knihu. Kniha je mal\xE1."}]},{id:"a1-02",level:"A1",title:"\u041F\u0435\u0440\u0432\u044B\u0439 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440",location:"\u041F\u043B\u043E\u0449\u0430\u0434\u044C",scene:"\u041D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u0438 \u041D\u0438\u043D\u0430 \u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0442 \u0442\u0435\u0431\u044F \u0441 \u041C\u0430\u0442\u0435\u0435\u043C. \u041D\u0443\u0436\u043D\u043E \u043F\u043E\u0437\u0434\u043E\u0440\u043E\u0432\u0430\u0442\u044C\u0441\u044F, \u043F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C \u0437\u0430 \u043F\u043E\u043C\u043E\u0449\u044C \u0438 \u043F\u043E\u043F\u0440\u043E\u0449\u0430\u0442\u044C\u0441\u044F.",goal:"\u0412\u044B\u0431\u0438\u0440\u0430\u0442\u044C \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435 \u0438 \u0432\u0435\u0436\u043B\u0438\u0432\u0443\u044E \u0444\u043E\u0440\u043C\u0443\u043B\u0443 \u043F\u043E \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438.",grammar:{title:"\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044F \u0438 \u0432\u0435\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u044C",body:"\u0421 \u043F\u0440\u0438\u044F\u0442\u0435\u043B\u0435\u043C \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0437\u0434\u043E\u0440\u043E\u0432\u0430\u0442\u044C\u0441\u044F \u0441\u043B\u043E\u0432\u043E\u043C Ahoj. \u0412 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435, \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435 \u0438\u043B\u0438 \u043F\u0440\u0438 \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u0438 \u043A \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u043E\u043C\u0443 \u0432\u0437\u0440\u043E\u0441\u043B\u043E\u043C\u0443 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 Dobr\xFD de\u0148. \u0423\u0442\u0440\u043E\u043C \u0433\u043E\u0432\u043E\u0440\u044F\u0442 Dobr\xE9 r\xE1no, \u0432\u0435\u0447\u0435\u0440\u043E\u043C \u2014 Dobr\xFD ve\u010Der. \u041F\u0440\u0438 \u043F\u0440\u043E\u0449\u0430\u043D\u0438\u0438 \u0432 \u0432\u0435\u0436\u043B\u0438\u0432\u043E\u0439 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438 \u0443\u043F\u043E\u0442\u0440\u0435\u0431\u043B\u044F\u044E\u0442 Dovidenia. \u010Eakujem \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \xAB\u0441\u043F\u0430\u0441\u0438\u0431\u043E\xBB. \u0421\u043B\u043E\u0432\u043E Pros\xEDm \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438: \u044D\u0442\u043E \xAB\u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430\xBB \u043F\u0440\u0438 \u043F\u0440\u043E\u0441\u044C\u0431\u0435, \u043E\u0442\u0432\u0435\u0442 \u043D\u0430 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C \u0438\u043B\u0438 \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C. Prep\xE1\u010Dte \u2014 \u0432\u0435\u0436\u043B\u0438\u0432\u043E\u0435 \xAB\u0438\u0437\u0432\u0438\u043D\u0438\u0442\u0435\xBB; \u043F\u0440\u0438\u044F\u0442\u0435\u043B\u044E \u043C\u043E\u0436\u043D\u043E \u0441\u043A\u0430\u0437\u0430\u0442\u044C Prep\xE1\u010D. \xC1no \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0435, Nie \u2014 \u043E\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442. \u0417\u0434\u0435\u0441\u044C \u0432\u0430\u0436\u043D\u0430 \u043D\u0435 \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u0430\u044F \u043F\u043E\u0434\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 \u0440\u0443\u0441\u0441\u043A\u043E\u0433\u043E \u0441\u043B\u043E\u0432\u0430, \u0430 \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F \u043C\u0435\u0436\u0434\u0443 \u0441\u043E\u0431\u0435\u0441\u0435\u0434\u043D\u0438\u043A\u0430\u043C\u0438. \u0415\u0441\u043B\u0438 \u0441\u043E\u043C\u043D\u0435\u0432\u0430\u0435\u0448\u044C\u0441\u044F, \u043F\u0440\u0438 \u043F\u0435\u0440\u0432\u043E\u043C \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u0438 \u0432\u044B\u0431\u0438\u0440\u0430\u0439 \u0432\u0435\u0436\u043B\u0438\u0432\u0443\u044E \u0444\u043E\u0440\u043C\u0443.",examples:[{sk:"Dobr\xFD de\u0148, pani Nov\xE1kov\xE1.",ru:"\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435, \u0433\u043E\u0441\u043F\u043E\u0436\u0430 \u041D\u043E\u0432\u0430\u043A\u043E\u0432\u0430."},{sk:"\u010Eakujem. \u2014 Pros\xEDm.",ru:"\u0421\u043F\u0430\u0441\u0438\u0431\u043E. \u2014 \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430."},{sk:"Prep\xE1\u010Dte, kde je \u0161kola?",ru:"\u0418\u0437\u0432\u0438\u043D\u0438\u0442\u0435, \u0433\u0434\u0435 \u0448\u043A\u043E\u043B\u0430?"}]},words:[{sk:"Ahoj",ru:"\u043F\u0440\u0438\u0432\u0435\u0442; \u043F\u043E\u043A\u0430",example:"Ahoj, Nina!",translation:"\u041F\u0440\u0438\u0432\u0435\u0442, \u041D\u0438\u043D\u0430!"},{sk:"Dobr\xFD de\u0148",ru:"\u0434\u043E\u0431\u0440\u044B\u0439 \u0434\u0435\u043D\u044C; \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435",example:"Dobr\xFD de\u0148, p\xE1n Nov\xE1k.",translation:"\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435, \u0433\u043E\u0441\u043F\u043E\u0434\u0438\u043D \u041D\u043E\u0432\u0430\u043A."},{sk:"Dobr\xE9 r\xE1no",ru:"\u0434\u043E\u0431\u0440\u043E\u0435 \u0443\u0442\u0440\u043E",example:"Dobr\xE9 r\xE1no, Matej.",translation:"\u0414\u043E\u0431\u0440\u043E\u0435 \u0443\u0442\u0440\u043E, \u041C\u0430\u0442\u0435\u0439."},{sk:"Dobr\xFD ve\u010Der",ru:"\u0434\u043E\u0431\u0440\u044B\u0439 \u0432\u0435\u0447\u0435\u0440",example:"Dobr\xFD ve\u010Der, pani u\u010Dite\u013Eka.",translation:"\u0414\u043E\u0431\u0440\u044B\u0439 \u0432\u0435\u0447\u0435\u0440, \u0443\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u0438\u0446\u0430."},{sk:"Dovidenia",ru:"\u0434\u043E \u0441\u0432\u0438\u0434\u0430\u043D\u0438\u044F",example:"\u010Eakujem a dovidenia.",translation:"\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0438 \u0434\u043E \u0441\u0432\u0438\u0434\u0430\u043D\u0438\u044F."},{sk:"\u010Eakujem",ru:"\u0441\u043F\u0430\u0441\u0438\u0431\u043E",example:"\u010Eakujem za pomoc.",translation:"\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0437\u0430 \u043F\u043E\u043C\u043E\u0449\u044C."},{sk:"Pros\xEDm",ru:"\u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430",example:"Vodu, pros\xEDm.",translation:"\u0412\u043E\u0434\u0443, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430."},{sk:"Prep\xE1\u010Dte",ru:"\u0438\u0437\u0432\u0438\u043D\u0438\u0442\u0435",example:"Prep\xE1\u010Dte, nerozumiem.",translation:"\u0418\u0437\u0432\u0438\u043D\u0438\u0442\u0435, \u044F \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E."},{sk:"\xC1no",ru:"\u0434\u0430",example:"\xC1no, to je moja kniha.",translation:"\u0414\u0430, \u044D\u0442\u043E \u043C\u043E\u044F \u043A\u043D\u0438\u0433\u0430."},{sk:"Nie",ru:"\u043D\u0435\u0442",example:"Nie, to nie je moje meno.",translation:"\u041D\u0435\u0442, \u044D\u0442\u043E \u043D\u0435 \u043C\u043E\u0451 \u0438\u043C\u044F."}],exercises:[{type:"choice",prompt:"\u0422\u044B \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0448\u044C\u0441\u044F \u043A \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0446\u0435 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430. \u041A\u0430\u043A \u043F\u043E\u0437\u0434\u043E\u0440\u043E\u0432\u0430\u0442\u044C\u0441\u044F?",options:["Dobr\xFD de\u0148.","Ahoj, kamar\xE1t!","Dobr\xFA noc.","Dovidenia."],answer:"Dobr\xFD de\u0148.",explanation:"Dobr\xFD de\u0148 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0434\u043B\u044F \u0432\u0435\u0436\u043B\u0438\u0432\u043E\u0433\u043E \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u044F."},{type:"cloze",prompt:"\u0412\u0441\u0442\u0430\u0432\u044C \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C.",options:["\u010Eakujem","Dovidenia","Nie","Ahoj"],answer:"\u010Eakujem",explanation:"\u010Eakujem za pomoc \u2014 \xAB\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0437\u0430 \u043F\u043E\u043C\u043E\u0449\u044C\xBB.",sk:"_____ za pomoc."},{type:"choice",prompt:"\u041A\u0430\u043A \u0432\u0435\u0436\u043B\u0438\u0432\u043E \u043F\u043E\u043F\u0440\u043E\u0449\u0430\u0442\u044C\u0441\u044F?",options:["Dovidenia.","Dobr\xE9 r\xE1no.","\xC1no.","Prep\xE1\u010Dte."],answer:"Dovidenia.",explanation:"Dovidenia \u2014 \u0432\u0435\u0436\u043B\u0438\u0432\u043E\u0435 \u043F\u0440\u043E\u0449\u0430\u043D\u0438\u0435."},{type:"typing",prompt:"\u041D\u0430\u043F\u0438\u0448\u0438 \u043F\u043E-\u0441\u043B\u043E\u0432\u0430\u0446\u043A\u0438 \xAB\u0441\u043F\u0430\u0441\u0438\u0431\u043E\xBB \u043E\u0434\u043D\u0438\u043C \u0441\u043B\u043E\u0432\u043E\u043C.",answer:"\u010Fakujem",explanation:"\u041D\u0435 \u0437\u0430\u0431\u0443\u0434\u044C \u043C\u044F\u0433\u043A\u0443\u044E \u010F \u0432 \u043D\u0430\u0447\u0430\u043B\u0435: \u010Fakujem."},{type:"listening",prompt:"\u041A\u0430\u043A\u043E\u0435 \u0432\u0440\u0435\u043C\u044F \u0441\u0443\u0442\u043E\u043A \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044E?",options:["\u0423\u0442\u0440\u043E","\u0412\u0435\u0447\u0435\u0440","\u041D\u043E\u0447\u044C","\u041F\u043E\u043B\u0434\u0435\u043D\u044C"],answer:"\u0423\u0442\u0440\u043E",explanation:"Dobr\xE9 r\xE1no \u2014 \xAB\u0414\u043E\u0431\u0440\u043E\u0435 \u0443\u0442\u0440\u043E\xBB.",audio:"Dobr\xE9 r\xE1no, Andrej."},{type:"order",prompt:"\u0421\u043E\u0431\u0435\u0440\u0438 \u0432\u0435\u0436\u043B\u0438\u0432\u043E\u0435 \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435, \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 Dobr\xFD.",answer:["Dobr\xFD","de\u0148,","pani","Nov\xE1kov\xE1."],explanation:"Dobr\xFD de\u0148, pani Nov\xE1kov\xE1. \u041E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u0435 \u0432\u044B\u0434\u0435\u043B\u0435\u043D\u043E \u0437\u0430\u043F\u044F\u0442\u043E\u0439."},{type:"reading",prompt:"\u0427\u0442\u043E \u041C\u0430\u0442\u0435\u0439 \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u043D\u0430 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C?",options:["Pros\xEDm.","Nie.","Dovidenia.","Dobr\xE9 r\xE1no."],answer:"Pros\xEDm.",explanation:"\u0412 \u044D\u0442\u043E\u043C \u0434\u0438\u0430\u043B\u043E\u0433\u0435 Pros\xEDm \u2014 \u043E\u0442\u0432\u0435\u0442 \xAB\u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430\xBB \u043D\u0430 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C.",text:`Nina: \u010Eakujem za pomoc.
Matej: Pros\xEDm.
Nina: Dovidenia!`},{type:"choice",prompt:"\u041D\u0443\u0436\u043D\u043E \u043F\u0440\u0438\u0432\u043B\u0435\u0447\u044C \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u043E\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0438 \u0438\u0437\u0432\u0438\u043D\u0438\u0442\u044C\u0441\u044F. \u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u0440\u0430\u0437\u0443.",options:["Prep\xE1\u010Dte.","\u010Eakujem.","Dovidenia.","\xC1no."],answer:"Prep\xE1\u010Dte.",explanation:"Prep\xE1\u010Dte \u2014 \u0432\u0435\u0436\u043B\u0438\u0432\u0430\u044F \u0444\u043E\u0440\u043C\u0430 \xAB\u0438\u0437\u0432\u0438\u043D\u0438\u0442\u0435\xBB."}]},{id:"a1-03",level:"A1",title:"\u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0438 \u043E \u0441\u0435\u0431\u0435",location:"\u0421\u0442\u0443\u0434\u0435\u043D\u0447\u0435\u0441\u043A\u0438\u0439 \u043A\u043B\u0443\u0431",scene:"\u041C\u0430\u0442\u0435\u0439 \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0430\u0435\u0442 \u0442\u0435\u0431\u044F \u0432 \u0441\u0442\u0443\u0434\u0435\u043D\u0447\u0435\u0441\u043A\u0438\u0439 \u043A\u043B\u0443\u0431. \u0414\u043B\u044F \u0431\u0435\u0439\u0434\u0436\u0430 \u043D\u0443\u0436\u043D\u043E \u043D\u0430\u0437\u0432\u0430\u0442\u044C \u0441\u0435\u0431\u044F \u0438 \u043A\u043E\u0440\u043E\u0442\u043A\u043E \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C, \u043E\u0442\u043A\u0443\u0434\u0430 \u0442\u044B.",goal:"\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044C\u0441\u044F \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u0432\u0440\u0435\u043C\u044F \u0433\u043B\u0430\u0433\u043E\u043B\u0430 by\u0165.",grammar:{title:"\u0413\u043B\u0430\u0433\u043E\u043B by\u0165 \u0438 \u043E\u0442\u0440\u0438\u0446\u0430\u043D\u0438\u0435",body:"\u0412 \u0441\u043B\u043E\u0432\u0430\u0446\u043A\u043E\u043C \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u043C \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0433\u043B\u0430\u0433\u043E\u043B \xAB\u0431\u044B\u0442\u044C\xBB \u043E\u0431\u044B\u0447\u043D\u043E \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442\u0441\u044F: Som \u0161tudent \u2014 \xAB\u042F \u0441\u0442\u0443\u0434\u0435\u043D\u0442\xBB. \u0424\u043E\u0440\u043C\u044B: ja som, ty si, on \u0438\u043B\u0438 ona je, my sme, vy ste, oni \u0438\u043B\u0438 ony s\xFA. \u041B\u0438\u0447\u043D\u043E\u0435 \u043C\u0435\u0441\u0442\u043E\u0438\u043C\u0435\u043D\u0438\u0435 \u0447\u0430\u0441\u0442\u043E \u043E\u043F\u0443\u0441\u043A\u0430\u044E\u0442, \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u043B\u0438\u0446\u043E \u0443\u0436\u0435 \u0432\u0438\u0434\u043D\u043E \u043F\u043E \u0433\u043B\u0430\u0433\u043E\u043B\u0443. \u041F\u0440\u0438 \u043E\u0442\u0440\u0438\u0446\u0430\u043D\u0438\u0438 \u0443\u043F\u043E\u0442\u0440\u0435\u0431\u043B\u044F\u044E\u0442\u0441\u044F nie som, nie si, nie je, nie sme, nie ste, nie s\xFA. \u0414\u043B\u044F \u0438\u043C\u0435\u043D\u0438 \u043D\u0443\u0436\u043D\u0430 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F Vol\xE1m sa Andrej. \u041F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435 \u043C\u043E\u0436\u043D\u043E \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0438\u0442\u044C \u0433\u043E\u0442\u043E\u0432\u043E\u0439 \u0444\u0440\u0430\u0437\u043E\u0439 Som z Ruska. \u041D\u0435 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438 \u0440\u0443\u0441\u0441\u043A\u0443\u044E \u0444\u0440\u0430\u0437\u0443 \u0431\u0435\u0437 \u0441\u0432\u044F\u0437\u043A\u0438: \u043F\u043E-\u0441\u043B\u043E\u0432\u0430\u0446\u043A\u0438 \xAB\u042F \u0441\u0442\u0443\u0434\u0435\u043D\u0442\xBB \u0442\u0440\u0435\u0431\u0443\u0435\u0442 som. \u041F\u0440\u0438 \u0432\u0435\u0436\u043B\u0438\u0432\u043E\u043C \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u0438 \u043A \u043E\u0434\u043D\u043E\u043C\u0443 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0443 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 vy ste.",examples:[{sk:"Vol\xE1m sa Andrej.",ru:"\u041C\u0435\u043D\u044F \u0437\u043E\u0432\u0443\u0442 \u0410\u043D\u0434\u0440\u0435\u0439."},{sk:"Som z Ruska.",ru:"\u042F \u0438\u0437 \u0420\u043E\u0441\u0441\u0438\u0438."},{sk:"Nie som u\u010Dite\u013E.",ru:"\u042F \u043D\u0435 \u0443\u0447\u0438\u0442\u0435\u043B\u044C."}]},words:[{sk:"\u0161tudent",ru:"\u0441\u0442\u0443\u0434\u0435\u043D\u0442",example:"Som \u0161tudent.",translation:"\u042F \u0441\u0442\u0443\u0434\u0435\u043D\u0442."},{sk:"\u0161tudentka",ru:"\u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043A\u0430",example:"Nina je \u0161tudentka.",translation:"\u041D\u0438\u043D\u0430 \u2014 \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043A\u0430."},{sk:"u\u010Dite\u013E",ru:"\u0443\u0447\u0438\u0442\u0435\u043B\u044C",example:"On je u\u010Dite\u013E.",translation:"\u041E\u043D \u0443\u0447\u0438\u0442\u0435\u043B\u044C."},{sk:"u\u010Dite\u013Eka",ru:"\u0443\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u0438\u0446\u0430",example:"Ona je u\u010Dite\u013Eka.",translation:"\u041E\u043D\u0430 \u0443\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u0438\u0446\u0430."},{sk:"Slovensko",ru:"\u0421\u043B\u043E\u0432\u0430\u043A\u0438\u044F",example:"Slovensko je v Eur\xF3pe.",translation:"\u0421\u043B\u043E\u0432\u0430\u043A\u0438\u044F \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0432 \u0415\u0432\u0440\u043E\u043F\u0435."},{sk:"Rusko",ru:"\u0420\u043E\u0441\u0441\u0438\u044F",example:"Som z Ruska.",translation:"\u042F \u0438\u0437 \u0420\u043E\u0441\u0441\u0438\u0438."},{sk:"poch\xE1dza\u0165",ru:"\u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442\u044C; \u0431\u044B\u0442\u044C \u0440\u043E\u0434\u043E\u043C",example:"Odkia\u013E poch\xE1dza\u0161?",translation:"\u041E\u0442\u043A\u0443\u0434\u0430 \u0442\u044B \u0440\u043E\u0434\u043E\u043C?"},{sk:"b\xFDva\u0165",ru:"\u0436\u0438\u0442\u044C; \u043F\u0440\u043E\u0436\u0438\u0432\u0430\u0442\u044C",example:"B\xFDvam v meste.",translation:"\u042F \u0436\u0438\u0432\u0443 \u0432 \u0433\u043E\u0440\u043E\u0434\u0435."},{sk:"hovori\u0165",ru:"\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C",example:"Hovor\xEDm po rusky.",translation:"\u042F \u0433\u043E\u0432\u043E\u0440\u044E \u043F\u043E-\u0440\u0443\u0441\u0441\u043A\u0438."},{sk:"rozumie\u0165",ru:"\u043F\u043E\u043D\u0438\u043C\u0430\u0442\u044C",example:"Rozumiem po slovensky.",translation:"\u042F \u043F\u043E\u043D\u0438\u043C\u0430\u044E \u043F\u043E-\u0441\u043B\u043E\u0432\u0430\u0446\u043A\u0438."}],exercises:[{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443 \u0433\u043B\u0430\u0433\u043E\u043B\u0430 \u0434\u043B\u044F ja.",options:["som","si","je","s\xFA"],answer:"som",explanation:"Ja som \u2014 \xAB\u044F \u0435\u0441\u0442\u044C\xBB. \u0412 \u0441\u043B\u043E\u0432\u0430\u0446\u043A\u043E\u043C \u0441\u0432\u044F\u0437\u043A\u0443 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442.",sk:"Ja _____ \u0161tudent."},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443 \u0433\u043B\u0430\u0433\u043E\u043B\u0430 \u0434\u043B\u044F my.",options:["sme","som","ste","je"],answer:"sme",explanation:"My sme \u2014 \xAB\u043C\u044B \u0435\u0441\u0442\u044C\xBB.",sk:"My _____ \u0161tudenti."},{type:"choice",prompt:"\u041A\u0430\u043A \u0441\u043A\u0430\u0437\u0430\u0442\u044C \xAB\u042F \u043D\u0435 \u0443\u0447\u0438\u0442\u0435\u043B\u044C\xBB?",options:["Nie som u\u010Dite\u013E.","Ne som u\u010Dite\u013E.","Som nie u\u010Dite\u013Eka.","Ja u\u010Dite\u013E nie."],answer:"Nie som u\u010Dite\u013E.",explanation:"\u041E\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u0444\u043E\u0440\u043C\u0430 \u0431\u044B\u0442\u044C: nie som."},{type:"typing",prompt:"\u0412\u043F\u0438\u0448\u0438 \u043F\u043E-\u0441\u043B\u043E\u0432\u0430\u0446\u043A\u0438 \xAB\u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043A\u0430\xBB \u043E\u0434\u043D\u0438\u043C \u0441\u043B\u043E\u0432\u043E\u043C.",answer:"\u0161tudentka",explanation:"\u0424\u043E\u0440\u043C\u0430 \u0436\u0435\u043D\u0441\u043A\u043E\u0433\u043E \u0440\u043E\u0434\u0430 \u2014 \u0161tudentka."},{type:"listening",prompt:"\u041E\u0442\u043A\u0443\u0434\u0430 \u043F\u0440\u0438\u0435\u0445\u0430\u043B \u0433\u043E\u0432\u043E\u0440\u044F\u0449\u0438\u0439?",options:["\u0418\u0437 \u0420\u043E\u0441\u0441\u0438\u0438","\u0418\u0437 \u0421\u043B\u043E\u0432\u0430\u043A\u0438\u0438","\u0418\u0437 \u041F\u043E\u043B\u044C\u0448\u0438","\u0418\u0437 \u0427\u0435\u0445\u0438\u0438"],answer:"\u0418\u0437 \u0420\u043E\u0441\u0441\u0438\u0438",explanation:"Som z Ruska \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \xAB\u042F \u0438\u0437 \u0420\u043E\u0441\u0441\u0438\u0438\xBB.",audio:"Vol\xE1m sa Andrej. Som z Ruska. Hovor\xEDm po rusky."},{type:"order",prompt:"\u0421\u043E\u0431\u0435\u0440\u0438 \xAB\u041C\u0435\u043D\u044F \u0437\u043E\u0432\u0443\u0442 \u0410\u043D\u0434\u0440\u0435\u0439\xBB, \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 Vol\xE1m.",answer:["Vol\xE1m","sa","Andrej."],explanation:"Vola\u0165 sa \u2014 \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u043D\u044B\u0439 \u0433\u043B\u0430\u0433\u043E\u043B. \u0427\u0430\u0441\u0442\u0438\u0446\u0430 sa \u043D\u0443\u0436\u043D\u0430."},{type:"reading",prompt:"\u041A\u0442\u043E \u041D\u0438\u043D\u0430?",options:["\u0421\u0442\u0443\u0434\u0435\u043D\u0442\u043A\u0430","\u0423\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u0438\u0446\u0430","\u0412\u0440\u0430\u0447","\u041F\u0440\u043E\u0434\u0430\u0432\u0435\u0446"],answer:"\u0421\u0442\u0443\u0434\u0435\u043D\u0442\u043A\u0430",explanation:"\u0412 \u0442\u0435\u043A\u0441\u0442\u0435 \u043F\u0440\u044F\u043C\u043E \u0441\u043A\u0430\u0437\u0430\u043D\u043E Nina je \u0161tudentka.",text:"Nina je \u0161tudentka. B\xFDva v Bratislave. Hovor\xED po slovensky a po anglicky. Matej je jej kamar\xE1t."},{type:"cloze",prompt:"\u0422\u044B \u0432\u0435\u0436\u043B\u0438\u0432\u043E \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0448\u044C \u043E\u0434\u043D\u043E\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430. \u0412\u044B\u0431\u0435\u0440\u0438 \u0441\u0432\u044F\u0437\u043A\u0443.",options:["ste","si","som","s\xFA"],answer:"ste",explanation:"\u041F\u0440\u0438 \u0432\u0435\u0436\u043B\u0438\u0432\u043E\u043C \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u0444\u043E\u0440\u043C\u0430 vy ste.",sk:"Vy _____ u\u010Dite\u013E?"}]},{id:"a1-04",level:"A1",title:"\u0417\u0430\u043A\u0430\u0437 \u0431\u0435\u0437 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0430",location:"\u041A\u0430\u0444\u0435",scene:"\u041D\u0438\u043D\u0430 \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0430\u0435\u0442 \u0442\u0435\u0431\u044F \u043D\u0430 \u043A\u043E\u0444\u0435. \u0417\u0430\u043A\u0430\u0437 \u0438 \u0441\u0447\u0451\u0442 \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0441\u0430\u043C\u043E\u043C\u0443 \u2014 \u043E\u0444\u0438\u0446\u0438\u0430\u043D\u0442 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043F\u043E-\u0441\u043B\u043E\u0432\u0430\u0446\u043A\u0438.",goal:"\u0417\u0430\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C \u043D\u0430\u043F\u0438\u0442\u043A\u0438 \u0438 \u0437\u0430\u043C\u0435\u0447\u0430\u0442\u044C \u0432\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043F\u0430\u0434\u0435\u0436.",grammar:{title:"\u0427\u0442\u043E \u044F \u0445\u043E\u0447\u0443: chcem \u0438 \u0432\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043F\u0430\u0434\u0435\u0436",body:"\u041F\u043E\u0441\u043B\u0435 chcem (\xAB\u044F \u0445\u043E\u0447\u0443\xBB) \u0438 pros\xEDm \u0432 \u0437\u0430\u043A\u0430\u0437\u0435 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430 \u0447\u0430\u0441\u0442\u043E \u0441\u0442\u043E\u0438\u0442 \u0432 \u0432\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C \u043F\u0430\u0434\u0435\u0436\u0435: k\xE1va \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u0432 k\xE1vu, voda \u2014 \u0432 vodu, polievka \u2014 \u0432 polievku. \u0423 \u043C\u043D\u043E\u0433\u0438\u0445 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u0436\u0435\u043D\u0441\u043A\u043E\u0433\u043E \u0440\u043E\u0434\u0430 \u043D\u0430 -a \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u0435 \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u043D\u0430 -u. \u0423 \u043D\u0435\u043E\u0434\u0443\u0448\u0435\u0432\u043B\u0451\u043D\u043D\u044B\u0445 \u0441\u043B\u043E\u0432 \u043C\u0443\u0436\u0441\u043A\u043E\u0433\u043E \u0440\u043E\u0434\u0430, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440 \u010Daj, chlieb \u0438 \xFA\u010Det, \u0444\u043E\u0440\u043C\u0430 \u0437\u0434\u0435\u0441\u044C \u043E\u0431\u044B\u0447\u043D\u043E \u0441\u043E\u0432\u043F\u0430\u0434\u0430\u0435\u0442 \u0441 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0439. \u0421\u0440\u0435\u0434\u043D\u0438\u0439 \u0440\u043E\u0434 \u0442\u043E\u0436\u0435 \u0447\u0430\u0441\u0442\u043E \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442 \u0444\u043E\u0440\u043C\u0443: mlieko. \u0421\u043B\u043E\u0432\u0430 \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430 \u0438 \u0441\u043F\u0430\u0441\u0438\u0431\u043E \u0434\u0435\u043B\u0430\u044E\u0442 \u043F\u0440\u043E\u0441\u0442\u043E\u0439 \u0437\u0430\u043A\u0430\u0437 \u0432\u0435\u0436\u043B\u0438\u0432\u0435\u0435: K\xE1vu, pros\xEDm. \u0414\u043B\u044F \u043E\u043F\u043B\u0430\u0442\u044B \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 Chcem plati\u0165 \u0438\u043B\u0438 \xDA\u010Det, pros\xEDm. \u041D\u0435 \u0441\u0447\u0438\u0442\u0430\u0439 \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u0435 -u \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u044B\u043C: \u0432\u044B\u0431\u0438\u0440\u0430\u0439 \u0444\u043E\u0440\u043C\u0443 \u0441 \u0443\u0447\u0451\u0442\u043E\u043C \u0440\u043E\u0434\u0430 \u0438 \u043C\u043E\u0434\u0435\u043B\u0438 \u0441\u043B\u043E\u0432\u0430.",examples:[{sk:"K\xE1vu, pros\xEDm.",ru:"\u041A\u043E\u0444\u0435, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430."},{sk:"Chcem vodu.",ru:"\u042F \u0445\u043E\u0447\u0443 \u0432\u043E\u0434\u0443."},{sk:"\xDA\u010Det, pros\xEDm.",ru:"\u0421\u0447\u0451\u0442, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430."}]},words:[{sk:"k\xE1va",ru:"\u043A\u043E\u0444\u0435",example:"Pros\xEDm si k\xE1vu.",translation:"\u041C\u043D\u0435 \u043A\u043E\u0444\u0435, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430."},{sk:"\u010Daj",ru:"\u0447\u0430\u0439",example:"\u010Caj je tepl\xFD.",translation:"\u0427\u0430\u0439 \u0442\u0451\u043F\u043B\u044B\u0439."},{sk:"voda",ru:"\u0432\u043E\u0434\u0430",example:"Chcem vodu.",translation:"\u042F \u0445\u043E\u0447\u0443 \u0432\u043E\u0434\u0443."},{sk:"mlieko",ru:"\u043C\u043E\u043B\u043E\u043A\u043E",example:"M\xE1te mlieko?",translation:"\u0423 \u0432\u0430\u0441 \u0435\u0441\u0442\u044C \u043C\u043E\u043B\u043E\u043A\u043E?"},{sk:"cukor",ru:"\u0441\u0430\u0445\u0430\u0440",example:"Cukor je tu.",translation:"\u0421\u0430\u0445\u0430\u0440 \u0437\u0434\u0435\u0441\u044C."},{sk:"chlieb",ru:"\u0445\u043B\u0435\u0431",example:"Chcem chlieb.",translation:"\u042F \u0445\u043E\u0447\u0443 \u0445\u043B\u0435\u0431."},{sk:"polievka",ru:"\u0441\u0443\u043F",example:"Polievka je dobr\xE1.",translation:"\u0421\u0443\u043F \u0432\u043A\u0443\u0441\u043D\u044B\u0439."},{sk:"\xFA\u010Det",ru:"\u0441\u0447\u0451\u0442 \u0434\u043B\u044F \u043E\u043F\u043B\u0430\u0442\u044B",example:"\xDA\u010Det, pros\xEDm.",translation:"\u0421\u0447\u0451\u0442, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430."},{sk:"plati\u0165",ru:"\u043F\u043B\u0430\u0442\u0438\u0442\u044C",example:"Chcem plati\u0165.",translation:"\u042F \u0445\u043E\u0447\u0443 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C."},{sk:"chcie\u0165",ru:"\u0445\u043E\u0442\u0435\u0442\u044C",example:"Chcem \u010Daj.",translation:"\u042F \u0445\u043E\u0447\u0443 \u0447\u0430\u0439."}],exercises:[{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443 \u0441\u043B\u043E\u0432\u0430 k\xE1va \u0432 \u0437\u0430\u043A\u0430\u0437\u0435.",options:["k\xE1vu","k\xE1va","k\xE1ve","k\xE1vy"],answer:"k\xE1vu",explanation:"K\xE1va \u2014 \u0436\u0435\u043D\u0441\u043A\u0438\u0439 \u0440\u043E\u0434 \u043D\u0430 -a; \u0432 \u0432\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E \u0447\u0438\u0441\u043B\u0430: k\xE1vu.",sk:"Chcem _____.",ru:"\u042F \u0445\u043E\u0447\u0443 \u043A\u043E\u0444\u0435."},{type:"choice",prompt:"\u041A\u0430\u043A \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0441\u0447\u0451\u0442?",options:["\xDA\u010Det, pros\xEDm.","\u0160kola, pros\xEDm.","Ahoj, voda.","Meno, pros\xEDm."],answer:"\xDA\u010Det, pros\xEDm.",explanation:"\xDA\u010Det \u0432 \u043A\u0430\u0444\u0435 \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u0441\u0447\u0451\u0442 \u043A \u043E\u043F\u043B\u0430\u0442\u0435."},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443 \u0441\u043B\u043E\u0432\u0430 \u010Daj \u043F\u043E\u0441\u043B\u0435 chcem.",options:["\u010Daj","\u010Daju","\u010Daja","\u010Dajom"],answer:"\u010Daj",explanation:"\u0423 \u043D\u0435\u043E\u0434\u0443\u0448\u0435\u0432\u043B\u0451\u043D\u043D\u043E\u0433\u043E \u010Daj \u0432\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u0437\u0434\u0435\u0441\u044C \u0441\u043E\u0432\u043F\u0430\u0434\u0430\u0435\u0442 \u0441 \u0438\u043C\u0435\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C.",sk:"Chcem _____.",ru:"\u042F \u0445\u043E\u0447\u0443 \u0447\u0430\u0439."},{type:"typing",prompt:"\u041D\u0430\u043F\u0438\u0448\u0438 \u0444\u043E\u0440\u043C\u0443 \u0441\u043B\u043E\u0432\u0430 voda \u043F\u043E\u0441\u043B\u0435 Chcem.",answer:"vodu",explanation:"Voda \u2192 vodu: \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u0435 -a \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u043D\u0430 -u."},{type:"listening",prompt:"\u0427\u0442\u043E \u0437\u0430\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u041D\u0438\u043D\u0430?",options:["\u0427\u0430\u0439 \u0438 \u0441\u0443\u043F","\u041A\u043E\u0444\u0435 \u0438 \u0445\u043B\u0435\u0431","\u0412\u043E\u0434\u0443 \u0438 \u0445\u043B\u0435\u0431","\u041C\u043E\u043B\u043E\u043A\u043E \u0438 \u043A\u043E\u0444\u0435"],answer:"\u0427\u0430\u0439 \u0438 \u0441\u0443\u043F",explanation:"\u010Caj a polievku \u2014 \xAB\u0447\u0430\u0439 \u0438 \u0441\u0443\u043F\xBB.",audio:"Dobr\xFD de\u0148. \u010Caj a polievku, pros\xEDm."},{type:"order",prompt:"\u0421\u043E\u0431\u0435\u0440\u0438 \xAB\u042F \u0445\u043E\u0447\u0443 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C\xBB, \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 Chcem.",answer:["Chcem","plati\u0165."],explanation:"\u041F\u043E\u0441\u043B\u0435 chcem \u0432\u0442\u043E\u0440\u043E\u0439 \u0433\u043B\u0430\u0433\u043E\u043B \u0441\u0442\u043E\u0438\u0442 \u0432 \u043D\u0435\u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u043E\u0439 \u0444\u043E\u0440\u043C\u0435: plati\u0165."},{type:"reading",prompt:"\u0427\u0442\u043E \u043F\u044C\u0451\u0442 \u041C\u0430\u0442\u0435\u0439?",options:["\u041A\u043E\u0444\u0435","\u0427\u0430\u0439","\u0412\u043E\u0434\u0443","\u041C\u043E\u043B\u043E\u043A\u043E"],answer:"\u041A\u043E\u0444\u0435",explanation:"Matej m\xE1 k\xE1vu \u2014 \u0443 \u041C\u0430\u0442\u0435\u044F \u043A\u043E\u0444\u0435.",text:"Nina m\xE1 \u010Daj. Matej m\xE1 k\xE1vu. Andrej m\xE1 vodu a chlieb. V\u0161etci s\xFA v kaviarni."},{type:"choice",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E \u043E\u0444\u043E\u0440\u043C\u043B\u0435\u043D\u043D\u044B\u0439 \u0437\u0430\u043A\u0430\u0437 \u0432\u043E\u0434\u044B.",options:["Vodu, pros\xEDm.","Voda, pros\xEDm si.","Vode, pros\xEDm.","Vodou, pros\xEDm."],answer:"Vodu, pros\xEDm.",explanation:"\u041A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u0432\u0435\u0436\u043B\u0438\u0432\u044B\u0439 \u0437\u0430\u043A\u0430\u0437 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442 \u0432\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439: vodu."}]},{id:"a1-05",level:"A1",title:"\u0423\u0441\u043F\u0435\u0442\u044C \u043D\u0430 \u0432\u0441\u0442\u0440\u0435\u0447\u0443",location:"\u0427\u0430\u0441\u044B \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u0438",scene:"\u041C\u0430\u0442\u0435\u0439 \u043E\u0441\u0442\u0430\u0432\u0438\u043B \u0432\u0440\u0435\u043C\u044F \u0432\u0441\u0442\u0440\u0435\u0447\u0438 \u0438 \u043D\u043E\u043C\u0435\u0440 \u0441\u0442\u043E\u043B\u0438\u043A\u0430. \u0420\u0430\u0437\u0431\u0435\u0440\u0438 \u0447\u0438\u0441\u043B\u0430, \u0447\u0442\u043E\u0431\u044B \u043D\u0435 \u043E\u043F\u043E\u0437\u0434\u0430\u0442\u044C \u043A \u0434\u0440\u0443\u0437\u044C\u044F\u043C.",goal:"\u041F\u043E\u043D\u0438\u043C\u0430\u0442\u044C \u043F\u0440\u043E\u0441\u0442\u044B\u0435 \u0447\u0438\u0441\u043B\u0430 \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C, \u043A\u043E\u0433\u0434\u0430 \u0441\u043E\u0441\u0442\u043E\u0438\u0442\u0441\u044F \u0432\u0441\u0442\u0440\u0435\u0447\u0430.",grammar:{title:"\u0427\u0438\u0441\u043B\u0430 \u0438 \u0432\u0440\u0435\u043C\u044F",body:"\u0427\u0438\u0441\u043B\u0430 \u043E\u0442 \u043E\u0434\u043D\u043E\u0433\u043E \u0434\u043E \u043F\u044F\u0442\u0438: jeden, dva, tri, \u0161tyri, p\xE4\u0165; \u0434\u0435\u0441\u044F\u0442\u044C \u2014 desa\u0165. \u0424\u043E\u0440\u043C\u0430 \xAB\u043E\u0434\u0438\u043D\xBB \u0441\u043E\u0433\u043B\u0430\u0441\u0443\u0435\u0442\u0441\u044F \u0441 \u0440\u043E\u0434\u043E\u043C: jeden \u010Daj, jedna k\xE1va, jedno mesto. \u0414\u043B\u044F \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u0436\u0435\u043D\u0441\u043A\u043E\u0433\u043E \u0438 \u0441\u0440\u0435\u0434\u043D\u0435\u0433\u043E \u0440\u043E\u0434\u0430 \u0447\u0438\u0441\u043B\u043E \u0434\u0432\u0430 \u0438\u043C\u0435\u0435\u0442 \u0444\u043E\u0440\u043C\u0443 dve: dve k\xE1vy, dve mest\xE1. \u041F\u043E\u0441\u043B\u0435 \u043F\u044F\u0442\u0438 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u043E\u0431\u044B\u0447\u043D\u043E \u0441\u0442\u043E\u0438\u0442 \u0432 \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E \u0447\u0438\u0441\u043B\u0430: p\xE4\u0165 min\xFAt. \u0414\u043B\u044F \u043D\u0430\u0447\u0430\u043B\u0430 \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0439 \u0442\u0430\u043A\u0438\u0435 \u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u044F \u0446\u0435\u043B\u0438\u043A\u043E\u043C. \u0427\u0442\u043E\u0431\u044B \u043D\u0430\u0437\u0432\u0430\u0442\u044C \u0432\u0440\u0435\u043C\u044F \u0432\u0441\u0442\u0440\u0435\u0447\u0438, \u0443\u0434\u043E\u0431\u043D\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C o druhej (\xAB\u0432 \u0434\u0432\u0430\xBB), o tretej (\xAB\u0432 \u0442\u0440\u0438\xBB), o desiatej (\xAB\u0432 \u0434\u0435\u0441\u044F\u0442\u044C\xBB). Dnes \u2014 \u0441\u0435\u0433\u043E\u0434\u043D\u044F, zajtra \u2014 \u0437\u0430\u0432\u0442\u0440\u0430. \u0412 \u0432\u043E\u043F\u0440\u043E\u0441\u0435 Ko\u013Eko je hod\xEDn? \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u044E\u0442, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0447\u0430\u0441, \u0430 Kedy? \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \xAB\u043A\u043E\u0433\u0434\u0430?\xBB.",examples:[{sk:"dve k\xE1vy",ru:"\u0434\u0432\u0430 \u043A\u043E\u0444\u0435"},{sk:"p\xE4\u0165 min\xFAt",ru:"\u043F\u044F\u0442\u044C \u043C\u0438\u043D\u0443\u0442"},{sk:"Stretneme sa o tretej.",ru:"\u0412\u0441\u0442\u0440\u0435\u0442\u0438\u043C\u0441\u044F \u0432 \u0442\u0440\u0438."}]},words:[{sk:"jeden",ru:"\u043E\u0434\u0438\u043D",example:"Jeden \u010Daj, pros\xEDm.",translation:"\u041E\u0434\u0438\u043D \u0447\u0430\u0439, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430."},{sk:"dva",ru:"\u0434\u0432\u0430",example:"M\xE1m dva l\xEDstky.",translation:"\u0423 \u043C\u0435\u043D\u044F \u0434\u0432\u0430 \u0431\u0438\u043B\u0435\u0442\u0430."},{sk:"tri",ru:"\u0442\u0440\u0438",example:"Tu s\xFA tri knihy.",translation:"\u0417\u0434\u0435\u0441\u044C \u0442\u0440\u0438 \u043A\u043D\u0438\u0433\u0438."},{sk:"\u0161tyri",ru:"\u0447\u0435\u0442\u044B\u0440\u0435",example:"M\xE1me \u0161tyri stoli\u010Dky.",translation:"\u0423 \u043D\u0430\u0441 \u0447\u0435\u0442\u044B\u0440\u0435 \u0441\u0442\u0443\u043B\u0430."},{sk:"p\xE4\u0165",ru:"\u043F\u044F\u0442\u044C",example:"M\xE1m p\xE4\u0165 min\xFAt.",translation:"\u0423 \u043C\u0435\u043D\u044F \u043F\u044F\u0442\u044C \u043C\u0438\u043D\u0443\u0442."},{sk:"desa\u0165",ru:"\u0434\u0435\u0441\u044F\u0442\u044C",example:"Je desa\u0165 hod\xEDn.",translation:"\u0421\u0435\u0439\u0447\u0430\u0441 \u0434\u0435\u0441\u044F\u0442\u044C \u0447\u0430\u0441\u043E\u0432."},{sk:"hodina",ru:"\u0447\u0430\u0441; \u0443\u0447\u0435\u0431\u043D\u044B\u0439 \u0447\u0430\u0441",example:"Hodina sa za\u010D\xEDna.",translation:"\u0423\u0440\u043E\u043A \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F."},{sk:"min\xFAta",ru:"\u043C\u0438\u043D\u0443\u0442\u0430",example:"E\u0161te jedna min\xFAta.",translation:"\u0415\u0449\u0451 \u043E\u0434\u043D\u0430 \u043C\u0438\u043D\u0443\u0442\u0430."},{sk:"dnes",ru:"\u0441\u0435\u0433\u043E\u0434\u043D\u044F",example:"Dnes som doma.",translation:"\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u0434\u043E\u043C\u0430."},{sk:"zajtra",ru:"\u0437\u0430\u0432\u0442\u0440\u0430",example:"Zajtra m\xE1m \u010Das.",translation:"\u0417\u0430\u0432\u0442\u0440\u0430 \u0443 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u0432\u0440\u0435\u043C\u044F."}],exercises:[{type:"choice",prompt:"\u041A\u0430\u043A\u043E\u0435 \u0447\u0438\u0441\u043B\u043E \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u0161tyri?",options:["4","3","5","10"],answer:"4",explanation:"\u0160tyri \u2014 \u0447\u0435\u0442\u044B\u0440\u0435."},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443 \xAB\u043E\u0434\u043D\u0430\xBB \u0441\u043E \u0441\u043B\u043E\u0432\u043E\u043C k\xE1va.",options:["jedna","jeden","jedno","jedni"],answer:"jedna",explanation:"K\xE1va \u2014 \u0436\u0435\u043D\u0441\u043A\u0438\u0439 \u0440\u043E\u0434, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 jedna.",sk:"_____ k\xE1va, pros\xEDm."},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443 \xAB\u0434\u0432\u0435\xBB \u0441\u043E \u0441\u043B\u043E\u0432\u043E\u043C knihy.",options:["dve","dva","dvaja","dvojmo"],answer:"dve",explanation:"Kniha \u2014 \u0436\u0435\u043D\u0441\u043A\u0438\u0439 \u0440\u043E\u0434: dve knihy.",sk:"Tu s\xFA _____ knihy."},{type:"typing",prompt:"\u041D\u0430\u043F\u0438\u0448\u0438 \u0447\u0438\u0441\u043B\u043E 5 \u043F\u043E-\u0441\u043B\u043E\u0432\u0430\u0446\u043A\u0438 \u043E\u0434\u043D\u0438\u043C \u0441\u043B\u043E\u0432\u043E\u043C.",answer:"p\xE4\u0165",explanation:"\u041F\u044F\u0442\u044C \u2014 p\xE4\u0165. \u0417\u0434\u0435\u0441\u044C \xE4 \u0438 \u043C\u044F\u0433\u043A\u0430\u044F \u0165."},{type:"listening",prompt:"\u041A\u043E\u0433\u0434\u0430 \u0441\u043E\u0441\u0442\u043E\u0438\u0442\u0441\u044F \u0432\u0441\u0442\u0440\u0435\u0447\u0430?",options:["\u0417\u0430\u0432\u0442\u0440\u0430 \u0432 \u0442\u0440\u0438"