<!DOCTYPE html><html lang="ru"><head><script>
(function(){
  if (!window.AndroidNative) return;
  function NativeUtterance(text){this.text=text||"";this.lang="sk-SK";this.rate=1;this.pitch=1;this.volume=1;this.voice=null;this.onstart=null;this.onend=null;this.onerror=null;}
  window.SpeechSynthesisUtterance=NativeUtterance;
  var synth={
    speaking:false,pending:false,paused:false,onvoiceschanged:null,
    getVoices:function(){return [{name:"Slovenčina",lang:"sk-SK",default:true,localService:true}];},
    cancel:function(){try{AndroidNative.stopSpeech();}catch(e){}},
    pause:function(){},resume:function(){},
    addEventListener:function(){},removeEventListener:function(){},
    speak:function(u){
      try{
        if(u&&u.onstart)u.onstart();
        AndroidNative.setSpeechRate(Number((u&&u.rate)||1));
        AndroidNative.speak(String((u&&u.text)||""));
        if(u&&u.onend)setTimeout(function(){u.onend();},80);
      }catch(e){if(u&&u.onerror)u.onerror(e);}
    }
  };
  try{Object.defineProperty(window,"speechSynthesis",{value:synth,configurable:true});}catch(e){window.speechSynthesis=synth;}
})();
</script><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#8063d9"><meta name="description" content="Slovak Quest: 40 сюжетных миссий для изучения словацкого от первых слов до тем B2."><meta name="apple-mobile-web-app-capable" content="yes"><title>Slovak Quest — путь в университет</title><link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2064%2064%22%3E%3Crect%20width%3D%2264%22%20height%3D%2264%22%20rx%3D%2218%22%20fill%3D%22%238063d9%22%2F%3E%3Ccircle%20cx%3D%2232%22%20cy%3D%2232%22%20r%3D%2221%22%20fill%3D%22none%22%20stroke%3D%22%23fff1ca%22%20stroke-width%3D%223%22%2F%3E%3Cpath%20d%3D%22m42%2022-7%2013-13%207%207-13z%22%20fill%3D%22%23fff1ca%22%2F%3E%3Ccircle%20cx%3D%2232%22%20cy%3D%2232%22%20r%3D%223%22%20fill%3D%22%238063d9%22%2F%3E%3C%2Fsvg%3E%0A"><style>
:root{--paper:#f6f5fb;--white:#fff;--ink:#302742;--muted:#817a91;--purple:#8063d9;--purple-dark:#6a4bc3;--pale:#eee8fb;--line:#e9e5f0;--mint:#dff1e9;--green:#28785e;--peach:#fff0e8;--radius:22px;--shadow:0 8px 28px #3f2b6c06;--font-body:"Trebuchet MS","Segoe UI",Arial,sans-serif}
