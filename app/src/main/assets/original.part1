x-shadow:0 4px 0 #583ba7,0 6px 18px #8063d930}.button.primary:active{box-shadow:0 1px 0 #6143b6;transform:translateY(3px)}.button.pale{background:#f2edf9;color:#69518b;border:1px solid #e7dff3}.button.pale:hover:not(:disabled){background:#e9e0f7}.button.subtle{background:white;border:1px solid var(--line);color:#81748d}.button.full{width:100%}.button.active{background:#e4d9f9;color:var(--purple-dark)}.button-row{display:flex;align-items:center;flex-wrap:wrap;gap:12px}.button-row.centered{justify-content:center}.text-button{font-size:12px;color:var(--purple-dark);font-weight:750;display:inline-flex;align-items:center;gap:7px;padding:6px 0;line-height:1.5}.text-button:hover:not(:disabled){text-decoration:underline}.icon-button{border-radius:50%;display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;padding:7px;flex-shrink:0;color:#8b7d9e}.icon-button:hover{background:#eee8f6;color:var(--purple-dark)}.mini-badge{font-size:10px;font-weight:800;color:#876ea9;background:#f0eaf8;padding:4px 8px;border-radius:6px;display:inline-block;white-space:nowrap;letter-spacing:.03em}
