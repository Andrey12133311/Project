\u0435\u0448\u0451\u0432\u044B\u0439."},{sk:"mal\xFD",ru:"\u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439",example:"Obchod je mal\xFD.",translation:"\u041C\u0430\u0433\u0430\u0437\u0438\u043D \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439."},{sk:"ve\u013Ek\xFD",ru:"\u0431\u043E\u043B\u044C\u0448\u043E\u0439",example:"Byt je ve\u013Ek\xFD.",translation:"\u041A\u0432\u0430\u0440\u0442\u0438\u0440\u0430 \u0431\u043E\u043B\u044C\u0448\u0430\u044F."},{sk:"ta\u0161ka",ru:"\u0441\u0443\u043C\u043A\u0430",example:"Ta\u0161ka je \u013Eahk\xE1.",translation:"\u0421\u0443\u043C\u043A\u0430 \u043B\u0451\u0433\u043A\u0430\u044F."}],exercises:[{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \xAB\u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F\xBB \u043A \u0441\u043B\u043E\u0432\u0443 ta\u0161ka.",options:["mal\xE1","mal\xFD","mal\xE9","mal\xED"],answer:"mal\xE1",explanation:"Ta\u0161ka \u2014 \u0436\u0435\u043D\u0441\u043A\u0438\u0439 \u0440\u043E\u0434: mal\xE1 ta\u0161ka.",sk:"To je _____ ta\u0161ka."},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \xAB\u0431\u043E\u043B\u044C\u0448\u043E\u0435\xBB \u043A \u0441\u043B\u043E\u0432\u0443 jablko.",options:["ve\u013Ek\xE9","ve\u013Ek\xFD","ve\u013Ek\xE1","ve\u013Ek\xED"],answer:"ve\u013Ek\xE9",explanation:"Jablko \u2014 \u0441\u0440\u0435\u0434\u043D\u0438\u0439 \u0440\u043E\u0434: ve\u013Ek\xE9 jablko.",sk:"To je _____ jablko."},{type:"choice",prompt:"\u041A\u0430\u043A \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0446\u0435\u043D\u0443 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430?",options:["Ko\u013Eko to stoj\xED?","Kde je moje meno?","Kto je dnes?","Kam je cena?"],answer:"Ko\u013Eko to stoj\xED?",explanation:"Ko\u013Eko to stoj\xED? \u2014 \xAB\u0421\u043A\u043E\u043B\u044C\u043A\u043E \u044D\u0442\u043E \u0441\u0442\u043E\u0438\u0442?\xBB"},{type:"typing",prompt:"\u041D\u0430\u043F\u0438\u0448\u0438 \u043F\u043E-\u0441\u043B\u043E\u0432\u0430\u0446\u043A\u0438 \xAB\u0441\u044B\u0440\xBB.",answer:"syr",explanation:"\u0412 \u0441\u043B\u043E\u0432\u0435 syr \u043F\u0438\u0448\u0435\u0442\u0441\u044F y."},{type:"listening",prompt:"\u0427\u0442\u043E \u0445\u043E\u0447\u0435\u0442 \u043A\u0443\u043F\u0438\u0442\u044C \u041D\u0438\u043D\u0430?",options:["\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0443\u044E \u0441\u0443\u043C\u043A\u0443","\u0411\u043E\u043B\u044C\u0448\u043E\u0439 \u0441\u044B\u0440","\u0414\u043E\u0440\u043E\u0433\u043E\u0435 \u044F\u0431\u043B\u043E\u043A\u043E","\u0411\u043E\u043B\u044C\u0448\u0443\u044E \u043A\u043D\u0438\u0433\u0443"],answer:"\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0443\u044E \u0441\u0443\u043C\u043A\u0443",explanation:"Mal\xFA ta\u0161ku \u2014 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0443\u044E \u0441\u0443\u043C\u043A\u0443; \u043E\u0431\u0435 \u0444\u043E\u0440\u043C\u044B \u0441\u0442\u043E\u044F\u0442 \u0432 \u0432\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C.",audio:"Dobr\xFD de\u0148. Chcem mal\xFA ta\u0161ku, pros\xEDm."},{type:"order",prompt:"\u0421\u043E\u0431\u0435\u0440\u0438 \xAB\u042D\u0442\u043E\u0442 \u0441\u044B\u0440 \u0434\u043E\u0440\u043E\u0433\u043E\u0439\xBB, \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 Tento.",answer:["Tento","syr","je","drah\xFD."],explanation:"Syr \u2014 \u043C\u0443\u0436\u0441\u043A\u043E\u0439 \u0440\u043E\u0434: tento syr, drah\xFD."},{type:"reading",prompt:"\u041A\u0430\u043A\u043E\u0439 \u043F\u0440\u043E\u0434\u0443\u043A\u0442 \u0432 \u0442\u0435\u043A\u0441\u0442\u0435 \u0434\u0435\u0448\u0451\u0432\u044B\u0439?",options:["\u0425\u043B\u0435\u0431","\u0421\u044B\u0440","\u042F\u0431\u043B\u043E\u043A\u043E","\u041C\u043E\u043B\u043E\u043A\u043E"],answer:"\u0425\u043B\u0435\u0431",explanation:"Chlieb je lacn\xFD \u2014 \u0445\u043B\u0435\u0431 \u0434\u0435\u0448\u0451\u0432\u044B\u0439.",text:"V obchode je chlieb a syr. Chlieb je lacn\xFD, ale syr je drah\xFD. Nina kupuje chlieb."},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443 \u043F\u0440\u0438\u043B\u0430\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u0432 \xAB\u042F \u0445\u043E\u0447\u0443 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0443\u044E \u0441\u0443\u043C\u043A\u0443\xBB.",options:["mal\xFA","mal\xE1","mal\xFD","mal\xE9"],answer:"mal\xFA",explanation:"\u041F\u043E\u0441\u043B\u0435 chcem: mal\xFA ta\u0161ku \u2014 \u0432\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u0436\u0435\u043D\u0441\u043A\u043E\u0433\u043E \u0440\u043E\u0434\u0430.",sk:"Chcem _____ ta\u0161ku."}]},{id:"a1-08",level:"A1",title:"\u0414\u043E\u043C \u0438 \u0431\u043B\u0438\u0437\u043A\u0438\u0435",location:"\u0413\u043E\u0441\u0442\u0438\u043D\u0430\u044F",scene:"\u041C\u0430\u0442\u0435\u0439 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438 \u0441\u0435\u043C\u044C\u0438 \u0438 \u0441\u0432\u043E\u044E \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0443. \u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0438, \u043A\u043E\u043C\u0443 \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u0442 \u0432\u0435\u0449\u0438, \u0438 \u043D\u0430\u0439\u0434\u0438 \u043A\u043E\u043C\u043D\u0430\u0442\u0443 \u041D\u0438\u043D\u044B.",goal:"\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u043C\u043E\u0439/\u0442\u0432\u043E\u0439 \u0438 \u043D\u0430\u0437\u044B\u0432\u0430\u0442\u044C \u0447\u043B\u0435\u043D\u043E\u0432 \u0441\u0435\u043C\u044C\u0438 \u0438 \u0436\u0438\u043B\u044C\u0451.",grammar:{title:"\u041C\u043E\u0439, \u0442\u0432\u043E\u0439 \u0438 \u0443 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C",body:"\u0421\u043B\u043E\u0432\u0430 m\xF4j \u0438 tvoj \u0441\u043E\u0433\u043B\u0430\u0441\u0443\u044E\u0442\u0441\u044F \u0441 \u0442\u0435\u043C, \u0447\u0442\u043E \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0438\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0443: m\xF4j brat, moja sestra, moje mesto; tvoj brat, tvoja sestra, tvoje mesto. \u041E\u043D\u0438 \u043D\u0435 \u0437\u0430\u0432\u0438\u0441\u044F\u0442 \u043E\u0442 \u043F\u043E\u043B\u0430 \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430. \u0423 \u0434\u0435\u0432\u0443\u0448\u043A\u0438 \u0442\u043E\u0436\u0435 \u0431\u0443\u0434\u0435\u0442 m\xF4j brat, \u0435\u0441\u043B\u0438 \u0440\u0435\u0447\u044C \u043E \u0435\u0451 \u0431\u0440\u0430\u0442\u0435. \u0420\u0443\u0441\u0441\u043A\u043E\u0435 \xAB\u0443 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C\xBB \u0447\u0430\u0441\u0442\u043E \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442\u0441\u044F \u0433\u043B\u0430\u0433\u043E\u043B\u043E\u043C ma\u0165: M\xE1m izbu \u2014 \xAB\u0423 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u043A\u043E\u043C\u043D\u0430\u0442\u0430\xBB. \u0424\u043E\u0440\u043C\u044B: m\xE1m, m\xE1\u0161, m\xE1, m\xE1me, m\xE1te, maj\xFA. \u041E\u0442\u0440\u0438\u0446\u0430\u043D\u0438\u0435 \u043F\u0438\u0448\u0435\u0442\u0441\u044F \u0432\u043C\u0435\u0441\u0442\u0435: nem\xE1m, nem\xE1\u0161, nem\xE1. \u0420\u0430\u0437\u043B\u0438\u0447\u0430\u0439 Som doma (\xAB\u042F \u0434\u043E\u043C\u0430\xBB) \u0438 M\xE1m dom (\xAB\u0423 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u0434\u043E\u043C\xBB). \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438, \u0433\u043E\u0432\u043E\u0440\u0438\u0448\u044C \u043E \u043C\u0435\u0441\u0442\u043E\u043D\u0430\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0438, \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u043D\u043E\u0441\u0442\u0438 \u0438\u043B\u0438 \u0440\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439 \u0441\u0432\u044F\u0437\u0438.",examples:[{sk:"To je m\xF4j brat.",ru:"\u042D\u0442\u043E \u043C\u043E\u0439 \u0431\u0440\u0430\u0442."},{sk:"To je moja sestra.",ru:"\u042D\u0442\u043E \u043C\u043E\u044F \u0441\u0435\u0441\u0442\u0440\u0430."},{sk:"M\xE1m mal\xFD byt.",ru:"\u0423 \u043C\u0435\u043D\u044F \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0430."}]},words:[{sk:"dom",ru:"\u0434\u043E\u043C",example:"To je n\xE1\u0161 dom.",translation:"\u042D\u0442\u043E \u043D\u0430\u0448 \u0434\u043E\u043C."},{sk:"byt",ru:"\u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0430",example:"M\xE1m mal\xFD byt.",translation:"\u0423 \u043C\u0435\u043D\u044F \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0430."},{sk:"izba",ru:"\u043A\u043E\u043C\u043D\u0430\u0442\u0430",example:"Moja izba je svetl\xE1.",translation:"\u041C\u043E\u044F \u043A\u043E\u043C\u043D\u0430\u0442\u0430 \u0441\u0432\u0435\u0442\u043B\u0430\u044F."},{sk:"rodina",ru:"\u0441\u0435\u043C\u044C\u044F",example:"Moja rodina je doma.",translation:"\u041C\u043E\u044F \u0441\u0435\u043C\u044C\u044F \u0434\u043E\u043C\u0430."},{sk:"matka",ru:"\u043C\u0430\u0442\u044C",example:"Moja matka je u\u010Dite\u013Eka.",translation:"\u041C\u043E\u044F \u043C\u0430\u0442\u044C \u2014 \u0443\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u0438\u0446\u0430."},{sk:"otec",ru:"\u043E\u0442\u0435\u0446",example:"M\xF4j otec pracuje.",translation:"\u041C\u043E\u0439 \u043E\u0442\u0435\u0446 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442."},{sk:"brat",ru:"\u0431\u0440\u0430\u0442",example:"M\xF4j brat je \u0161tudent.",translation:"\u041C\u043E\u0439 \u0431\u0440\u0430\u0442 \u2014 \u0441\u0442\u0443\u0434\u0435\u043D\u0442."},{sk:"sestra",ru:"\u0441\u0435\u0441\u0442\u0440\u0430",example:"Moja sestra \u010D\xEDta.",translation:"\u041C\u043E\u044F \u0441\u0435\u0441\u0442\u0440\u0430 \u0447\u0438\u0442\u0430\u0435\u0442."},{sk:"m\xF4j",ru:"\u043C\u043E\u0439",example:"To je m\xF4j dom.",translation:"\u042D\u0442\u043E \u043C\u043E\u0439 \u0434\u043E\u043C."},{sk:"tvoj",ru:"\u0442\u0432\u043E\u0439",example:"Je to tvoj byt?",translation:"\u042D\u0442\u043E \u0442\u0432\u043E\u044F \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0430?"}],exercises:[{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \xAB\u043C\u043E\u044F\xBB \u043A \u0441\u043B\u043E\u0432\u0443 sestra.",options:["moja","m\xF4j","moje","moji"],answer:"moja",explanation:"Sestra \u2014 \u0436\u0435\u043D\u0441\u043A\u0438\u0439 \u0440\u043E\u0434, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 moja.",sk:"To je _____ sestra."},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \xAB\u0442\u0432\u043E\u0439\xBB \u043A \u0441\u043B\u043E\u0432\u0443 brat.",options:["tvoj","tvoja","tvoje","tvoju"],answer:"tvoj",explanation:"Brat \u2014 \u043C\u0443\u0436\u0441\u043A\u043E\u0439 \u0440\u043E\u0434: tvoj brat.",sk:"Je to _____ brat?"},{type:"choice",prompt:"\u041A\u0430\u043A \u0441\u043A\u0430\u0437\u0430\u0442\u044C \xAB\u0423 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u043A\u043E\u043C\u043D\u0430\u0442\u0430\xBB?",options:["M\xE1m izbu.","Som izba.","Je m\xF4j izba.","M\xE1\u0161 izby."],answer:"M\xE1m izbu.",explanation:"M\xE1m \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442 \xAB\u0443 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C\xBB, \u0430 izbu \u0441\u0442\u043E\u0438\u0442 \u0432 \u0432\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C."},{type:"typing",prompt:"\u041D\u0430\u043F\u0438\u0448\u0438 \u043F\u043E-\u0441\u043B\u043E\u0432\u0430\u0446\u043A\u0438 \xAB\u0441\u0435\u0441\u0442\u0440\u0430\xBB.",answer:"sestra",explanation:"\u0421\u043B\u043E\u0432\u043E sestra \u0431\u043B\u0438\u0437\u043A\u043E \u0440\u0443\u0441\u0441\u043A\u043E\u043C\u0443, \u043D\u043E \u043F\u0438\u0448\u0435\u0442\u0441\u044F \u043B\u0430\u0442\u0438\u043D\u0438\u0446\u0435\u0439."},{type:"listening",prompt:"\u041A\u0442\u043E \u0443\u0447\u0438\u0442\u0435\u043B\u044C?",options:["\u041E\u0442\u0435\u0446","\u041C\u0430\u0442\u044C","\u0411\u0440\u0430\u0442","\u0421\u0435\u0441\u0442\u0440\u0430"],answer:"\u041E\u0442\u0435\u0446",explanation:"M\xF4j otec je u\u010Dite\u013E \u2014 \u043C\u043E\u0439 \u043E\u0442\u0435\u0446 \u0443\u0447\u0438\u0442\u0435\u043B\u044C.",audio:"M\xF4j otec je u\u010Dite\u013E. Moja matka pracuje v obchode."},{type:"order",prompt:"\u0421\u043E\u0431\u0435\u0440\u0438 \xAB\u042D\u0442\u043E \u043C\u043E\u044F \u043A\u043E\u043C\u043D\u0430\u0442\u0430\xBB, \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 To.",answer:["To","je","moja","izba."],explanation:"Izba \u2014 \u0436\u0435\u043D\u0441\u043A\u0438\u0439 \u0440\u043E\u0434: moja izba."},{type:"reading",prompt:"\u0423 \u043A\u043E\u0433\u043E \u0431\u043E\u043B\u044C\u0448\u0430\u044F \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0430?",options:["\u0423 \u041C\u0430\u0442\u0435\u044F","\u0423 \u041D\u0438\u043D\u044B","\u0423 \u0410\u043D\u0434\u0440\u0435\u044F","\u0423 \u0441\u0435\u0441\u0442\u0440\u044B \u041D\u0438\u043D\u044B"],answer:"\u0423 \u041C\u0430\u0442\u0435\u044F",explanation:"Matej m\xE1 ve\u013Ek\xFD byt \u2014 \u0443 \u041C\u0430\u0442\u0435\u044F \u0431\u043E\u043B\u044C\u0448\u0430\u044F \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0430.",text:"Nina m\xE1 mal\xFA izbu. Matej m\xE1 ve\u013Ek\xFD byt. V byte s\xFA dve izby. Andrej je dnes u Mateja."},{type:"choice",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0435 \u043E\u0442\u0440\u0438\u0446\u0430\u043D\u0438\u0435 \xAB\u0423 \u043C\u0435\u043D\u044F \u043D\u0435\u0442 \u0434\u043E\u043C\u0430\xBB.",options:["Nem\xE1m dom.","Nie m\xE1m dom.","M\xE1m nie dom.","Som nem\xE1m dom."],answer:"Nem\xE1m dom.",explanation:"\u041E\u0442\u0440\u0438\u0446\u0430\u043D\u0438\u0435 \u0433\u043B\u0430\u0433\u043E\u043B\u0430 ma\u0165 \u043F\u0438\u0448\u0435\u0442\u0441\u044F \u0441\u043B\u0438\u0442\u043D\u043E: nem\xE1m."}]},{id:"a1-09",level:"A1",title:"\u041E\u0431\u044B\u0447\u043D\u044B\u0439 \u0434\u0435\u043D\u044C",location:"\u0423\u0447\u0435\u0431\u043D\u043E\u0435 \u043A\u0430\u0444\u0435",scene:"\u041D\u0438\u043D\u0430 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u0441\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0440\u0430\u0441\u043F\u043E\u0440\u044F\u0434\u043E\u043A \u0434\u043D\u044F, \u0447\u0442\u043E\u0431\u044B \u043C\u0435\u0436\u0434\u0443 \u0440\u0430\u0431\u043E\u0442\u043E\u0439 \u0438 \u0434\u0435\u043B\u0430\u043C\u0438 \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u043E\u0441\u044C \u0432\u0440\u0435\u043C\u044F \u043D\u0430 \u0441\u043B\u043E\u0432\u0430\u0446\u043A\u0438\u0439.",goal:"\u041E\u043F\u0438\u0441\u044B\u0432\u0430\u0442\u044C \u0437\u0430\u043D\u044F\u0442\u0438\u044F \u0432 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u043C \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0438 \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u0442\u044C \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0435 \u0444\u0440\u0430\u0437\u044B.",grammar:{title:"\u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u0432\u0440\u0435\u043C\u044F \u0438 \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u044B\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F",body:"\u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u0432\u0440\u0435\u043C\u044F \u043C\u043E\u0436\u0435\u0442 \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u0442\u044C \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0441\u0435\u0439\u0447\u0430\u0441 \u0438 \u043E\u0431\u044B\u0447\u043D\u044B\u0439 \u0440\u0430\u0441\u043F\u043E\u0440\u044F\u0434\u043E\u043A. \u0412 \u043F\u0435\u0440\u0432\u043E\u043C \u043B\u0438\u0446\u0435 \u0447\u0430\u0441\u0442\u043E \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442\u0441\u044F \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u0435 -m: \u010D\xEDtam, p\xED\u0161em, pracujem, \u0161tudujem. \u042D\u0442\u0438 \u0444\u043E\u0440\u043C\u044B \u043D\u0435\u043B\u044C\u0437\u044F \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u0442\u044C \u043E\u0434\u043D\u043E\u0439 \u0437\u0430\u043C\u0435\u043D\u043E\u0439 \u0434\u043B\u044F \u0432\u0441\u0435\u0445 \u0433\u043B\u0430\u0433\u043E\u043B\u043E\u0432: \u043F\u043E\u043B\u0435\u0437\u043D\u043E \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0442\u044C \u043F\u0430\u0440\u044B \u010D\xEDta\u0165 \u2014 \u010D\xEDtam, p\xEDsa\u0165 \u2014 p\xED\u0161em, pracova\u0165 \u2014 pracujem. \u0424\u043E\u0440\u043C\u0430 \u0442\u0440\u0435\u0442\u044C\u0435\u0433\u043E \u043B\u0438\u0446\u0430 \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F: Nina \u010D\xEDta, Matej pracuje. \u0414\u043B\u044F \u043E\u0442\u0440\u0438\u0446\u0430\u043D\u0438\u044F \u043E\u0431\u044B\u0447\u043D\u043E \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F ne-: ne\u010D\xEDtam, nepracujem. \u0420\u044F\u0434\u043E\u043C \u0441 \u0433\u043B\u0430\u0433\u043E\u043B\u043E\u043C \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C r\xE1no (\xAB\u0443\u0442\u0440\u043E\u043C\xBB), ve\u010Der (\xAB\u0432\u0435\u0447\u0435\u0440\u043E\u043C\xBB), dnes (\xAB\u0441\u0435\u0433\u043E\u0434\u043D\u044F\xBB). \u0421\u043E\u044E\u0437 a \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \xAB\u0438\xBB, ale \u2014 \xAB\u043D\u043E\xBB. \u041B\u0438\u0447\u043D\u043E\u0435 \u043C\u0435\u0441\u0442\u043E\u0438\u043C\u0435\u043D\u0438\u0435 \u0447\u0430\u0441\u0442\u043E \u043D\u0435 \u043D\u0443\u0436\u043D\u043E: R\xE1no pracujem \u2014 \u0443\u0436\u0435 \u043F\u043E\u043B\u043D\u043E\u0435 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u043E \u0441\u0435\u0431\u0435.",examples:[{sk:"R\xE1no pracujem.",ru:"\u0423\u0442\u0440\u043E\u043C \u044F \u0440\u0430\u0431\u043E\u0442\u0430\u044E."},{sk:"Ve\u010Der \u010D\xEDtam knihu.",ru:"\u0412\u0435\u0447\u0435\u0440\u043E\u043C \u044F \u0447\u0438\u0442\u0430\u044E \u043A\u043D\u0438\u0433\u0443."},{sk:"Nina \u0161tuduje.",ru:"\u041D\u0438\u043D\u0430 \u0443\u0447\u0438\u0442\u0441\u044F."}]},words:[{sk:"r\xE1no",ru:"\u0443\u0442\u0440\u043E\u043C; \u0443\u0442\u0440\u043E",example:"R\xE1no pijem \u010Daj.",translation:"\u0423\u0442\u0440\u043E\u043C \u044F \u043F\u044C\u044E \u0447\u0430\u0439."},{sk:"ve\u010Der",ru:"\u0432\u0435\u0447\u0435\u0440\u043E\u043C; \u0432\u0435\u0447\u0435\u0440",example:"Ve\u010Der som doma.",translation:"\u0412\u0435\u0447\u0435\u0440\u043E\u043C \u044F \u0434\u043E\u043C\u0430."},{sk:"vst\xE1va\u0165",ru:"\u0432\u0441\u0442\u0430\u0432\u0430\u0442\u044C",example:"Vst\xE1vam skoro.",translation:"\u042F \u0432\u0441\u0442\u0430\u044E \u0440\u0430\u043D\u043E."},{sk:"pracova\u0165",ru:"\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C",example:"Dnes pracujem.",translation:"\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u0440\u0430\u0431\u043E\u0442\u0430\u044E."},{sk:"\u0161tudova\u0165",ru:"\u0443\u0447\u0438\u0442\u044C\u0441\u044F \u0432 \u0432\u0443\u0437\u0435; \u0438\u0437\u0443\u0447\u0430\u0442\u044C",example:"\u0160tudujem politol\xF3giu.",translation:"\u042F \u0438\u0437\u0443\u0447\u0430\u044E \u043F\u043E\u043B\u0438\u0442\u043E\u043B\u043E\u0433\u0438\u044E."},{sk:"\u010D\xEDta\u0165",ru:"\u0447\u0438\u0442\u0430\u0442\u044C",example:"\u010C\xEDtam knihu.",translation:"\u042F \u0447\u0438\u0442\u0430\u044E \u043A\u043D\u0438\u0433\u0443."},{sk:"p\xEDsa\u0165",ru:"\u043F\u0438\u0441\u0430\u0442\u044C",example:"P\xED\u0161em spr\xE1vu.",translation:"\u042F \u043F\u0438\u0448\u0443 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435."},{sk:"spa\u0165",ru:"\u0441\u043F\u0430\u0442\u044C",example:"V noci sp\xEDm.",translation:"\u041D\u043E\u0447\u044C\u044E \u044F \u0441\u043F\u043B\u044E."},{sk:"jes\u0165",ru:"\u0435\u0441\u0442\u044C; \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u044C \u043F\u0438\u0449\u0443",example:"Jem chlieb.",translation:"\u042F \u0435\u043C \u0445\u043B\u0435\u0431."},{sk:"pi\u0165",ru:"\u043F\u0438\u0442\u044C",example:"Pijem vodu.",translation:"\u042F \u043F\u044C\u044E \u0432\u043E\u0434\u0443."}],exercises:[{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443 \xAB\u044F \u0440\u0430\u0431\u043E\u0442\u0430\u044E\xBB.",options:["pracujem","pracuje","pracova\u0165","pracuj\xFA"],answer:"pracujem",explanation:"\u041F\u0435\u0440\u0432\u043E\u0435 \u043B\u0438\u0446\u043E pracova\u0165 \u2014 pracujem.",sk:"Dnes _____.",ru:"\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u0440\u0430\u0431\u043E\u0442\u0430\u044E."},{type:"cloze",prompt:"\u041D\u0438\u043D\u0430 \u0447\u0438\u0442\u0430\u0435\u0442. \u0412\u044B\u0431\u0435\u0440\u0438 \u0433\u043B\u0430\u0433\u043E\u043B.",options:["\u010D\xEDta","\u010D\xEDtam","\u010D\xEDta\u0161","\u010D\xEDta\u0165"],answer:"\u010D\xEDta",explanation:"Nina \u2014 \u0442\u0440\u0435\u0442\u044C\u0435 \u043B\u0438\u0446\u043E \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E \u0447\u0438\u0441\u043B\u0430: \u010D\xEDta.",sk:"Nina _____ knihu."},{type:"choice",prompt:"\u041A\u0430\u043A \u0441\u043A\u0430\u0437\u0430\u0442\u044C \xAB\u042F \u043D\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u044E\xBB?",options:["Nepracujem.","Nie pracujem.","Pracujem ne.","Nepracova\u0165 som."],answer:"Nepracujem.",explanation:"\u041E\u0442\u0440\u0438\u0446\u0430\u043D\u0438\u0435 ne- \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0435\u0442\u0441\u044F \u043A \u0433\u043B\u0430\u0433\u043E\u043B\u0443: nepracujem."},{type:"typing",prompt:"\u041D\u0430\u043F\u0438\u0448\u0438 \xAB\u044F \u043F\u0438\u0448\u0443\xBB \u043E\u0434\u043D\u0438\u043C \u0441\u043B\u043E\u0432\u0430\u0446\u043A\u0438\u043C \u0441\u043B\u043E\u0432\u043E\u043C.",answer:"p\xED\u0161em",explanation:"\u041F\u0435\u0440\u0432\u043E\u0435 \u043B\u0438\u0446\u043E p\xEDsa\u0165 \u2014 p\xED\u0161em, \u0430 \u043D\u0435 p\xEDsam."},{type:"listening",prompt:"\u0427\u0442\u043E \u041C\u0430\u0442\u0435\u0439 \u0434\u0435\u043B\u0430\u0435\u0442 \u0432\u0435\u0447\u0435\u0440\u043E\u043C?",options:["\u0427\u0438\u0442\u0430\u0435\u0442","\u0420\u0430\u0431\u043E\u0442\u0430\u0435\u0442","\u041F\u044C\u0451\u0442 \u043A\u043E\u0444\u0435","\u0415\u0434\u0435\u0442 \u043D\u0430 \u0432\u043E\u043A\u0437\u0430\u043B"],answer:"\u0427\u0438\u0442\u0430\u0435\u0442",explanation:"Ve\u010Der \u010D\xEDtam knihu \u2014 \u0432\u0435\u0447\u0435\u0440\u043E\u043C \u044F \u0447\u0438\u0442\u0430\u044E \u043A\u043D\u0438\u0433\u0443.",audio:"R\xE1no pracujem. Ve\u010Der \u010D\xEDtam knihu."},{type:"order",prompt:"\u0421\u043E\u0431\u0435\u0440\u0438 \xAB\u0412\u0435\u0447\u0435\u0440\u043E\u043C \u044F \u0447\u0438\u0442\u0430\u044E \u043A\u043D\u0438\u0433\u0443\xBB, \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 Ve\u010Der.",answer:["Ve\u010Der","\u010D\xEDtam","knihu."],explanation:"Kniha \u043F\u043E\u0441\u043B\u0435 \u010D\xEDtam \u0441\u0442\u043E\u0438\u0442 \u0432 \u0432\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C: knihu.",acceptedOrders:[["Ve\u010Der","knihu","\u010D\xEDtam."]]},{type:"reading",prompt:"\u041A\u0442\u043E \u0443\u0442\u0440\u043E\u043C \u043F\u044C\u0451\u0442 \u0447\u0430\u0439?",options:["\u041D\u0438\u043D\u0430","\u041C\u0430\u0442\u0435\u0439","\u0410\u043D\u0434\u0440\u0435\u0439","\u0423\u0447\u0438\u0442\u0435\u043B\u044C"],answer:"\u041D\u0438\u043D\u0430",explanation:"\u0422\u0435\u043A\u0441\u0442 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 R\xE1no pije \u010Daj \u043E \u041D\u0438\u043D\u0435.",text:"Nina vst\xE1va skoro. R\xE1no pije \u010Daj a \u010D\xEDta. Matej pije k\xE1vu. Ve\u010Der Nina \u0161tuduje sloven\u010Dinu."},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0441\u043E\u044E\u0437 \xAB\u043D\u043E\xBB.",options:["ale","a","som","je"],answer:"ale",explanation:"Ale \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0435\u0442 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0435 \u0447\u0430\u0441\u0442\u0438: \xAB\u043D\u043E\xBB.",sk:"R\xE1no pracujem, _____ ve\u010Der \u0161tudujem.",ru:"\u043D\u043E"}]},{id:"a1-10",level:"A1",title:"\u041F\u0435\u0440\u0432\u044B\u0439 \u0434\u0435\u043D\u044C \u0431\u0435\u0437 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043E\u043A",location:"\u0410\u0432\u0442\u043E\u0441\u0442\u0430\u043D\u0446\u0438\u044F",scene:"\u041D\u0438\u043D\u0430 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u043B\u0430 \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u0443\u044E \u043C\u0438\u0441\u0441\u0438\u044E \u043F\u0435\u0440\u0432\u043E\u0439 \u0433\u043B\u0430\u0432\u044B: \u043A\u0443\u043F\u0438\u0442\u044C \u0431\u0438\u043B\u0435\u0442, \u043D\u0430\u0439\u0442\u0438 \u0434\u0440\u0443\u0437\u0435\u0439 \u0438 \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0435\u0435.",goal:"\u0421\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0435 \u0444\u0440\u0430\u0437\u044B \u0432 \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440.",grammar:{title:"\u041F\u0440\u043E\u0441\u044C\u0431\u0430, \u0443\u0442\u043E\u0447\u043D\u0435\u043D\u0438\u0435 \u0438 \u043D\u0435\u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u0435",body:"\u0412\u043E \u0432\u0440\u0435\u043C\u044F \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0430 \u043D\u0435 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u043F\u043E\u043D\u0438\u043C\u0430\u0442\u044C \u043A\u0430\u0436\u0434\u043E\u0435 \u0441\u043B\u043E\u0432\u043E. \u041F\u043E\u043B\u0435\u0437\u043D\u043E \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0441\u043E\u0431\u0435\u0441\u0435\u0434\u043D\u0438\u043A\u0430 \u0432\u0435\u0436\u043B\u0438\u0432\u043E\u0439 \u0444\u0440\u0430\u0437\u043E\u0439 Prep\xE1\u010Dte, nerozumiem \u2014 \xAB\u0418\u0437\u0432\u0438\u043D\u0438\u0442\u0435, \u044F \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E\xBB. \u0417\u0430\u0442\u0435\u043C \u043F\u043E\u043F\u0440\u043E\u0441\u0438 Hovorte pomaly, pros\xEDm \u2014 \xAB\u0413\u043E\u0432\u043E\u0440\u0438\u0442\u0435 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430\xBB \u0438\u043B\u0438 E\u0161te raz, pros\xEDm \u2014 \xAB\u0415\u0449\u0451 \u0440\u0430\u0437, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430\xBB. \u041A\u043E\u0433\u0434\u0430 \u043D\u0443\u0436\u043D\u043E \u0447\u0442\u043E-\u0442\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C, \u043F\u043E\u0434\u043E\u0439\u0434\u0451\u0442 Potrebujem (\xAB\u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E\xBB) \u0441 \u0432\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C \u043F\u0430\u0434\u0435\u0436\u043E\u043C: potrebujem l\xEDstok, potrebujem pomoc. \u0421\u043B\u043E\u0432\u043E e\u0161te \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \xAB\u0435\u0449\u0451\xBB, teraz \u2014 \xAB\u0441\u0435\u0439\u0447\u0430\u0441\xBB. \u041F\u0440\u0438 \u0432\u044B\u0431\u043E\u0440\u0435 \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u0430 \u0440\u0430\u0437\u043B\u0438\u0447\u0430\u0439 vlak, autobus \u0438 \u0441\u043B\u043E\u0432\u0430\u0446\u043A\u043E\u0435 mesto. \u041B\u0443\u0447\u0448\u0435 \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u043A\u043E\u0440\u043E\u0442\u043A\u0443\u044E \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0443\u044E \u0444\u0440\u0430\u0437\u0443 \u0438 \u0443\u0442\u043E\u0447\u043D\u0438\u0442\u044C \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u043E\u0435, \u0447\u0435\u043C \u043C\u043E\u043B\u0447\u0430\u0442\u044C. \u0412\u0441\u0435 \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u044F \u0438 \u043F\u043E\u0435\u0437\u0434\u043A\u0438 \u044D\u0442\u043E\u0439 \u043C\u0438\u0441\u0441\u0438\u0438 \u2014 \u0432\u044B\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u044B\u0435 \u0443\u0447\u0435\u0431\u043D\u044B\u0435 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438.",examples:[{sk:"Hovorte pomaly, pros\xEDm.",ru:"\u0413\u043E\u0432\u043E\u0440\u0438\u0442\u0435 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430."},{sk:"E\u0161te raz, pros\xEDm.",ru:"\u0415\u0449\u0451 \u0440\u0430\u0437, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430."},{sk:"Potrebujem l\xEDstok.",ru:"\u041C\u043D\u0435 \u043D\u0443\u0436\u0435\u043D \u0431\u0438\u043B\u0435\u0442."}]},words:[{sk:"l\xEDstok",ru:"\u0431\u0438\u043B\u0435\u0442",example:"Potrebujem l\xEDstok.",translation:"\u041C\u043D\u0435 \u043D\u0443\u0436\u0435\u043D \u0431\u0438\u043B\u0435\u0442."},{sk:"vlak",ru:"\u043F\u043E\u0435\u0437\u0434",example:"Vlak je na stanici.",translation:"\u041F\u043E\u0435\u0437\u0434 \u043D\u0430 \u0441\u0442\u0430\u043D\u0446\u0438\u0438."},{sk:"autobus",ru:"\u0430\u0432\u0442\u043E\u0431\u0443\u0441",example:"Autobus je tu.",translation:"\u0410\u0432\u0442\u043E\u0431\u0443\u0441 \u0437\u0434\u0435\u0441\u044C."},{sk:"cestova\u0165",ru:"\u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C; \u0435\u0437\u0434\u0438\u0442\u044C",example:"R\xE1d cestujem.",translation:"\u042F \u043B\u044E\u0431\u043B\u044E \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C."},{sk:"kufor",ru:"\u0447\u0435\u043C\u043E\u0434\u0430\u043D",example:"M\xF4j kufor je mal\xFD.",translation:"\u041C\u043E\u0439 \u0447\u0435\u043C\u043E\u0434\u0430\u043D \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439."},{sk:"mapa",ru:"\u043A\u0430\u0440\u0442\u0430 \u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438",example:"M\xE1m mapu mesta.",translation:"\u0423 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u043A\u0430\u0440\u0442\u0430 \u0433\u043E\u0440\u043E\u0434\u0430."},{sk:"pomoc",ru:"\u043F\u043E\u043C\u043E\u0449\u044C",example:"Potrebujem pomoc.",translation:"\u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u0430 \u043F\u043E\u043C\u043E\u0449\u044C."},{sk:"pomaly",ru:"\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E",example:"Hovorte pomaly, pros\xEDm.",translation:"\u0413\u043E\u0432\u043E\u0440\u0438\u0442\u0435 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430."},{sk:"e\u0161te",ru:"\u0435\u0449\u0451",example:"E\u0161te raz, pros\xEDm.",translation:"\u0415\u0449\u0451 \u0440\u0430\u0437, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430."},{sk:"teraz",ru:"\u0441\u0435\u0439\u0447\u0430\u0441",example:"Teraz m\xE1m \u010Das.",translation:"\u0421\u0435\u0439\u0447\u0430\u0441 \u0443 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u0432\u0440\u0435\u043C\u044F."}],exercises:[{type:"choice",prompt:"\u0422\u044B \u043D\u0435 \u043F\u043E\u043D\u044F\u043B \u043E\u0442\u0432\u0435\u0442. \u041A\u0430\u043A \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u043F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u044C?",options:["E\u0161te raz, pros\xEDm.","Dovidenia, \u0161kola.","Som \xFA\u010Det.","Dnes je meno."],answer:"E\u0161te raz, pros\xEDm.",explanation:"E\u0161te raz, pros\xEDm \u2014 \u043A\u043E\u0440\u043E\u0442\u043A\u0430\u044F \u0432\u0435\u0436\u043B\u0438\u0432\u0430\u044F \u043F\u0440\u043E\u0441\u044C\u0431\u0430 \u043F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u044C."},{type:"cloze",prompt:"\u0412\u0441\u0442\u0430\u0432\u044C \xAB\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E\xBB.",options:["pomaly","v\u013Eavo","drah\xFD","zajtra"],answer:"pomaly",explanation:"Hovorte pomaly \u2014 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E.",sk:"Hovorte _____, pros\xEDm."},{type:"choice",prompt:"\u041A\u0430\u043A \u0441\u043A\u0430\u0437\u0430\u0442\u044C \xAB\u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u0430 \u043F\u043E\u043C\u043E\u0449\u044C\xBB?",options:["Potrebujem pomoc.","Som pomoc.","Pomoc je m\xF4j.","M\xE1m pomaly."],answer:"Potrebujem pomoc.",explanation:"Potrebujem + \u043E\u0431\u044A\u0435\u043A\u0442 \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442 \xAB\u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E\xBB. \u0421\u043B\u043E\u0432\u043E pomoc \u0437\u0434\u0435\u0441\u044C \u043D\u0435 \u043C\u0435\u043D\u044F\u0435\u0442 \u0444\u043E\u0440\u043C\u0443."},{type:"typing",prompt:"\u041D\u0430\u043F\u0438\u0448\u0438 \u043F\u043E-\u0441\u043B\u043E\u0432\u0430\u0446\u043A\u0438 \xAB\u0431\u0438\u043B\u0435\u0442\xBB.",answer:"l\xEDstok",explanation:"\u0411\u0438\u043B\u0435\u0442 \u2014 l\xEDstok, \u0441 \u0434\u043E\u043B\u0433\u043E\u0439 \xED."},{type:"listening",prompt:"\u041A\u0430\u043A\u043E\u0439 \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442 \u043D\u0443\u0436\u0435\u043D \u0433\u043E\u0432\u043E\u0440\u044F\u0449\u0435\u043C\u0443?",options:["\u041F\u043E\u0435\u0437\u0434","\u0410\u0432\u0442\u043E\u0431\u0443\u0441","\u0422\u0440\u0430\u043C\u0432\u0430\u0439","\u0412\u0435\u043B\u043E\u0441\u0438\u043F\u0435\u0434"],answer:"\u041F\u043E\u0435\u0437\u0434",explanation:"\u041D\u0430 \u043F\u043E\u0435\u0437\u0434 \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 na vlak.",audio:"Dobr\xFD de\u0148. Potrebujem l\xEDstok na vlak, pros\xEDm."},{type:"order",prompt:"\u0421\u043E\u0431\u0435\u0440\u0438 \xAB\u0418\u0437\u0432\u0438\u043D\u0438\u0442\u0435, \u044F \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E\xBB, \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 Prep\xE1\u010Dte.",answer:["Prep\xE1\u010Dte,","nerozumiem."],explanation:"Nerozumiem \u2014 \u043E\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u0444\u043E\u0440\u043C\u0430 \xAB\u044F \u043F\u043E\u043D\u0438\u043C\u0430\u044E\xBB. \u041E\u043D\u0430 \u043F\u0438\u0448\u0435\u0442\u0441\u044F \u0441\u043B\u0438\u0442\u043D\u043E."},{type:"reading",prompt:"\u0413\u0434\u0435 \u0434\u0440\u0443\u0437\u044C\u044F \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044E\u0442\u0441\u044F \u0441\u0435\u0433\u043E\u0434\u043D\u044F?",options:["\u041D\u0430 \u0432\u043E\u043A\u0437\u0430\u043B\u0435","\u0412 \u043A\u0430\u0444\u0435","\u0412 \u0448\u043A\u043E\u043B\u0435","\u0414\u043E\u043C\u0430 \u0443 \u041D\u0438\u043D\u044B"],answer:"\u041D\u0430 \u0432\u043E\u043A\u0437\u0430\u043B\u0435",explanation:"Dnes sa stretneme na stanici \u2014 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043C\u0441\u044F \u043D\u0430 \u0432\u043E\u043A\u0437\u0430\u043B\u0435.",text:"Ahoj, Andrej! Dnes sa stretneme na stanici o tretej. M\xE1m dva l\xEDstky na vlak. Nina pr\xEDde tie\u017E. Matej."},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443 \u0432 \xAB\u041C\u0435\u043D\u044F \u0437\u043E\u0432\u0443\u0442 \u0410\u043D\u0434\u0440\u0435\u0439\xBB.",options:["sa","si","s\xFA","sme"],answer:"sa",explanation:"\u0412\u043E\u0437\u0432\u0440\u0430\u0442\u043D\u0430\u044F \u0447\u0430\u0441\u0442\u0438\u0446\u0430 \u0443 vola\u0165 sa \u2014 sa.",sk:"Vol\xE1m _____ Andrej."}]},{id:"a2-01",level:"A2",title:"\u0427\u0435\u0433\u043E \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442",location:"\u041F\u043E\u0447\u0442\u043E\u0432\u043E\u0435 \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0435",scene:"\u041C\u0430\u0442\u0435\u0439 \u0433\u043E\u0442\u043E\u0432\u0438\u0442 \u043F\u043E\u0441\u044B\u043B\u043A\u0443 \u0438 \u043D\u0438\u043A\u0430\u043A \u043D\u0435 \u043D\u0430\u0439\u0434\u0451\u0442 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B. \u041F\u043E\u043C\u043E\u0433\u0438 \u0432\u044B\u044F\u0441\u043D\u0438\u0442\u044C, \u0447\u0435\u0433\u043E \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0438 \u043A\u0443\u0434\u0430 \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0439\u0442\u0438.",goal:"\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043F\u0430\u0434\u0435\u0436 \u043F\u043E\u0441\u043B\u0435 \u0431\u0435\u0437, \u0438\u0437, \u043E\u0442 \u0438 \u0434\u043E.",grammar:{title:"\u0420\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043F\u0430\u0434\u0435\u0436: bez, z, od, do",body:"\u041F\u043E\u0441\u043B\u0435 \u043F\u0440\u0435\u0434\u043B\u043E\u0433\u043E\u0432 bez (\xAB\u0431\u0435\u0437\xBB), z \u0438\u043B\u0438 zo (\xAB\u0438\u0437\xBB), od (\xAB\u043E\u0442\xBB) \u0438 do (\xAB\u0432, \u0434\u043E\xBB) \u043D\u0443\u0436\u0435\u043D \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043F\u0430\u0434\u0435\u0436. \u0421\u0440\u0430\u0432\u043D\u0438 banka \u2014 do banky, \u0161kola \u2014 zo \u0161koly, mesto \u2014 z mesta, kamar\xE1t \u2014 od kamar\xE1ta. \u041E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u044F \u043C\u0443\u0436\u0441\u043A\u043E\u0433\u043E \u0440\u043E\u0434\u0430 \u043D\u0443\u0436\u043D\u043E \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0442\u044C \u0441\u043E \u0441\u043B\u043E\u0432\u043E\u043C: \u0431\u0435\u0437 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0430 \u2014 bez telef\xF3nu, \u0431\u0435\u0437 \u043F\u0430\u0441\u043F\u043E\u0440\u0442\u0430 \u2014 bez pasu. \u0414\u043B\u044F \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \xAB\u0432 \u0448\u043A\u043E\u043B\u0443\xBB \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F do \u0161koly, \u0430 \u0434\u043B\u044F \u043D\u0430\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F \xAB\u0432 \u0448\u043A\u043E\u043B\u0435\xBB \u2014 v \u0161kole: \u044D\u0442\u043E \u0440\u0430\u0437\u043D\u044B\u0435 \u043F\u0430\u0434\u0435\u0436\u0438. \u041F\u0440\u0435\u0434\u043B\u043E\u0433 zo \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u043E\u043C z, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u0431\u043B\u0435\u0433\u0447\u0430\u0435\u0442 \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0448\u0435\u043D\u0438\u0435. \u0412\u043E\u043F\u0440\u043E\u0441\u044B \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043F\u0430\u0434\u0435\u0436\u0430 \u2014 koho? \u010Doho? \u0417\u0434\u0435\u0441\u044C \u0443\u0447\u0438\u0441\u044C \u0443\u0437\u043D\u0430\u0432\u0430\u0442\u044C \u043F\u0440\u0435\u0434\u043B\u043E\u0433 \u0438 \u0442\u043E\u043B\u044C\u043A\u043E \u0437\u0430\u0442\u0435\u043C \u043C\u0435\u043D\u044F\u0442\u044C \u0444\u043E\u0440\u043C\u0443 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E.",examples:[{sk:"Idem do banky.",ru:"\u042F \u0438\u0434\u0443 \u0432 \u0431\u0430\u043D\u043A."},{sk:"Som z mesta.",ru:"\u042F \u0438\u0437 \u0433\u043E\u0440\u043E\u0434\u0430."},{sk:"Nem\xF4\u017Eem \xEDs\u0165 bez pasu.",ru:"\u042F \u043D\u0435 \u043C\u043E\u0433\u0443 \u043F\u043E\u0439\u0442\u0438 \u0431\u0435\u0437 \u043F\u0430\u0441\u043F\u043E\u0440\u0442\u0430."}]},words:[{sk:"k\u013E\xFA\u010D",ru:"\u043A\u043B\u044E\u0447",example:"Nem\xE1m k\u013E\xFA\u010D od izby.",translation:"\u0423 \u043C\u0435\u043D\u044F \u043D\u0435\u0442 \u043A\u043B\u044E\u0447\u0430 \u043E\u0442 \u043A\u043E\u043C\u043D\u0430\u0442\u044B."},{sk:"pas",ru:"\u043F\u0430\u0441\u043F\u043E\u0440\u0442",example:"Pas je v ta\u0161ke.",translation:"\u041F\u0430\u0441\u043F\u043E\u0440\u0442 \u0432 \u0441\u0443\u043C\u043A\u0435."},{sk:"telef\xF3n",ru:"\u0442\u0435\u043B\u0435\u0444\u043E\u043D",example:"M\xF4j telef\xF3n je doma.",translation:"\u041C\u043E\u0439 \u0442\u0435\u043B\u0435\u0444\u043E\u043D \u0434\u043E\u043C\u0430."},{sk:"doklad",ru:"\u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442",example:"Potrebujem tento doklad.",translation:"\u041C\u043D\u0435 \u043D\u0443\u0436\u0435\u043D \u044D\u0442\u043E\u0442 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442."},{sk:"bez",ru:"\u0431\u0435\u0437",example:"Pijem \u010Daj bez cukru.",translation:"\u042F \u043F\u044C\u044E \u0447\u0430\u0439 \u0431\u0435\u0437 \u0441\u0430\u0445\u0430\u0440\u0430."},{sk:"do",ru:"\u0432; \u0434\u043E \u2014 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435",example:"Idem do \u0161koly.",translation:"\u042F \u0438\u0434\u0443 \u0432 \u0448\u043A\u043E\u043B\u0443."},{sk:"z",ru:"\u0438\u0437",example:"Som z Ruska.",translation:"\u042F \u0438\u0437 \u0420\u043E\u0441\u0441\u0438\u0438."},{sk:"od",ru:"\u043E\u0442",example:"To je spr\xE1va od Niny.",translation:"\u042D\u0442\u043E \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435 \u043E\u0442 \u041D\u0438\u043D\u044B."},{sk:"po\u0161ta",ru:"\u043F\u043E\u0447\u0442\u0430",example:"Po\u0161ta je bl\xEDzko.",translation:"\u041F\u043E\u0447\u0442\u0430 \u0431\u043B\u0438\u0437\u043A\u043E."},{sk:"banka",ru:"\u0431\u0430\u043D\u043A",example:"Banka je ved\u013Ea po\u0161ty.",translation:"\u0411\u0430\u043D\u043A \u0440\u044F\u0434\u043E\u043C \u0441 \u043F\u043E\u0447\u0442\u043E\u0439."}],exercises:[{type:"cloze",prompt:"\u041D\u0443\u0436\u043D\u043E \u0438\u0434\u0442\u0438 \u0432 \u0431\u0430\u043D\u043A. \u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443 banka.",options:["banky","banke","banku","bankou"],answer:"banky",explanation:"\u041F\u043E\u0441\u043B\u0435 do \u043D\u0443\u0436\u0435\u043D \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439: do banky.",sk:"Idem do _____."},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443 telef\xF3n \u043F\u043E\u0441\u043B\u0435 bez.",options:["telef\xF3nu","telef\xF3ne","telef\xF3nom","telef\xF3n"],answer:"telef\xF3nu",explanation:"\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0435 \u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0435 \u2014 bez telef\xF3nu.",sk:"Dnes som bez _____."},{type:"choice",prompt:"\u041A\u0430\u043A \u0441\u043A\u0430\u0437\u0430\u0442\u044C \xAB\u0438\u0437 \u0448\u043A\u043E\u043B\u044B\xBB?",options:["zo \u0161koly","so \u0161kolou","do \u0161kole","na \u0161kola"],answer:"zo \u0161koly",explanation:"\u041F\u0440\u0435\u0434\u043B\u043E\u0433 zo \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E: \u0161koly. So \u0161kolou \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \xAB\u0441\u043E \u0448\u043A\u043E\u043B\u043E\u0439\xBB."},{type:"typing",prompt:"\u0412\u0441\u0442\u0430\u0432\u044C \u0444\u043E\u0440\u043C\u0443 \u0441\u043B\u043E\u0432\u0430 mesto \u043F\u043E\u0441\u043B\u0435 z: z ___.",answer:"mesta",explanation:"Mesto \u2192 mesta \u0432 \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E \u0447\u0438\u0441\u043B\u0430."},{type:"listening",prompt:"\u0427\u0435\u0433\u043E \u043D\u0435\u0442 \u0443 \u041C\u0430\u0442\u0435\u044F \u0441 \u0441\u043E\u0431\u043E\u0439?",options:["\u041F\u0430\u0441\u043F\u043E\u0440\u0442\u0430","\u0422\u0435\u043B\u0435\u0444\u043E\u043D\u0430","\u041A\u043B\u044E\u0447\u0430","\u0411\u0438\u043B\u0435\u0442\u0430"],answer:"\u041F\u0430\u0441\u043F\u043E\u0440\u0442\u0430",explanation:"Bez pasu \u2014 \u0431\u0435\u0437 \u043F\u0430\u0441\u043F\u043E\u0440\u0442\u0430.",audio:"Som pred bankou, ale som bez pasu. Pas je doma."},{type:"order",prompt:"\u0421\u043E\u0431\u0435\u0440\u0438 \xAB\u042F \u0438\u0434\u0443 \u043D\u0430 \u043F\u043E\u0447\u0442\u0443\xBB, \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 Idem.",answer:["Idem","na","po\u0161tu."],explanation:"\u0414\u043B\u044F \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u043D\u0430 \u043F\u043E\u0447\u0442\u0443 \u0437\u0434\u0435\u0441\u044C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F na + \u0432\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439: na po\u0161tu. \u041D\u0435 \u0432\u0441\u0435 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u0432\u044B\u0440\u0430\u0436\u0430\u044E\u0442\u0441\u044F \u0447\u0435\u0440\u0435\u0437 do."},{type:"reading",prompt:"\u041E\u0442 \u043A\u043E\u0433\u043E \u041D\u0438\u043D\u0430 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0430 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435?",options:["\u041E\u0442 \u041C\u0430\u0442\u0435\u044F","\u041E\u0442 \u0410\u043D\u0434\u0440\u0435\u044F","\u041E\u0442 \u043E\u0442\u0446\u0430","\u041E\u0442 \u0443\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u0438\u0446\u044B"],answer:"\u041E\u0442 \u041C\u0430\u0442\u0435\u044F",explanation:"Od Mateja \u2014 \u043E\u0442 \u041C\u0430\u0442\u0435\u044F.",text:"Nina m\xE1 spr\xE1vu od Mateja. Matej je na po\u0161te. Nem\xE1 k\u013E\xFA\u010D od izby. K\u013E\xFA\u010D je u Andreja."},{type:"choice",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0441\u043B\u043E\u0432\u043E\u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0435 \xAB\u0447\u0430\u0439 \u0431\u0435\u0437 \u0441\u0430\u0445\u0430\u0440\u0430\xBB.",options:["\u010Daj bez cukru","\u010Daj bez cukor","\u010Daj bez cukrom","\u010Daj bez cukre"],answer:"\u010Daj bez cukru",explanation:"\u041F\u043E\u0441\u043B\u0435 bez: cukor \u2192 cukru."}]},{id:"a2-02",level:"A2",title:"\u041F\u043E\u043C\u043E\u0433\u0438 \u0441\u043E\u0441\u0435\u0434\u0443",location:"\u0414\u0432\u043E\u0440 \u043E\u0431\u0449\u0435\u0436\u0438\u0442\u0438\u044F",scene:"\u041D\u0438\u043D\u0430 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0443\u0435\u0442 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043E\u0431\u043C\u0435\u043D \u043A\u043D\u0438\u0433\u0430\u043C\u0438. \u041A\u043E\u043C\u0443 \u043E\u0442\u0434\u0430\u0442\u044C \u043F\u043E\u0434\u0430\u0440\u043E\u043A, \u043A\u043E\u043C\u0443 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435 \u0438 \u043A\u043E\u043C\u0443 \u043F\u043E\u043C\u043E\u0447\u044C?",goal:"\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0434\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043F\u0430\u0434\u0435\u0436 \u0434\u043B\u044F \u0430\u0434\u0440\u0435\u0441\u0430\u0442\u0430 \u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\u044F.",grammar:{title:"\u0414\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043F\u0430\u0434\u0435\u0436: \u043A\u043E\u043C\u0443?",body:"\u0414\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043F\u0430\u0434\u0435\u0436 \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u043D\u0430 \u0432\u043E\u043F\u0440\u043E\u0441\u044B komu? \u010Domu? \u0438 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442, \u043A\u043E\u043C\u0443 \u0430\u0434\u0440\u0435\u0441\u043E\u0432\u0430\u043D\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435. \u041E\u043D \u043D\u0443\u0436\u0435\u043D \u043F\u043E\u0441\u043B\u0435 pom\xE1ha\u0165 (\xAB\u043F\u043E\u043C\u043E\u0433\u0430\u0442\u044C\xBB), \u010Fakova\u0165 (\xAB\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C\xBB) \u0438 \u043F\u0440\u0438 \u0443\u043A\u0430\u0437\u0430\u043D\u0438\u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\u044F \u0441 da\u0165 \u0438\u043B\u0438 posla\u0165. \u0421\u0440\u0430\u0432\u043D\u0438 kamar\xE1t \u2014 kamar\xE1tovi, Nina \u2014 Nine, sestra \u2014 sestre. \u0423 \u0436\u0435\u043D\u0441\u043A\u0438\u0445 \u0438\u043C\u0451\u043D \u043D\u0430 -a \u0437\u0434\u0435\u0441\u044C \u043E\u0431\u044B\u0447\u043D\u043E \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F -e; \u0443 \u043C\u043D\u043E\u0433\u0438\u0445 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0439 \u043B\u044E\u0434\u0435\u0439 \u043C\u0443\u0436\u0441\u043A\u043E\u0433\u043E \u0440\u043E\u0434\u0430 \u2014 -ovi. \u041A\u043E\u0440\u043E\u0442\u043A\u0438\u0435 \u043C\u0435\u0441\u0442\u043E\u0438\u043C\u0435\u043D\u043D\u044B\u0435 \u0444\u043E\u0440\u043C\u044B: mi \u2014 \xAB\u043C\u043D\u0435\xBB, ti \u2014 \xAB\u0442\u0435\u0431\u0435\xBB, mu \u2014 \xAB\u0435\u043C\u0443\xBB, jej \u2014 \xAB\u0435\u0439\xBB, n\xE1m \u2014 \xAB\u043D\u0430\u043C\xBB, v\xE1m \u2014 \xAB\u0432\u0430\u043C\xBB, im \u2014 \xAB\u0438\u043C\xBB. \u0417\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0439 \u0433\u043B\u0430\u0433\u043E\u043B \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u043F\u0430\u0434\u0435\u0436\u043E\u043C: Pom\xE1ham Nine. \u0420\u0443\u0441\u0441\u043A\u043E\u0435 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0438\u043D\u043E\u0433\u0434\u0430 \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043D\u0435 \u0432\u044B\u0431\u0438\u0440\u0430\u0439 \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0443.",examples:[{sk:"Pom\xE1ham kamar\xE1tovi.",ru:"\u042F \u043F\u043E\u043C\u043E\u0433\u0430\u044E \u0434\u0440\u0443\u0433\u0443."},{sk:"Posielam Nine spr\xE1vu.",ru:"\u042F \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u044E \u041D\u0438\u043D\u0435 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435."},{sk:"\u010Eakujem v\xE1m.",ru:"\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044E \u0432\u0430\u0441."}]},words:[{sk:"pom\xE1ha\u0165",ru:"\u043F\u043E\u043C\u043E\u0433\u0430\u0442\u044C",example:"Pom\xE1ham sestre.",translation:"\u042F \u043F\u043E\u043C\u043E\u0433\u0430\u044E \u0441\u0435\u0441\u0442\u0440\u0435."},{sk:"dar\u010Dek",ru:"\u043F\u043E\u0434\u0430\u0440\u043E\u043A",example:"M\xE1m dar\u010Dek pre Ninu.",translation:"\u0423 \u043C\u0435\u043D\u044F \u043F\u043E\u0434\u0430\u0440\u043E\u043A \u0434\u043B\u044F \u041D\u0438\u043D\u044B."},{sk:"kamar\xE1t",ru:"\u0434\u0440\u0443\u0433; \u043F\u0440\u0438\u044F\u0442\u0435\u043B\u044C",example:"M\xF4j kamar\xE1t b\xFDva bl\xEDzko.",translation:"\u041C\u043E\u0439 \u0434\u0440\u0443\u0433 \u0436\u0438\u0432\u0451\u0442 \u0431\u043B\u0438\u0437\u043A\u043E."},{sk:"kolega",ru:"\u043A\u043E\u043B\u043B\u0435\u0433\u0430",example:"Kolega mi pom\xE1ha.",translation:"\u041A\u043E\u043B\u043B\u0435\u0433\u0430 \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u043C\u043D\u0435."},{sk:"sused",ru:"\u0441\u043E\u0441\u0435\u0434",example:"Sused je doma.",translation:"\u0421\u043E\u0441\u0435\u0434 \u0434\u043E\u043C\u0430."},{sk:"posla\u0165",ru:"\u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C",example:"Chcem posla\u0165 spr\xE1vu.",translation:"\u042F \u0445\u043E\u0447\u0443 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435."},{sk:"da\u0165",ru:"\u0434\u0430\u0442\u044C",example:"M\xF4\u017Eem ti da\u0165 knihu.",translation:"\u042F \u043C\u043E\u0433\u0443 \u0434\u0430\u0442\u044C \u0442\u0435\u0431\u0435 \u043A\u043D\u0438\u0433\u0443."},{sk:"komu",ru:"\u043A\u043E\u043C\u0443",example:"Komu p\xED\u0161e\u0161?",translation:"\u041A\u043E\u043C\u0443 \u0442\u044B \u043F\u0438\u0448\u0435\u0448\u044C?"},{sk:"odpoveda\u0165",ru:"\u043E\u0442\u0432\u0435\u0447\u0430\u0442\u044C",example:"Odpoved\xE1m u\u010Dite\u013Eovi.",translation:"\u042F \u043E\u0442\u0432\u0435\u0447\u0430\u044E \u0443\u0447\u0438\u0442\u0435\u043B\u044E."},{sk:"\u010Fakova\u0165",ru:"\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C",example:"\u010Eakujem v\xE1m za pomoc.",translation:"\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044E \u0432\u0430\u0441 \u0437\u0430 \u043F\u043E\u043C\u043E\u0449\u044C."}],exercises:[{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443 kamar\xE1t \u043F\u043E\u0441\u043B\u0435 pom\xE1ham.",options:["kamar\xE1tovi","kamar\xE1ta","kamar\xE1tom","kamar\xE1t"],answer:"kamar\xE1tovi",explanation:"Pom\xE1ha\u0165 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0434\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E: komu? kamar\xE1tovi.",sk:"Pom\xE1ham _____."},{type:"cloze",prompt:"\u0421\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435 \u0430\u0434\u0440\u0435\u0441\u043E\u0432\u0430\u043D\u043E \u041D\u0438\u043D\u0435. \u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443 \u0438\u043C\u0435\u043D\u0438.",options:["Nine","Ninu","Ninou","Nina"],answer:"Nine",explanation:"\u041F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\u044C \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0432 \u0434\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u043C: Nina \u2192 Nine.",sk:"Posielam _____ spr\xE1vu."},{type:"choice",prompt:"\u0427\u0442\u043E \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 mi \u0432 \xABMatej mi pom\xE1ha\xBB?",options:["\u041C\u043D\u0435","\u041C\u0435\u043D\u044F","\u041C\u043E\u0439","\u0421\u043E \u043C\u043D\u043E\u0439"],answer:"\u041C\u043D\u0435",explanation:"Mi \u2014 \u043A\u0440\u0430\u0442\u043A\u0430\u044F \u0444\u043E\u0440\u043C\u0430 \u0434\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u043B\u0438\u0446\u0430: \u043C\u043D\u0435."},{type:"typing",prompt:"\u0412\u0441\u0442\u0430\u0432\u044C \u0444\u043E\u0440\u043C\u0443 sestra \u043F\u043E\u0441\u043B\u0435 pom\xE1ham: Pom\xE1ham ___.",answer:"sestre",explanation:"Sestra \u2192 sestre \u0432 \u0434\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u043C \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E \u0447\u0438\u0441\u043B\u0430."},{type:"listening",prompt:"\u041A\u043E\u043C\u0443 \u041C\u0430\u0442\u0435\u0439 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442 \u043A\u043D\u0438\u0433\u0443?",options:["\u0421\u043E\u0441\u0435\u0434\u0443","\u0421\u0435\u0441\u0442\u0440\u0435","\u041D\u0438\u043D\u0435","\u0423\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u0438\u0446\u0435"],answer:"\u0421\u043E\u0441\u0435\u0434\u0443",explanation:"Susedovi \u2014 \u0441\u043E\u0441\u0435\u0434\u0443, \u0444\u043E\u0440\u043C\u0430 \u0434\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043F\u0430\u0434\u0435\u0436\u0430.",audio:"Posielam susedovi knihu. Nine posielam spr\xE1vu."},{type:"order",prompt:"\u0421\u043E\u0431\u0435\u0440\u0438 \xAB\u041F\u043E\u043C\u043E\u0433\u0430\u044E \u0434\u0440\u0443\u0433\u0443\xBB, \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 Pom\xE1ham.",answer:["Pom\xE1ham","kamar\xE1tovi."],explanation:"\u0413\u043B\u0430\u0433\u043E\u043B pom\xE1ha\u0165 \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0441 \u0434\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C \u043F\u0430\u0434\u0435\u0436\u043E\u043C."},{type:"reading",prompt:"\u041A\u043E\u043C\u0443 \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u043F\u043E\u0434\u0430\u0440\u043E\u043A?",options:["\u041D\u0438\u043D\u0435","\u0421\u043E\u0441\u0435\u0434\u0443","\u041C\u0430\u0442\u0435\u044E","\u041A\u043E\u043B\u043B\u0435\u0433\u0435"],answer:"\u041D\u0438\u043D\u0435",explanation:"\u041C\u0430\u0442\u0435\u0439 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 Dar\u010Dek d\xE1m Nine \u2014 \u043F\u043E\u0434\u0430\u0440\u043E\u043A \u0434\u0430\u043C \u041D\u0438\u043D\u0435.",text:"Matej m\xE1 knihu a dar\u010Dek. Knihu d\xE1 susedovi. Dar\u010Dek d\xE1 Nine. Nina mu \u010Fakuje."},{type:"choice",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0443\u044E \u0432\u0435\u0436\u043B\u0438\u0432\u0443\u044E \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u043C \u043B\u044E\u0434\u044F\u043C.",options:["\u010Eakujem v\xE1m.","\u010Eakujem v\xE1s.","\u010Eakujem vy.","\u010Eakujem vami."],answer:"\u010Eakujem v\xE1m.",explanation:"\u010Eakova\u0165 \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442 \u0434\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C: v\xE1m."}]},{id:"a2-03",level:"A2",title:"\u0420\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u0443 \u0414\u0443\u043D\u0430\u044F",location:"\u041D\u0430\u0431\u0435\u0440\u0435\u0436\u043D\u0430\u044F",scene:"\u041D\u0438\u043D\u0430 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442\u0441\u044F \u0441 \u041C\u0430\u0442\u0435\u0435\u043C \u0443 \u0440\u0435\u043A\u0438. \u041D\u0430\u0439\u0434\u0438 \u043C\u0435\u0441\u0442\u043E \u0432\u0441\u0442\u0440\u0435\u0447\u0438 \u0438 \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0438, \u0441 \u043A\u0435\u043C \u0438 \u043D\u0430 \u0447\u0451\u043C \u0442\u044B \u0435\u0434\u0435\u0448\u044C.",goal:"\u0420\u0430\u0437\u043B\u0438\u0447\u0430\u0442\u044C \u043C\u0435\u0441\u0442\u043D\u044B\u0439 \u0438 \u0442\u0432\u043E\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043F\u0430\u0434\u0435\u0436\u0438 \u0432 \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0445 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044F\u0445.",grammar:{title:"\u0413\u0434\u0435, \u043E \u0447\u0451\u043C, \u0441 \u043A\u0435\u043C \u0438 \u0447\u0435\u043C",body:"\u041C\u0435\u0441\u0442\u043D\u044B\u0439 \u043F\u0430\u0434\u0435\u0436 \u0443\u043F\u043E\u0442\u0440\u0435\u0431\u043B\u044F\u0435\u0442\u0441\u044F \u0441 \u043F\u0440\u0435\u0434\u043B\u043E\u0433\u0430\u043C\u0438: v meste (\xAB\u0432 \u0433\u043E\u0440\u043E\u0434\u0435\xBB), v kni\u017Enici (\xAB\u0432 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0435\xBB), o \u0161kole (\xAB\u043E \u0448\u043A\u043E\u043B\u0435\xBB). \u041E\u043D \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u043D\u0430 \u0432\u043E\u043F\u0440\u043E\u0441\u044B kde? \u0438\u043B\u0438 o \u010Dom? \u0422\u0432\u043E\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u0430 \u0438\u043B\u0438 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043E: s kamar\xE1tom (\xAB\u0441 \u0434\u0440\u0443\u0433\u043E\u043C\xBB), s Ninou (\xAB\u0441 \u041D\u0438\u043D\u043E\u0439\xBB), vlakom (\xAB\u043F\u043E\u0435\u0437\u0434\u043E\u043C\xBB), perom (\xAB\u0440\u0443\u0447\u043A\u043E\u0439\xBB). \u041F\u0440\u0435\u0434\u043B\u043E\u0433 s \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u043A \u0442\u0432\u043E\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C\u0443, \u0430 z \u2014 \u043A \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C\u0443: s Ninou \u0437\u043D\u0430\u0447\u0438\u0442 \xAB\u0441 \u041D\u0438\u043D\u043E\u0439\xBB, z mesta \u2014 \xAB\u0438\u0437 \u0433\u043E\u0440\u043E\u0434\u0430\xBB. \u0414\u043B\u044F \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u0430 \u0447\u0430\u0441\u0442\u043E \u043D\u0435 \u043D\u0443\u0436\u0435\u043D \u043F\u0440\u0435\u0434\u043B\u043E\u0433: cestujem autobusom. \u041E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u044F \u0437\u0430\u0432\u0438\u0441\u044F\u0442 \u043E\u0442 \u0442\u0438\u043F\u0430 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E; \u0432\u044B\u0443\u0447\u0438 \u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u044F \u0446\u0435\u043B\u0438\u043A\u043E\u043C \u0438 \u0441\u0440\u0430\u0432\u043D\u0438\u0432\u0430\u0439 \u043A\u043E\u043D\u0442\u0435\u043A\u0441\u0442\u044B, \u0430 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u043D\u0435\u0448\u043D\u0435 \u043F\u043E\u0445\u043E\u0436\u0438\u0435 \u0440\u0443\u0441\u0441\u043A\u0438\u0435 \u0444\u043E\u0440\u043C\u044B.",examples:[{sk:"Som v kni\u017Enici.",ru:"\u042F \u0432 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0435."},{sk:"Hovor\xEDme o \u0161kole.",ru:"\u041C\u044B \u0433\u043E\u0432\u043E\u0440\u0438\u043C \u043E \u0448\u043A\u043E\u043B\u0435."},{sk:"Cestujem s Ninou vlakom.",ru:"\u042F \u0435\u0434\u0443 \u0441 \u041D\u0438\u043D\u043E\u0439 \u043F\u043E\u0435\u0437\u0434\u043E\u043C."}]},words:[{sk:"kni\u017Enica",ru:"\u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0430",example:"Som v kni\u017Enici.",translation:"\u042F \u0432 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0435."},{sk:"park",ru:"\u043F\u0430\u0440\u043A",example:"Stretneme sa v parku.",translation:"\u0412\u0441\u0442\u0440\u0435\u0442\u0438\u043C\u0441\u044F \u0432 \u043F\u0430\u0440\u043A\u0435."},{sk:"m\xFAzeum",ru:"\u043C\u0443\u0437\u0435\u0439",example:"M\xFAzeum je otvoren\xE9.",translation:"\u041C\u0443\u0437\u0435\u0439 \u043E\u0442\u043A\u0440\u044B\u0442."},{sk:"most",ru:"\u043C\u043E\u0441\u0442",example:"Most je nad riekou.",translation:"\u041C\u043E\u0441\u0442 \u043D\u0430\u0434 \u0440\u0435\u043A\u043E\u0439."},{sk:"elektri\u010Dka",ru:"\u0442\u0440\u0430\u043C\u0432\u0430\u0439",example:"Cestujem elektri\u010Dkou.",translation:"\u042F \u0435\u0434\u0443 \u0442\u0440\u0430\u043C\u0432\u0430\u0435\u043C."},{sk:"bicykel",ru:"\u0432\u0435\u043B\u043E\u0441\u0438\u043F\u0435\u0434",example:"M\xE1m nov\xFD bicykel.",translation:"\u0423 \u043C\u0435\u043D\u044F \u043D\u043E\u0432\u044B\u0439 \u0432\u0435\u043B\u043E\u0441\u0438\u043F\u0435\u0434."},{sk:"spolu",ru:"\u0432\u043C\u0435\u0441\u0442\u0435",example:"Ideme spolu.",translation:"\u041C\u044B \u0438\u0434\u0451\u043C \u0432\u043C\u0435\u0441\u0442\u0435."},{sk:"stretnutie",ru:"\u0432\u0441\u0442\u0440\u0435\u0447\u0430",example:"Stretnutie je o tretej.",translation:"\u0412\u0441\u0442\u0440\u0435\u0447\u0430 \u0432 \u0442\u0440\u0438."},{sk:"rozpr\xE1va\u0165 sa",ru:"\u0440\u0430\u0437\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0442\u044C",example:"Rozpr\xE1vam sa s Ninou.",translation:"\u042F \u0440\u0430\u0437\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u044E \u0441 \u041D\u0438\u043D\u043E\u0439."},{sk:"pero",ru:"\u0440\u0443\u0447\u043A\u0430 \u0434\u043B\u044F \u043F\u0438\u0441\u044C\u043C\u0430",example:"P\xED\u0161em perom.",translation:"\u042F \u043F\u0438\u0448\u0443 \u0440\u0443\u0447\u043A\u043E\u0439."}],exercises:[{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443 \xAB\u0432 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0435\xBB.",options:["kni\u017Enici","kni\u017Enicu","kni\u017Enicou","kni\u017Enica"],answer:"kni\u017Enici",explanation:"V kni\u017Enici \u2014 \u043C\u0435\u0441\u0442\u043D\u044B\u0439 \u043F\u0430\u0434\u0435\u0436 \u0434\u043B\u044F \u043D\u0430\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F \u0432 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0435.",sk:"Nina je v _____."},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443 \u0438\u043C\u0435\u043D\u0438 \u043F\u043E\u0441\u043B\u0435 s.",options:["Ninou","Niny","Nine","Nina"],answer:"Ninou",explanation:"S k\xFDm? S Ninou \u2014 \u0442\u0432\u043E\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043F\u0430\u0434\u0435\u0436.",sk:"Rozpr\xE1vam sa s _____."},{type:"choice",prompt:"\u041A\u0430\u043A \u0441\u043A\u0430\u0437\u0430\u0442\u044C \xAB\u042F \u0435\u0434\u0443 \u043F\u043E\u0435\u0437\u0434\u043E\u043C\xBB?",options:["Cestujem vlakom.","Cestujem vlaku.","Cestujem z vlak.","Cestujem na vlakom."],answer:"Cestujem vlakom.",explanation:"\u0421\u0440\u0435\u0434\u0441\u0442\u0432\u043E \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u0432\u044B\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044F \u0442\u0432\u043E\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C \u0431\u0435\u0437 \u043F\u0440\u0435\u0434\u043B\u043E\u0433\u0430: vlakom."},{type:"typing",prompt:"\u0412\u0441\u0442\u0430\u0432\u044C \u0444\u043E\u0440\u043C\u0443 pero: P\xED\u0161em ___. (\xAB\u042F \u043F\u0438\u0448\u0443 \u0440\u0443\u0447\u043A\u043E\u0439\xBB.)",answer:"perom",explanation:"Pero \u2192 perom \u0432 \u0442\u0432\u043E\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E \u0447\u0438\u0441\u043B\u0430."},{type:"listening",prompt:"\u0413\u0434\u0435 \u043D\u0430\u0445\u043E\u0434\u044F\u0442\u0441\u044F \u0434\u0440\u0443\u0437\u044C\u044F?",options:["\u0412 \u043F\u0430\u0440\u043A\u0435","\u0412 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0435","\u0412 \u043C\u0443\u0437\u0435\u0435","\u041D\u0430 \u0432\u043E\u043A\u0437\u0430\u043B\u0435"],answer:"\u0412 \u043F\u0430\u0440\u043A\u0435",explanation:"Sme v parku \u2014 \u043C\u044B \u0432 \u043F\u0430\u0440\u043A\u0435.",audio:"Sme v parku. Rozpr\xE1vame sa o \u0161kole. Potom p\xF4jdeme do kni\u017Enice."},{type:"order",prompt:"\u0421\u043E\u0431\u0435\u0440\u0438 \xAB\u041C\u044B \u0440\u0430\u0437\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u043C \u043E \u0448\u043A\u043E\u043B\u0435\xBB, \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 Rozpr\xE1vame.",answer:["Rozpr\xE1vame","sa","o","\u0161kole."],explanation:"Rozpr\xE1va\u0165 sa \u2014 \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u043D\u044B\u0439 \u0433\u043B\u0430\u0433\u043E\u043B, o \u0161kole \u2014 \u043C\u0435\u0441\u0442\u043D\u044B\u0439 \u043F\u0430\u0434\u0435\u0436."},{type:"reading",prompt:"\u041D\u0430 \u0447\u0451\u043C \u043F\u0440\u0438\u0435\u0437\u0436\u0430\u0435\u0442 \u041D\u0438\u043D\u0430?",options:["\u041D\u0430 \u0442\u0440\u0430\u043C\u0432\u0430\u0435","\u041D\u0430 \u0432\u0435\u043B\u043E\u0441\u0438\u043F\u0435\u0434\u0435","\u041D\u0430 \u043F\u043E\u0435\u0437\u0434\u0435","\u041D\u0430 \u0430\u0432\u0442\u043E\u0431\u0443\u0441\u0435"],answer:"\u041D\u0430 \u0442\u0440\u0430\u043C\u0432\u0430\u0435",explanation:"Elektri\u010Dkou \u2014 \u0442\u0440\u0430\u043C\u0432\u0430\u0435\u043C, \u0442\u0432\u043E\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043F\u0430\u0434\u0435\u0436.",text:"Matej je v m\xFAzeu. Nina cestuje elektri\u010Dkou. Andrej ide pe\u0161o. V\u0161etci sa stretn\xFA pri m\xFAzeu o \u0161tvrtej."},{type:"choice",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u043F\u0435\u0440\u0435\u0432\u043E\u0434 \xAB\u0441 \u0434\u0440\u0443\u0433\u043E\u043C\xBB.",options:["s kamar\xE1tom","z kamar\xE1ta","do kamar\xE1ta","o kamar\xE1tovi"],answer:"s kamar\xE1tom",explanation:"\u041F\u0440\u0435\u0434\u043B\u043E\u0433 s + \u0442\u0432\u043E\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u0430."}]},{id:"a2-04",level:"A2",title:"\u0412\u0447\u0435\u0440\u0430 \u0431\u044B\u043B\u043E \u0438\u043D\u0430\u0447\u0435",location:"\u0424\u043E\u0442\u043E\u0441\u0442\u0443\u0434\u0438\u044F",scene:"\u041C\u0430\u0442\u0435\u0439 \u043F\u0440\u0438\u043D\u0451\u0441 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438 \u0432\u0447\u0435\u0440\u0430\u0448\u043D\u0435\u0439 \u043F\u0440\u043E\u0433\u0443\u043B\u043A\u0438. \u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438 \u0441\u043E\u0431\u044B\u0442\u0438\u044F \u0438 \u0441\u0440\u0430\u0432\u043D\u0438, \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u043B\u0438 \u043E\u043D \u0438 \u041D\u0438\u043D\u0430.",goal:"\u0420\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C \u043E \u043F\u0440\u043E\u0448\u043B\u043E\u043C \u0438 \u0441\u043E\u0433\u043B\u0430\u0441\u043E\u0432\u044B\u0432\u0430\u0442\u044C \u0444\u043E\u0440\u043C\u044B \u043F\u043E \u0440\u043E\u0434\u0443.",grammar:{title:"\u041F\u0440\u043E\u0448\u0435\u0434\u0448\u0435\u0435 \u0432\u0440\u0435\u043C\u044F: bol som \u0438 bola som",body:"\u041F\u0440\u043E\u0448\u0435\u0434\u0448\u0435\u0435 \u0432\u0440\u0435\u043C\u044F \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442\u0441\u044F \u0444\u043E\u0440\u043C\u043E\u0439 \u043D\u0430 -l \u0438 \u0432\u0441\u043F\u043E\u043C\u043E\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C \u0433\u043B\u0430\u0433\u043E\u043B\u043E\u043C \u0432 \u043F\u0435\u0440\u0432\u043E\u043C \u0438 \u0432\u0442\u043E\u0440\u043E\u043C \u043B\u0438\u0446\u0435: \u010D\xEDtal som, \u010D\xEDtala som, \u010D\xEDtal si. \u0424\u043E\u0440\u043C\u0430 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0440\u043E\u0434 \u0433\u043E\u0432\u043E\u0440\u044F\u0449\u0435\u0433\u043E: \u043C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441\u043A\u0430\u0436\u0435\u0442 bol som, \u0436\u0435\u043D\u0449\u0438\u043D\u0430 \u2014 bola som. \u0412 \u0442\u0440\u0435\u0442\u044C\u0435\u043C \u043B\u0438\u0446\u0435 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435 je \u043D\u0435 \u043D\u0443\u0436\u043D\u043E: Nina \u010D\xEDtala, Matej \u010D\xEDtal. \u0412\u043E \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u043C \u0447\u0438\u0441\u043B\u0435: \u010D\xEDtali sme, \u010D\xEDtali ste, oni \u010D\xEDtali. \u041D\u0435 \u0432\u0441\u0435 \u0433\u043B\u0430\u0433\u043E\u043B\u044B \u043E\u0431\u0440\u0430\u0437\u0443\u044E\u0442 \u043E\u0441\u043D\u043E\u0432\u0443 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u043E: vidie\u0165 \u2014 videl, pr\xEDs\u0165 \u2014 pri\u0161iel. \u041A\u043E\u0440\u043E\u0442\u043A\u043E\u0435 som \u043E\u0431\u044B\u0447\u043D\u043E \u0441\u0442\u043E\u0438\u0442 \u043F\u043E\u0441\u043B\u0435 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0441\u043C\u044B\u0441\u043B\u043E\u0432\u043E\u0433\u043E \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0430: V\u010Dera som \u010D\xEDtal. \u041F\u0440\u0438 \u043E\u0442\u0440\u0438\u0446\u0430\u043D\u0438\u0438 ne- \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043A \u0444\u043E\u0440\u043C\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F: ne\u010D\xEDtal som. \u0412\u044B\u0440\u0430\u0436\u0435\u043D\u0438\u044F v\u010Dera \u0438 minul\xFD t\xFD\u017Ede\u0148 \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442 \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0438\u0442\u044C \u043C\u043E\u043C\u0435\u043D\u0442 \u0432 \u043F\u0440\u043E\u0448\u043B\u043E\u043C.",examples:[{sk:"V\u010Dera som bol doma.",ru:"\u0412\u0447\u0435\u0440\u0430 \u044F \u0431\u044B\u043B \u0434\u043E\u043C\u0430."},{sk:"Nina bola v meste.",ru:"\u041D\u0438\u043D\u0430 \u0431\u044B\u043B\u0430 \u0432 \u0433\u043E\u0440\u043E\u0434\u0435."},{sk:"Matej pri\u0161iel ve\u010Der.",ru:"\u041C\u0430\u0442\u0435\u0439 \u043F\u0440\u0438\u0448\u0451\u043B \u0432\u0435\u0447\u0435\u0440\u043E\u043C."}]},words:[{sk:"v\u010Dera",ru:"\u0432\u0447\u0435\u0440\u0430",example:"V\u010Dera som \u010D\xEDtal.",translation:"\u0412\u0447\u0435\u0440\u0430 \u044F \u0447\u0438\u0442\u0430\u043B."},{sk:"predv\u010Derom",ru:"\u043F\u043E\u0437\u0430\u0432\u0447\u0435\u0440\u0430",example:"Predv\u010Derom sme cestovali.",translation:"\u041F\u043E\u0437\u0430\u0432\u0447\u0435\u0440\u0430 \u043C\u044B \u0435\u0437\u0434\u0438\u043B\u0438."},{sk:"minul\xFD",ru:"\u043F\u0440\u043E\u0448\u043B\u044B\u0439",example:"Minul\xFD t\xFD\u017Ede\u0148 som pracoval.",translation:"\u041D\u0430 \u043F\u0440\u043E\u0448\u043B\u043E\u0439 \u043D\u0435\u0434\u0435\u043B\u0435 \u044F \u0440\u0430\u0431\u043E\u0442\u0430\u043B."},{sk:"nav\u0161t\xEDvi\u0165",ru:"\u043F\u043E\u0441\u0435\u0442\u0438\u0442\u044C",example:"Nav\u0161t\xEDvili sme m\xFAzeum.",translation:"\u041C\u044B \u043F\u043E\u0441\u0435\u0442\u0438\u043B\u0438 \u043C\u0443\u0437\u0435\u0439."},{sk:"vidie\u0165",ru:"\u0432\u0438\u0434\u0435\u0442\u044C",example:"Videl som nov\xFD film.",translation:"\u042F \u0432\u0438\u0434\u0435\u043B \u043D\u043E\u0432\u044B\u0439 \u0444\u0438\u043B\u044C\u043C."},{sk:"stretn\xFA\u0165",ru:"\u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C",example:"Stretol som Ninu.",translation:"\u042F \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B \u041D\u0438\u043D\u0443."},{sk:"pr\xEDs\u0165",ru:"\u043F\u0440\u0438\u0439\u0442\u0438; \u043F\u0440\u0438\u0431\u044B\u0442\u044C",example:"Matej pri\u0161iel r\xE1no.",translation:"\u041C\u0430\u0442\u0435\u0439 \u043F\u0440\u0438\u0448\u0451\u043B \u0443\u0442\u0440\u043E\u043C."},{sk:"zosta\u0165",ru:"\u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F",example:"Nina zostala doma.",translation:"\u041D\u0438\u043D\u0430 \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u0434\u043E\u043C\u0430."},{sk:"film",ru:"\u0444\u0438\u043B\u044C\u043C",example:"Film bol zauj\xEDmav\xFD.",translation:"\u0424\u0438\u043B\u044C\u043C \u0431\u044B\u043B \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u043C."},{sk:"v\xFDlet",ru:"\u043F\u043E\u0435\u0437\u0434\u043A\u0430; \u044D\u043A\u0441\u043A\u0443\u0440\u0441\u0438\u044F",example:"V\xFDlet bol kr\xE1tky.",translation:"\u041F\u043E\u0435\u0437\u0434\u043A\u0430 \u0431\u044B\u043B\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0439."}],exercises:[{type:"cloze",prompt:"\u0410\u043D\u0434\u0440\u0435\u0439 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E \u0441\u0435\u0431\u0435 \u0432 \u043F\u0440\u043E\u0448\u043B\u043E\u043C. \u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443.",options:["bol","bola","boli","by\u0165"],answer:"bol",explanation:"\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u043E \u0441\u0435\u0431\u0435: bol som. \u041F\u043E\u0441\u043B\u0435 v\u010Dera \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0435 som \u0441\u0442\u043E\u0438\u0442 \u043F\u0435\u0440\u0435\u0434 bol.",sk:"V\u010Dera som _____ doma."},{type:"cloze",prompt:"\u041D\u0438\u043D\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E \u0441\u0435\u0431\u0435. \u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443.",options:["\u010D\xEDtala","\u010D\xEDtal","\u010D\xEDtali","\u010D\xEDta\u0165"],answer:"\u010D\xEDtala",explanation:"\u0416\u0435\u043D\u0441\u043A\u0430\u044F \u0444\u043E\u0440\u043C\u0430 \u043F\u0440\u043E\u0448\u0435\u0434\u0448\u0435\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u2014 \u010D\xEDtala.",sk:"V\u010Dera som _____ knihu, povedala Nina."},{type:"choice",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0435 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \xAB\u041C\u0430\u0442\u0435\u0439 \u0440\u0430\u0431\u043E\u0442\u0430\u043B\xBB.",options:["Matej pracoval.","Matej je pracoval.","Matej som pracoval.","Matej pracovala."],answer:"Matej pracoval.",explanation:"\u0412 \u0442\u0440\u0435\u0442\u044C\u0435\u043C \u043B\u0438\u0446\u0435 \u043F\u0440\u043E\u0448\u0435\u0434\u0448\u0435\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0432\u0441\u043F\u043E\u043C\u043E\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439 je \u043D\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F."},{type:"typing",prompt:"\u041D\u0430\u043F\u0438\u0448\u0438 \u043C\u0443\u0436\u0441\u043A\u0443\u044E \u0444\u043E\u0440\u043C\u0443 \u043F\u0440\u043E\u0448\u0435\u0434\u0448\u0435\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043E\u0442 vidie\u0165 (\u0431\u0435\u0437 som).",answer:"videl",explanation:"\u0423 vidie\u0165 \u043F\u0440\u043E\u0448\u0435\u0434\u0448\u0430\u044F \u0444\u043E\u0440\u043C\u0430 videl."},{type:"listening",prompt:"\u041A\u043E\u0433\u0434\u0430 \u041C\u0430\u0442\u0435\u0439 \u043F\u0440\u0438\u0448\u0451\u043B?",options:["\u0412\u0447\u0435\u0440\u0430 \u0432\u0435\u0447\u0435\u0440\u043E\u043C","\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0443\u0442\u0440\u043E\u043C","\u041F\u043E\u0437\u0430\u0432\u0447\u0435\u0440\u0430 \u0443\u0442\u0440\u043E\u043C","\u0417\u0430\u0432\u0442\u0440\u0430 \u0432\u0435\u0447\u0435\u0440\u043E\u043C"],answer:"\u0412\u0447\u0435\u0440\u0430 \u0432\u0435\u0447\u0435\u0440\u043E\u043C",explanation:"V\u010Dera ve\u010Der \u2014 \u0432\u0447\u0435\u0440\u0430 \u0432\u0435\u0447\u0435\u0440\u043E\u043C.",audio:"Matej pri\u0161iel v\u010Dera ve\u010Der. Nina pri\u0161la dnes r\xE1no."},{type:"order",prompt:"\u0421\u043E\u0431\u0435\u0440\u0438 \xAB\u0412\u0447\u0435\u0440\u0430 \u044F \u043F\u043E\u0441\u0435\u0442\u0438\u043B \u043C\u0443\u0437\u0435\u0439\xBB, \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 V\u010Dera.",answer:["V\u010Dera","som","nav\u0161t\xEDvil","m\xFAzeum."],explanation:"\u041F\u043E\u0441\u043B\u0435 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0430 V\u010Dera \u0441\u0442\u0430\u0432\u0438\u0442\u0441\u044F som, \u0437\u0430\u0442\u0435\u043C nav\u0161t\xEDvil.",acceptedOrders:[["V\u010Dera","som","m\xFAzeum","nav\u0161t\xEDvil."]]},{type:"reading",prompt:"\u041A\u0442\u043E \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u0434\u043E\u043C\u0430?",options:["\u041D\u0438\u043D\u0430","\u041C\u0430\u0442\u0435\u0439","\u0410\u043D\u0434\u0440\u0435\u0439","\u0421\u043E\u0441\u0435\u0434"],answer:"\u041D\u0438\u043D\u0430",explanation:"Nina zostala doma \u2014 \u041D\u0438\u043D\u0430 \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u0434\u043E\u043C\u0430.",text:"V\u010Dera bol Matej v kine. Andrej nav\u0161t\xEDvil m\xFAzeum. Nina zostala doma a \u010D\xEDtala knihu. Ve\u010Der si v\u0161etci telefonovali."},{type:"cloze",prompt:"\u041C\u044B \u0447\u0438\u0442\u0430\u043B\u0438. \u0412\u044B\u0431\u0435\u0440\u0438 \u0432\u0441\u043F\u043E\u043C\u043E\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u0433\u043B\u0430\u0433\u043E\u043B.",options:["sme","som","ste","s\xFA"],answer:"sme",explanation:"\u041F\u0435\u0440\u0432\u043E\u0435 \u043B\u0438\u0446\u043E \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E \u0447\u0438\u0441\u043B\u0430 \u0432 \u043F\u0440\u043E\u0448\u0435\u0434\u0448\u0435\u043C: \u010D\xEDtali sme.",sk:"V\u010Dera _____ \u010D\xEDtali."}]},{id:"a2-05",level:"A2",title:"\u041F\u043B\u0430\u043D\u044B \u043D\u0430 \u043D\u0435\u0434\u0435\u043B\u044E",location:"\u041A\u0430\u043B\u0435\u043D\u0434\u0430\u0440\u044C \u043A\u043B\u0443\u0431\u0430",scene:"\u041D\u0438\u043D\u0430 \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442 \u043A\u043E\u043C\u0430\u043D\u0434\u0443 \u0434\u043B\u044F \u0443\u0447\u0435\u0431\u043D\u043E\u0433\u043E \u043F\u0440\u043E\u0435\u043A\u0442\u0430. \u0420\u0430\u0441\u043F\u0438\u0448\u0438, \u0447\u0435\u043C \u0431\u0443\u0434\u0435\u0448\u044C \u0437\u0430\u043D\u0438\u043C\u0430\u0442\u044C\u0441\u044F \u0438 \u0447\u0442\u043E \u0443\u0441\u043F\u0435\u0435\u0448\u044C \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u044C.",goal:"\u0420\u0430\u0437\u043B\u0438\u0447\u0430\u0442\u044C \u0431\u0443\u0434\u0443\u0449\u0438\u0439 \u043F\u0440\u043E\u0446\u0435\u0441\u0441 \u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043D\u043D\u043E\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435.",grammar:{title:"\u0411\u0443\u0434\u0443\u0449\u0435\u0435 \u0432\u0440\u0435\u043C\u044F \u0438 \u0432\u0438\u0434 \u0433\u043B\u0430\u0433\u043E\u043B\u0430",body:"\u0423 \u043D\u0435\u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u044B\u0445 \u0433\u043B\u0430\u0433\u043E\u043B\u043E\u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u0435 \u0447\u0430\u0441\u0442\u043E \u0441\u0442\u0440\u043E\u0438\u0442\u0441\u044F \u0441 budem \u0438 \u0438\u043D\u0444\u0438\u043D\u0438\u0442\u0438\u0432\u043E\u043C: budem \u010D\xEDta\u0165 \u2014 \xAB\u0431\u0443\u0434\u0443 \u0447\u0438\u0442\u0430\u0442\u044C\xBB, budem pripravova\u0165 \u2014 \xAB\u0431\u0443\u0434\u0443 \u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C\xBB. \u0424\u043E\u0440\u043C\u044B \u0432\u0441\u043F\u043E\u043C\u043E\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u0433\u043B\u0430\u0433\u043E\u043B\u0430: budem, bude\u0161, bude, budeme, budete, bud\xFA. \u0421\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u044B\u0435 \u0433\u043B\u0430\u0433\u043E\u043B\u044B \u0432\u044B\u0440\u0430\u0436\u0430\u044E\u0442 \u0431\u0443\u0434\u0443\u0449\u0438\u0439 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u0441\u0432\u043E\u0435\u0439 \u043B\u0438\u0447\u043D\u043E\u0439 \u0444\u043E\u0440\u043C\u043E\u0439: pre\u010D\xEDtam \u2014 \xAB\u043F\u0440\u043E\u0447\u0438\u0442\u0430\u044E\xBB, priprav\xEDm \u2014 \xAB\u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043B\u044E\xBB, k\xFApim \u2014 \xAB\u043A\u0443\u043F\u043B\u044E\xBB. \u041E\u0431\u044B\u0447\u043D\u043E \u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0442\u044C budem \u043F\u0435\u0440\u0435\u0434 \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u044B\u043C \u0438\u043D\u0444\u0438\u043D\u0438\u0442\u0438\u0432\u043E\u043C. \u0421\u0440\u0430\u0432\u043D\u0438 Zajtra budem \u010D\xEDta\u0165 \u0438 Zajtra pre\u010D\xEDtam t\xFAto knihu: \u0432\u043E \u0432\u0442\u043E\u0440\u043E\u043C \u0441\u043B\u0443\u0447\u0430\u0435 \u0432\u0430\u0436\u0435\u043D \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043D\u043D\u044B\u0439 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442. \u0423 \xEDs\u0165 \u043E\u0441\u043E\u0431\u043E\u0435 \u0431\u0443\u0434\u0443\u0449\u0435\u0435: p\xF4jdem. \u0412\u0438\u0434 \u043B\u0443\u0447\u0448\u0435 \u0443\u0447\u0438\u0442\u044C \u043F\u0430\u0440\u0430\u043C\u0438: kupova\u0165 \u2014 k\xFApi\u0165, pripravova\u0165 \u2014 pripravi\u0165, \u010D\xEDta\u0165 \u2014 pre\u010D\xEDta\u0165.",examples:[{sk:"Zajtra budem \u010D\xEDta\u0165.",ru:"\u0417\u0430\u0432\u0442\u0440\u0430 \u044F \u0431\u0443\u0434\u0443 \u0447\u0438\u0442\u0430\u0442\u044C."},{sk:"Zajtra pre\u010D\xEDtam tento \u010Dl\xE1nok.",ru:"\u0417\u0430\u0432\u0442\u0440\u0430 \u044F \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u044E \u044D\u0442\u0443 \u0441\u0442\u0430\u0442\u044C\u044E."},{sk:"Ve\u010Der p\xF4jdem domov.",ru:"\u0412\u0435\u0447\u0435\u0440\u043E\u043C \u044F \u043F\u043E\u0439\u0434\u0443 \u0434\u043E\u043C\u043E\u0439."}]},words:[{sk:"bud\xFAci",ru:"\u0431\u0443\u0434\u0443\u0449\u0438\u0439; \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439",example:"Bud\xFAci t\xFD\u017Ede\u0148 m\xE1m \u010Das.",translation:"\u041D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u043D\u0435\u0434\u0435\u043B\u0435 \u0443 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u0432\u0440\u0435\u043C\u044F."},{sk:"t\xFD\u017Ede\u0148",ru:"\u043D\u0435\u0434\u0435\u043B\u044F",example:"T\xFD\u017Ede\u0148 m\xE1 sedem dn\xED.",translation:"\u0412 \u043D\u0435\u0434\u0435\u043B\u0435 \u0441\u0435\u043C\u044C \u0434\u043D\u0435\u0439."},{sk:"pl\xE1n",ru:"\u043F\u043B\u0430\u043D",example:"M\xE1m nov\xFD pl\xE1n.",translation:"\u0423 \u043C\u0435\u043D\u044F \u043D\u043E\u0432\u044B\u0439 \u043F\u043B\u0430\u043D."},{sk:"pripravi\u0165",ru:"\u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C",example:"Priprav\xEDm ve\u010Deru.",translation:"\u042F \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u044E \u0443\u0436\u0438\u043D."},{sk:"pripravova\u0165",ru:"\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C; \u043F\u043E\u0434\u0433\u043E\u0442\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C",example:"Pripravujem prezent\xE1ciu.",translation:"\u042F \u0433\u043E\u0442\u043E\u0432\u043B\u044E \u043F\u0440\u0435\u0437\u0435\u043D\u0442\u0430\u0446\u0438\u044E."},{sk:"k\xFApi\u0165",ru:"\u043A\u0443\u043F\u0438\u0442\u044C",example:"K\xFApim si knihu.",translation:"\u042F \u043A\u0443\u043F\u043B\u044E \u0441\u0435\u0431\u0435 \u043A\u043D\u0438\u0433\u0443."},{sk:"kupova\u0165",ru:"\u043F\u043E\u043A\u0443\u043F\u0430\u0442\u044C",example:"\u010Casto kupujem knihy.",translation:"\u042F \u0447\u0430\u0441\u0442\u043E \u043F\u043E\u043A\u0443\u043F\u0430\u044E \u043A\u043D\u0438\u0433\u0438."},{sk:"pre\u010D\xEDta\u0165",ru:"\u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C",example:"Pre\u010D\xEDtam tento text.",translation:"\u042F \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u044E \u044D\u0442\u043E\u0442 \u0442\u0435\u043A\u0441\u0442."},{sk:"dokon\u010Di\u0165",ru:"\u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u044C",example:"Zajtra dokon\u010D\xEDm \xFAlohu.",translation:"\u0417\u0430\u0432\u0442\u0440\u0430 \u044F \u0437\u0430\u043A\u043E\u043D\u0447\u0443 \u0437\u0430\u0434\u0430\u043D\u0438\u0435."},{sk:"nesk\xF4r",ru:"\u043F\u043E\u0437\u0436\u0435",example:"Pr\xEDdem nesk\xF4r.",translation:"\u042F \u043F\u0440\u0438\u0434\u0443 \u043F\u043E\u0437\u0436\u0435."}],exercises:[{type:"cloze",prompt:"\u0421\u043A\u0430\u0436\u0438 \xAB\u0417\u0430\u0432\u0442\u0440\u0430 \u044F \u0431\u0443\u0434\u0443 \u0447\u0438\u0442\u0430\u0442\u044C\xBB.",options:["budem","som","si","s\xFA"],answer:"budem",explanation:"\u0411\u0443\u0434\u0443\u0449\u0438\u0439 \u043F\u0440\u043E\u0446\u0435\u0441\u0441: budem + \u0438\u043D\u0444\u0438\u043D\u0438\u0442\u0438\u0432 \u010D\xEDta\u0165.",sk:"Zajtra _____ \u010D\xEDta\u0165."},{type:"choice",prompt:"\u041A\u0430\u043A\u043E\u0439 \u0432\u0430\u0440\u0438\u0430\u043D\u0442 \u043F\u043E\u0434\u0447\u0451\u0440\u043A\u0438\u0432\u0430\u0435\u0442 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435 \u0447\u0442\u0435\u043D\u0438\u044F?",options:["Pre\u010D\xEDtam knihu.","Budem \u010D\xEDta\u0165 knihu.","\u010C\xEDtam knihu.","R\xE1d \u010D\xEDtam knihy."],answer:"Pre\u010D\xEDtam knihu.",explanation:"Pre\u010D\xEDta\u0165 \u2014 \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u044B\u0439 \u0432\u0438\u0434: \u0440\u0435\u0447\u044C \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u043A\u043D\u0438\u0433\u0430 \u0431\u0443\u0434\u0435\u0442 \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043D\u0430."},{type:"cloze",prompt:"\u0421\u043A\u0430\u0436\u0438 \xAB\u041C\u044B \u0431\u0443\u0434\u0435\u043C \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C\xBB.",options:["budeme","budem","budete","bud\xFA"],answer:"budeme",explanation:"My budeme \u2014 \u043F\u0435\u0440\u0432\u043E\u0435 \u043B\u0438\u0446\u043E \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E \u0447\u0438\u0441\u043B\u0430.",sk:"Zajtra _____ pracova\u0165."},{type:"typing",prompt:"\u041D\u0430\u043F\u0438\u0448\u0438 \xAB\u044F \u043F\u043E\u0439\u0434\u0443\xBB \u043E\u0434\u043D\u0438\u043C \u0441\u043B\u043E\u0432\u0430\u0446\u043A\u0438\u043C \u0441\u043B\u043E\u0432\u043E\u043C.",answer:"p\xF4jdem",explanation:"\u0423 \xEDs\u0165 \u0431\u0443\u0434\u0443\u0449\u0435\u0435 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u043B\u0438\u0446\u0430 \u2014 p\xF4jdem."},{type:"listening",prompt:"\u0427\u0442\u043E \u041D\u0438\u043D\u0430 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442 \u0437\u0430\u0432\u0442\u0440\u0430?",options:["\u041F\u0440\u0435\u0437\u0435\u043D\u0442\u0430\u0446\u0438\u044E","\u041A\u043D\u0438\u0433\u0443","\u041F\u043E\u0435\u0437\u0434\u043A\u0443","\u0424\u0438\u043B\u044C\u043C"],answer:"\u041F\u0440\u0435\u0437\u0435\u043D\u0442\u0430\u0446\u0438\u044E",explanation:"Dokon\u010D\xEDm prezent\xE1ciu \u2014 \u0437\u0430\u043A\u043E\u043D\u0447\u0443 \u043F\u0440\u0435\u0437\u0435\u043D\u0442\u0430\u0446\u0438\u044E.",audio:"Dnes pripravujem prezent\xE1ciu. Zajtra ju dokon\u010D\xEDm."},{type:"order",prompt:"\u0421\u043E\u0431\u0435\u0440\u0438 \xAB\u041D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u043D\u0435\u0434\u0435\u043B\u0435 \u043C\u044B \u0431\u0443\u0434\u0435\u043C \u0443\u0447\u0438\u0442\u044C\u0441\u044F\xBB, \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 Bud\xFAci.",answer:["Bud\xFAci","t\xFD\u017Ede\u0148","budeme","\u0161tudova\u0165."],explanation:"Bud\xFAci t\xFD\u017Ede\u0148 \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u0432\u0440\u0435\u043C\u044F, budeme \u0161tudova\u0165 \u2014 \u0431\u0443\u0434\u0443\u0449\u0438\u0439 \u043F\u0440\u043E\u0446\u0435\u0441\u0441."},{type:"reading",prompt:"\u041A\u043E\u0433\u0434\u0430 \u041C\u0430\u0442\u0435\u0439 \u043A\u0443\u043F\u0438\u0442 \u0431\u0438\u043B\u0435\u0442?",options:["\u0417\u0430\u0432\u0442\u0440\u0430","\u0421\u0435\u0433\u043E\u0434\u043D\u044F","\u0412\u0447\u0435\u0440\u0430","\u041D\u0430 \u043F\u0440\u043E\u0448\u043B\u043E\u0439 \u043D\u0435\u0434\u0435\u043B\u0435"],answer:"\u0417\u0430\u0432\u0442\u0440\u0430",explanation:"\u0412 \u0442\u0435\u043A\u0441\u0442\u0435 Zajtra k\xFApim l\xEDstok.",text:"Dnes budem pracova\u0165 doma. Zajtra k\xFApim l\xEDstok a priprav\xEDm si kufor. V piatok p\xF4jdem vlakom do Trnavy. Matej."},{type:"choice",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0443\u044E \u0444\u043E\u0440\u043C\u0443 \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043E \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0430 \xAB\u042F \u043A\u0443\u043F\u043B\u044E \u043A\u043D\u0438\u0433\u0443\xBB.",options:["K\xFApim knihu.","Budem k\xFApi\u0165 knihu.","Som k\xFApim knihu.","K\xFApim budem knihu."],answer:"K\xFApim knihu.",explanation:"K\xFApi\u0165 \u2014 \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u044B\u0439 \u0433\u043B\u0430\u0433\u043E\u043B; \u0435\u0433\u043E \u043B\u0438\u0447\u043D\u0430\u044F \u0444\u043E\u0440\u043C\u0430 k\xFApim \u0443\u0436\u0435 \u0432\u044B\u0440\u0430\u0436\u0430\u0435\u0442 \u0431\u0443\u0434\u0443\u0449\u0435\u0435."}]},{id:"a2-06",level:"A2",title:"\u041A\u0430\u043A \u0442\u044B \u0441\u0435\u0431\u044F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0448\u044C?",location:"\u0417\u0430\u043F\u0438\u0441\u044C \u043D\u0430 \u043F\u0440\u0438\u0451\u043C",scene:"\u041D\u0438\u043D\u0430 \u0445\u043E\u0447\u0435\u0442 \u0437\u0430\u043F\u0438\u0441\u0430\u0442\u044C\u0441\u044F \u043D\u0430 \u043F\u0440\u0438\u0451\u043C \u0438 \u043F\u0440\u043E\u0441\u0438\u0442 \u043F\u043E\u043C\u043E\u0447\u044C \u0441 \u0444\u043E\u0440\u043C\u0443\u043B\u0438\u0440\u043E\u0432\u043A\u0430\u043C\u0438. \u0422\u0432\u043E\u044F \u0437\u0430\u0434\u0430\u0447\u0430 \u2014 \u043F\u043E\u043D\u044F\u0442\u044C \u0441\u0438\u043C\u043F\u0442\u043E\u043C\u044B \u0432 \u0434\u0438\u0430\u043B\u043E\u0433\u0435 \u0438 \u0432\u0440\u0435\u043C\u044F \u0437\u0430\u043F\u0438\u0441\u0438.",goal:"\u041E\u043F\u0438\u0441\u044B\u0432\u0430\u0442\u044C \u0441\u0430\u043C\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0435 \u0438 \u043F\u043E\u043D\u0438\u043C\u0430\u0442\u044C \u0437\u0430\u043F\u0438\u0441\u044C \u043D\u0430 \u043F\u0440\u0438\u0451\u043C \u0431\u0435\u0437 \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u0438\u0445 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0430\u0446\u0438\u0439.",grammar:{title:"\u0423 \u043C\u0435\u043D\u044F \u0431\u043E\u043B\u0438\u0442: bol\xED ma \u0438 \u0431\u043E\u043B\u0438\u0442 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0447\u0430\u0441\u0442\u0435\u0439 \u0442\u0435\u043B\u0430",body:"\u0414\u043B\u044F \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u044F \u0431\u043E\u043B\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F Bol\xED ma hlava \u2014 \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E \xAB\u0433\u043E\u043B\u043E\u0432\u0430 \u0431\u043E\u043B\u0438\u0442 \u0443 \u043C\u0435\u043D\u044F\xBB. Hlava \u0437\u0434\u0435\u0441\u044C \u043F\u043E\u0434\u043B\u0435\u0436\u0430\u0449\u0435\u0435 \u0432 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u043C \u0447\u0438\u0441\u043B\u0435, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 bol\xED. \u041F\u0440\u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430\u0445 \u043D\u0443\u0436\u0435\u043D \u0433\u043B\u0430\u0433\u043E\u043B \u0432\u043E \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u043C: Bolia ma nohy \u2014 \xAB\u0423 \u043C\u0435\u043D\u044F \u0431\u043E\u043B\u044F\u0442 \u043D\u043E\u0433\u0438\xBB. \u041A\u043E\u0440\u043E\u0442\u043A\u043E\u0435 ma \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \xAB\u043C\u0435\u043D\u044F\xBB \u0438 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u043A \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0443, \u0438\u0441\u043F\u044B\u0442\u044B\u0432\u0430\u044E\u0449\u0435\u043C\u0443 \u0431\u043E\u043B\u044C. \u0421\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0437\u0432\u0430\u0442\u044C \u0441 som: Som unaven\xFD \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043C\u0443\u0436\u0447\u0438\u043D\u0430, Som unaven\xE1 \u2014 \u0436\u0435\u043D\u0449\u0438\u043D\u0430. M\xE1m hor\xFA\u010Dku \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \xAB\u0423 \u043C\u0435\u043D\u044F \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430\xBB. \u0414\u043B\u044F \u0437\u0430\u043F\u0438\u0441\u0438 \u043F\u043E\u0434\u043E\u0439\u0434\u0451\u0442 Chcem sa objedna\u0165 \u0438\u043B\u0438 Chcel by som sa objedna\u0165. \u042D\u0442\u0430 \u043C\u0438\u0441\u0441\u0438\u044F \u0443\u0447\u0438\u0442 \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u044E \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438 \u0438 \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u044E \u043E\u0442\u0432\u0435\u0442\u0430; \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u043E \u043B\u0435\u0447\u0435\u043D\u0438\u0438 \u0432 \u043D\u0435\u0439 \u043D\u0435 \u0440\u0430\u0441\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442\u0441\u044F.",examples:[{sk:"Bol\xED ma hlava.",ru:"\u0423 \u043C\u0435\u043D\u044F \u0431\u043E\u043B\u0438\u0442 \u0433\u043E\u043B\u043E\u0432\u0430."},{sk:"Bolia ma nohy.",ru:"\u0423 \u043C\u0435\u043D\u044F \u0431\u043E\u043B\u044F\u0442 \u043D\u043E\u0433\u0438."},{sk:"Chcem sa objedna\u0165.",ru:"\u042F \u0445\u043E\u0447\u0443 \u0437\u0430\u043F\u0438\u0441\u0430\u0442\u044C\u0441\u044F \u043D\u0430 \u043F\u0440\u0438\u0451\u043C."}]},words:[{sk:"lek\xE1r",ru:"\u0432\u0440\u0430\u0447",example:"Lek\xE1r m\xE1 dnes slu\u017Ebu.",translation:"\u0423 \u0432\u0440\u0430\u0447\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0434\u0435\u0436\u0443\u0440\u0441\u0442\u0432\u043E."},{sk:"lek\xE1re\u0148",ru:"\u0430\u043F\u0442\u0435\u043A\u0430",example:"Lek\xE1re\u0148 je bl\xEDzko.",translation:"\u0410\u043F\u0442\u0435\u043A\u0430 \u0431\u043B\u0438\u0437\u043A\u043E."},{sk:"hlava",ru:"\u0433\u043E\u043B\u043E\u0432\u0430",example:"Bol\xED ma hlava.",translation:"\u0423 \u043C\u0435\u043D\u044F \u0431\u043E\u043B\u0438\u0442 \u0433\u043E\u043B\u043E\u0432\u0430."},{sk:"hrdlo",ru:"\u0433\u043E\u0440\u043B\u043E",example:"Bol\xED ma hrdlo.",translation:"\u0423 \u043C\u0435\u043D\u044F \u0431\u043E\u043B\u0438\u0442 \u0433\u043E\u0440\u043B\u043E."},{sk:"brucho",ru:"\u0436\u0438\u0432\u043E\u0442",example:"Bol\xED ma brucho.",translation:"\u0423 \u043C\u0435\u043D\u044F \u0431\u043E\u043B\u0438\u0442 \u0436\u0438\u0432\u043E\u0442."},{sk:"boles\u0165",ru:"\u0431\u043E\u043B\u044C",example:"T\xE1to boles\u0165 je siln\xE1.",translation:"\u042D\u0442\u0430 \u0431\u043E\u043B\u044C \u0441\u0438\u043B\u044C\u043D\u0430\u044F."},{sk:"hor\xFA\u010Dka",ru:"\u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u0430\u044F \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430; \u0436\u0430\u0440",example:"M\xE1m hor\xFA\u010Dku.",translation:"\u0423 \u043C\u0435\u043D\u044F \u0432\u044B\u0441\u043E\u043A\u0430\u044F \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430."},{sk:"unaven\xFD",ru:"\u0443\u0441\u0442\u0430\u0432\u0448\u0438\u0439",example:"Som unaven\xFD.",translation:"\u042F \u0443\u0441\u0442\u0430\u043B."},{sk:"objedna\u0165 sa",ru:"\u0437\u0430\u043F\u0438\u0441\u0430\u0442\u044C\u0441\u044F \u043D\u0430 \u043F\u0440\u0438\u0451\u043C",example:"Chcem sa objedna\u0165 k lek\xE1rovi.",translation:"\u042F \u0445\u043E\u0447\u0443 \u0437\u0430\u043F\u0438\u0441\u0430\u0442\u044C\u0441\u044F \u043A \u0432\u0440\u0430\u0447\u0443."},{sk:"term\xEDn",ru:"\u0434\u0430\u0442\u0430 \u0438 \u0432\u0440\u0435\u043C\u044F; \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044B\u0439 \u0441\u0440\u043E\u043A",example:"M\xE1m term\xEDn v pondelok.",translation:"\u0423 \u043C\u0435\u043D\u044F \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043E \u043D\u0430 \u043F\u043E\u043D\u0435\u0434\u0435\u043B\u044C\u043D\u0438\u043A."}],exercises:[{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443 \u0434\u043B\u044F \xAB\u0423 \u043C\u0435\u043D\u044F \u0431\u043E\u043B\u0438\u0442 \u0433\u043E\u043B\u043E\u0432\u0430\xBB.",options:["Bol\xED","Bolia","Bol\xEDm","Bolie\u0165"],answer:"Bol\xED",explanation:"Hlava \u2014 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435 \u0447\u0438\u0441\u043B\u043E, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 bol\xED.",sk:"_____ ma hlava."},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443 \u0434\u043B\u044F \xAB\u0423 \u043C\u0435\u043D\u044F \u0431\u043E\u043B\u044F\u0442 \u043D\u043E\u0433\u0438\xBB.",options:["Bolia","Bol\xED","Bol\xEDm","Bol\xED\u0161"],answer:"Bolia",explanation:"Nohy \u2014 \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435 \u0447\u0438\u0441\u043B\u043E: bolia.",sk:"_____ ma nohy."},{type:"choice",prompt:"\u041A\u0430\u043A \u0441\u043A\u0430\u0437\u0430\u0442\u044C \xAB\u042F \u0445\u043E\u0447\u0443 \u0437\u0430\u043F\u0438\u0441\u0430\u0442\u044C\u0441\u044F \u043D\u0430 \u043F\u0440\u0438\u0451\u043C\xBB?",options:["Chcem sa objedna\u0165.","Chcem objedna\u0165 ma.","Som term\xEDn.","Objedna\u0165 sa je boles\u0165."],answer:"Chcem sa objedna\u0165.",explanation:"Objedna\u0165 sa \u2014 \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u043D\u044B\u0439 \u0433\u043B\u0430\u0433\u043E\u043B: \u0437\u0430\u043F\u0438\u0441\u0430\u0442\u044C\u0441\u044F."},{type:"typing",prompt:"\u041D\u0438\u043D\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \xAB\u042F \u0443\u0441\u0442\u0430\u043B\u0430\xBB. \u0412\u0441\u0442\u0430\u0432\u044C \u043F\u0440\u0438\u043B\u0430\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435: Som ___.",answer:"unaven\xE1",explanation:"\u0412 \u0436\u0435\u043D\u0441\u043A\u043E\u043C \u0440\u043E\u0434\u0435: unaven\xE1, \u0441 \u0434\u043E\u043B\u0433\u043E\u0439 \xE1 \u0432 \u043A\u043E\u043D\u0446\u0435."},{type:"listening",prompt:"\u041D\u0430 \u043A\u0430\u043A\u043E\u0439 \u0434\u0435\u043D\u044C \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u043F\u0440\u0438\u0451\u043C?",options:["\u041D\u0430 \u043F\u043E\u043D\u0435\u0434\u0435\u043B\u044C\u043D\u0438\u043A","\u041D\u0430 \u0432\u0442\u043E\u0440\u043D\u0438\u043A","\u041D\u0430 \u043F\u044F\u0442\u043D\u0438\u0446\u0443","\u041D\u0430 \u0432\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u044C\u0435"],answer:"\u041D\u0430 \u043F\u043E\u043D\u0435\u0434\u0435\u043B\u044C\u043D\u0438\u043A",explanation:"V pondelok \u2014 \u0432 \u043F\u043E\u043D\u0435\u0434\u0435\u043B\u044C\u043D\u0438\u043A.",audio:"V\xE1\u0161 term\xEDn je v pondelok o deviatej."},{type:"order",prompt:"\u0421\u043E\u0431\u0435\u0440\u0438 \xAB\u0423 \u043C\u0435\u043D\u044F \u0431\u043E\u043B\u0438\u0442 \u0433\u043E\u0440\u043B\u043E\xBB, \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 Bol\xED.",answer:["Bol\xED","ma","hrdlo."],explanation:"Hrdlo \u2014 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435 \u0447\u0438\u0441\u043B\u043E, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 bol\xED; ma \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443 \u0431\u043E\u043B\u044C\u043D\u043E."},{type:"reading",prompt:"\u0427\u0442\u043E \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0438\u0442 \u041D\u0438\u043D\u0443 \u0441\u043E\u0433\u043B\u0430\u0441\u043D\u043E \u0442\u0435\u043A\u0441\u0442\u0443?",options:["\u0413\u043E\u0440\u043B\u043E \u0438 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430","\u0422\u043E\u043B\u044C\u043A\u043E \u0436\u0438\u0432\u043E\u0442","\u0422\u043E\u043B\u044C\u043A\u043E \u043D\u043E\u0433\u0438","\u041D\u0438\u0447\u0435\u0433\u043E, \u043E\u043D\u0430 \u043F\u0440\u0438\u0448\u043B\u0430 \u0437\u0430 \u0441\u043F\u0440\u0430\u0432\u043A\u043E\u0439"],answer:"\u0413\u043E\u0440\u043B\u043E \u0438 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430",explanation:"\u0412 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0438 \u0443\u043A\u0430\u0437\u0430\u043D\u044B bol\xED ma hrdlo \u0438 m\xE1m hor\xFA\u010Dku.",text:"Dobr\xFD de\u0148. Vol\xE1m sa Nina. Bol\xED ma hrdlo a m\xE1m hor\xFA\u010Dku. Chcem sa objedna\u0165 k lek\xE1rovi. M\xE1te dnes vo\u013En\xFD term\xEDn?"},{type:"choice",prompt:"\u0427\u0435\u043C \u043E\u0442\u043B\u0438\u0447\u0430\u044E\u0442\u0441\u044F lek\xE1r \u0438 lek\xE1re\u0148?",options:["\u0412\u0440\u0430\u0447 \u0438 \u0430\u043F\u0442\u0435\u043A\u0430","\u0410\u043F\u0442\u0435\u043A\u0430 \u0438 \u0431\u043E\u043B\u044C","\u0413\u043E\u043B\u043E\u0432\u0430 \u0438 \u0433\u043E\u0440\u043B\u043E","\u0412\u0440\u0430\u0447 \u0438 \u043F\u0430\u0446\u0438\u0435\u043D\u0442"],answer:"\u0412\u0440\u0430\u0447 \u0438 \u0430\u043F\u0442\u0435\u043A\u0430",explanation:"Lek\xE1r \u2014 \u0447\u0435\u043B\u043E\u0432\u0435\u043A, \u0432\u0440\u0430\u0447; lek\xE1re\u0148 \u2014 \u0430\u043F\u0442\u0435\u043A\u0430."}]},{id:"a2-07",level:"A2",title:"\u041F\u043E\u0435\u0437\u0434\u043A\u0430 \u0432 \u0422\u0440\u043D\u0430\u0432\u0443",location:"\u0416\u0435\u043B\u0435\u0437\u043D\u043E\u0434\u043E\u0440\u043E\u0436\u043D\u0430\u044F \u0441\u0442\u0430\u043D\u0446\u0438\u044F",scene:"\u041C\u0430\u0442\u0435\u0439 \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u043B \u0443\u0447\u0435\u0431\u043D\u0443\u044E \u043F\u043E\u0435\u0437\u0434\u043A\u0443 \u0432 \u0422\u0440\u043D\u0430\u0432\u0443. \u041E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u0435 \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u043E\u0441\u044C: \u043D\u0430\u0439\u0434\u0438 \u043F\u0443\u0442\u044C \u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u044C, \u043D\u0443\u0436\u0435\u043D \u043B\u0438 \u043F\u0435\u0440\u0435\u0441\u0430\u0434\u043E\u0447\u043D\u044B\u0439 \u043F\u043E\u0435\u0437\u0434.",goal:"\u041F\u043E\u043D\u0438\u043C\u0430\u0442\u044C \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u044F, \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0438, \u043F\u0435\u0440\u0435\u0441\u0430\u0434\u043A\u0438 \u0438 \u0432\u0438\u0434\u044B \u0431\u0438\u043B\u0435\u0442\u043E\u0432.",grammar:{title:"\u041D\u0443\u0436\u043D\u043E, \u043C\u043E\u0436\u043D\u043E, \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F: \u043C\u043E\u0434\u0430\u043B\u044C\u043D\u044B\u0435 \u0433\u043B\u0430\u0433\u043E\u043B\u044B",body:"\u041C\u043E\u0434\u0430\u043B\u044C\u043D\u044B\u0435 \u0433\u043B\u0430\u0433\u043E\u043B\u044B \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u044E\u0442\u0441\u044F \u0441 \u0438\u043D\u0444\u0438\u043D\u0438\u0442\u0438\u0432\u043E\u043C: mus\xEDm prestupova\u0165 \u2014 \xAB\u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u043F\u0435\u0440\u0435\u0441\u0430\u0436\u0438\u0432\u0430\u0442\u044C\u0441\u044F\xBB, m\xF4\u017Eem \xEDs\u0165 \u2014 \xAB\u044F \u043C\u043E\u0433\u0443 \u0438\u0434\u0442\u0438\xBB, chcem cestova\u0165 \u2014 \xAB\u044F \u0445\u043E\u0447\u0443 \u0435\u0445\u0430\u0442\u044C\xBB. Musie\u0165 \u0432\u044B\u0440\u0430\u0436\u0430\u0435\u0442 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u044C, m\xF4c\u0165 \u2014 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0438\u043B\u0438 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u0432 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0435\u043C \u043A\u043E\u043D\u0442\u0435\u043A\u0441\u0442\u0435. \u0424\u043E\u0440\u043C\u044B \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u043B\u0438\u0446\u0430 mus\xEDm \u0438 m\xF4\u017Eem \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0439 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E. \u041E\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435 nemus\xEDm \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \xAB\u043C\u043D\u0435 \u043D\u0435 \u043D\u0443\u0436\u043D\u043E\xBB, \u0430 \u043D\u0435 \u0437\u0430\u043F\u0440\u0435\u0442. \u0414\u043B\u044F \u0441\u0442\u0440\u043E\u0433\u043E\u0433\u043E \xAB\u043D\u0435\u043B\u044C\u0437\u044F\xBB \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F nesmiem. \u0412 \u043F\u043E\u0435\u0437\u0434\u043A\u0435 \u0440\u0430\u0437\u043B\u0438\u0447\u0430\u0439 priamy vlak (\xAB\u043F\u0440\u044F\u043C\u043E\u0439 \u043F\u043E\u0435\u0437\u0434\xBB) \u0438 vlak s prestupom (\xAB\u043F\u043E\u0435\u0437\u0434 \u0441 \u043F\u0435\u0440\u0435\u0441\u0430\u0434\u043A\u043E\u0439\xBB). Me\u0161kanie \u2014 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0430. \u0417\u0434\u0435\u0441\u044C \u043F\u0440\u0438\u0432\u0435\u0434\u0435\u043D\u044B \u0432\u044B\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u044B\u0435 \u0443\u0447\u0435\u0431\u043D\u044B\u0435 \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u044F: \u0438\u0445 \u0432\u0440\u0435\u043C\u044F \u0438 \u043D\u043E\u043C\u0435\u0440\u0430 \u043F\u0443\u0442\u0435\u0439 \u043D\u0435 \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u043C \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u0435\u043C.",examples:[{sk:"Mus\xEDm prestupova\u0165.",ru:"\u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u043F\u0435\u0440\u0435\u0441\u0430\u0436\u0438\u0432\u0430\u0442\u044C\u0441\u044F."},{sk:"Nemus\xEDte prestupova\u0165.",ru:"\u0412\u0430\u043C \u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u043F\u0435\u0440\u0435\u0441\u0430\u0436\u0438\u0432\u0430\u0442\u044C\u0441\u044F."},{sk:"Vlak m\xE1 me\u0161kanie.",ru:"\u041F\u043E\u0435\u0437\u0434 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044F."}]},words:[{sk:"n\xE1stupi\u0161te",ru:"\u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0430",example:"Vlak pr\xEDde na druh\xE9 n\xE1stupi\u0161te.",translation:"\u041F\u043E\u0435\u0437\u0434 \u043F\u0440\u0438\u0431\u0443\u0434\u0435\u0442 \u043D\u0430 \u0432\u0442\u043E\u0440\u0443\u044E \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0443."},{sk:"odchod",ru:"\u043E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435",example:"Odchod je o \xF4smej.",translation:"\u041E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0432 \u0432\u043E\u0441\u0435\u043C\u044C."},{sk:"pr\xEDchod",ru:"\u043F\u0440\u0438\u0431\u044B\u0442\u0438\u0435",example:"Pr\xEDchod je o deviatej.",translation:"\u041F\u0440\u0438\u0431\u044B\u0442\u0438\u0435 \u0432 \u0434\u0435\u0432\u044F\u0442\u044C."},{sk:"me\u0161kanie",ru:"\u043E\u043F\u043E\u0437\u0434\u0430\u043D\u0438\u0435; \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0430",example:"Vlak m\xE1 me\u0161kanie.",translation:"\u041F\u043E\u0435\u0437\u0434 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044F."},{sk:"prestupova\u0165",ru:"\u043F\u0435\u0440\u0435\u0441\u0430\u0436\u0438\u0432\u0430\u0442\u044C\u0441\u044F",example:"Mus\xEDm prestupova\u0165?",translation:"\u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u043F\u0435\u0440\u0435\u0441\u0430\u0436\u0438\u0432\u0430\u0442\u044C\u0441\u044F?"},{sk:"spiato\u010Dn\xFD",ru:"\u043E\u0431\u0440\u0430\u0442\u043D\u044B\u0439; \u0442\u0443\u0434\u0430 \u0438 \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u043E \u0431\u0438\u043B\u0435\u0442\u0435",example:"Pros\xEDm si spiato\u010Dn\xFD l\xEDstok.",translation:"\u041C\u043D\u0435 \u0431\u0438\u043B\u0435\u0442 \u0442\u0443\u0434\u0430 \u0438 \u043E\u0431\u0440\u0430\u0442\u043D\u043E, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430."},{sk:"priamy",ru:"\u043F\u0440\u044F\u043C\u043E\u0439",example:"Toto je priamy vlak.",translation:"\u042D\u0442\u043E \u043F\u0440\u044F\u043C\u043E\u0439 \u043F\u043E\u0435\u0437\u0434."},{sk:"spoj",ru:"\u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u043D\u044B\u0439 \u0440\u0435\u0439\u0441; \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435",example:"Tento spoj ide do Trnavy.",translation:"\u042D\u0442\u043E\u0442 \u0440\u0435\u0439\u0441 \u0438\u0434\u0451\u0442 \u0432 \u0422\u0440\u043D\u0430\u0432\u0443."},{sk:"cestovn\xFD poriadok",ru:"\u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u0435 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F",example:"\u010C\xEDtam cestovn\xFD poriadok.",translation:"\u042F \u0447\u0438\u0442\u0430\u044E \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u0435."},{sk:"cesta",ru:"\u043F\u0443\u0442\u044C; \u0434\u043E\u0440\u043E\u0433\u0430; \u043F\u043E\u0435\u0437\u0434\u043A\u0430",example:"Cesta bola kr\xE1tka.",translation:"\u041F\u043E\u0435\u0437\u0434\u043A\u0430 \u0431\u044B\u043B\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0439."}],exercises:[{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \xAB\u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E\xBB \u043F\u0435\u0440\u0435\u0434 \u0438\u043D\u0444\u0438\u043D\u0438\u0442\u0438\u0432\u043E\u043C.",options:["Mus\xEDm","Som","M\xE1m sa","Bud\xFA"],answer:"Mus\xEDm",explanation:"Mus\xEDm + \u0438\u043D\u0444\u0438\u043D\u0438\u0442\u0438\u0432 \u0432\u044B\u0440\u0430\u0436\u0430\u0435\u0442 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u044C.",sk:"_____ prestupova\u0165.",ru:"\u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u043F\u0435\u0440\u0435\u0441\u0430\u0436\u0438\u0432\u0430\u0442\u044C\u0441\u044F."},{type:"choice",prompt:"\u0427\u0442\u043E \u0437\u043D\u0430\u0447\u0438\u0442 Nemus\xEDte prestupova\u0165?",options:["\u0412\u0430\u043C \u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u043F\u0435\u0440\u0435\u0441\u0430\u0436\u0438\u0432\u0430\u0442\u044C\u0441\u044F.","\u0412\u0430\u043C \u0437\u0430\u043F\u0440\u0435\u0449\u0435\u043D\u043E \u043F\u0435\u0440\u0435\u0441\u0430\u0436\u0438\u0432\u0430\u0442\u044C\u0441\u044F.","\u0412\u044B \u0443\u0436\u0435 \u043F\u0435\u0440\u0435\u0441\u0435\u043B\u0438.","\u0412\u044B \u0434\u043E\u043B\u0436\u043D\u044B \u043F\u0435\u0440\u0435\u0441\u0435\u0441\u0442\u044C \u0434\u0432\u0430\u0436\u0434\u044B."],answer:"\u0412\u0430\u043C \u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u043F\u0435\u0440\u0435\u0441\u0430\u0436\u0438\u0432\u0430\u0442\u044C\u0441\u044F.",explanation:"Nemus\xEDte \u0441\u043D\u0438\u043C\u0430\u0435\u0442 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u044C; \u0437\u0430\u043F\u0440\u0435\u0442 \u0432\u044B\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044F \u0438\u043D\u0430\u0447\u0435."},{type:"choice",prompt:"\u041A\u0430\u043A\u043E\u0439 \u0431\u0438\u043B\u0435\u0442 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0434\u043B\u044F \u043F\u043E\u0435\u0437\u0434\u043A\u0438 \u0442\u0443\u0434\u0430 \u0438 \u043E\u0431\u0440\u0430\u0442\u043D\u043E?",options:["Spiato\u010Dn\xFD l\xEDstok","Priamy kufor","Nov\xE9 n\xE1stupi\u0161te","Mal\xFD cestovn\xFD poriadok"],answer:"Spiato\u010Dn\xFD l\xEDstok",explanation:"Spiato\u010Dn\xFD l\xEDstok \u2014 \u0431\u0438\u043B\u0435\u0442 \u0442\u0443\u0434\u0430 \u0438 \u043E\u0431\u0440\u0430\u0442\u043D\u043E."},{type:"typing",prompt:"\u041D\u0430\u043F\u0438\u0448\u0438 \u043F\u043E-\u0441\u043B\u043E\u0432\u0430\u0446\u043A\u0438 \xAB\u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0430\xBB \u043E\u0434\u043D\u0438\u043C \u0441\u043B\u043E\u0432\u043E\u043C.",answer:"me\u0161kanie",explanation:"Me\u0161kanie \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0443 \u0438\u043B\u0438 \u043E\u043F\u043E\u0437\u0434\u0430\u043D\u0438\u0435."},{type:"listening",prompt:"\u041D\u0430 \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u0438\u043D\u0443\u0442 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0443\u0447\u0435\u0431\u043D\u044B\u0439 \u043F\u043E\u0435\u0437\u0434?",options:["\u041D\u0430 \u0434\u0435\u0441\u044F\u0442\u044C","\u041D\u0430 \u043F\u044F\u0442\u044C","\u041D\u0430 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C","\u041D\u0430 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C"],answer:"\u041D\u0430 \u0434\u0435\u0441\u044F\u0442\u044C",explanation:"Desa\u0165 min\xFAt \u2014 \u0434\u0435\u0441\u044F\u0442\u044C \u043C\u0438\u043D\u0443\u0442. \u042D\u0442\u043E \u0432\u044B\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u043E\u0435 \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u0435.",audio:"Vlak do Trnavy m\xE1 me\u0161kanie desa\u0165 min\xFAt."},{type:"order",prompt:"\u0421\u043E\u0431\u0435\u0440\u0438 \xAB\u0412\u0430\u043C \u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u043F\u0435\u0440\u0435\u0441\u0430\u0436\u0438\u0432\u0430\u0442\u044C\u0441\u044F\xBB, \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 Nemus\xEDte.",answer:["Nemus\xEDte","prestupova\u0165."],explanation:"\u041F\u043E\u0441\u043B\u0435 \u043C\u043E\u0434\u0430\u043B\u044C\u043D\u043E\u0433\u043E nemus\xEDte \u0441\u0442\u0430\u0432\u0438\u0442\u0441\u044F \u0438\u043D\u0444\u0438\u043D\u0438\u0442\u0438\u0432 prestupova\u0165."},{type:"reading",prompt:"\u041D\u0443\u0436\u043D\u0430 \u043B\u0438 \u043F\u0435\u0440\u0435\u0441\u0430\u0434\u043A\u0430 \u043D\u0430 \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u043C \u0440\u0435\u0439\u0441\u0435?",options:["\u041D\u0435\u0442, \u043F\u043E\u0435\u0437\u0434 \u043F\u0440\u044F\u043C\u043E\u0439","\u0414\u0430, \u043E\u0434\u043D\u0430","\u0414\u0430, \u0434\u0432\u0435","\u0412 \u0442\u0435\u043A\u0441\u0442\u0435 \u0441\u043A\u0430\u0437\u0430\u043D\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u043E \u0446\u0435\u043D\u0435"],answer:"\u041D\u0435\u0442, \u043F\u043E\u0435\u0437\u0434 \u043F\u0440\u044F\u043C\u043E\u0439",explanation:"Priamy vlak \u0438 Nemus\xEDte prestupova\u0165 \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u043D\u0430 \u043F\u043E\u0435\u0437\u0434\u043A\u0443 \u0431\u0435\u0437 \u043F\u0435\u0440\u0435\u0441\u0430\u0434\u043A\u0438.",text:"Cvi\u010Dn\xE9 ozn\xE1menie: Priamy vlak do Trnavy odch\xE1dza o deviatej z druh\xE9ho n\xE1stupi\u0161\u0165a. Nemus\xEDte prestupova\u0165. Vlak dnes nem\xE1 me\u0161kanie."},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \xAB\u044F \u043C\u043E\u0433\u0443\xBB.",options:["m\xF4\u017Eem","m\xF4\u017Ee\u0161","m\xF4\u017Eu","m\xF4c\u0165"],answer:"m\xF4\u017Eem",explanation:"\u041F\u0435\u0440\u0432\u043E\u0435 \u043B\u0438\u0446\u043E m\xF4c\u0165 \u2014 m\xF4\u017Eem.",sk:"_____ \xEDs\u0165 t\xFDmto vlakom?"}]},{id:"a2-08",level:"A2",title:"\u041D\u043E\u0432\u0430\u044F \u043A\u043E\u043C\u043D\u0430\u0442\u0430",location:"\u0421\u0442\u0443\u0434\u0435\u043D\u0447\u0435\u0441\u043A\u0438\u0439 \u0434\u043E\u043C",scene:"\u041D\u0438\u043D\u0430 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u0443\u044E \u043A\u043E\u043C\u043D\u0430\u0442\u0443. \u0421\u043F\u0440\u043E\u0441\u0438 \u043E\u0431 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u0438 \u0432\u0435\u0436\u043B\u0438\u0432\u043E \u043F\u043E\u043F\u0440\u043E\u0441\u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u043A\u0443\u0445\u043D\u044E.",goal:"\u041E\u0431\u0441\u0443\u0436\u0434\u0430\u0442\u044C \u0436\u0438\u043B\u044C\u0451 \u0438 \u0441\u0442\u0440\u043E\u0438\u0442\u044C \u0432\u0435\u0436\u043B\u0438\u0432\u044B\u0435 \u043F\u0440\u043E\u0441\u044C\u0431\u044B.",grammar:{title:"\u0412\u0435\u0436\u043B\u0438\u0432\u043E\u0435 \u0443\u0441\u043B\u043E\u0432\u043D\u043E\u0435 \u043D\u0430\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u0435",body:"\u0414\u043B\u044F \u043C\u044F\u0433\u043A\u043E\u0439 \u043F\u0440\u043E\u0441\u044C\u0431\u044B \u0443\u043F\u043E\u0442\u0440\u0435\u0431\u043B\u044F\u0435\u0442\u0441\u044F \u0443\u0441\u043B\u043E\u0432\u043D\u0430\u044F \u0444\u043E\u0440\u043C\u0430: Chcel by som (\xAB\u044F \u0445\u043E\u0442\u0435\u043B \u0431\u044B\xBB, \u043C\u0443\u0436\u0447\u0438\u043D\u0430), Chcela by som (\xAB\u044F \u0445\u043E\u0442\u0435\u043B\u0430 \u0431\u044B\xBB, \u0436\u0435\u043D\u0449\u0438\u043D\u0430). \u0412\u0435\u0436\u043B\u0438\u0432\u044B\u0439 \u0432\u043E\u043F\u0440\u043E\u0441 \u043A \u0441\u043E\u0431\u0435\u0441\u0435\u0434\u043D\u0438\u043A\u0443: Mohli by ste mi uk\xE1za\u0165 izbu? \u2014 \xAB\u041D\u0435 \u043C\u043E\u0433\u043B\u0438 \u0431\u044B \u0432\u044B \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u043C\u043D\u0435 \u043A\u043E\u043C\u043D\u0430\u0442\u0443?\xBB. \u0427\u0430\u0441\u0442\u0438\u0446\u0430 by \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u0430; \u0432 \u043F\u0435\u0440\u0432\u043E\u043C \u043B\u0438\u0446\u0435 \u0440\u044F\u0434\u043E\u043C \u0441\u0442\u043E\u0438\u0442 som, \u0432\u043E \u0432\u0442\u043E\u0440\u043E\u043C \u2014 si \u0438\u043B\u0438 \u0432\u0435\u0436\u043B\u0438\u0432\u043E\u0435 ste. \u0421\u0440\u0430\u0432\u043D\u0438 \u043F\u0440\u044F\u043C\u043E\u0435 Chcem izbu \u0438 \u0431\u043E\u043B\u0435\u0435 \u043C\u044F\u0433\u043A\u043E\u0435 Chcel by som izbu. \u041F\u0440\u0438\u043B\u0430\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u0441\u043E\u0433\u043B\u0430\u0441\u0443\u0435\u0442\u0441\u044F \u0441 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C: tich\xE1 izba, tich\xFD byt. \u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u0430\u0440\u0435\u043D\u0434\u044B \u0432 \u0438\u0433\u0440\u0435 \u0432\u044B\u043C\u044B\u0448\u043B\u0435\u043D\u044B. \u0417\u0430\u0434\u0430\u0447\u0430 \u0443\u0440\u043E\u043A\u0430 \u2014 \u043F\u043E\u043D\u044F\u0442\u044C \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435 \u0438 \u0437\u0430\u0434\u0430\u0442\u044C \u0432\u043E\u043F\u0440\u043E\u0441, \u0430 \u043D\u0435 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0435 \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u043D\u044B\u0435 \u0443\u0441\u043B\u043E\u0432\u0438\u044F.",examples:[{sk:"Chcel by som tich\xFA izbu.",ru:"\u042F \u0445\u043E\u0442\u0435\u043B \u0431\u044B \u0442\u0438\u0445\u0443\u044E \u043A\u043E\u043C\u043D\u0430\u0442\u0443."},{sk:"Mohli by ste mi uk\xE1za\u0165 kuchy\u0148u?",ru:"\u041D\u0435 \u043C\u043E\u0433\u043B\u0438 \u0431\u044B \u0432\u044B \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u043C\u043D\u0435 \u043A\u0443\u0445\u043D\u044E?"},{sk:"Chcela by som sa op\xFDta\u0165.",ru:"\u042F \u0445\u043E\u0442\u0435\u043B\u0430 \u0431\u044B \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C."}]},words:[{sk:"pren\xE1jom",ru:"\u0430\u0440\u0435\u043D\u0434\u0430; \u0441\u0434\u0430\u0447\u0430 \u0432 \u0430\u0440\u0435\u043D\u0434\u0443",example:"T\xE1to izba je na pren\xE1jom.",translation:"\u042D\u0442\u0430 \u043A\u043E\u043C\u043D\u0430\u0442\u0430 \u0441\u0434\u0430\u0451\u0442\u0441\u044F \u0432 \u0430\u0440\u0435\u043D\u0434\u0443."},{sk:"n\xE1jom",ru:"\u0430\u0440\u0435\u043D\u0434\u043D\u0430\u044F \u043F\u043B\u0430\u0442\u0430; \u0430\u0440\u0435\u043D\u0434\u0430",example:"Ko\u013Eko je mesa\u010Dn\xFD n\xE1jom?",translation:"\u041A\u0430\u043A\u043E\u0432\u0430 \u043C\u0435\u0441\u044F\u0447\u043D\u0430\u044F \u0430\u0440\u0435\u043D\u0434\u043D\u0430\u044F \u043F\u043B\u0430\u0442\u0430?"},{sk:"spolub\xFDvaj\xFAci",ru:"\u0441\u043E\u0441\u0435\u0434 \u043F\u043E \u0436\u0438\u043B\u044C\u044E",example:"M\xF4j spolub\xFDvaj\xFAci je Matej.",translation:"\u041C\u043E\u0439 \u0441\u043E\u0441\u0435\u0434 \u043F\u043E \u0436\u0438\u043B\u044C\u044E \u2014 \u041C\u0430\u0442\u0435\u0439."},{sk:"zmluva",ru:"\u0434\u043E\u0433\u043E\u0432\u043E\u0440",example:"Chcem si pre\u010D\xEDta\u0165 zmluvu.",translation:"\u042F \u0445\u043E\u0447\u0443 \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C \u0434\u043E\u0433\u043E\u0432\u043E\u0440."},{sk:"kuchy\u0148a",ru:"\u043A\u0443\u0445\u043D\u044F",example:"Kuchy\u0148a je spolo\u010Dn\xE1.",translation:"\u041A\u0443\u0445\u043D\u044F \u043E\u0431\u0449\u0430\u044F."},{sk:"k\xFApe\u013E\u0148a",ru:"\u0432\u0430\u043D\u043D\u0430\u044F \u043A\u043E\u043C\u043D\u0430\u0442\u0430",example:"K\xFApe\u013E\u0148a je ved\u013Ea izby.",translation:"\u0412\u0430\u043D\u043D\u0430\u044F \u0440\u044F\u0434\u043E\u043C \u0441 \u043A\u043E\u043C\u043D\u0430\u0442\u043E\u0439."},{sk:"okno",ru:"\u043E\u043A\u043D\u043E",example:"Okno je otvoren\xE9.",translation:"\u041E\u043A\u043D\u043E \u043E\u0442\u043A\u0440\u044B\u0442\u043E."},{sk:"poste\u013E",ru:"\u043A\u0440\u043E\u0432\u0430\u0442\u044C",example:"Poste\u013E je pri okne.",translation:"\u041A\u0440\u043E\u0432\u0430\u0442\u044C \u0443 \u043E\u043A\u043D\u0430."},{sk:"tich\xFD",ru:"\u0442\u0438\u0445\u0438\u0439",example:"Byt je tich\xFD.",translation:"\u041A\u0432\u0430\u0440\u0442\u0438\u0440\u0430 \u0442\u0438\u0445\u0430\u044F."},{sk:"m\xF4c\u0165",ru:"\u043C\u043E\u0447\u044C; \u0438\u043C\u0435\u0442\u044C \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C",example:"M\xF4\u017Eem si pozrie\u0165 izbu?",translation:"\u041C\u043E\u0436\u043D\u043E \u043C\u043D\u0435 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043A\u043E\u043C\u043D\u0430\u0442\u0443?"}],exercises:[{type:"cloze",prompt:"\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0432\u0435\u0436\u043B\u0438\u0432\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \xAB\u042F \u0445\u043E\u0442\u0435\u043B \u0431\u044B\xBB.",options:["som","si","ste","je"],answer:"som",explanation:"\u0424\u043E\u0440\u043C\u0430 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u043B\u0438\u0446\u0430 \u2014 chcel by som.",sk:"Chcel by _____ tich\xFA izbu."},{type:"cloze",prompt:"\u041D\u0438\u043D\u0430 \u0432\u0435\u0436\u043B\u0438\u0432\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E \u0441\u0435\u0431\u0435. \u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443.",options:["Chcela","Chcel","Chceli","Chcie\u0165"],answer:"Chcela",explanation:"\u0414\u043B\u044F \u0436\u0435\u043D\u0449\u0438\u043D\u044B: chcela by som.",sk:"_____ by som si pozrie\u0165 izbu, povedala Nina."},{type:"choice",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0432\u0435\u0436\u043B\u0438\u0432\u0443\u044E \u043F\u0440\u043E\u0441\u044C\u0431\u0443 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u043A\u0443\u0445\u043D\u044E.",options:["Mohli by ste mi uk\xE1za\u0165 kuchy\u0148u?","Uk\xE1za\u0165 kuchy\u0148a je som?","Chcel by je kuchy\u0148a?","M\xF4\u017Eete by som kuchy\u0148u?"],answer:"Mohli by ste mi uk\xE1za\u0165 kuchy\u0148u?",explanation:"Mohli by ste \u2014 \u0432\u0435\u0436\u043B\u0438\u0432\u043E\u0435 \u0443\u0441\u043B\u043E\u0432\u043D\u043E\u0435 \u043D\u0430\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u0435; kuchy\u0148u \u2014 \u0432\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439."},{type:"typing",prompt:"\u0412\u0441\u0442\u0430\u0432\u044C \u0444\u043E\u0440\u043C\u0443 \u043F\u0440\u0438\u043B\u0430\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \xAB\u0442\u0438\u0445\u0430\u044F\xBB: ___ izba.",answer:"tich\xE1",explanation:"Izba \u2014 \u0436\u0435\u043D\u0441\u043A\u0438\u0439 \u0440\u043E\u0434, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 tich\xE1."},{type:"listening",prompt:"\u041A\u0430\u043A\u0430\u044F \u0447\u0430\u0441\u0442\u044C \u0436\u0438\u043B\u044C\u044F \u043E\u0431\u0449\u0430\u044F?",options:["\u041A\u0443\u0445\u043D\u044F","\u041A\u043E\u043C\u043D\u0430\u0442\u0430","\u041A\u0440\u043E\u0432\u0430\u0442\u044C","\u041E\u043A\u043D\u043E"],answer:"\u041A\u0443\u0445\u043D\u044F",explanation:"Spolo\u010Dn\xE1 kuchy\u0148a \u2014 \u043E\u0431\u0449\u0430\u044F \u043A\u0443\u0445\u043D\u044F.",audio:"Izba je mal\xE1 a tich\xE1. Kuchy\u0148a je spolo\u010Dn\xE1. Poste\u013E je pri okne."},{type:"order",prompt:"\u0421\u043E\u0431\u0435\u0440\u0438 \xAB\u042F \u0445\u043E\u0442\u0435\u043B \u0431\u044B \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043A\u043E\u043C\u043D\u0430\u0442\u0443\xBB, \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 Chcel.",answer:["Chcel","by","som","si","pozrie\u0165","izbu."],explanation:"\u0412\u0435\u0436\u043B\u0438\u0432\u0430\u044F \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F chcel by som; pozrie\u0165 si \u2014 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0434\u043B\u044F \u0441\u0435\u0431\u044F.",acceptedOrders:[["Chcel","by","som","si","izbu","pozrie\u0165."]]},{type:"reading",prompt:"\u0413\u0434\u0435 \u0441\u0442\u043E\u0438\u0442 \u043A\u0440\u043E\u0432\u0430\u0442\u044C?",options:["\u0423 \u043E\u043A\u043D\u0430","\u041D\u0430 \u043A\u0443\u0445\u043D\u0435","\u0420\u044F\u0434\u043E\u043C \u0441 \u0432\u0445\u043E\u0434\u043D\u043E\u0439 \u0434\u0432\u0435\u0440\u044C\u044E","\u0412 \u0432\u0430\u043D\u043D\u043E\u0439"],answer:"\u0423 \u043E\u043A\u043D\u0430",explanation:"Pri okne \u2014 \u0443 \u043E\u043A\u043D\u0430.",text:"Ponuka v hre: Tich\xE1 izba m\xE1 poste\u013E pri okne a mal\xFD st\xF4l. Kuchy\u0148a a k\xFApe\u013E\u0148a s\xFA spolo\u010Dn\xE9. V byte b\xFDva aj Matej."},{type:"choice",prompt:"\u0427\u0435\u043C \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F Chcel by som \u043E\u0442 Chcem?",options:["\u041F\u0435\u0440\u0432\u043E\u0435 \u0437\u0432\u0443\u0447\u0438\u0442 \u043A\u0430\u043A \u0431\u043E\u043B\u0435\u0435 \u043C\u044F\u0433\u043A\u043E\u0435 \u043F\u043E\u0436\u0435\u043B\u0430\u043D\u0438\u0435","\u041F\u0435\u0440\u0432\u043E\u0435 \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u043F\u0440\u043E\u0448\u043B\u043E\u0435 \u0441\u043E\u0431\u044B\u0442\u0438\u0435","\u041F\u0435\u0440\u0432\u043E\u0435 \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u0437\u0430\u043F\u0440\u0435\u0442","\u041F\u0435\u0440\u0432\u043E\u0435 \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u043A \u0433\u0440\u0443\u043F\u043F\u0435"],answer:"\u041F\u0435\u0440\u0432\u043E\u0435 \u0437\u0432\u0443\u0447\u0438\u0442 \u043A\u0430\u043A \u0431\u043E\u043B\u0435\u0435 \u043C\u044F\u0433\u043A\u043E\u0435 \u043F\u043E\u0436\u0435\u043B\u0430\u043D\u0438\u0435",explanation:"Chcel by som \u2014 \xAB\u044F \u0445\u043E\u0442\u0435\u043B \u0431\u044B\xBB, chcem \u2014 \xAB\u044F \u0445\u043E\u0447\u0443\xBB."}]},{id:"a2-09",level:"A2",title:"\u041F\u0435\u0440\u0432\u044B\u0439 \u0434\u0435\u043D\u044C \u043D\u0430 \u0444\u0430\u043A\u0443\u043B\u044C\u0442\u0435\u0442\u0435",location:"\u0423\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442",scene:"\u041C\u0430\u0442\u0435\u0439 \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442 \u0442\u0435\u0431\u044F \u043F\u043E \u0443\u0447\u0435\u0431\u043D\u043E\u043C\u0443 \u043A\u043E\u0440\u043F\u0443\u0441\u0443. \u041D\u0430\u0439\u0434\u0438 \u0441\u0435\u043C\u0438\u043D\u0430\u0440, \u0440\u0430\u0437\u0431\u0435\u0440\u0438\u0441\u044C \u0432 \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u0438 \u0438 \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0438 \u043E \u0441\u0432\u043E\u0438\u0445 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0430\u0445.",goal:"\u041F\u043E\u043D\u0438\u043C\u0430\u0442\u044C \u0443\u0447\u0435\u0431\u043D\u044B\u0435 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u044F \u0438 \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0442\u044C \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u0441 ktor\xFD \u0438 preto\u017Ee.",grammar:{title:"\u041A\u043E\u0442\u043E\u0440\u044B\u0439 \u0438 \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E",body:"\u0427\u0442\u043E\u0431\u044B \u0441\u0432\u044F\u0437\u0430\u0442\u044C \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043E\u0431 \u043E\u0434\u043D\u043E\u043C \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0435, \u0443\u043F\u043E\u0442\u0440\u0435\u0431\u043B\u044F\u044E\u0442 \u043A\u043E\u0442\u043E\u0440\u044B\u0439: predmet, ktor\xFD ma zauj\xEDma \u2014 \xAB\u043F\u0440\u0435\u0434\u043C\u0435\u0442, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043C\u0435\u043D\u044F \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0443\u0435\u0442\xBB. \u0424\u043E\u0440\u043C\u0430 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u0440\u043E\u0434\u0430 \u0438 \u0440\u043E\u043B\u0438 \u0432\u043D\u0443\u0442\u0440\u0438 \u043F\u0440\u0438\u0434\u0430\u0442\u043E\u0447\u043D\u043E\u0433\u043E: kniha, ktor\xE1 je na stole; mesto, ktor\xE9 pozn\xE1m. \u041F\u043E\u043A\u0430 \u043F\u043E\u0442\u0440\u0435\u043D\u0438\u0440\u0443\u0439 \u0444\u043E\u0440\u043C\u044B \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432 \u0440\u043E\u043B\u0438 \u043F\u043E\u0434\u043B\u0435\u0436\u0430\u0449\u0435\u0433\u043E \u0438 \u043F\u0440\u043E\u0441\u0442\u044B\u0435 \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0435 \u043F\u0440\u0438\u043C\u0435\u0440\u044B. \u041F\u0440\u0438\u0447\u0438\u043D\u0443 \u0432\u0432\u043E\u0434\u0438\u0442 preto\u017Ee \u2014 \xAB\u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E\xBB: \u0160tudujem sloven\u010Dinu, preto\u017Ee chcem \u0161tudova\u0165 na Slovensku. \u041F\u0435\u0440\u0435\u0434 \u0442\u0430\u043A\u0438\u043C \u043F\u0440\u0438\u0434\u0430\u0442\u043E\u0447\u043D\u044B\u043C \u0441\u0442\u0430\u0432\u0438\u0442\u0441\u044F \u0437\u0430\u043F\u044F\u0442\u0430\u044F. Predn\xE1\u0161ka \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u043B\u0435\u043A\u0446\u0438\u044E, semin\xE1r \u2014 \u0441\u0435\u043C\u0438\u043D\u0430\u0440, rozvrh \u2014 \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u0435 \u0437\u0430\u043D\u044F\u0442\u0438\u0439. \u0421\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u044F \u043E\u0431 \u0443\u0447\u0435\u0431\u043D\u044B\u0445 \u0434\u043D\u044F\u0445 \u0432 \u0438\u0433\u0440\u0435 \u0432\u044B\u043C\u044B\u0448\u043B\u0435\u043D\u044B; \u043E\u043D\u0438 \u043D\u0443\u0436\u043D\u044B \u0434\u043B\u044F \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0438 \u0447\u0442\u0435\u043D\u0438\u044F, \u0430 \u043D\u0435 \u0434\u043B\u044F \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u044F \u043F\u0440\u0430\u0432\u0438\u043B \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u043E\u0433\u043E \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430.",examples:[{sk:"To je predmet, ktor\xFD ma zauj\xEDma.",ru:"\u042D\u0442\u043E \u043F\u0440\u0435\u0434\u043C\u0435\u0442, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043C\u0435\u043D\u044F \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0443\u0435\u0442."},{sk:"To je fakulta, ktor\xE1 je v centre.",ru:"\u042D\u0442\u043E \u0444\u0430\u043A\u0443\u043B\u044C\u0442\u0435\u0442, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0432 \u0446\u0435\u043D\u0442\u0440\u0435."},{sk:"\u0160tudujem, preto\u017Ee chcem rozumie\u0165.",ru:"\u042F \u0443\u0447\u0443\u0441\u044C, \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0445\u043E\u0447\u0443 \u043F\u043E\u043D\u0438\u043C\u0430\u0442\u044C."}]},words:[{sk:"fakulta",ru:"\u0444\u0430\u043A\u0443\u043B\u044C\u0442\u0435\u0442",example:"Fakulta je v centre.",translation:"\u0424\u0430\u043A\u0443\u043B\u044C\u0442\u0435\u0442 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0432 \u0446\u0435\u043D\u0442\u0440\u0435."},{sk:"univerzita",ru:"\u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442",example:"Univerzita m\xE1 kni\u017Enicu.",translation:"\u0423 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430 \u0435\u0441\u0442\u044C \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0430."},{sk:"predn\xE1\u0161ka",ru:"\u043B\u0435\u043A\u0446\u0438\u044F",example:"Predn\xE1\u0161ka sa za\u010D\xEDna o desiatej.",translation:"\u041B\u0435\u043A\u0446\u0438\u044F \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u0432 \u0434\u0435\u0441\u044F\u0442\u044C."},{sk:"semin\xE1r",ru:"\u0441\u0435\u043C\u0438\u043D\u0430\u0440",example:"Dnes m\xE1me semin\xE1r.",translation:"\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0443 \u043D\u0430\u0441 \u0441\u0435\u043C\u0438\u043D\u0430\u0440."},{sk:"sk\xFA\u0161ka",ru:"\u044D\u043A\u0437\u0430\u043C\u0435\u043D",example:"Sk\xFA\u0161ka bude v piatok.",translation:"\u042D\u043A\u0437\u0430\u043C\u0435\u043D \u0431\u0443\u0434\u0435\u0442 \u0432 \u043F\u044F\u0442\u043D\u0438\u0446\u0443."},{sk:"rozvrh",ru:"\u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u0435 \u0437\u0430\u043D\u044F\u0442\u0438\u0439",example:"Pozer\xE1m sa na rozvrh.",translation:"\u042F \u0441\u043C\u043E\u0442\u0440\u044E \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u0435."},{sk:"prihl\xE1\u0161ka",ru:"\u0437\u0430\u044F\u0432\u043B\u0435\u043D\u0438\u0435 \u043D\u0430 \u043F\u043E\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u0435; \u0437\u0430\u044F\u0432\u043A\u0430",example:"Vypl\u0148ujem prihl\xE1\u0161ku.",translation:"\u042F \u0437\u0430\u043F\u043E\u043B\u043D\u044F\u044E \u0437\u0430\u044F\u0432\u043B\u0435\u043D\u0438\u0435."},{sk:"predmet",ru:"\u0443\u0447\u0435\u0431\u043D\u044B\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442",example:"Tento predmet je zauj\xEDmav\xFD.",translation:"\u042D\u0442\u043E\u0442 \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0439."},{sk:"pozn\xE1mka",ru:"\u0437\u0430\u043C\u0435\u0442\u043A\u0430",example:"P\xED\u0161em si pozn\xE1mky.",translation:"\u042F \u0434\u0435\u043B\u0430\u044E \u0437\u0430\u043C\u0435\u0442\u043A\u0438."},{sk:"politol\xF3gia",ru:"\u043F\u043E\u043B\u0438\u0442\u043E\u043B\u043E\u0433\u0438\u044F",example:"Zauj\xEDma ma politol\xF3gia.",translation:"\u041C\u0435\u043D\u044F \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0443\u0435\u0442 \u043F\u043E\u043B\u0438\u0442\u043E\u043B\u043E\u0433\u0438\u044F."}],exercises:[{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043A \u0441\u043B\u043E\u0432\u0443 predmet.",options:["ktor\xFD","ktor\xE1","ktor\xE9","ktor\xED"],answer:"ktor\xFD",explanation:"Predmet \u2014 \u043C\u0443\u0436\u0441\u043A\u043E\u0439 \u0440\u043E\u0434; \u0432 \u043F\u0440\u0438\u0434\u0430\u0442\u043E\u0447\u043D\u043E\u043C \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u2014 \u043F\u043E\u0434\u043B\u0435\u0436\u0430\u0449\u0435\u0435.",sk:"To je predmet, _____ ma zauj\xEDma."},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043A \u0441\u043B\u043E\u0432\u0443 fakulta.",options:["ktor\xE1","ktor\xFD","ktor\xE9","ktor\xED"],answer:"ktor\xE1",explanation:"Fakulta \u2014 \u0436\u0435\u043D\u0441\u043A\u0438\u0439 \u0440\u043E\u0434: ktor\xE1.",sk:"To je fakulta, _____ je v centre."},{type:"choice",prompt:"\u041A\u0430\u043A\u043E\u0435 \u0441\u043B\u043E\u0432\u043E \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \xAB\u043B\u0435\u043A\u0446\u0438\u044F\xBB?",options:["predn\xE1\u0161ka","prestup","pren\xE1jom","pr\xEDchod"],answer:"predn\xE1\u0161ka",explanation:"Predn\xE1\u0161ka \u2014 \u043B\u0435\u043A\u0446\u0438\u044F. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u0441\u043B\u043E\u0432\u0430 \u043E\u0442\u043D\u043E\u0441\u044F\u0442\u0441\u044F \u043A \u0434\u0440\u0443\u0433\u0438\u043C \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044F\u043C."},{type:"typing",prompt:"\u041D\u0430\u043F\u0438\u0448\u0438 \u043F\u043E-\u0441\u043B\u043E\u0432\u0430\u0446\u043A\u0438 \xAB\u043F\u043E\u043B\u0438\u0442\u043E\u043B\u043E\u0433\u0438\u044F\xBB.",answer:"politol\xF3gia",explanation:"Politol\xF3gia \u043F\u0438\u0448\u0435\u0442\u0441\u044F \u0441 \u0434\u043E\u043B\u0433\u043E\u0439 \xF3."},{type:"listening",prompt:"\u0412\u043E \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u043B\u0435\u043A\u0446\u0438\u044F?",options:["\u0412 \u0434\u0435\u0441\u044F\u0442\u044C","\u0412 \u0434\u0435\u0432\u044F\u0442\u044C","\u0412 \u0442\u0440\u0438","\u0412 \u0447\u0435\u0442\u044B\u0440\u0435"],answer:"\u0412 \u0434\u0435\u0441\u044F\u0442\u044C",explanation:"O desiatej \u2014 \u0432 \u0434\u0435\u0441\u044F\u0442\u044C. \u042D\u0442\u043E \u0443\u0447\u0435\u0431\u043D\u043E\u0435 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435.",audio:"Predn\xE1\u0161ka sa za\u010D\xEDna o desiatej. Semin\xE1r bude popoludn\xED."},{type:"order",prompt:"\u0421\u043E\u0431\u0435\u0440\u0438 \xAB\u041C\u0435\u043D\u044F \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0443\u0435\u0442 \u043F\u043E\u043B\u0438\u0442\u043E\u043B\u043E\u0433\u0438\u044F\xBB, \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 Zauj\xEDma.",answer:["Zauj\xEDma","ma","politol\xF3gia."],explanation:"\u0412 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438 zauj\xEDma ma \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0443\u044E\u0449\u0435\u0439 \u0442\u0435\u043C\u044B \u2014 \u043F\u043E\u0434\u043B\u0435\u0436\u0430\u0449\u0435\u0435."},{type:"reading",prompt:"\u041F\u043E\u0447\u0435\u043C\u0443 \u041D\u0438\u043D\u0430 \u0443\u0447\u0438\u0442 \u0441\u043B\u043E\u0432\u0430\u0446\u043A\u0438\u0439?",options:["\u0425\u043E\u0447\u0435\u0442 \u0443\u0447\u0438\u0442\u044C\u0441\u044F \u0432 \u0421\u043B\u043E\u0432\u0430\u043A\u0438\u0438","\u0425\u043E\u0447\u0435\u0442 \u043A\u0443\u043F\u0438\u0442\u044C \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0443","\u0413\u043E\u0442\u043E\u0432\u0438\u0442\u0441\u044F \u043A \u043F\u043E\u0435\u0437\u0434\u043A\u0435 \u0432 \u041F\u043E\u043B\u044C\u0448\u0443","\u0423\u0436\u0435 \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0451\u0442 \u0441\u043B\u043E\u0432\u0430\u0446\u043A\u0438\u0439"],answer:"\u0425\u043E\u0447\u0435\u0442 \u0443\u0447\u0438\u0442\u044C\u0441\u044F \u0432 \u0421\u043B\u043E\u0432\u0430\u043A\u0438\u0438",explanation:"\u041F\u0440\u0438\u0447\u0438\u043D\u0430 \u0443\u043A\u0430\u0437\u0430\u043D\u0430 \u043F\u043E\u0441\u043B\u0435 preto\u017Ee.",text:"Nina sa u\u010D\xED po slovensky, preto\u017Ee chce \u0161tudova\u0165 na Slovensku. Zauj\xEDma ju politol\xF3gia. Dnes si \u010D\xEDta rozvrh a pripravuje si pozn\xE1mky."},{type:"cloze",prompt:"\u0412\u0441\u0442\u0430\u0432\u044C \u0441\u043E\u044E\u0437 \xAB\u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E\xBB.",options:["preto\u017Ee","potom","kde","ko\u013Eko"],answer:"preto\u017Ee",explanation:"Preto\u017Ee \u0432\u0432\u043E\u0434\u0438\u0442 \u043F\u0440\u0438\u0447\u0438\u043D\u0443.",sk:"U\u010D\xEDm sa po slovensky, _____ chcem rozumie\u0165 predn\xE1\u0161kam."}]},{id:"a2-10",level:"A2",title:"\u041F\u0438\u0441\u044C\u043C\u043E \u041D\u0438\u043D\u0435",location:"\u041F\u043E\u0447\u0442\u043E\u0432\u044B\u0439 \u044F\u0449\u0438\u043A \u043A\u043B\u0443\u0431\u0430",scene:"\u0422\u044B \u043E\u0441\u0432\u043E\u0438\u043B\u0441\u044F \u0432 \u0433\u043E\u0440\u043E\u0434\u0435. \u041D\u0430\u043F\u0438\u0448\u0438 \u041D\u0438\u043D\u0435 \u043E \u0441\u0432\u043E\u0435\u0439 \u043D\u0435\u0434\u0435\u043B\u0435 \u0438 \u043F\u0440\u0438\u0433\u043B\u0430\u0441\u0438 \u0435\u0451 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C\u0441\u044F \u043F\u043E\u0441\u043B\u0435 \u0437\u0430\u043D\u044F\u0442\u0438\u0439.",goal:"\u0421\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C \u0441\u0432\u044F\u0437\u043D\u043E\u0435 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435 \u043E \u043F\u0440\u043E\u0448\u043B\u043E\u043C, \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u043C \u0438 \u043F\u043B\u0430\u043D\u0430\u0445.",grammar:{title:"\u0421\u0432\u044F\u0437\u043D\u044B\u0439 \u0440\u0430\u0441\u0441\u043A\u0430\u0437: \u0441\u043D\u0430\u0447\u0430\u043B\u0430, \u043F\u043E\u0442\u043E\u043C, \u043F\u043E\u044D\u0442\u043E\u043C\u0443",body:"\u0427\u0442\u043E\u0431\u044B \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435 \u0431\u044B\u043B\u043E \u043F\u043E\u043D\u044F\u0442\u043D\u044B\u043C, \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0430\u0439 \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u0441\u043E\u0431\u044B\u0442\u0438\u0439 \u0441\u043B\u043E\u0432\u0430\u043C\u0438 najprv (\xAB\u0441\u043D\u0430\u0447\u0430\u043B\u0430\xBB), potom (\xAB\u043F\u043E\u0442\u043E\u043C\xBB), nakoniec (\xAB\u043D\u0430\u043A\u043E\u043D\u0435\u0446, \u0432 \u043A\u043E\u043D\u0446\u0435\xBB). \u041F\u0440\u0438\u0447\u0438\u043D\u0443 \u0432\u0432\u043E\u0434\u0438\u0442 preto\u017Ee, \u0430 \u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0435 \u2014 preto: Nem\xE1m \u010Das, preto\u017Ee pracujem (\xAB\u041D\u0435\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438, \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u044E\xBB); Pracujem, preto nem\xE1m \u010Das (\xAB\u0420\u0430\u0431\u043E\u0442\u0430\u044E, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043D\u0435\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438\xBB). \u0421\u043B\u0435\u0434\u0438 \u0437\u0430 \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u043C\u0438 \u0444\u043E\u0440\u043C\u0430\u043C\u0438: \u0432\u0447\u0435\u0440\u0430 bol som, \u0441\u0435\u0433\u043E\u0434\u043D\u044F som, \u0437\u0430\u0432\u0442\u0440\u0430 budem. \u0412 \u0434\u0440\u0443\u0436\u0435\u0441\u043A\u043E\u043C \u043F\u0438\u0441\u044C\u043C\u0435 \u043D\u0430\u0447\u043D\u0438 \u0441 Ahoj, Nina! \u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0438 \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435\u043C \u0438\u043B\u0438 \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u043C. Te\u0161\xEDm sa na stretnutie \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \xAB\u042F \u0441 \u0440\u0430\u0434\u043E\u0441\u0442\u044C\u044E \u0436\u0434\u0443 \u0432\u0441\u0442\u0440\u0435\u0447\u0438\xBB. \u0417\u0434\u0435\u0441\u044C \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0439 \u044F\u0441\u043D\u043E\u0441\u0442\u044C \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u044F \u0438 \u0441\u0432\u044F\u0437\u043D\u043E\u0441\u0442\u044C; \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u043F\u043E \u043E\u0431\u0440\u0430\u0437\u0446\u0443 \u043D\u0435 \u0437\u0430\u043C\u0435\u043D\u044F\u0435\u0442 \u043E\u0446\u0435\u043D\u043A\u0438 \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u044F.",examples:[{sk:"Najprv \u0161tudujem, potom pracujem.",ru:"\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u044F \u0443\u0447\u0443\u0441\u044C, \u043F\u043E\u0442\u043E\u043C \u0440\u0430\u0431\u043E\u0442\u0430\u044E."},{sk:"Pracujem, preto nem\xE1m \u010Das.",ru:"\u042F \u0440\u0430\u0431\u043E\u0442\u0430\u044E, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0443 \u043C\u0435\u043D\u044F \u043D\u0435\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438."},{sk:"Te\u0161\xEDm sa na stretnutie.",ru:"\u0421 \u0440\u0430\u0434\u043E\u0441\u0442\u044C\u044E \u0436\u0434\u0443 \u0432\u0441\u0442\u0440\u0435\u0447\u0438."}]},words:[{sk:"spr\xE1va",ru:"\u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435",example:"P\xED\u0161em Nine spr\xE1vu.",translation:"\u042F \u043F\u0438\u0448\u0443 \u041D\u0438\u043D\u0435 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435."},{sk:"list",ru:"\u043F\u0438\u0441\u044C\u043C\u043E",example:"Posielam kamar\xE1tovi list.",translation:"\u042F \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u044E \u0434\u0440\u0443\u0433\u0443 \u043F\u0438\u0441\u044C\u043C\u043E."},{sk:"pozvanie",ru:"\u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435",example:"\u010Eakujem za pozvanie.",translation:"\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0437\u0430 \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435."},{sk:"vysvetli\u0165",ru:"\u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C",example:"M\xF4\u017Eete mi to vysvetli\u0165?",translation:"\u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u043C\u043D\u0435 \u044D\u0442\u043E \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C?"},{sk:"preto\u017Ee",ru:"\u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E",example:"Som doma, preto\u017Ee \u0161tudujem.",translation:"\u042F \u0434\u043E\u043C\u0430, \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0443\u0447\u0443\u0441\u044C."},{sk:"preto",ru:"\u043F\u043E\u044D\u0442\u043E\u043C\u0443",example:"\u0160tudujem, preto nem\xE1m \u010Das.",translation:"\u042F \u0443\u0447\u0443\u0441\u044C, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0443 \u043C\u0435\u043D\u044F \u043D\u0435\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438."},{sk:"najprv",ru:"\u0441\u043D\u0430\u0447\u0430\u043B\u0430",example:"Najprv si pre\u010D\xEDtam text.",translation:"\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u044F \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u044E \u0442\u0435\u043A\u0441\u0442."},{sk:"potom",ru:"\u043F\u043E\u0442\u043E\u043C",example:"Potom nap\xED\u0161em spr\xE1vu.",translation:"\u041F\u043E\u0442\u043E\u043C \u044F \u043D\u0430\u043F\u0438\u0448\u0443 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435."},{sk:"nakoniec",ru:"\u043D\u0430\u043A\u043E\u043D\u0435\u0446; \u0432 \u043A\u043E\u043D\u0446\u0435",example:"Nakoniec p\xF4jdeme domov.",translation:"\u0412 \u043A\u043E\u043D\u0446\u0435 \u043C\u044B \u043F\u043E\u0439\u0434\u0451\u043C \u0434\u043E\u043C\u043E\u0439."},{sk:"te\u0161i\u0165 sa",ru:"\u0440\u0430\u0434\u043E\u0432\u0430\u0442\u044C\u0441\u044F; \u0441 \u0440\u0430\u0434\u043E\u0441\u0442\u044C\u044E \u0436\u0434\u0430\u0442\u044C",example:"Te\u0161\xEDm sa na stretnutie.",translation:"\u0421 \u0440\u0430\u0434\u043E\u0441\u0442\u044C\u044E \u0436\u0434\u0443 \u0432\u0441\u0442\u0440\u0435\u0447\u0438."}],exercises:[{type:"cloze",prompt:"\u0412\u0441\u0442\u0430\u0432\u044C \xAB\u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E\xBB \u0434\u043B\u044F \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u044F \u043F\u0440\u0438\u0447\u0438\u043D\u044B.",options:["preto\u017Ee","preto","potom","najprv"],answer:"preto\u017Ee",explanation:"\u041F\u043E\u0441\u043B\u0435 preto\u017Ee \u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u043F\u0440\u0438\u0447\u0438\u043D\u0430.",sk:"Dnes nem\xE1m \u010Das, _____ pracujem."},{type:"cloze",prompt:"\u0412\u0441\u0442\u0430\u0432\u044C \xAB\u043F\u043E\u044D\u0442\u043E\u043C\u0443\xBB \u043F\u0435\u0440\u0435\u0434 \u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0435\u043C.",options:["preto","preto\u017Ee","kde","ktor\xFD"],answer:"preto",explanation:"Pracujem \u2014 \u043F\u0440\u0438\u0447\u0438\u043D\u0430; nem\xE1m \u010Das \u2014 \u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0435.",sk:"Dnes pracujem, _____ nem\xE1m \u010Das."},{type:"choice",prompt:"\u041A\u0430\u043A\u043E\u0435 \u0441\u043B\u043E\u0432\u043E \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u043F\u0435\u0440\u0432\u044B\u0439 \u0448\u0430\u0433?",options:["najprv","nakoniec","v\u010Dera","nesk\xF4r"],answer:"najprv",explanation:"Najprv \u2014 \u0441\u043D\u0430\u0447\u0430\u043B\u0430; nakoniec \u2014 \u0432 \u043A\u043E\u043D\u0446\u0435."},{type:"typing",prompt:"\u041D\u0430\u043F\u0438\u0448\u0438 \u043F\u043E-\u0441\u043B\u043E\u0432\u0430\u0446\u043A\u0438 \xAB\u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435\xBB \u043E\u0434\u043D\u0438\u043C \u0441\u043B\u043E\u0432\u043E\u043C.",answer:"pozvanie",explanation:"\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C \u0437\u0430 \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435: \u010Eakujem za pozvanie."},{type:"listening",prompt:"\u0427\u0442\u043E \u0433\u043E\u0432\u043E\u0440\u044F\u0449\u0438\u0439 \u0441\u0434\u0435\u043B\u0430\u0435\u0442 \u043F\u043E\u0441\u043B\u0435 \u0447\u0442\u0435\u043D\u0438\u044F?",options:["\u041D\u0430\u043F\u0438\u0448\u0435\u0442 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435","\u041F\u043E\u0439\u0434\u0451\u0442 \u0441\u043F\u0430\u0442\u044C","\u041A\u0443\u043F\u0438\u0442 \u0431\u0438\u043B\u0435\u0442","\u041F\u043E\u0437\u0432\u043E\u043D\u0438\u0442 \u0432\u0440\u0430\u0447\u0443"],answer:"\u041D\u0430\u043F\u0438\u0448\u0435\u0442 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435",explanation:"Potom nap\xED\u0161em spr\xE1vu \u2014 \u043F\u043E\u0442\u043E\u043C \u043D\u0430\u043F\u0438\u0448\u0443 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435.",audio:"Najprv si pre\u010D\xEDtam text. Potom nap\xED\u0161em spr\xE1vu. Nakoniec p\xF4jdem domov."},{type:"order",prompt:"\u0421\u043E\u0431\u0435\u0440\u0438 \xAB\u0421 \u0440\u0430\u0434\u043E\u0441\u0442\u044C\u044E \u0436\u0434\u0443 \u0432\u0441\u0442\u0440\u0435\u0447\u0438\xBB, \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 Te\u0161\xEDm.",answer:["Te\u0161\xEDm","sa","na","stretnutie."],explanation:"Te\u0161i\u0165 sa na + \u0432\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u0432\u044B\u0440\u0430\u0436\u0430\u0435\u0442 \u0440\u0430\u0434\u043E\u0441\u0442\u043D\u043E\u0435 \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u0435."},{type:"reading",prompt:"\u041A\u043E\u0433\u0434\u0430 \u0410\u043D\u0434\u0440\u0435\u0439 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C\u0441\u044F?",options:["\u0417\u0430\u0432\u0442\u0440\u0430 \u0432\u0435\u0447\u0435\u0440\u043E\u043C","\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0443\u0442\u0440\u043E\u043C","\u0412\u0447\u0435\u0440\u0430 \u043F\u043E\u0441\u043B\u0435 \u0437\u0430\u043D\u044F\u0442\u0438\u0439","\u041D\u0430 \u043F\u0440\u043E\u0448\u043B\u043E\u0439 \u043D\u0435\u0434\u0435\u043B\u0435"],answer:"\u0417\u0430\u0432\u0442\u0440\u0430 \u0432\u0435\u0447\u0435\u0440\u043E\u043C",explanation:"Stretneme sa zajtra ve\u010Der? \u2014 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C\u0441\u044F \u0437\u0430\u0432\u0442\u0440\u0430 \u0432\u0435\u0447\u0435\u0440\u043E\u043C.",text:"Ahoj, Nina! V\u010Dera som bol v kni\u017Enici. Dnes pripravujem \xFAlohu, preto nem\xE1m \u010Das. Zajtra budem vo\u013En\xFD. Stretneme sa zajtra ve\u010Der v kaviarni? Te\u0161\xEDm sa na stretnutie. Andrej."},{type:"writing",prompt:"\u041D\u0430\u043F\u0438\u0448\u0438 \u041D\u0438\u043D\u0435 \u0434\u0440\u0443\u0436\u0435\u0441\u043A\u043E\u0435 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435 \u043F\u043E-\u0441\u043B\u043E\u0432\u0430\u0446\u043A\u0438: \u0447\u0442\u043E \u0442\u044B \u0434\u0435\u043B\u0430\u043B \u0432\u0447\u0435\u0440\u0430, \u0447\u0435\u043C \u0437\u0430\u043D\u044F\u0442 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0438 \u043A\u043E\u0433\u0434\u0430 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0448\u044C \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C\u0441\u044F. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u0445\u043E\u0442\u044F \u0431\u044B \u043E\u0434\u0438\u043D \u0441\u043E\u044E\u0437 \u043F\u0440\u0438\u0447\u0438\u043D\u044B \u0438\u043B\u0438 \u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u044F. \u041E\u0431\u044A\u0451\u043C: 45\u201370 \u0441\u043B\u043E\u0432.",minWords:45,answer:"",model:"Ahoj, Nina! V\u010Dera som bol v kni\u017Enici a \u010D\xEDtal som knihu o Slovensku. Potom som i\u0161iel domov. Dnes sa u\u010D\xEDm po slovensky, preto\u017Ee chcem lep\u0161ie rozumie\u0165 na univerzite. Zajtra budem ma\u0165 vo\u013En\xFD ve\u010Der. Chcel by som \u0165a pozva\u0165 na \u010Daj. Stretneme sa o \u0161iestej v kaviarni? Te\u0161\xEDm sa na stretnutie. Andrej.",checklist:["\u0415\u0441\u0442\u044C \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435 \u0438 \u043F\u043E\u043D\u044F\u0442\u043D\u044B\u0439 \u0430\u0434\u0440\u0435\u0441\u0430\u0442.","\u0415\u0441\u0442\u044C \u0445\u043E\u0442\u044F \u0431\u044B \u043E\u0434\u043D\u043E \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0432 \u043F\u0440\u043E\u0448\u0435\u0434\u0448\u0435\u043C \u0432\u0440\u0435\u043C\u0435\u043D\u0438.","\u041E\u043F\u0438\u0441\u0430\u043D\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F\u0448\u043D\u0435\u0435 \u0437\u0430\u043D\u044F\u0442\u0438\u0435.","\u0423\u043A\u0430\u0437\u0430\u043D\u044B \u0432\u0440\u0435\u043C\u044F \u0438\u043B\u0438 \u043C\u0435\u0441\u0442\u043E \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u043D\u043E\u0439 \u0432\u0441\u0442\u0440\u0435\u0447\u0438.","\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E \u0440\u0430\u0437\u043B\u0438\u0447\u0435\u043D\u044B preto\u017Ee (\u043F\u0440\u0438\u0447\u0438\u043D\u0430) \u0438 preto (\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0435).","\u041F\u043E\u0441\u043B\u0435 \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438 \u0438\u0441\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u044B \u043D\u0430\u0439\u0434\u0435\u043D\u043D\u044B\u0435 \u043E\u0448\u0438\u0431\u043A\u0438."],explanation:"\u041E\u0431\u0440\u0430\u0437\u0435\u0446 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043E\u0434\u043D\u0443 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u0443\u044E \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0443, \u0430 \u043D\u0435 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442. \u0421\u0440\u0430\u0432\u043D\u0438 \u0432\u0440\u0435\u043C\u0435\u043D\u0430, \u0430\u0434\u0440\u0435\u0441\u0430\u0442\u0430 \u0438 \u0441\u0432\u044F\u0437\u043A\u0438. \u0421\u043E\u0432\u043F\u0430\u0434\u0435\u043D\u0438\u0435 \u0447\u0438\u0441\u043B\u0430 \u0441\u043B\u043E\u0432 \u0438 \u043F\u0443\u043D\u043A\u0442\u043E\u0432 \u043F\u043B\u0430\u043D\u0430 \u043D\u0435 \u0434\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u044F\u0437\u044B\u043A\u043E\u0432\u044B\u0445 \u043E\u0448\u0438\u0431\u043E\u043A."}]}];var fh=[{id:"b1-01",level:"B1",title:"\u0418\u0441\u0442\u043E\u0440\u0438\u044F \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0434\u043D\u044F",location:"\u041D\u0430\u0431\u0435\u0440\u0435\u0436\u043D\u0430\u044F",scene:"\u041C\u0430\u0442\u0435\u044E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u043A\u0430\u043A \u043F\u0440\u043E\u0448\u0451\u043B \u0442\u0432\u043E\u0439 \u043F\u0435\u0440\u0432\u044B\u0439 \u0434\u0435\u043D\u044C. \u041D\u0438\u043D\u0430 \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0438\u0441\u0442\u043E\u0440\u0438\u044E \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043D\u043E\u0433\u043E \u0431\u043B\u043E\u043A\u043D\u043E\u0442\u0430.",goal:"\u0420\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C \u043E \u043F\u0440\u043E\u0448\u043B\u043E\u043C \u0438 \u043E\u0442\u043B\u0438\u0447\u0438\u0442\u044C \u043F\u0440\u043E\u0446\u0435\u0441\u0441 \u043E\u0442 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0430.",grammar:{title:"\u0412\u0438\u0434 \u0433\u043B\u0430\u0433\u043E\u043B\u0430 \u0432 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0435",body:"\u041D\u0435\u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u044B\u0439 \u0432\u0438\u0434 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043A\u0430\u043A \u043F\u0440\u043E\u0446\u0435\u0441\u0441, \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u0443 \u0438\u043B\u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u0435\u043D\u0438\u0435: \u010D\xEDta\u0165, h\u013Eada\u0165. \u0421\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u044B\u0439 \u0432\u0438\u0434 \u0432\u044B\u0434\u0435\u043B\u044F\u0435\u0442 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435 \u0438 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442: pre\u010D\xEDta\u0165, n\xE1js\u0165. \u0421\u043B\u043E\u0432\u0430 hodinu \u0438 ka\u017Ed\xFD de\u0148 \u0447\u0430\u0441\u0442\u043E \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442 \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u043F\u0440\u043E\u0446\u0435\u0441\u0441, \u0430 cel\xFD \u0438 kone\u010Dne \u2014 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442, \u043D\u043E \u0432\u044B\u0431\u043E\u0440 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u0441\u043C\u044B\u0441\u043B\u0430 \u0432\u0441\u0435\u0439 \u0444\u0440\u0430\u0437\u044B. \u0412 \u043F\u0440\u043E\u0448\u0435\u0434\u0448\u0435\u043C \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043C\u0443\u0436\u0447\u0438\u043D\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 h\u013Eadal som, \u0436\u0435\u043D\u0449\u0438\u043D\u0430 \u2014 h\u013Eadala som. \u041A\u0440\u0430\u0442\u043A\u043E\u0435 som \u043E\u0431\u044B\u0447\u043D\u043E \u0441\u0442\u043E\u0438\u0442 \u043F\u043E\u0441\u043B\u0435 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0441\u043C\u044B\u0441\u043B\u043E\u0432\u043E\u0433\u043E \u0431\u043B\u043E\u043A\u0430: V\u010Dera som h\u013Eadal zo\u0161it. \u0414\u043B\u044F \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438 \u0441\u043E\u0431\u044B\u0442\u0438\u0439 \u043F\u0440\u0438\u0433\u043E\u0434\u044F\u0442\u0441\u044F najprv, potom, medzit\xFDm, napokon. \u041D\u0435 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0439 som \u043A \u0442\u0440\u0435\u0442\u044C\u0435\u043C\u0443 \u043B\u0438\u0446\u0443: Nina na\u0161la zo\u0161it. \u0424\u043E\u0440\u043C\u044B \u0440\u0430\u0437\u043D\u044B\u0445 \u0432\u0438\u0434\u043E\u0432 \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0439 \u043F\u0430\u0440\u0430\u043C\u0438, \u043F\u043E\u0441\u043A\u043E\u043B\u044C\u043A\u0443 \u043F\u0440\u0438\u0441\u0442\u0430\u0432\u043A\u0430 \u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442 \u043D\u0443\u0436\u043D\u0443\u044E \u043F\u0430\u0440\u0443.",examples:[{sk:"Hodinu som \u010D\xEDtal \u010Dl\xE1nok, ale nedo\u010D\xEDtal som ho.",ru:"\u042F \u0447\u0430\u0441 \u0447\u0438\u0442\u0430\u043B \u0441\u0442\u0430\u0442\u044C\u044E, \u043D\u043E \u043D\u0435 \u0434\u043E\u0447\u0438\u0442\u0430\u043B \u0435\u0451."},{sk:"Napokon som na\u0161iel svoj zo\u0161it.",ru:"\u0412 \u043A\u043E\u043D\u0446\u0435 \u043A\u043E\u043D\u0446\u043E\u0432 \u044F \u043D\u0430\u0448\u0451\u043B \u0441\u0432\u043E\u0439 \u0431\u043B\u043E\u043A\u043D\u043E\u0442."}]},words:[{sk:"z\xE1\u017Eitok",ru:"\u043F\u0435\u0440\u0435\u0436\u0438\u0442\u043E\u0435 \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D\u0438\u0435",example:"Bol to nezabudnute\u013En\xFD z\xE1\u017Eitok.",translation:"\u042D\u0442\u043E \u0431\u044B\u043B\u043E \u043D\u0435\u0437\u0430\u0431\u044B\u0432\u0430\u0435\u043C\u043E\u0435 \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D\u0438\u0435."},{sk:"udalos\u0165",ru:"\u0441\u043E\u0431\u044B\u0442\u0438\u0435",example:"O tej udalosti sme hovorili ve\u010Der.",translation:"\u041C\u044B \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438 \u043E\u0431 \u044D\u0442\u043E\u043C \u0441\u043E\u0431\u044B\u0442\u0438\u0438 \u0432\u0435\u0447\u0435\u0440\u043E\u043C."},{sk:"spomen\xFA\u0165 si",ru:"\u0432\u0441\u043F\u043E\u043C\u043D\u0438\u0442\u044C",example:"Spomenul som si na adresu.",translation:"\u042F \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u043B \u0430\u0434\u0440\u0435\u0441."},{sk:"zrazu",ru:"\u0432\u0434\u0440\u0443\u0433",example:"Zrazu za\u010Dalo pr\u0161a\u0165.",translation:"\u0412\u0434\u0440\u0443\u0433 \u043F\u043E\u0448\u0451\u043B \u0434\u043E\u0436\u0434\u044C."},{sk:"medzit\xFDm",ru:"\u0442\u0435\u043C \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C",example:"Nina medzit\xFDm na\u0161la zo\u0161it.",translation:"\u041D\u0438\u043D\u0430 \u0442\u0435\u043C \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C \u043D\u0430\u0448\u043B\u0430 \u0431\u043B\u043E\u043A\u043D\u043E\u0442."},{sk:"napokon",ru:"\u0432 \u043A\u043E\u043D\u0446\u0435 \u043A\u043E\u043D\u0446\u043E\u0432",example:"Napokon sme pri\u0161li domov.",translation:"\u0412 \u043A\u043E\u043D\u0446\u0435 \u043A\u043E\u043D\u0446\u043E\u0432 \u043C\u044B \u043F\u0440\u0438\u0448\u043B\u0438 \u0434\u043E\u043C\u043E\u0439."},{sk:"strati\u0165",ru:"\u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C",example:"Nechcem strati\u0165 l\xEDstok.",translation:"\u042F \u043D\u0435 \u0445\u043E\u0447\u0443 \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C \u0431\u0438\u043B\u0435\u0442."},{sk:"n\xE1js\u0165",ru:"\u043D\u0430\u0439\u0442\u0438",example:"Podarilo sa mi n\xE1js\u0165 k\u013E\xFA\u010D.",translation:"\u041C\u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043D\u0430\u0439\u0442\u0438 \u043A\u043B\u044E\u0447."},{sk:"v\u0161imn\xFA\u0165 si",ru:"\u0437\u0430\u043C\u0435\u0442\u0438\u0442\u044C",example:"V\u0161imol som si nov\xFD oznam.",translation:"\u042F \u0437\u0430\u043C\u0435\u0442\u0438\u043B \u043D\u043E\u0432\u043E\u0435 \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u0435."},{sk:"stihn\xFA\u0165",ru:"\u0443\u0441\u043F\u0435\u0442\u044C",example:"Chcem stihn\xFA\u0165 za\u010Diatok predn\xE1\u0161ky.",translation:"\u042F \u0445\u043E\u0447\u0443 \u0443\u0441\u043F\u0435\u0442\u044C \u043A \u043D\u0430\u0447\u0430\u043B\u0443 \u043B\u0435\u043A\u0446\u0438\u0438."}],exercises:[{type:"reading",prompt:"\u041F\u043E\u0447\u0435\u043C\u0443 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0447\u0438\u043A \u043D\u0435 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u0437\u0430 \u0431\u043B\u043E\u043A\u043D\u043E\u0442\u043E\u043C?",explanation:"\u041D\u0438\u043D\u0430 \u043F\u043E\u0437\u0432\u043E\u043D\u0438\u043B\u0430 \u0438 \u0441\u043E\u043E\u0431\u0449\u0438\u043B\u0430, \u0447\u0442\u043E \u043D\u0430\u0448\u043B\u0430 \u0431\u043B\u043E\u043A\u043D\u043E\u0442 \u0432 \u0442\u043E\u043C \u0436\u0435 \u0442\u0440\u0430\u043C\u0432\u0430\u0435. \u0412 \u0442\u0435\u043A\u0441\u0442\u0435 \u043D\u0435\u0442 \u043E\u0442\u043A\u0430\u0437\u0430 \u043E\u0442 \u0432\u0441\u0442\u0440\u0435\u0447\u0438.",text:"V prv\xFD de\u0148 som sa pon\xE1h\u013Eal na stretnutie s Ninou. V elektri\u010Dke som \u010D\xEDtal pozn\xE1mky a pri vystupovan\xED som zabudol zo\u0161it na sedadle. A\u017E pred kaviar\u0148ou som si v\u0161imol, \u017Ee ho nem\xE1m. Chcel som sa vr\xE1ti\u0165 na zast\xE1vku, ale Nina mi zavolala. Cestovala tou istou elektri\u010Dkou a zo\u0161it na\u0161la. Napokon sme sa stretli o desa\u0165 min\xFAt nesk\xF4r. Bol som r\xE1d, \u017Ee som nemusel p\xEDsa\u0165 v\u0161etko znova.",options:["Zo\u0161it u\u017E na\u0161la Nina.","Zo\u0161it zostal doma.","Stretnutie sa zru\u0161ilo.","Pozn\xE1mky u\u017E nepotreboval."],answer:"Zo\u0161it u\u017E na\u0161la Nina."},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0432 \u043F\u0440\u043E\u043F\u0443\u0441\u043A.",explanation:"\u041F\u043E\u0432\u0442\u043E\u0440\u044F\u0432\u0448\u0438\u0439\u0441\u044F \u043F\u0440\u043E\u0446\u0435\u0441\u0441 \u0431\u0435\u0437 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u044F: \u010D\xEDtal som. \u0423\u0442\u043E\u0447\u043D\u0435\u043D\u0438\u0435 \xAB\u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u0434\u043E \u043A\u043E\u043D\u0446\u0430\xBB \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u0432\u0430\u0436\u043D\u043E.",sk:"Ka\u017Ed\xFD ve\u010Der som ___ kr\xE1tky \u010Dl\xE1nok, ale nie v\u017Edy a\u017E do konca.",options:["pre\u010D\xEDtal","\u010D\xEDtal","pre\u010D\xEDtam","\u010D\xEDta\u0165"],answer:"\u010D\xEDtal"},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0432 \u043F\u0440\u043E\u043F\u0443\u0441\u043A.",explanation:"Nina \u2014 \u0442\u0440\u0435\u0442\u044C\u0435 \u043B\u0438\u0446\u043E, \u0436\u0435\u043D\u0441\u043A\u0438\u0439 \u0440\u043E\u0434: na\u0161la. \u0412\u0441\u043F\u043E\u043C\u043E\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435 som \u0437\u0434\u0435\u0441\u044C \u043D\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F.",sk:"Nina v\u010Dera ___ m\xF4j zo\u0161it v elektri\u010Dke.",options:["na\u0161la som","na\u0161iel","na\u0161la","n\xE1js\u0165"],answer:"na\u0161la"},{type:"order",prompt:"\u0421\u043E\u0431\u0435\u0440\u0438 \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u0443\u044E \u0444\u0440\u0430\u0437\u0443 \xAB\u0412\u0447\u0435\u0440\u0430 \u044F \u043D\u0430\u0448\u0451\u043B \u0441\u0432\u043E\u0439 \u0431\u043B\u043E\u043A\u043D\u043E\u0442\xBB, \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 V\u010Dera.",explanation:"\u041F\u043E\u0441\u043B\u0435 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u043E\u0431\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430 \u043E\u0431\u044B\u0447\u043D\u043E \u0441\u0442\u0430\u0432\u0438\u0442\u0441\u044F \u043A\u0440\u0430\u0442\u043A\u043E\u0435 som: V\u010Dera som na\u0161iel svoj zo\u0161it.",answer:["V\u010Dera","som","na\u0161iel","svoj","zo\u0161it."],acceptedOrders:[["V\u010Dera","som","svoj","zo\u0161it","na\u0161iel."]]},{type:"listening",prompt:"\u0427\u0442\u043E \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E \u043D\u0435\u043F\u043E\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u043E \u043F\u0435\u0440\u0435\u0434 \u043F\u043E\u0441\u0435\u0449\u0435\u043D\u0438\u0435\u043C \u043A\u0430\u0444\u0435?",explanation:"Po predn\xE1\u0161ke \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \xAB\u043F\u043E\u0441\u043B\u0435 \u043B\u0435\u043A\u0446\u0438\u0438\xBB: \u0438\u043C\u0435\u043D\u043D\u043E \u043B\u0435\u043A\u0446\u0438\u044F \u043F\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0430 \u043A\u0430\u0444\u0435.",audio:"Najprv som \u010Dakal pred kni\u017Enicou. Ke\u010F pri\u0161la Nina, i\u0161li sme spolu na predn\xE1\u0161ku. Po predn\xE1\u0161ke sme si sadli do kaviarne a porovnali svoje pozn\xE1mky.",options:["\u010Cakanie na vlak.","N\xE1v\u0161teva predn\xE1\u0161ky.","P\xEDsanie sk\xFA\u0161ky.","Telefon\xE1t domov."],answer:"N\xE1v\u0161teva predn\xE1\u0161ky."},{type:"typing",prompt:"\u041D\u0430\u043F\u0438\u0448\u0438 \u043F\u043E-\u0441\u043B\u043E\u0432\u0430\u0446\u043A\u0438 \u043E\u0434\u043D\u043E \u0441\u043B\u043E\u0432\u043E \xAB\u0442\u0435\u043C \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C\xBB \u0438\u0437 \u0441\u043B\u043E\u0432\u0430\u0440\u044F \u043C\u0438\u0441\u0441\u0438\u0438.",explanation:"Medzit\xFDm \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u0435\u0442 \u0441\u043E\u0431\u044B\u0442\u0438\u044F, \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0432\u0448\u0438\u0435 \u043F\u0430\u0440\u0430\u043B\u043B\u0435\u043B\u044C\u043D\u043E.",answer:"medzit\xFDm"},{type:"choice",prompt:"\u041A\u0430\u043A\u043E\u0435 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u043E\u0434\u043D\u043E\u0437\u043D\u0430\u0447\u043D\u043E \u043F\u043E\u0434\u0447\u0451\u0440\u043A\u0438\u0432\u0430\u0435\u0442 \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043D\u043D\u044B\u0439 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442?",explanation:"\u0421\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u044B\u0439 \u0432\u0438\u0434 pre\u010D\xEDtal \u0438 \u0434\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435 cel\xFD \u010Dl\xE1nok \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442, \u0447\u0442\u043E \u0441\u0442\u0430\u0442\u044C\u044F \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043D\u0430 \u0446\u0435\u043B\u0438\u043A\u043E\u043C.",options:["V\u010Dera som \u010D\xEDtal v kni\u017Enici.","\u010Casto som \u010D\xEDtal ve\u010Der.","Pre\u010D\xEDtal som cel\xFD \u010Dl\xE1nok.","Pr\xE1ve som \u010D\xEDtal pozn\xE1mky."],answer:"Pre\u010D\xEDtal som cel\xFD \u010Dl\xE1nok."},{type:"writing",prompt:"\u041D\u0430\u043F\u0438\u0448\u0438 120\u2013160 \u0441\u043B\u043E\u0432 \u043F\u043E-\u0441\u043B\u043E\u0432\u0430\u0446\u043A\u0438 \u043E \u043F\u0435\u0440\u0432\u043E\u043C \u0434\u043D\u0435 \u0432 \u043D\u043E\u0432\u043E\u043C \u0433\u043E\u0440\u043E\u0434\u0435. \u0414\u043E\u0431\u0430\u0432\u044C \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0443\u044E \u0442\u0440\u0443\u0434\u043D\u043E\u0441\u0442\u044C, \u0435\u0451 \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u0438 \u0441\u0432\u043E\u0438 \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D\u0438\u044F. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 najprv, potom \u0438 napokon.",explanation:"\u042D\u0442\u043E \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u043F\u0438\u0441\u044C\u043C\u0435\u043D\u043D\u0430\u044F \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0430: \u0441\u0440\u0430\u0432\u043D\u0438 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435 \u0438 \u044F\u0437\u044B\u043A \u0441 \u043E\u0431\u0440\u0430\u0437\u0446\u043E\u043C. \u041E\u0431\u044A\u0451\u043C \u0442\u0435\u043A\u0441\u0442\u0430 \u0441\u0430\u043C \u043F\u043E \u0441\u0435\u0431\u0435 \u043D\u0435 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442 \u0443\u0440\u043E\u0432\u0435\u043D\u044C CEFR.",answer:"",minWords:120,model:"Do nov\xE9ho mesta som pri\u0161iel skoro r\xE1no. Najprv som h\u013Eadal zast\xE1vku, preto\u017Ee som sa chcel dosta\u0165 na intern\xE1t. Nemal som v\u0161ak dos\u0165 nabit\xFD telef\xF3n a nevedel som si otvori\u0165 mapu. Op\xFDtal som sa \u017Eeny pri stanici, ktor\xE1 mi ochotne vysvetlila cestu. Potom som nast\xFApil do elektri\u010Dky a pozorne sledoval n\xE1zvy zast\xE1vok. Na intern\xE1te som si odlo\u017Eil bato\u017Einu a trochu si odd\xFDchol. Popoludn\xED som sa stretol s Ninou. Uk\xE1zala mi kni\u017Enicu aj miesto, kde sa \u0161tudenti stret\xE1vaj\xFA po predn\xE1\u0161kach. Medzit\xFDm sa m\xF4j telef\xF3n nabil, tak\u017Ee som mohol zavola\u0165 domov. Napokon sme i\u0161li na kr\xE1tku prech\xE1dzku k rieke. R\xE1no som bol nerv\xF3zny, ale ve\u010Der som sa u\u017E c\xEDtil pokojnej\u0161ie. Zistil som, \u017Ee po\u017Eiada\u0165 o pomoc nie je hanba. Pr\xE1ve v\u010Faka tomu som spoznal mil\xFDch \u013Eud\xED.",checklist:["\u0415\u0441\u0442\u044C \u043D\u0430\u0447\u0430\u043B\u043E, \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430, \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435.","\u041F\u0440\u043E\u0448\u0435\u0434\u0448\u0435\u0435 \u0432\u0440\u0435\u043C\u044F \u0441\u043E\u0433\u043B\u0430\u0441\u043E\u0432\u0430\u043D\u043E \u0441 \u0440\u043E\u0434\u043E\u043C \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0447\u0438\u043A\u0430.","\u0420\u0430\u0437\u043B\u0438\u0447\u0430\u044E\u0442\u0441\u044F \u043F\u0440\u043E\u0446\u0435\u0441\u0441 \u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043D\u043D\u043E\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435.","\u0415\u0441\u0442\u044C \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435 \u0441\u0432\u044F\u0437\u043A\u0438 \u0438 \u043D\u0435 \u043C\u0435\u043D\u0435\u0435 120 \u0441\u043B\u043E\u0432."]}]},{id:"b1-02",level:"B1",title:"\u041B\u044E\u0434\u0438 \u0438 \u043C\u0435\u0441\u0442\u0430",location:"\u0411\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0430",scene:"\u041D\u0438\u043D\u0430 \u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0442 \u0442\u0435\u0431\u044F \u0441 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0430\u0440\u0435\u043C. \u041D\u0443\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438 \u043A\u043D\u0438\u0433\u0443 \u0438 \u0443\u0442\u043E\u0447\u043D\u0438\u0442\u044C, \u043A\u0430\u043A\u0438\u0435 \u0438\u0437\u0434\u0430\u043D\u0438\u044F \u043C\u043E\u0436\u043D\u043E \u0432\u0437\u044F\u0442\u044C \u0434\u043E\u043C\u043E\u0439.",goal:"\u041E\u043F\u0438\u0441\u044B\u0432\u0430\u0442\u044C \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B \u0438 \u043B\u044E\u0434\u0435\u0439 \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0439.",grammar:{title:"Ktor\xFD: \u0440\u043E\u0434, \u0447\u0438\u0441\u043B\u043E \u0438 \u043F\u0430\u0434\u0435\u0436",body:"\u041E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u043C\u0435\u0441\u0442\u043E\u0438\u043C\u0435\u043D\u0438\u0435 ktor\xFD \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u0435\u0442 \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435 \u0441 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C: kniha, ktor\xE1 le\u017E\xED na stole. \u0420\u043E\u0434 \u0438 \u0447\u0438\u0441\u043B\u043E \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u044E\u0442\u0441\u044F \u044D\u0442\u0438\u043C \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C, \u0430 \u043F\u0430\u0434\u0435\u0436 \u2014 \u0440\u043E\u043B\u044C\u044E \u0432\u043D\u0443\u0442\u0440\u0438 \u043F\u0440\u0438\u0434\u0430\u0442\u043E\u0447\u043D\u043E\u0439 \u0447\u0430\u0441\u0442\u0438. \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \xAB\u043A\u043D\u0438\u0433\u0430, \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u044F \u0447\u0438\u0442\u0430\u044E\xBB \u2014 kniha, ktor\xFA \u010D\xEDtam: \u010D\xEDta\u0165 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043F\u0440\u044F\u043C\u043E\u0433\u043E \u0434\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u0432 \u0432\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C \u043F\u0430\u0434\u0435\u0436\u0435. \u041F\u0440\u0435\u0434\u043B\u043E\u0433 \u0442\u043E\u0436\u0435 \u0432\u043B\u0438\u044F\u0435\u0442 \u043D\u0430 \u0444\u043E\u0440\u043C\u0443: \u010Dlovek, s ktor\xFDm hovor\xEDm. \u0414\u043B\u044F \u043C\u0443\u0436\u0447\u0438\u043D \u0432\u043E \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u043C \u0447\u0438\u0441\u043B\u0435 \u0432 \u0438\u043C\u0435\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C \u043F\u0430\u0434\u0435\u0436\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F ktor\xED; \u0434\u043B\u044F \u043A\u043D\u0438\u0433 \u2014 ktor\xE9. \u041F\u0435\u0440\u0435\u0434 \u043F\u0440\u0438\u0434\u0430\u0442\u043E\u0447\u043D\u044B\u043C \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435\u043C \u0441\u0442\u0430\u0432\u0438\u0442\u0441\u044F \u0437\u0430\u043F\u044F\u0442\u0430\u044F. \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043D\u0430\u0439\u0434\u0438, \u043A \u043A\u0430\u043A\u043E\u043C\u0443 \u0441\u043B\u043E\u0432\u0443 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435, \u0437\u0430\u0442\u0435\u043C \u043C\u044B\u0441\u043B\u0435\u043D\u043D\u043E \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438 \u043F\u0440\u043E\u0441\u0442\u0443\u044E \u0444\u0440\u0430\u0437\u0443 \u0432\u043D\u0443\u0442\u0440\u0438 \u043D\u0435\u0433\u043E. \u042D\u0442\u043E\u0442 \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u043D\u0435 \u0432\u044B\u0431\u0438\u0440\u0430\u0442\u044C \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u043C\u0443 \u0441\u043B\u043E\u0432\u0443.",examples:[{sk:"H\u013Ead\xE1m knihu, ktor\xFA si odpor\xFA\u010Dala.",ru:"\u042F \u0438\u0449\u0443 \u043A\u043D\u0438\u0433\u0443, \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0442\u044B \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u043E\u0432\u0430\u043B\u0430."},{sk:"To je \u010Dlovek, s ktor\xFDm som hovoril.",ru:"\u042D\u0442\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A, \u0441 \u043A\u043E\u0442\u043E\u0440\u044B\u043C \u044F \u0440\u0430\u0437\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u043B."}]},words:[{sk:"odpor\xFA\u010Da\u0165",ru:"\u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u043E\u0432\u0430\u0442\u044C",example:"Ktor\xFA knihu mi odpor\xFA\u010Date?",translation:"\u041A\u0430\u043A\u0443\u044E \u043A\u043D\u0438\u0433\u0443 \u0432\u044B \u043C\u043D\u0435 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0435?"},{sk:"oddelenie",ru:"\u043E\u0442\u0434\u0435\u043B",example:"Odborn\xE9 knihy s\xFA na tomto oddelen\xED.",translation:"\u0421\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u0430\u044F \u043B\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0432 \u044D\u0442\u043E\u043C \u043E\u0442\u0434\u0435\u043B\u0435."},{sk:"v\xFDpo\u017Ei\u010Dka",ru:"\u0432\u044B\u0434\u0430\u0447\u0430 \u043A\u043D\u0438\u0433\u0438 \u043D\u0430 \u0432\u0440\u0435\u043C\u044F",example:"V\xFDpo\u017Ei\u010Dku m\xF4\u017Eete pred\u013A\u017Ei\u0165.",translation:"\u0421\u0440\u043E\u043A \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F \u0432\u0437\u044F\u0442\u043E\u0439 \u043A\u043D\u0438\u0433\u043E\u0439 \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u0434\u043B\u0438\u0442\u044C."},{sk:"\u010Ditate\u013E",ru:"\u0447\u0438\u0442\u0430\u0442\u0435\u043B\u044C",example:"Ka\u017Ed\xFD \u010Ditate\u013E m\xE1 svoj preukaz.",translation:"\u0423 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0447\u0438\u0442\u0430\u0442\u0435\u043B\u044F \u0435\u0441\u0442\u044C \u0441\u0432\u043E\u0439 \u0431\u0438\u043B\u0435\u0442."},{sk:"vydanie",ru:"\u0438\u0437\u0434\u0430\u043D\u0438\u0435",example:"Potrebujem nov\u0161ie vydanie tejto knihy.",translation:"\u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0431\u043E\u043B\u0435\u0435 \u043D\u043E\u0432\u043E\u0435 \u0438\u0437\u0434\u0430\u043D\u0438\u0435 \u044D\u0442\u043E\u0439 \u043A\u043D\u0438\u0433\u0438."},{sk:"autor",ru:"\u0430\u0432\u0442\u043E\u0440",example:"Autor vysvet\u013Euje z\xE1kladn\xE9 pojmy.",translation:"\u0410\u0432\u0442\u043E\u0440 \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442 \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0435 \u043F\u043E\u043D\u044F\u0442\u0438\u044F."},{sk:"polica",ru:"\u043F\u043E\u043B\u043A\u0430",example:"Slovn\xEDk je na hornej polici.",translation:"\u0421\u043B\u043E\u0432\u0430\u0440\u044C \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043D\u0430 \u0432\u0435\u0440\u0445\u043D\u0435\u0439 \u043F\u043E\u043B\u043A\u0435."},{sk:"odborn\xFD",ru:"\u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439; \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439",example:"\u010C\xEDtame odborn\xFD text o spolo\u010Dnosti.",translation:"\u041C\u044B \u0447\u0438\u0442\u0430\u0435\u043C \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439 \u0442\u0435\u043A\u0441\u0442 \u043E\u0431 \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435."},{sk:"dostupn\xFD",ru:"\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0439",example:"Tento \u010Dl\xE1nok je dostupn\xFD online.",translation:"\u042D\u0442\u0430 \u0441\u0442\u0430\u0442\u044C\u044F \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430 \u0432 \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442\u0435."},{sk:"u\u017Eito\u010Dn\xFD",ru:"\u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0439",example:"Slovn\xEDk je pre m\u0148a u\u017Eito\u010Dn\xFD.",translation:"\u0421\u043B\u043E\u0432\u0430\u0440\u044C \u0434\u043B\u044F \u043C\u0435\u043D\u044F \u043F\u043E\u043B\u0435\u0437\u0435\u043D."}],exercises:[{type:"reading",prompt:"\u0427\u0442\u043E \u043D\u0443\u0436\u043D\u043E \u0438\u0437\u0443\u0447\u0430\u0442\u044C \u0432 \u0447\u0438\u0442\u0430\u043B\u044C\u043D\u043E\u043C \u0437\u0430\u043B\u0435?",explanation:"\u0421\u043B\u043E\u0432\u0430\u0440\u044C \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u0432 \u0447\u0438\u0442\u0430\u043B\u044C\u043D\u043E\u043C \u0437\u0430\u043B\u0435: zost\xE1va v \u0161tudovni. \u041F\u0435\u0440\u0432\u0443\u044E \u043A\u043D\u0438\u0433\u0443 \u043C\u043E\u0436\u043D\u043E \u0432\u0437\u044F\u0442\u044C \u0434\u043E\u043C\u043E\u0439, \u0441\u0442\u0430\u0442\u044C\u044F \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430 \u043E\u043D\u043B\u0430\u0439\u043D.",text:"Knihovn\xED\u010Dka mi uk\xE1zala dve knihy o spolo\u010Dnosti. Prv\xFA, ktor\xFA mi odpor\xFA\u010Dala Nina, si m\xF4\u017Eem po\u017Ei\u010Da\u0165 domov. Druh\xE1 je nov\xE9 vydanie slovn\xEDka a zost\xE1va v \u0161tudovni. M\xF4\u017Eem v nej \u010D\xEDta\u0165 po\u010Das otv\xE1rac\xEDch hod\xEDn. Knihovn\xED\u010Dka mi tie\u017E uk\xE1zala elektronick\xFD \u010Dl\xE1nok, ktor\xFD je dostupn\xFD aj z domu. Rozhodol som sa vzia\u0165 si prv\xFA knihu a pozn\xE1mky zo slovn\xEDka si urobi\u0165 na mieste.",options:["Prv\xFA knihu.","Nov\xE9 vydanie slovn\xEDka.","Elektronick\xFD \u010Dl\xE1nok.","V\u0161etky uveden\xE9 texty."],answer:"Nov\xE9 vydanie slovn\xEDka."},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0432 \u043F\u0440\u043E\u043F\u0443\u0441\u043A.",explanation:"Kniha \u2014 \u0436\u0435\u043D\u0441\u043A\u0438\u0439 \u0440\u043E\u0434, \u043D\u043E \u0432\u043D\u0443\u0442\u0440\u0438 \u043F\u0440\u0438\u0434\u0430\u0442\u043E\u0447\u043D\u043E\u0433\u043E \u044D\u0442\u043E \u043E\u0431\u044A\u0435\u043A\u0442 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0430\u0446\u0438\u0438: odporu\u010Dila knihu \u2192 ktor\xFA.",sk:"\u010C\xEDtam knihu, ___ mi odporu\u010Dila Nina.",options:["ktor\xE1","ktor\xE9mu","ktor\xFA","ktor\xFDm"],answer:"ktor\xFA"},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0432 \u043F\u0440\u043E\u043F\u0443\u0441\u043A.",explanation:"\u0160tudenti \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u043B\u044E\u0434\u0435\u0439 \u043C\u0443\u0436\u0441\u043A\u043E\u0433\u043E \u0440\u043E\u0434\u0430 \u0432\u043E \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u043C \u0447\u0438\u0441\u043B\u0435, \u043F\u043E\u0434\u043B\u0435\u0436\u0430\u0449\u0435\u0435: ktor\xED.",sk:"To s\xFA \u0161tudenti, ___ pripravuj\xFA spolo\u010Dn\xFD projekt.",options:["ktor\xE9","ktor\xED","ktor\xFA","ktor\xFDm"],answer:"ktor\xED"},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0432 \u043F\u0440\u043E\u043F\u0443\u0441\u043A.",explanation:"\u041F\u0440\u0435\u0434\u043B\u043E\u0433 s \u0441\u043E \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435\u043C \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0442\u0432\u043E\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043F\u0430\u0434\u0435\u0436\u0430: s profesorom \u2192 s ktor\xFDm.",sk:"Pozn\xE1m profesora, s ___ sa chce\u0161 porozpr\xE1va\u0165.",options:["ktor\xFD","ktor\xE9ho","ktor\xE9mu","ktor\xFDm"],answer:"ktor\xFDm"},{type:"order",prompt:"\u0421\u043E\u0431\u0435\u0440\u0438 \u0444\u0440\u0430\u0437\u0443 \xAB\u042D\u0442\u043E \u043A\u043D\u0438\u0433\u0430, \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u044F \u0438\u0441\u043A\u0430\u043B\xBB, \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 To.",explanation:"Ktor\xFA \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u043A kniha \u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0435\u0442 \u0440\u043E\u043B\u044C \u043F\u0440\u044F\u043C\u043E\u0433\u043E \u0434\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u0432\u043D\u0443\u0442\u0440\u0438 \u043F\u0440\u0438\u0434\u0430\u0442\u043E\u0447\u043D\u043E\u0433\u043E.",answer:["To","je","kniha,","ktor\xFA","som","h\u013Eadal."]},{type:"typing",prompt:"\u0412\u043F\u0438\u0448\u0438 \u043F\u0440\u043E\u043F\u0443\u0449\u0435\u043D\u043D\u0443\u044E \u0444\u043E\u0440\u043C\u0443: \xABKniha, o ___ hovor\xEDme, je nov\xE1.\xBB",explanation:"Hovori\u0165 o \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043C\u0435\u0441\u0442\u043D\u043E\u0433\u043E \u043F\u0430\u0434\u0435\u0436\u0430. \u0414\u043B\u044F kniha: o ktorej.",answer:"ktorej"},{type:"choice",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0435 \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445 \u043A\u043D\u0438\u0433.",explanation:"Knihy \u2014 \u0436\u0435\u043D\u0441\u043A\u0438\u0439 \u0440\u043E\u0434, \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435 \u0447\u0438\u0441\u043B\u043E; \u043F\u043E\u0434\u043B\u0435\u0436\u0430\u0449\u0435\u0435 \u043F\u0440\u0438\u0434\u0430\u0442\u043E\u0447\u043D\u043E\u0433\u043E: ktor\xE9.",options:["Knihy, ktor\xED le\u017Eia na stole.","Knihy, ktor\xE9 le\u017Eia na stole.","Knihy, ktor\xFA le\u017E\xED na stole.","Knihy, ktor\xE9ho le\u017Eia na stole."],answer:"Knihy, ktor\xE9 le\u017Eia na stole."},{type:"speaking",prompt:"\u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0438 \u043F\u043E-\u0441\u043B\u043E\u0432\u0430\u0446\u043A\u0438 \u043E \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0435 \u0438\u043B\u0438 \u0443\u0447\u0435\u0431\u043D\u043E\u043C \u043C\u0435\u0441\u0442\u0435, \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0442\u0435\u0431\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u0445\u043E\u0442\u044F \u0431\u044B \u0442\u0440\u0438 \u0444\u043E\u0440\u043C\u044B \u043A\u043E\u0442\u043E\u0440\u044B\u0439: ktor\xFD, ktor\xE1, ktor\xE9, ktor\xFA \u0438\u043B\u0438 s ktor\xFDm.",explanation:"\u042D\u0442\u043E \u0443\u0441\u0442\u043D\u0430\u044F \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0430 \u0441 \u0441\u0430\u043C\u043E\u043E\u0446\u0435\u043D\u043A\u043E\u0439. \u041E\u0446\u0435\u043D\u0438 \u043F\u043E\u043D\u044F\u0442\u043D\u043E\u0441\u0442\u044C, \u0441\u0432\u044F\u0437\u043D\u043E\u0441\u0442\u044C \u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u044F; \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u043E\u0446\u0435\u043D\u043A\u0430 \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0448\u0435\u043D\u0438\u044F \u0437\u0434\u0435\u0441\u044C \u043D\u0435 \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u0430\u0433\u0430\u0435\u0442\u0441\u044F.",answer:"",targetSeconds:60,model:"Najrad\u0161ej \u0161tudujem v kni\u017Enici, ktor\xE1 je bl\xEDzko intern\xE1tu. Je tam tich\xE1 miestnos\u0165, v ktorej sa viem s\xFAstredi\u0165. \u010Casto si beriem knihu, ktor\xFA mi odporu\u010D\xED spolu\u017Eiak. Najviac mi pom\xE1haj\xFA texty, ktor\xE9 obsahuj\xFA konkr\xE9tne pr\xEDklady. Pozn\xE1m aj knihovn\xEDka, s ktor\xFDm m\xF4\u017Eem hovori\u0165 o nov\xFDch vydaniach. Doma m\xE1m v\xE4\u010D\u0161ie pohodlie, ale v kni\u017Enici ma menej vec\xED vyru\u0161uje.",checklist:["\u041D\u0430\u0437\u0432\u0430\u043D\u043E \u043C\u0435\u0441\u0442\u043E \u0438 \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u043E, \u043F\u043E\u0447\u0435\u043C\u0443 \u043E\u043D\u043E \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442.","\u0415\u0441\u0442\u044C \u043C\u0438\u043D\u0438\u043C\u0443\u043C \u0442\u0440\u0438 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438.","\u041F\u0430\u0434\u0435\u0436 \u043F\u043E\u0441\u043B\u0435 \u043F\u0440\u0435\u0434\u043B\u043E\u0433\u0430 \u0432\u044B\u0431\u0440\u0430\u043D \u043E\u0441\u043E\u0437\u043D\u0430\u043D\u043D\u043E.","\u0420\u0435\u0447\u044C \u043F\u043E\u043D\u044F\u0442\u043D\u0430 \u0431\u0435\u0437 \u0447\u0442\u0435\u043D\u0438\u044F \u0432\u0441\u0435\u0433\u043E \u043E\u0431\u0440\u0430\u0437\u0446\u0430."]}]},{id:"b1-03",level:"B1",title:"\u0415\u0441\u043B\u0438 \u0431\u044B\u2026",location:"\u0413\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439 \u043F\u0430\u0440\u043A",scene:"\u041C\u0430\u0442\u0435\u0439 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u0442\u044C \u0441\u0442\u0443\u0434\u0435\u043D\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u043E\u0435\u043A\u0442. \u0422\u044B \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u0435\u0448\u044C, \u0447\u0442\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u043B \u0431\u044B \u043F\u0440\u0438 \u0431\u043E\u043B\u044C\u0448\u0435\u043C \u0431\u044E\u0434\u0436\u0435\u0442\u0435 \u0438 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u043C \u0432\u0440\u0435\u043C\u0435\u043D\u0438.",goal:"\u0413\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u043E \u0433\u0438\u043F\u043E\u0442\u0435\u0437\u0430\u0445 \u0438 \u043E\u0442\u043B\u0438\u0447\u0430\u0442\u044C \u0438\u0445 \u043E\u0442 \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u0439.",grammar:{title:"Keby \u0438 \u0443\u0441\u043B\u043E\u0432\u043D\u043E\u0435 \u043D\u0430\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u0435",body:"\u0414\u043B\u044F \u0432\u043E\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u043C\u043E\u0439 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F keby \u0441 \u0444\u043E\u0440\u043C\u043E\u0439 \u043D\u0430 -l: Keby som mal \u010Das. \u0412 \u0433\u043B\u0430\u0432\u043D\u043E\u0439 \u0447\u0430\u0441\u0442\u0438 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0443\u0441\u043B\u043E\u0432\u043D\u043E\u0435 \u043D\u0430\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u0435: pripravil by som projekt. \u041F\u043E\u0441\u043B\u0435 keby \u0432\u0442\u043E\u0440\u0443\u044E \u0447\u0430\u0441\u0442\u0438\u0446\u0443 by \u043D\u0435 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u044E\u0442. \u0421\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0435 by som, by si, by sme, by ste \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u043F\u043E \u043B\u0438\u0446\u0430\u043C; \u0432 \u0442\u0440\u0435\u0442\u044C\u0435\u043C \u043B\u0438\u0446\u0435 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F by. \u0424\u043E\u0440\u043C\u0430 \u043D\u0430 -l \u0441\u043E\u0433\u043B\u0430\u0441\u0443\u0435\u0442\u0441\u044F \u0441 \u0440\u043E\u0434\u043E\u043C: chcel by som \u0438\u043B\u0438 chcela by som. \u0420\u0435\u0430\u043B\u044C\u043D\u0443\u044E \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0447\u0430\u0441\u0442\u043E \u0432\u0432\u043E\u0434\u044F\u0442 \u0441\u043E\u044E\u0437\u043E\u043C ak: Ak bude \u010Das, pr\xEDdem. \u0420\u0430\u0437\u043D\u0438\u0446\u0430 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0432\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438: \u0433\u043E\u0432\u043E\u0440\u044F\u0449\u0438\u0439 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0443\u0441\u043B\u043E\u0432\u0438\u0435 \u043A\u0430\u043A \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0435 \u043B\u0438\u0431\u043E \u043A\u0430\u043A \u0432\u043E\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u043C\u043E\u0435. \u0414\u043B\u044F \u0432\u0435\u0436\u043B\u0438\u0432\u043E\u0433\u043E \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u0442\u043E\u0436\u0435 \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F \u0443\u0441\u043B\u043E\u0432\u043D\u043E\u0435 \u043D\u0430\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u0435: Mohli by sme za\u010Da\u0165 sk\xF4r.",examples:[{sk:"Keby sme mali viac \u010Dasu, pripravili by sme v\xFDstavu.",ru:"\u0415\u0441\u043B\u0438 \u0431\u044B \u0443 \u043D\u0430\u0441 \u0431\u044B\u043B\u043E \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u0440\u0435\u043C\u0435\u043D\u0438, \u043C\u044B \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u043B\u0438 \u0431\u044B \u0432\u044B\u0441\u0442\u0430\u0432\u043A\u0443."},{sk:"Ak bude zajtra pekne, stretneme sa vonku.",ru:"\u0415\u0441\u043B\u0438 \u0437\u0430\u0432\u0442\u0440\u0430 \u0431\u0443\u0434\u0435\u0442 \u0445\u043E\u0440\u043E\u0448\u0430\u044F \u043F\u043E\u0433\u043E\u0434\u0430, \u043C\u044B \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043C\u0441\u044F \u043D\u0430 \u0443\u043B\u0438\u0446\u0435."}]},words:[{sk:"\u017Eelanie",ru:"\u0436\u0435\u043B\u0430\u043D\u0438\u0435",example:"Jeho \u017Eelanie je \u0161tudova\u0165 v zahrani\u010D\xED.",translation:"\u0415\u0433\u043E \u0436\u0435\u043B\u0430\u043D\u0438\u0435 \u2014 \u0443\u0447\u0438\u0442\u044C\u0441\u044F \u0437\u0430 \u0433\u0440\u0430\u043D\u0438\u0446\u0435\u0439."},{sk:"podmienka",ru:"\u0443\u0441\u043B\u043E\u0432\u0438\u0435",example:"D\xF4le\u017Eitou podmienkou je dostatok \u010Dasu.",translation:"\u0412\u0430\u0436\u043D\u043E\u0435 \u0443\u0441\u043B\u043E\u0432\u0438\u0435 \u2014 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438."},{sk:"mo\u017Enos\u0165",ru:"\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C; \u0432\u0430\u0440\u0438\u0430\u043D\u0442",example:"M\xE1me e\u0161te jednu mo\u017Enos\u0165.",translation:"\u0423 \u043D\u0430\u0441 \u0435\u0441\u0442\u044C \u0435\u0449\u0451 \u043E\u0434\u0438\u043D \u0432\u0430\u0440\u0438\u0430\u043D\u0442."},{sk:"rozhodn\xFA\u0165 sa",ru:"\u0440\u0435\u0448\u0438\u0442\u044C; \u043F\u0440\u0438\u043D\u044F\u0442\u044C \u0440\u0435\u0448\u0435\u043D\u0438\u0435",example:"Mus\xEDme sa rozhodn\xFA\u0165 do piatka.",translation:"\u041C\u044B \u0434\u043E\u043B\u0436\u043D\u044B \u043F\u0440\u0438\u043D\u044F\u0442\u044C \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u0434\u043E \u043F\u044F\u0442\u043D\u0438\u0446\u044B."},{sk:"zmeni\u0165",ru:"\u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C",example:"Chcel by som zmeni\u0165 svoj pl\xE1n.",translation:"\u042F \u0445\u043E\u0442\u0435\u043B \u0431\u044B \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u0441\u0432\u043E\u0439 \u043F\u043B\u0430\u043D."},{sk:"navrhn\xFA\u0165",ru:"\u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C",example:"M\xF4\u017Eem navrhn\xFA\u0165 in\xE9 rie\u0161enie?",translation:"\u041C\u043E\u0433\u0443 \u044F \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u0434\u0440\u0443\u0433\u043E\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435?"},{sk:"u\u0161etri\u0165",ru:"\u0441\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0442\u044C",example:"Takto m\xF4\u017Eeme u\u0161etri\u0165 \u010Das.",translation:"\u0422\u0430\u043A \u043C\u044B \u043C\u043E\u0436\u0435\u043C \u0441\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0442\u044C \u0432\u0440\u0435\u043C\u044F."},{sk:"podpora",ru:"\u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0430",example:"Projekt potrebuje podporu \u0161tudentov.",translation:"\u041F\u0440\u043E\u0435\u043A\u0442\u0443 \u043D\u0443\u0436\u043D\u0430 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0430 \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043E\u0432."},{sk:"pl\xE1nova\u0165",ru:"\u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u0442\u044C",example:"Pl\xE1nujeme spolo\u010Dn\xE9 stretnutie.",translation:"\u041C\u044B \u043F\u043B\u0430\u043D\u0438\u0440\u0443\u0435\u043C \u043E\u0431\u0449\u0443\u044E \u0432\u0441\u0442\u0440\u0435\u0447\u0443."},{sk:"uskuto\u010Dni\u0165",ru:"\u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u0442\u044C; \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438",example:"Chceme uskuto\u010Dni\u0165 mal\xFA v\xFDstavu.",translation:"\u041C\u044B \u0445\u043E\u0442\u0438\u043C \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0443\u044E \u0432\u044B\u0441\u0442\u0430\u0432\u043A\u0443."}],exercises:[{type:"reading",prompt:"\u0427\u0442\u043E \u0434\u043E\u043B\u0436\u043D\u043E \u043F\u0440\u043E\u0438\u0437\u043E\u0439\u0442\u0438 \u043F\u0435\u0440\u0435\u0434 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u043E\u0439 \u043E\u043D\u043B\u0430\u0439\u043D-\u0432\u044B\u0441\u0442\u0430\u0432\u043A\u0438?",explanation:"\u0421\u043E\u0433\u043B\u0430\u0441\u0438\u0435 \u0430\u0432\u0442\u043E\u0440\u043E\u0432 \u043D\u0430\u0437\u0432\u0430\u043D\u043E \u0443\u0441\u043B\u043E\u0432\u0438\u0435\u043C \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0438 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u044B. \u0411\u043E\u043B\u044C\u0448\u043E\u0435 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0435 \u0434\u043B\u044F \u043E\u043D\u043B\u0430\u0439\u043D-\u0432\u044B\u0441\u0442\u0430\u0432\u043A\u0438 \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F.",text:"Matej by chcel usporiada\u0165 v\xFDstavu fotografi\xED. Keby mal v\xE4\u010D\u0161iu miestnos\u0165, pozval by aj \u013Eud\xED z mesta. Zatia\u013E v\u0161ak m\xF4\u017Ee pou\u017Ei\u0165 iba mal\xFA \u0161tudov\u0148u. Nina navrhla online v\xFDstavu, ktor\xFA by si mohlo pozrie\u0165 viac \u013Eud\xED. Matej s\xFAhlas\xED, ale najprv chce zisti\u0165, \u010Di autori fotografi\xED dovolia ich zverejnenie. Ak z\xEDskaj\xFA s\xFAhlas, pripravia str\xE1nku po\u010Das v\xEDkendu.",options:["Musia k\xFApi\u0165 fotoapar\xE1t.","Autori musia s\xFAhlasi\u0165 so zverejnen\xEDm.","Musia z\xEDska\u0165 v\xE4\u010D\u0161iu miestnos\u0165.","Nina mus\xED pozva\u0165 cel\xE9 mesto."],answer:"Autori musia s\xFAhlasi\u0165 so zverejnen\xEDm."},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0432 \u043F\u0440\u043E\u043F\u0443\u0441\u043A.",explanation:"\u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u0430\u044F \u0444\u043E\u0440\u043C\u0430 \u0443\u0441\u043B\u043E\u0432\u0438\u044F: Keby som mal. \u041F\u043E\u0441\u043B\u0435 keby \u043D\u0435 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u044E\u0442 \u0432\u0442\u043E\u0440\u043E\u0435 by.",sk:"Keby som ___ viac \u010Dasu, chodil by som \u010Dastej\u0161ie do kni\u017Enice.",options:["budem ma\u0165","mal","by mal","m\xE1m"],answer:"mal"},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0432 \u043F\u0440\u043E\u043F\u0443\u0441\u043A.",explanation:"\u0414\u043B\u044F \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u043B\u0438\u0446\u0430 \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E \u0447\u0438\u0441\u043B\u0430 \u043D\u0443\u0436\u043D\u043E by sme.",sk:"My ___ pripravili spolo\u010Dn\xFD projekt.",options:["by som","by ste","by sme","by si"],answer:"by sme"},{type:"choice",prompt:"\u041A\u0430\u043A\u043E\u0435 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0435 \u0431\u0443\u0434\u0443\u0449\u0435\u0435 \u0443\u0441\u043B\u043E\u0432\u0438\u0435?",explanation:"Ak budem ma\u0165 \u010Das \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0443\u0441\u043B\u043E\u0432\u0438\u0435 \u043A\u0430\u043A \u0440\u0435\u0430\u043B\u044C\u043D\u0443\u044E \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043C.",options:["Keby som mal \u010Das, pri\u0161iel by som.","Ak budem ma\u0165 \u010Das, pr\xEDdem.","Bol by som r\xE1d doma.","Keby pr\u0161alo, zostali by sme doma."],answer:"Ak budem ma\u0165 \u010Das, pr\xEDdem."},{type:"order",prompt:"\u0421\u043E\u0431\u0435\u0440\u0438 \u0443\u0441\u043B\u043E\u0432\u0438\u0435 \xAB\u0415\u0441\u043B\u0438 \u0431\u044B \u0443 \u043C\u0435\u043D\u044F \u0431\u044B\u043B\u043E \u0432\u0440\u0435\u043C\u044F\xBB, \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 Keby.",explanation:"\u041F\u043E\u0441\u043B\u0435 keby \u0441\u043B\u0435\u0434\u0443\u0435\u0442 som, \u0437\u0430\u0442\u0435\u043C \u0444\u043E\u0440\u043C\u0430 mal. \u042D\u0442\u043E \u0443\u0441\u043B\u043E\u0432\u043D\u0430\u044F \u0447\u0430\u0441\u0442\u044C, \u0430 \u043D\u0435 \u043F\u043E\u043B\u043D\u043E\u0435 \u0441\u043B\u043E\u0436\u043D\u043E\u0435 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435.",answer:["Keby","som","mal","\u010Das."],acceptedOrders:[["Keby","som","\u010Das","mal."]]},{type:"typing",prompt:"\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0432\u0435\u0436\u043B\u0438\u0432\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \xAB\u042F \u0445\u043E\u0442\u0435\u043B \u0431\u044B\u2026\xBB. \u041D\u0430\u043F\u0438\u0448\u0438 \u044D\u0442\u0438 \u0442\u0440\u0438 \u0441\u043B\u043E\u0432\u0430 \u043F\u043E-\u0441\u043B\u043E\u0432\u0430\u0446\u043A\u0438.",explanation:"Chcel by som \u2014 \u043C\u0443\u0436\u0441\u043A\u0430\u044F \u0444\u043E\u0440\u043C\u0430. \u0416\u0435\u043D\u0449\u0438\u043D\u0430 \u0441\u043A\u0430\u0437\u0430\u043B\u0430 \u0431\u044B Chcela by som.",answer:"Chcel by som"},{type:"listening",prompt:"\u0427\u0442\u043E \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u0433\u043E\u0432\u043E\u0440\u044F\u0449\u0438\u0439 \u0441 \u0443\u0447\u0451\u0442\u043E\u043C \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u044F?",explanation:"\u0420\u0430\u043D\u043D\u0435\u0435 \u043D\u0430\u0447\u0430\u043B\u043E \u2014 \u043B\u0438\u0448\u044C \u0433\u0438\u043F\u043E\u0442\u0435\u0437\u0430, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u0430. \u0420\u0435\u0430\u043B\u044C\u043D\u043E\u0435 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u2014 \u0441\u043E\u043A\u0440\u0430\u0442\u0438\u0442\u044C \u0432\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u0435.",audio:"Keby sme za\u010Dali o hodinu sk\xF4r, mali by sme viac \u010Dasu na ot\xE1zky. Dnes to v\u0161ak nie je mo\u017En\xE9, preto\u017Ee miestnos\u0165 bude vo\u013En\xE1 a\u017E o tretej. Navrhujem preto skr\xE1ti\u0165 \xFAvod.",options:["Za\u010Da\u0165 o hodinu sk\xF4r.","Zru\u0161i\u0165 v\u0161etky ot\xE1zky.","Skr\xE1ti\u0165 \xFAvod.","Zmeni\u0165 miestnos\u0165 na v\xE4\u010D\u0161iu."],answer:"Skr\xE1ti\u0165 \xFAvod."},{type:"speaking",prompt:"\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044C, \u0447\u0442\u043E \u0443 \u0442\u0435\u0431\u044F \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0439 \u043C\u0435\u0441\u044F\u0446 \u0434\u043B\u044F \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0438 \u043A \u0443\u0447\u0451\u0431\u0435. \u041E\u0431\u044A\u044F\u0441\u043D\u0438, \u0447\u0442\u043E \u0442\u044B \u0441\u0434\u0435\u043B\u0430\u043B \u0431\u044B \u0438 \u043F\u043E\u0447\u0435\u043C\u0443. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u0434\u0432\u0430 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u0441 keby.",explanation:"\u042D\u0442\u043E \u0443\u0441\u0442\u043D\u0430\u044F \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0430 \u0441 \u0441\u0430\u043C\u043E\u043E\u0446\u0435\u043D\u043A\u043E\u0439. \u041E\u0446\u0435\u043D\u0438 \u043F\u043E\u043D\u044F\u0442\u043D\u043E\u0441\u0442\u044C, \u0441\u0432\u044F\u0437\u043D\u043E\u0441\u0442\u044C \u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u044F; \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u043E\u0446\u0435\u043D\u043A\u0430 \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0448\u0435\u043D\u0438\u044F \u0437\u0434\u0435\u0441\u044C \u043D\u0435 \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u0430\u0433\u0430\u0435\u0442\u0441\u044F.",answer:"",targetSeconds:60,model:"Keby som mal cel\xFD vo\u013En\xFD mesiac, rozdelil by som si ho na men\u0161ie \u010Dasti. Ka\u017Ed\xE9 r\xE1no by som sa venoval sloven\u010Dine a popoludn\xED by som \u010D\xEDtal odborn\xE9 texty. Keby som poznal \u0161tudenta politol\xF3gie, po\u017Eiadal by som ho o pravideln\xE9 rozhovory. Nechcel by som sa v\u0161ak u\u010Di\u0165 bez prest\xE1vok. Jeden de\u0148 v t\xFD\u017Edni by som si nechal na oddych, aby som mal dos\u0165 energie.",checklist:["\u0414\u0432\u0435 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438 keby \u0431\u0435\u0437 \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u043E\u0433\u043E by \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u0438.","\u0415\u0441\u0442\u044C \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0435 \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442\u043E\u0432.","\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E \u0441\u043E\u0433\u043B\u0430\u0441\u043E\u0432\u0430\u043D\u044B \u0444\u043E\u0440\u043C\u044B by som / by sme.","\u041E\u0442\u0432\u0435\u0442 \u0434\u043B\u0438\u0442\u0441\u044F \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E \u043C\u0438\u043D\u0443\u0442\u0443."]}]},{id:"b1-04",level:"B1",title:"\u041D\u0430 \u0441\u043E\u0431\u0435\u0441\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0438",location:"\u041A\u0430\u0440\u044C\u0435\u0440\u043D\u044B\u0439 \u0446\u0435\u043D\u0442\u0440",scene:"\u0412 \u0443\u0447\u0435\u0431\u043D\u043E\u043C \u0441\u0446\u0435\u043D\u0430\u0440\u0438\u0438 \u041D\u0438\u043D\u0430 \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442 \u043F\u0440\u043E\u0431\u043D\u043E\u0435 \u0441\u043E\u0431\u0435\u0441\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435. \u041D\u0443\u0436\u043D\u043E \u044F\u0441\u043D\u043E \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C \u043E\u0431 \u043E\u043F\u044B\u0442\u0435 \u0438 \u0443\u0442\u043E\u0447\u043D\u0438\u0442\u044C \u0440\u0430\u0431\u043E\u0447\u0438\u0435 \u0437\u0430\u0434\u0430\u0447\u0438.",goal:"\u041E\u043F\u0438\u0441\u0430\u0442\u044C \u0441\u0432\u043E\u0438 \u0443\u043C\u0435\u043D\u0438\u044F \u0431\u0435\u0437 \u043F\u0440\u0435\u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0439 \u0438 \u0437\u0430\u0434\u0430\u0442\u044C \u0432\u0435\u0436\u043B\u0438\u0432\u044B\u0435 \u0432\u043E\u043F\u0440\u043E\u0441\u044B.",grammar:{title:"\u0423\u043C\u0435\u043D\u0438\u0435, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0438 \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C",body:"Vedie\u0165 \u0441 \u0438\u043D\u0444\u0438\u043D\u0438\u0442\u0438\u0432\u043E\u043C \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u0443\u043C\u0435\u043D\u0438\u0435: viem vysvetli\u0165 probl\xE9m. M\xF4c\u0165 \u0447\u0430\u0449\u0435 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0438\u043B\u0438 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435: m\xF4\u017Eem pr\xEDs\u0165 v pondelok. \u041D\u0430 \u0441\u043E\u0431\u0435\u0441\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0438 \u0432\u0430\u0436\u043D\u043E \u0440\u0430\u0437\u043B\u0438\u0447\u0430\u0442\u044C, \u0447\u0442\u043E \u0442\u044B \u0443\u043C\u0435\u0435\u0448\u044C, \u0430 \u0447\u0442\u043E \u0441\u043C\u043E\u0436\u0435\u0448\u044C \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u043F\u0440\u0438 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445. \u0421\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0435 ma\u0165 sk\xFAsenosti s \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0442\u0432\u043E\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043F\u0430\u0434\u0435\u0436\u0430: s pr\xEDpravou textov. \u041F\u043E\u0441\u043B\u0435 venova\u0165 sa \u043D\u0443\u0436\u0435\u043D \u0434\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439: venujem sa projektom. Zodpovedn\xFD za \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0441 \u0432\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C: zodpovedn\xFD za komunik\xE1ciu. \u0414\u043B\u044F \u0432\u0435\u0436\u043B\u0438\u0432\u043E\u0433\u043E \u0432\u043E\u043F\u0440\u043E\u0441\u0430 \u0443\u043F\u043E\u0442\u0440\u0435\u0431\u043B\u044F\u0439 Mohli by ste mi poveda\u0165\u2026?. \u041D\u0435 \u0437\u0430\u043C\u0435\u043D\u044F\u0439 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0439 \u043E\u043F\u044B\u0442 \u043E\u0431\u0449\u0438\u043C\u0438 \u043F\u043E\u0445\u0432\u0430\u043B\u0430\u043C\u0438: \u043E\u0434\u0438\u043D \u043F\u0440\u0438\u043C\u0435\u0440 \u0441 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u043E\u043C \u0434\u0435\u043B\u0430\u0435\u0442 \u043E\u0442\u0432\u0435\u0442 \u043F\u043E\u043D\u044F\u0442\u043D\u0435\u0435. \u0412 \u043F\u0438\u0441\u044C\u043C\u0435\u043D\u043D\u043E\u043C \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0439 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u044B\u0439 \u0432\u0435\u0436\u043B\u0438\u0432\u044B\u0439 \u0442\u043E\u043D \u043D\u0430 \u043F\u0440\u043E\u0442\u044F\u0436\u0435\u043D\u0438\u0438 \u0432\u0441\u0435\u0433\u043E \u0442\u0435\u043A\u0441\u0442\u0430.",examples:[{sk:"Viem pripravi\u0165 kr\xE1tku spr\xE1vu.",ru:"\u042F \u0443\u043C\u0435\u044E \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u043E\u0442\u0447\u0451\u0442."},{sk:"M\xF4\u017Eem nast\xFApi\u0165 bud\xFAci t\xFD\u017Ede\u0148.",ru:"\u042F \u043C\u043E\u0433\u0443 \u043F\u0440\u0438\u0441\u0442\u0443\u043F\u0438\u0442\u044C \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u043D\u0435\u0434\u0435\u043B\u0435."}]},words:[{sk:"sk\xFAsenos\u0165",ru:"\u043E\u043F\u044B\u0442; \u043F\u0435\u0440\u0435\u0436\u0438\u0442\u044B\u0439 \u0441\u043B\u0443\u0447\u0430\u0439",example:"M\xE1m sk\xFAsenos\u0165 s organizovan\xEDm stretnut\xED.",translation:"\u0423 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u043E\u043F\u044B\u0442 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438 \u0432\u0441\u0442\u0440\u0435\u0447."},{sk:"zru\u010Dnos\u0165",ru:"\u043D\u0430\u0432\u044B\u043A",example:"P\xEDsanie jasn\xFDch textov je u\u017Eito\u010Dn\xE1 zru\u010Dnos\u0165.",translation:"\u0423\u043C\u0435\u043D\u0438\u0435 \u043F\u0438\u0441\u0430\u0442\u044C \u043F\u043E\u043D\u044F\u0442\u043D\u044B\u0435 \u0442\u0435\u043A\u0441\u0442\u044B \u2014 \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0439 \u043D\u0430\u0432\u044B\u043A."},{sk:"pracovn\xFD pohovor",ru:"\u0441\u043E\u0431\u0435\u0441\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435 \u043F\u0440\u0438 \u043F\u0440\u0438\u0451\u043C\u0435 \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0443",example:"Zajtra m\xE1m pracovn\xFD pohovor.",translation:"\u0417\u0430\u0432\u0442\u0440\u0430 \u0443 \u043C\u0435\u043D\u044F \u0441\u043E\u0431\u0435\u0441\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435."},{sk:"\u017Eivotopis",ru:"\u0440\u0435\u0437\u044E\u043C\u0435; \u0431\u0438\u043E\u0433\u0440\u0430\u0444\u0438\u044F",example:"Poslal som stru\u010Dn\xFD \u017Eivotopis.",translation:"\u042F \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B \u043A\u0440\u0430\u0442\u043A\u043E\u0435 \u0440\u0435\u0437\u044E\u043C\u0435."},{sk:"zamestn\xE1vate\u013E",ru:"\u0440\u0430\u0431\u043E\u0442\u043E\u0434\u0430\u0442\u0435\u043B\u044C",example:"Zamestn\xE1vate\u013E vysvetlil pracovn\xE9 \xFAlohy.",translation:"\u0420\u0430\u0431\u043E\u0442\u043E\u0434\u0430\u0442\u0435\u043B\u044C \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B \u0440\u0430\u0431\u043E\u0447\u0438\u0435 \u0437\u0430\u0434\u0430\u0447\u0438."},{sk:"uch\xE1dza\u010D",ru:"\u043A\u0430\u043D\u0434\u0438\u0434\u0430\u0442; \u0441\u043E\u0438\u0441\u043A\u0430\u0442\u0435\u043B\u044C",example:"Uch\xE1dza\u010D odpovedal na ot\xE1zku.",translation:"\u041A\u0430\u043D\u0434\u0438\u0434\u0430\u0442 \u043E\u0442\u0432\u0435\u0442\u0438\u043B \u043D\u0430 \u0432\u043E\u043F\u0440\u043E\u0441."},{sk:"zodpovednos\u0165",ru:"\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C",example:"T\xE1to \xFAloha vy\u017Eaduje zodpovednos\u0165.",translation:"\u042D\u0442\u0430 \u0437\u0430\u0434\u0430\u0447\u0430 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u0438."},{sk:"spo\u013Eahliv\xFD",ru:"\u043D\u0430\u0434\u0451\u0436\u043D\u044B\u0439",example:"H\u013Ead\xE1me spo\u013Eahliv\xE9ho kolegu.",translation:"\u041C\u044B \u0438\u0449\u0435\u043C \u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0433\u043E \u043A\u043E\u043B\u043B\u0435\u0433\u0443."},{sk:"spolupracova\u0165",ru:"\u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0430\u0442\u044C",example:"R\xE1d spolupracujem s \u013Eu\u010Fmi.",translation:"\u041C\u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0430\u0442\u044C \u0441 \u043B\u044E\u0434\u044C\u043C\u0438."},{sk:"pracovn\xE1 ponuka",ru:"\u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0440\u0430\u0431\u043E\u0442\u044B; \u0432\u0430\u043A\u0430\u043D\u0441\u0438\u044F",example:"Pre\u010D\xEDtal som si pracovn\xFA ponuku.",translation:"\u042F \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043B \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435 \u0432\u0430\u043A\u0430\u043D\u0441\u0438\u0438."}],exercises:[{type:"reading",prompt:"\u041A\u0430\u043A \u043A\u0430\u043D\u0434\u0438\u0434\u0430\u0442 \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442 \u0441\u0432\u043E\u0439 \u043E\u043F\u044B\u0442?",explanation:"\u041E\u043D \u043F\u0440\u0438\u0432\u043E\u0434\u0438\u0442 \u043F\u0440\u0438\u043C\u0435\u0440 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0438 \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u0439 \u0438 \u0447\u0435\u0441\u0442\u043D\u043E \u043E\u0442\u043C\u0435\u0447\u0430\u0435\u0442, \u0447\u0442\u043E \u0435\u0449\u0451 \u043D\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0441 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u043D\u044B\u043C\u0438 \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u044F\u043C\u0438.",text:"Vo fikt\xEDvnej pracovnej ponuke sa h\u013Ead\xE1 \u010Dlovek, ktor\xFD vie p\xEDsa\u0165 kr\xE1tke informa\u010Dn\xE9 texty a odpoveda\u0165 na ot\xE1zky n\xE1v\u0161tevn\xEDkov. Pr\xE1ca je v kancel\xE1rii tri dni v t\xFD\u017Edni. Nina sa p\xFDta kandid\xE1ta, \u010Di u\u017E podobn\xE9 \xFAlohy robil. Kandid\xE1t odpoved\xE1, \u017Ee pripravoval oznamy pre \u0161tudentsk\xFD klub, ale s vybavovan\xEDm telefon\xE1tov e\u0161te sk\xFAsenosti nem\xE1. Dod\xE1va, \u017Ee sa to chce nau\u010Di\u0165.",options:["Tvrd\xED, \u017Ee vie v\u0161etko.","Uv\xE1dza konkr\xE9tnu sk\xFAsenos\u0165 aj oblas\u0165, ktor\xFA sa potrebuje nau\u010Di\u0165.","Odmieta v\u0161etky pracovn\xE9 \xFAlohy.","Hovor\xED iba o pracovnom \u010Dase."],answer:"Uv\xE1dza konkr\xE9tnu sk\xFAsenos\u0165 aj oblas\u0165, ktor\xFA sa potrebuje nau\u010Di\u0165."},{type:"cloze",prompt:"\u0412\u044B\u0440\u0430\u0437\u0438 \u0438\u043C\u0435\u043D\u043D\u043E \u0441\u0432\u043E\u0451 \u0443\u043C\u0435\u043D\u0438\u0435: \xAB\u042F \u0443\u043C\u0435\u044E \u0445\u043E\u0440\u043E\u0448\u043E \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C \u044D\u0442\u043E\u0442 \u043F\u043E\u0440\u044F\u0434\u043E\u043A, \u043F\u043E\u0441\u043A\u043E\u043B\u044C\u043A\u0443 \u0447\u0430\u0441\u0442\u043E \u0435\u0433\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\xBB.",explanation:"\u0420\u0435\u0447\u044C \u043E\u0431 \u0443\u043C\u0435\u043D\u0438\u0438, \u043F\u043E\u0434\u043A\u0440\u0435\u043F\u043B\u0451\u043D\u043D\u043E\u043C \u043E\u043F\u044B\u0442\u043E\u043C: viem vysvetli\u0165.",sk:"___ dobre vysvetli\u0165 tento postup, preto\u017Ee som ho \u010Dasto pou\u017E\xEDval.",options:["Viem","Smie\u0161","Musel","Budem"],answer:"Viem"},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0432 \u043F\u0440\u043E\u043F\u0443\u0441\u043A.",explanation:"Zodpovedn\xFD za + \u0432\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043F\u0430\u0434\u0435\u0436: za komunik\xE1ciu.",sk:"Bol som zodpovedn\xFD za ___ so \u0161tudentmi.",options:["komunik\xE1cie","komunik\xE1ciou","komunik\xE1ciu","komunik\xE1cii"],answer:"komunik\xE1ciu"},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0432 \u043F\u0440\u043E\u043F\u0443\u0441\u043A.",explanation:"\u041F\u0440\u0435\u0434\u043B\u043E\u0433 s \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0442\u0432\u043E\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043F\u0430\u0434\u0435\u0436\u0430: s pr\xEDpravou.",sk:"M\xE1m sk\xFAsenosti s ___ kr\xE1tkych spr\xE1v.",options:["pr\xEDprava","pr\xEDpravu","pr\xEDprave","pr\xEDpravou"],answer:"pr\xEDpravou"},{type:"choice",prompt:"\u041A\u0430\u043A \u0432\u0435\u0436\u043B\u0438\u0432\u043E \u0443\u0442\u043E\u0447\u043D\u0438\u0442\u044C \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0435 \u0437\u0430\u0434\u0430\u0447\u0438?",explanation:"Mohli by ste\u2026? \u2014 \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u0430\u044F \u0432\u0435\u0436\u043B\u0438\u0432\u0430\u044F \u043F\u0440\u043E\u0441\u044C\u0431\u0430 \u043F\u0440\u0438 \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u0438 \u043D\u0430 \xAB\u0432\u044B\xBB.",options:["Povedz \xFAlohy!","Mohli by ste mi op\xEDsa\u0165 hlavn\xE9 \xFAlohy?","Pre\u010Do nevie\u0161 \xFAlohy?","Ja \xFAlohy nikdy nerob\xEDm."],answer:"Mohli by ste mi op\xEDsa\u0165 hlavn\xE9 \xFAlohy?"},{type:"order",prompt:"\u0421\u043E\u0431\u0435\u0440\u0438 \u0444\u0440\u0430\u0437\u0443 \xAB\u042F \u0445\u043E\u0442\u0435\u043B \u0431\u044B \u0431\u043E\u043B\u044C\u0448\u0435 \u0443\u0437\u043D\u0430\u0442\u044C \u043E \u0432\u0430\u0448\u0435\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u0435\xBB, \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 Chcel.",explanation:"\u041A\u0440\u0430\u0442\u043A\u0438\u0435 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B by som sa \u0441\u0442\u043E\u044F\u0442 \u0432\u043C\u0435\u0441\u0442\u0435 \u043F\u043E\u0441\u043B\u0435 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0441\u043C\u044B\u0441\u043B\u043E\u0432\u043E\u0433\u043E \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430.",answer:["Chcel","by","som","sa","dozvedie\u0165","viac","o","va\u0161om","t\xEDme."],acceptedOrders:[["Chcel","by","som","sa","o","va\u0161om","t\xEDme","dozvedie\u0165","viac."],["Chcel","by","som","sa","viac","dozvedie\u0165","o","va\u0161om","t\xEDme."],["Chcel","by","som","sa","dozvedie\u0165","o","va\u0161om","t\xEDme","viac."]]},{type:"typing",prompt:"\u041D\u0430\u043F\u0438\u0448\u0438 \u0441\u043B\u043E\u0432\u043E\u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0435 \xAB\u0441\u043E\u0431\u0435\u0441\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435 \u043F\u0440\u0438 \u043F\u0440\u0438\u0451\u043C\u0435 \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0443\xBB \u0438\u0437 \u0441\u043B\u043E\u0432\u0430\u0440\u044F.",explanation:"Pracovn\xFD pohovor \u2014 \u0438\u043C\u0435\u043D\u043D\u043E \u0441\u043E\u0431\u0435\u0441\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435, \u0430 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440.",answer:"pracovn\xFD pohovor"},{type:"writing",prompt:"\u041D\u0430\u043F\u0438\u0448\u0438 120\u2013160 \u0441\u043B\u043E\u0432 \u0432 \u043E\u0442\u0432\u0435\u0442 \u043D\u0430 \u0432\u044B\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u0443\u044E \u0432\u0430\u043A\u0430\u043D\u0441\u0438\u044E \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A\u0430 \u0441\u0442\u0443\u0434\u0435\u043D\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u0446\u0435\u043D\u0442\u0440\u0430. \u0423\u043A\u0430\u0436\u0438 \u0442\u043E\u043B\u044C\u043A\u043E \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0439 \u0438\u043B\u0438 \u044F\u0432\u043D\u043E \u0432\u044B\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u044B\u0439 \u0443\u0447\u0435\u0431\u043D\u044B\u0439 \u043E\u043F\u044B\u0442, \u043D\u0430\u0437\u043E\u0432\u0438 \u0443\u043C\u0435\u043D\u0438\u0435 \u0438 \u0437\u0430\u0434\u0430\u0439 \u0434\u0432\u0430 \u0432\u043E\u043F\u0440\u043E\u0441\u0430 \u043E \u0440\u0430\u0431\u043E\u0442\u0435.",explanation:"\u042D\u0442\u043E \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u043F\u0438\u0441\u044C\u043C\u0435\u043D\u043D\u0430\u044F \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0430: \u0441\u0440\u0430\u0432\u043D\u0438 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435 \u0438 \u044F\u0437\u044B\u043A \u0441 \u043E\u0431\u0440\u0430\u0437\u0446\u043E\u043C. \u041E\u0431\u044A\u0451\u043C \u0442\u0435\u043A\u0441\u0442\u0430 \u0441\u0430\u043C \u043F\u043E \u0441\u0435\u0431\u0435 \u043D\u0435 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442 \u0443\u0440\u043E\u0432\u0435\u043D\u044C CEFR.",answer:"",minWords:120,model:"Dobr\xFD de\u0148, zaujal ma v\xE1\u0161 inzer\xE1t na poz\xEDciu pomocn\xEDka \u0161tudentsk\xE9ho centra. R\xE1d by som sa dozvedel viac o tejto pr\xE1ci. M\xE1m sk\xFAsenosti s pr\xEDpravou kr\xE1tkych textov a r\xE1d vysvet\u013Eujem inform\xE1cie zrozumite\u013En\xFDm sp\xF4sobom. Pri pr\xE1ci sa sna\u017E\xEDm najprv pochopi\u0165 ot\xE1zku a a\u017E potom navrhn\xFA\u0165 rie\u0161enie. Dok\xE1\u017Eem spolupracova\u0165 s \u010Fal\u0161\xEDmi \u013Eu\u010Fmi a v\u010Das ozn\xE1mi\u0165, ke\u010F potrebujem pomoc. Sloven\u010Dinu si st\xE1le zlep\u0161ujem, najm\xE4 v p\xEDsomnej komunik\xE1cii. Mohli by ste mi, pros\xEDm, poveda\u0165, ak\xE9 ot\xE1zky n\xE1v\u0161tevn\xEDkov by som naj\u010Dastej\u0161ie rie\u0161il? Zauj\xEDmalo by ma tie\u017E, ako prebieha za\u0161kolenie nov\xE9ho pracovn\xEDka. Ak by bolo potrebn\xE9 doplni\u0165 \u010Fal\u0161ie inform\xE1cie, r\xE1d ich po\u0161lem. Na osobnom stretnut\xED by som mohol uvies\u0165 konkr\xE9tne pr\xEDklady svojich doteraj\u0161\xEDch \xFAloh. \u010Eakujem za v\xE1\u0161 \u010Das a za odpove\u010F. Prajem v\xE1m pekn\xFD de\u0148. R\xE1d sa tie\u017E dozviem, ktor\xE9 zru\u010Dnosti by som si mal pred n\xE1stupom doplni\u0165.",checklist:["\u0415\u0441\u0442\u044C \u0446\u0435\u043B\u044C \u043F\u0438\u0441\u044C\u043C\u0430 \u0438 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0439 \u043F\u0440\u0438\u043C\u0435\u0440 \u0443\u043C\u0435\u043D\u0438\u044F.","\u041D\u0435 \u043F\u0440\u0438\u043F\u0438\u0441\u0430\u043D\u044B \u0441\u0435\u0431\u0435 \u043D\u0435\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0435 \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F.","\u0417\u0430\u0434\u0430\u043D\u044B \u0434\u0432\u0430 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u0432\u0435\u0436\u043B\u0438\u0432\u044B\u0445 \u0432\u043E\u043F\u0440\u043E\u0441\u0430.","\u0421\u043E\u0445\u0440\u0430\u043D\u0451\u043D \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439 \u0441\u0442\u0438\u043B\u044C \u0438 \u0441\u0432\u044F\u0437\u043D\u043E\u0441\u0442\u044C."]}]},{id:"b1-05",level:"B1",title:"\u041F\u0438\u0441\u044C\u043C\u043E \u0432 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442",location:"\u0423\u0447\u0435\u0431\u043D\u044B\u0439 \u043E\u0442\u0434\u0435\u043B",scene:"\u041D\u0443\u0436\u043D\u043E \u0443\u0442\u043E\u0447\u043D\u0438\u0442\u044C \u0434\u0435\u0442\u0430\u043B\u0438 \u0432\u044B\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u043E\u0439 \u0437\u0430\u044F\u0432\u043A\u0438. \u041C\u0430\u0442\u0435\u0439 \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442: \u043F\u0440\u0430\u0432\u0438\u043B\u0430 \u044D\u0442\u043E\u0439 \u043C\u0438\u0441\u0441\u0438\u0438 \u043E\u0442\u043D\u043E\u0441\u044F\u0442\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E \u043A \u0441\u044E\u0436\u0435\u0442\u0443 \u0438\u0433\u0440\u044B.",goal:"\u0417\u0430\u0434\u0430\u0432\u0430\u0442\u044C \u0442\u043E\u0447\u043D\u044B\u0435 \u0432\u043E\u043F\u0440\u043E\u0441\u044B \u043E \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u0445 \u0438 \u0441\u0440\u043E\u043A\u0430\u0445.",grammar:{title:"\u041A\u043E\u0441\u0432\u0435\u043D\u043D\u044B\u0439 \u0432\u043E\u043F\u0440\u043E\u0441: \u010Di, kedy, kde",body:"\u041F\u043E\u0441\u043B\u0435 \u0432\u0432\u043E\u0434\u043D\u043E\u0439 \u043F\u0440\u043E\u0441\u044C\u0431\u044B \u0432\u043E\u043F\u0440\u043E\u0441 \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0442\u044C \u0432 \u043F\u0440\u0438\u0434\u0430\u0442\u043E\u0447\u043D\u043E\u0435 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435: Mohli by ste mi poveda\u0165, kedy sa za\u010D\xEDna kurz? \u0415\u0441\u043B\u0438 \u0438\u0441\u0445\u043E\u0434\u043D\u044B\u0439 \u0432\u043E\u043F\u0440\u043E\u0441 \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u0430\u0433\u0430\u0435\u0442 \xAB\u0434\u0430\xBB \u0438\u043B\u0438 \xAB\u043D\u0435\u0442\xBB, \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F \u010Di: Chcel by som vedie\u0165, \u010Di sta\u010D\xED k\xF3pia. \u041F\u0435\u0440\u0435\u0434 \u043F\u0440\u0438\u0434\u0430\u0442\u043E\u0447\u043D\u044B\u043C \u0441\u0442\u0430\u0432\u0438\u0442\u0441\u044F \u0437\u0430\u043F\u044F\u0442\u0430\u044F. \u041F\u043E\u0440\u044F\u0434\u043E\u043A \u0441\u043B\u043E\u0432 \u043E\u0431\u044B\u0447\u043D\u043E \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u043F\u043E\u0432\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C; \u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442\u044C \u0430\u043D\u0433\u043B\u0438\u0439\u0441\u043A\u0443\u044E \u0438\u043D\u0432\u0435\u0440\u0441\u0438\u044E \u0432 \u0441\u043B\u043E\u0432\u0430\u0446\u043A\u0438\u0439. \u0421\u043E\u044E\u0437 \u010Di \u0437\u0434\u0435\u0441\u044C \u043D\u0435 \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u0440\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u043E\u0435 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u043D\u043E\u0435 \xAB\u0438\u043B\u0438\xBB: \u043E\u043D \u0432\u0432\u043E\u0434\u0438\u0442 \u0432\u043E\u043F\u0440\u043E\u0441 \u043E \u0442\u043E\u043C, \u0432\u0435\u0440\u043D\u043E \u043B\u0438 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0435. \u0412 \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u043C \u043F\u0438\u0441\u044C\u043C\u0435 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E \u043D\u0430\u0437\u043E\u0432\u0438 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0443, \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044E \u0438 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u0443\u044E \u043F\u0440\u043E\u0441\u044C\u0431\u0443. \u041D\u0435 \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u044F\u0439 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0440\u0430\u0437\u043D\u044B\u0445 \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432 \u0432 \u043E\u0434\u043D\u0443 \u0434\u043B\u0438\u043D\u043D\u0443\u044E \u0444\u0440\u0430\u0437\u0443: \u0442\u0430\u043A \u0430\u0434\u0440\u0435\u0441\u0430\u0442\u0443 \u043B\u0435\u0433\u0447\u0435 \u043E\u0442\u0432\u0435\u0442\u0438\u0442\u044C \u043D\u0430 \u043A\u0430\u0436\u0434\u044B\u0439 \u043F\u0443\u043D\u043A\u0442.",examples:[{sk:"Pros\xEDm o inform\xE1ciu, \u010Di m\xF4\u017Eem pr\xEDlohu doplni\u0165 nesk\xF4r.",ru:"\u041F\u0440\u043E\u0448\u0443 \u0441\u043E\u043E\u0431\u0449\u0438\u0442\u044C, \u043C\u043E\u0433\u0443 \u043B\u0438 \u044F \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u043F\u043E\u0437\u0436\u0435."},{sk:"Mohli by ste mi poveda\u0165, kde n\xE1jdem formul\xE1r?",ru:"\u041D\u0435 \u043C\u043E\u0433\u043B\u0438 \u0431\u044B \u0432\u044B \u0441\u043A\u0430\u0437\u0430\u0442\u044C, \u0433\u0434\u0435 \u044F \u043D\u0430\u0439\u0434\u0443 \u0431\u043B\u0430\u043D\u043A?"}]},words:[{sk:"prij\xEDmacie konanie",ru:"\u043F\u0440\u043E\u0446\u0435\u0434\u0443\u0440\u0430 \u043F\u0440\u0438\u0451\u043C\u0430",example:"P\xFDtam sa na prij\xEDmacie konanie.",translation:"\u042F \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u044E \u043E \u043F\u0440\u043E\u0446\u0435\u0434\u0443\u0440\u0435 \u043F\u0440\u0438\u0451\u043C\u0430."},{sk:"\u0161tudijn\xFD program",ru:"\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430",example:"Zauj\xEDma ma tento \u0161tudijn\xFD program.",translation:"\u041C\u0435\u043D\u044F \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0443\u0435\u0442 \u044D\u0442\u0430 \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430."},{sk:"prihl\xE1\u0161ka",ru:"\u0437\u0430\u044F\u0432\u043B\u0435\u043D\u0438\u0435 \u043D\u0430 \u043F\u043E\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u0435; \u0437\u0430\u044F\u0432\u043A\u0430",example:"Prihl\xE1\u0161ku som zatia\u013E neodoslal.",translation:"\u042F \u043F\u043E\u043A\u0430 \u043D\u0435 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B \u0437\u0430\u044F\u0432\u043B\u0435\u043D\u0438\u0435."},{sk:"pr\xEDloha",ru:"\u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u043A \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0443",example:"V spr\xE1ve ch\xFDba jedna pr\xEDloha.",translation:"\u0412 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0438 \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u043E\u0434\u043D\u043E\u0433\u043E \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u044F."},{sk:"term\xEDn",ru:"\u0441\u0440\u043E\u043A; \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u0430\u044F \u0434\u0430\u0442\u0430",example:"Chcem si overi\u0165 presn\xFD term\xEDn.",translation:"\u042F \u0445\u043E\u0447\u0443 \u0443\u0442\u043E\u0447\u043D\u0438\u0442\u044C \u0442\u043E\u0447\u043D\u044B\u0439 \u0441\u0440\u043E\u043A."},{sk:"potvrdenie",ru:"\u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0435; \u0441\u043F\u0440\u0430\u0432\u043A\u0430",example:"\u010Cak\xE1m na potvrdenie prijatia spr\xE1vy.",translation:"\u042F \u0436\u0434\u0443 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u044F \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u044F \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u044F."},{sk:"overen\xE1 k\xF3pia",ru:"\u0437\u0430\u0432\u0435\u0440\u0435\u043D\u043D\u0430\u044F \u043A\u043E\u043F\u0438\u044F",example:"P\xFDtam sa, \u010Di potrebuj\xFA overen\xFA k\xF3piu.",translation:"\u042F \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u044E, \u043D\u0443\u0436\u043D\u0430 \u043B\u0438 \u0437\u0430\u0432\u0435\u0440\u0435\u043D\u043D\u0430\u044F \u043A\u043E\u043F\u0438\u044F."},{sk:"predlo\u017Ei\u0165",ru:"\u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044C; \u043F\u0440\u0435\u0434\u044A\u044F\u0432\u0438\u0442\u044C",example:"Kedy m\xE1m predlo\u017Ei\u0165 tento dokument?",translation:"\u041A\u043E\u0433\u0434\u0430 \u043C\u043D\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u044D\u0442\u043E\u0442 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442?"},{sk:"doplni\u0165",ru:"\u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u044C",example:"Potrebujem doplni\u0165 ch\xFDbaj\xFAci \xFAdaj.",translation:"\u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u044C \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u044E\u0449\u0438\u0435 \u0434\u0430\u043D\u043D\u044B\u0435."},{sk:"\u0161tudijn\xE9 oddelenie",ru:"\u0443\u0447\u0435\u0431\u043D\u044B\u0439 \u043E\u0442\u0434\u0435\u043B",example:"Nap\xEDsal som na \u0161tudijn\xE9 oddelenie.",translation:"\u042F \u043D\u0430\u043F\u0438\u0441\u0430\u043B \u0432 \u0443\u0447\u0435\u0431\u043D\u044B\u0439 \u043E\u0442\u0434\u0435\u043B."}],exercises:[{type:"reading",prompt:"\u0427\u0442\u043E \u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u0441\u0434\u0435\u043B\u0430\u0442\u044C, \u0435\u0441\u043B\u0438 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u043D\u0435 \u0431\u0443\u0434\u0435\u0442 \u0433\u043E\u0442\u043E\u0432\u043E \u043A \u043F\u044F\u0442\u043D\u0438\u0446\u0435?",explanation:"\u0412 \u0443\u0447\u0435\u0431\u043D\u043E\u043C \u0442\u0435\u043A\u0441\u0442\u0435 \u043F\u0440\u044F\u043C\u043E \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442\u0441\u044F \u043D\u0430\u043F\u0438\u0441\u0430\u0442\u044C \u0432 \u043E\u0442\u0434\u0435\u043B \u0438 \u0441\u043E\u0433\u043B\u0430\u0441\u043E\u0432\u0430\u0442\u044C \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0438\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F. \u042D\u0442\u043E \u043D\u0435 \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0435 \u043F\u0440\u0430\u0432\u0438\u043B\u0430 \u043F\u043E\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u044F.",text:"V tejto vymyslenej hernej situ\xE1cii \u0161tudijn\xE9 oddelenie odpoved\xE1: Prihl\xE1\u0161ku sme dostali. V pr\xEDlohe v\u0161ak nevid\xEDme preh\u013Ead absolvovan\xFDch predmetov. Po\u0161lite ho, pros\xEDm, do piatka. Ak ho dovtedy nebudete ma\u0165, nap\xED\u0161te n\xE1m a dohodneme sa na \u010Fal\u0161om postupe. Zatia\u013E neposielajte origin\xE1ly dokumentov. Po doplnen\xED pr\xEDlohy v\xE1m potvrd\xEDme, \u017Ee je va\u0161a \u017Eiados\u0165 \xFApln\xE1. Toto je iba jazykov\xE9 cvi\u010Denie, nie pokyn skuto\u010Dnej univerzity.",options:["Bez vysvetlenia \u010Daka\u0165 mesiac.","Okam\u017Eite posla\u0165 v\u0161etky origin\xE1ly.","Nap\xEDsa\u0165 oddeleniu a dohodn\xFA\u0165 \u010Fal\u0161\xED postup.","Zru\u0161i\u0165 prihl\xE1\u0161ku."],answer:"Nap\xEDsa\u0165 oddeleniu a dohodn\xFA\u0165 \u010Fal\u0161\xED postup."},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0432 \u043F\u0440\u043E\u043F\u0443\u0441\u043A.",explanation:"\u0412\u043E\u043F\u0440\u043E\u0441 \xAB\u043C\u043E\u0433\u0443 \u043B\u0438?\xBB \u0432\u0432\u043E\u0434\u0438\u0442\u0441\u044F \u0441\u043E\u044E\u0437\u043E\u043C \u010Di.",sk:"Chcel by som vedie\u0165, ___ m\xF4\u017Eem pr\xEDlohu posla\u0165 nesk\xF4r.",options:["ktor\xFD","\u010Di","preto","aby"],answer:"\u010Di"},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0432 \u043F\u0440\u043E\u043F\u0443\u0441\u043A.",explanation:"\u0421\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u043C \u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043D\u0430\u0447\u0430\u043B\u0430: kedy.",sk:"Pros\xEDm o inform\xE1ciu, ___ sa za\u010D\xEDna pr\xEDpravn\xFD kurz.",options:["kedy","ktor\xFA","preto\u017Ee","napriek"],answer:"kedy"},{type:"choice",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u043D\u0430\u0438\u0431\u043E\u043B\u0435\u0435 \u0442\u043E\u0447\u043D\u044B\u0439 \u0432\u043E\u043F\u0440\u043E\u0441 \u043E \u0444\u043E\u0440\u043C\u0435 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430.",explanation:"\u0412\u043E\u043F\u0440\u043E\u0441 \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0439 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442 \u0438 \u0444\u043E\u0440\u043C\u0430\u0442, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043D\u0430 \u043D\u0435\u0433\u043E \u043C\u043E\u0436\u043D\u043E \u0434\u0430\u0442\u044C \u043E\u0434\u043D\u043E\u0437\u043D\u0430\u0447\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442.",options:["Je to dobr\xE9?","Ako to je?","Sta\u010D\xED v tejto hernej situ\xE1cii elektronick\xE1 k\xF3pia preh\u013Eadu predmetov?","Urob\xEDte v\u0161etko?"],answer:"Sta\u010D\xED v tejto hernej situ\xE1cii elektronick\xE1 k\xF3pia preh\u013Eadu predmetov?"},{type:"order",prompt:"\u0421\u043E\u0431\u0435\u0440\u0438 \u043F\u0440\u043E\u0441\u044C\u0431\u0443 \xAB\u041F\u0440\u043E\u0448\u0443 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0435 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u044F\xBB, \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 Pros\xEDm.",explanation:"Pros\xEDm o + \u0432\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439; prijatia spr\xE1vy \u0443\u0442\u043E\u0447\u043D\u044F\u0435\u0442, \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0435 \u0447\u0435\u0433\u043E \u0437\u0430\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F.",answer:["Pros\xEDm","o","potvrdenie","prijatia","spr\xE1vy."]},{type:"typing",prompt:"\u041D\u0430\u043F\u0438\u0448\u0438 \u043F\u043E-\u0441\u043B\u043E\u0432\u0430\u0446\u043A\u0438 \xAB\u0443\u0447\u0435\u0431\u043D\u044B\u0439 \u043E\u0442\u0434\u0435\u043B\xBB \u0438\u0437 \u0441\u043B\u043E\u0432\u0430\u0440\u044F \u044D\u0442\u043E\u0439 \u043C\u0438\u0441\u0441\u0438\u0438.",explanation:"\u042D\u0442\u043E \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0435 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u043F\u043E\u0434\u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u044F, \u0441 \u043A\u043E\u0442\u043E\u0440\u044B\u043C \u043E\u0431\u044B\u0447\u043D\u043E \u0441\u0432\u044F\u0437\u0430\u043D\u044B \u0443\u0447\u0435\u0431\u043D\u044B\u0435 \u0430\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u0435 \u0432\u043E\u043F\u0440\u043E\u0441\u044B.",answer:"\u0161tudijn\xE9 oddelenie"},{type:"listening",prompt:"\u0427\u0442\u043E \u043F\u0440\u043E\u0441\u0438\u0442 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C?",explanation:"\u041D\u0443\u0436\u043D\u043E \u0443\u0442\u043E\u0447\u043D\u0438\u0442\u044C, \u043A \u043A\u0430\u043A\u043E\u043C\u0443 \u0437\u0430\u044F\u0432\u043B\u0435\u043D\u0438\u044E \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u0444\u0430\u0439\u043B. \u041F\u043E\u0432\u0442\u043E\u0440\u043D\u0430\u044F \u043E\u0442\u043F\u0440\u0430\u0432\u043A\u0430 \u043F\u0440\u044F\u043C\u043E \u043D\u0430\u0437\u0432\u0430\u043D\u0430 \u043D\u0435\u043D\u0443\u0436\u043D\u043E\u0439.",audio:"Dobr\xFD de\u0148, pr\xEDlohu sme u\u017E dostali, ale n\xE1zov s\xFAboru nie je jasn\xFD. Pros\xEDm, nap\xED\u0161te n\xE1m, ku ktorej prihl\xE1\u0161ke patr\xED. Samotn\xFD s\xFAbor nemus\xEDte posiela\u0165 znova.",options:["Posla\u0165 s\xFAbor e\u0161te raz.","Vysvetli\u0165, ku ktorej prihl\xE1\u0161ke s\xFAbor patr\xED.","Zaplati\u0165 poplatok.","Prinies\u0165 origin\xE1l osobne."],answer:"Vysvetli\u0165, ku ktorej prihl\xE1\u0161ke s\xFAbor patr\xED."},{type:"writing",prompt:"\u0412 \u0443\u0447\u0435\u0431\u043D\u043E\u043C \u0441\u0446\u0435\u043D\u0430\u0440\u0438\u0438 \u043D\u0430\u043F\u0438\u0448\u0438 120\u2013160 \u0441\u043B\u043E\u0432 \u0432 \u0443\u0447\u0435\u0431\u043D\u044B\u0439 \u043E\u0442\u0434\u0435\u043B: \u043D\u0430\u0437\u043E\u0432\u0438 \u0438\u043D\u0442\u0435\u0440\u0435\u0441 \u043A \u043C\u0430\u0433\u0438\u0441\u0442\u0440\u0430\u0442\u0443\u0440\u0435 \u043F\u043E \u043F\u043E\u043B\u0438\u0442\u043E\u043B\u043E\u0433\u0438\u0438 \u0438 \u0441\u043F\u0440\u043E\u0441\u0438 \u043E \u0444\u043E\u0440\u043C\u0430\u0442\u0435 \u043A\u043E\u043F\u0438\u0438 \u0434\u0438\u043F\u043B\u043E\u043C\u0430, \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0435 \u0438 \u043C\u043E\u043C\u0435\u043D\u0442\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u043E\u0432. \u041D\u0435 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0439, \u0447\u0442\u043E \u0432\u044B\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u044B\u0435 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F \u0440\u0435\u0430\u043B\u044C\u043D\u044B.",explanation:"\u042D\u0442\u043E \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u043F\u0438\u0441\u044C\u043C\u0435\u043D\u043D\u0430\u044F \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0430: \u0441\u0440\u0430\u0432\u043D\u0438 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435 \u0438 \u044F\u0437\u044B\u043A \u0441 \u043E\u0431\u0440\u0430\u0437\u0446\u043E\u043C. \u041E\u0431\u044A\u0451\u043C \u0442\u0435\u043A\u0441\u0442\u0430 \u0441\u0430\u043C \u043F\u043E \u0441\u0435\u0431\u0435 \u043D\u0435 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442 \u0443\u0440\u043E\u0432\u0435\u043D\u044C CEFR.",answer:"",minWords:120,model:"Dobr\xFD de\u0148, zauj\xEDmam sa o magistersk\xE9 \u0161t\xFAdium politol\xF3gie a pripravujem si podklady k prihl\xE1\u0161ke. Obraciam sa na v\xE1s s prosbou o spresnenie po\u017Eadovanej formy dokumentov. Mohli by ste mi, pros\xEDm, poveda\u0165, \u010Di je pri podan\xED prihl\xE1\u0161ky potrebn\xE1 overen\xE1 k\xF3pia diplomu, alebo sta\u010D\xED elektronick\xE1 k\xF3pia? Chcel by som si tie\u017E overi\u0165, ak\xFD preklad dokladu akceptujete a v ktorej f\xE1ze prij\xEDmacieho konania ho m\xE1m predlo\u017Ei\u0165. Ak sa na jednotliv\xE9 dokumenty vz\u0165ahuj\xFA odli\u0161n\xE9 term\xEDny, bol by som v\u010Fa\u010Dn\xFD za ich vysvetlenie. Nechcem posiela\u0165 ne\xFApln\xFA prihl\xE1\u0161ku ani nespr\xE1vnu verziu pr\xEDloh. Ak s\xFA tieto inform\xE1cie uveden\xE9 v ofici\xE1lnych pokynoch, pros\xEDm o odkaz na pr\xEDslu\u0161n\xFA str\xE1nku. Vopred v\xE1m \u010Fakujem za pomoc a za v\xE1\u0161 \u010Das. S pozdravom, z\xE1ujemca o \u0161t\xFAdium. R\xE1d dopln\xEDm \u010Fal\u0161ie \xFAdaje, ktor\xE9 v\xE1m pom\xF4\u017Eu presnej\u0161ie pos\xFAdi\u0165 moju ot\xE1zku.",checklist:["\u041F\u0438\u0441\u044C\u043C\u043E \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442 \u0442\u0440\u0438 \u0442\u043E\u0447\u043D\u044B\u0445 \u0432\u043E\u043F\u0440\u043E\u0441\u0430, \u0430 \u043D\u0435 \u0434\u043E\u0433\u0430\u0434\u043A\u0438 \u043E \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F\u0445.","\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u044B \u010Di \u0438 \u0432\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u0441\u043B\u043E\u0432\u043E \u0432 \u043A\u043E\u0441\u0432\u0435\u043D\u043D\u043E\u043C \u0432\u043E\u043F\u0440\u043E\u0441\u0435.","\u0415\u0441\u0442\u044C \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435, \u0446\u0435\u043B\u044C \u0438 \u0432\u0435\u0436\u043B\u0438\u0432\u043E\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435.","\u0421\u043E\u0431\u043B\u044E\u0434\u0435\u043D\u044B \u0437\u0430\u043F\u044F\u0442\u044B\u0435 \u043F\u0435\u0440\u0435\u0434 \u043F\u0440\u0438\u0434\u0430\u0442\u043E\u0447\u043D\u044B\u043C\u0438."]}]},{id:"b1-06",level:"B1",title:"\u0421\u0432\u043E\u044F \u0442\u043E\u0447\u043A\u0430 \u0437\u0440\u0435\u043D\u0438\u044F",location:"\u0421\u0442\u0443\u0434\u0435\u043D\u0447\u0435\u0441\u043A\u043E\u0435 \u043A\u0430\u0444\u0435",scene:"\u041D\u0438\u043D\u0430 \u0438 \u041C\u0430\u0442\u0435\u0439 \u0441\u043F\u043E\u0440\u044F\u0442 \u043E \u0437\u0430\u043D\u044F\u0442\u0438\u044F\u0445 \u043E\u043D\u043B\u0430\u0439\u043D. \u0422\u0432\u043E\u044F \u0437\u0430\u0434\u0430\u0447\u0430 \u2014 \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C \u043C\u043D\u0435\u043D\u0438\u0435 \u0438 \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C \u0434\u043E\u0432\u043E\u0434\u044B \u043E\u0431\u043E\u0438\u0445.",goal:"\u0421\u0440\u0430\u0432\u043D\u0438\u0442\u044C \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u044B \u0438 \u043E\u0431\u043E\u0441\u043D\u043E\u0432\u0430\u0442\u044C \u043F\u043E\u0437\u0438\u0446\u0438\u044E.",grammar:{title:"\u041F\u0440\u0438\u0447\u0438\u043D\u0430, \u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0435 \u0438 \u043F\u0440\u0438\u043C\u0435\u0440",body:"Preto\u017Ee \u0432\u0432\u043E\u0434\u0438\u0442 \u043F\u0440\u0438\u0447\u0438\u043D\u0443: Ostal som doma, preto\u017Ee som bol unaven\xFD. Preto \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043D\u0430 \u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0435: Bol som unaven\xFD, preto som ostal doma. \u042D\u0442\u0438 \u0441\u043B\u043E\u0432\u0430 \u043F\u043E\u0445\u043E\u0436\u0438, \u043D\u043E \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C \u0438\u0445 \u0431\u0435\u0437 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u044B \u043D\u0435\u043B\u044C\u0437\u044F. \u0414\u043B\u044F \u043B\u0438\u0447\u043D\u043E\u0433\u043E \u043C\u043D\u0435\u043D\u0438\u044F \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0442 Pod\u013Ea m\u0148a\u2026 \u0438 Mysl\xEDm si, \u017Ee\u2026. \u041F\u043E\u0441\u043B\u0435 mysl\xEDm si \u0441\u0442\u0430\u0432\u0438\u0442\u0441\u044F \u0437\u0430\u043F\u044F\u0442\u0430\u044F \u043F\u0435\u0440\u0435\u0434 \u017Ee. \u0424\u0440\u0430\u0437\u0430 S\xFAhlas\xEDm s t\xFDmto n\xE1zorom \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0442\u0432\u043E\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043F\u0430\u0434\u0435\u0436\u0430 \u043F\u043E\u0441\u043B\u0435 s. \u0427\u0442\u043E\u0431\u044B \u043C\u043D\u0435\u043D\u0438\u0435 \u0441\u0442\u0430\u043B\u043E \u0430\u0440\u0433\u0443\u043C\u0435\u043D\u0442\u043E\u043C, \u0434\u043E\u0431\u0430\u0432\u044C \u043F\u0440\u0438\u0447\u0438\u043D\u0443, \u0437\u0430\u0442\u0435\u043C \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0439 \u043F\u0440\u0438\u043C\u0435\u0440 \u0441 napr\xEDklad. \u041F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u043E\u043B\u043E\u0436\u043D\u0443\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u043C\u043E\u0436\u043D\u043E \u0432\u0432\u0435\u0441\u0442\u0438 \u0447\u0435\u0440\u0435\u0437 na druhej strane. \u041D\u0435 \u043F\u043E\u0434\u043C\u0435\u043D\u044F\u0439 \u0447\u0443\u0436\u0443\u044E \u043F\u043E\u0437\u0438\u0446\u0438\u044E \u0431\u043E\u043B\u0435\u0435 \u0441\u0438\u043B\u044C\u043D\u044B\u043C \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0435\u043C: \xAB\u0438\u043D\u043E\u0433\u0434\u0430 \u0443\u0434\u043E\u0431\u043D\u0435\u0435\xBB \u043D\u0435 \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \xAB\u0432\u0441\u0435\u0433\u0434\u0430 \u043B\u0443\u0447\u0448\u0435\xBB.",examples:[{sk:"U\u010D\xEDm sa doma, preto\u017Ee tam m\xE1m pokoj.",ru:"\u042F \u0437\u0430\u043D\u0438\u043C\u0430\u044E\u0441\u044C \u0434\u043E\u043C\u0430, \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0442\u0430\u043C \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E."},{sk:"Cesta je dlh\xE1, preto si vyber\xE1m online kurz.",ru:"\u0414\u043E\u0440\u043E\u0433\u0430 \u0434\u043E\u043B\u0433\u0430\u044F, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u044F \u0432\u044B\u0431\u0438\u0440\u0430\u044E \u043E\u043D\u043B\u0430\u0439\u043D-\u043A\u0443\u0440\u0441."}]},words:[{sk:"n\xE1zor",ru:"\u043C\u043D\u0435\u043D\u0438\u0435",example:"R\xE1d by som vysvetlil svoj n\xE1zor.",translation:"\u042F \u0445\u043E\u0442\u0435\u043B \u0431\u044B \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C \u0441\u0432\u043E\u0451 \u043C\u043D\u0435\u043D\u0438\u0435."},{sk:"d\xF4vod",ru:"\u043F\u0440\u0438\u0447\u0438\u043D\u0430; \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0435",example:"Ak\xFD je hlavn\xFD d\xF4vod tvojho rozhodnutia?",translation:"\u041A\u0430\u043A\u043E\u0432\u0430 \u0433\u043B\u0430\u0432\u043D\u0430\u044F \u043F\u0440\u0438\u0447\u0438\u043D\u0430 \u0442\u0432\u043E\u0435\u0433\u043E \u0440\u0435\u0448\u0435\u043D\u0438\u044F?"},{sk:"v\xFDhoda",ru:"\u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E",example:"V\xFDhodou kurzu je mal\xE1 skupina.",translation:"\u041F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E \u043A\u0443\u0440\u0441\u0430 \u2014 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F \u0433\u0440\u0443\u043F\u043F\u0430."},{sk:"nev\xFDhoda",ru:"\u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u043A",example:"Nev\xFDhodou je dlh\xE1 cesta.",translation:"\u041D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u043A \u2014 \u0434\u043E\u043B\u0433\u0430\u044F \u0434\u043E\u0440\u043E\u0433\u0430."},{sk:"s\xFAhlasi\u0165",ru:"\u0441\u043E\u0433\u043B\u0430\u0448\u0430\u0442\u044C\u0441\u044F",example:"S t\xFDmto n\xE1vrhom s\xFAhlas\xEDm.",translation:"\u042F \u0441\u043E\u0433\u043B\u0430\u0441\u0435\u043D \u0441 \u044D\u0442\u0438\u043C \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435\u043C."},{sk:"nes\xFAhlasi\u0165",ru:"\u043D\u0435 \u0441\u043E\u0433\u043B\u0430\u0448\u0430\u0442\u044C\u0441\u044F",example:"Nes\xFAhlas\xEDm s t\xFDmto z\xE1verom.",translation:"\u042F \u043D\u0435 \u0441\u043E\u0433\u043B\u0430\u0441\u0435\u043D \u0441 \u044D\u0442\u0438\u043C \u0432\u044B\u0432\u043E\u0434\u043E\u043C."},{sk:"porovna\u0165",ru:"\u0441\u0440\u0430\u0432\u043D\u0438\u0442\u044C",example:"Sk\xFAsme porovna\u0165 obidve mo\u017Enosti.",translation:"\u0414\u0430\u0432\u0430\u0439 \u0441\u0440\u0430\u0432\u043D\u0438\u043C \u043E\u0431\u0430 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0430."},{sk:"vysvetli\u0165",ru:"\u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C",example:"M\xF4\u017Eete vysvetli\u0165 svoj postup?",translation:"\u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C \u0441\u0432\u043E\u0439 \u043F\u043E\u0434\u0445\u043E\u0434?"},{sk:"napr\xEDklad",ru:"\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440",example:"M\xF4\u017Eeme sa stretn\xFA\u0165 napr\xEDklad v kni\u017Enici.",translation:"\u041C\u044B \u043C\u043E\u0436\u0435\u043C \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C\u0441\u044F, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u0432 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0435."},{sk:"preto\u017Ee",ru:"\u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E",example:"Zostal som doma, preto\u017Ee pr\u0161alo.",translation:"\u042F \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u0434\u043E\u043C\u0430, \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0448\u0451\u043B \u0434\u043E\u0436\u0434\u044C."}],exercises:[{type:"reading",prompt:"\u041D\u0430 \u0447\u0451\u043C \u0441\u043E\u0448\u043B\u0438\u0441\u044C \u041D\u0438\u043D\u0430 \u0438 \u041C\u0430\u0442\u0435\u0439?",explanation:"\u041E\u043D\u0438 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u044E\u0442 \u0441\u043E\u0447\u0435\u0442\u0430\u0442\u044C \u0444\u043E\u0440\u043C\u0430\u0442\u044B: \u0442\u0435\u043E\u0440\u0438\u044F \u043E\u043D\u043B\u0430\u0439\u043D, \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u044F \u043E\u0447\u043D\u043E. \u042D\u0442\u043E \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u0437\u0430\u0434\u0430\u0447\u0438.",text:"Nina m\xE1 rada online predn\xE1\u0161ky, preto\u017Ee nemus\xED cestova\u0165. Ke\u010F v\u0161ak pripravuje spolo\u010Dn\xFD projekt, uprednost\u0148uje osobn\xE9 stretnutie. Matej sa doma \u013Eahko rozpt\xFDli, a preto sa mu lep\u0161ie \u0161tuduje v u\u010Debni. Obaja sa zhodli, \u017Ee jeden sp\xF4sob nemus\xED by\u0165 najlep\u0161\xED pre v\u0161etky predmety. Navrhli kombin\xE1ciu: teoretick\xE9 predn\xE1\u0161ky sledova\u0165 online a praktick\xE9 \xFAlohy rie\u0161i\u0165 spolu na univerzite.",options:["Ka\u017Ed\xFD predmet m\xE1 by\u0165 iba online.","Osobn\xE9 stretnutia nemaj\xFA v\xFDznam.","Sp\xF4sob v\xFDu\u010Dby m\xE1 z\xE1visie\u0165 aj od typu \xFAlohy.","Nina nechce pracova\u0165 v skupine."],answer:"Sp\xF4sob v\xFDu\u010Dby m\xE1 z\xE1visie\u0165 aj od typu \xFAlohy."},{type:"cloze",prompt:"\u0412\u044B\u0440\u0430\u0437\u0438 \u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0435: \u043A\u0443\u0440\u0441 \u0440\u044F\u0434\u043E\u043C, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043D\u0435 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0434\u043E\u043B\u0433\u043E \u0435\u0445\u0430\u0442\u044C. \u0412\u044B\u0431\u0435\u0440\u0438 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0443\u044E \u0441\u0432\u044F\u0437\u043A\u0443.",explanation:"\u0411\u043B\u0438\u0437\u043E\u0441\u0442\u044C \u043A\u0443\u0440\u0441\u0430 \u2014 \u043F\u0440\u0438\u0447\u0438\u043D\u0430, \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0434\u043E\u043B\u0433\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u0438 \u2014 \u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0435. \u041F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 preto.",sk:"Kurz je bl\xEDzko, ___ nemus\xEDm dlho cestova\u0165.",options:["preto\u017Ee","preto","aby","ktor\xFD"],answer:"preto"},{type:"cloze",prompt:"\u041D\u0430\u0437\u043E\u0432\u0438 \u043F\u0440\u0438\u0447\u0438\u043D\u0443 \u0432\u044B\u0431\u043E\u0440\u0430 \u043A\u043D\u0438\u0433\u0438: \xAB\u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0432 \u043D\u0435\u0439 \u043C\u043D\u043E\u0433\u043E \u043F\u0440\u0438\u043C\u0435\u0440\u043E\u0432\xBB. \u0412\u044B\u0431\u0435\u0440\u0438 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0443\u044E \u0441\u0432\u044F\u0437\u043A\u0443.",explanation:"\u041F\u043E\u0441\u043B\u0435 \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430 \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442\u0441\u044F \u043F\u0440\u0438\u0447\u0438\u043D\u0430 \u0432\u044B\u0431\u043E\u0440\u0430: \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0432 \u043A\u043D\u0438\u0433\u0435 \u043C\u043D\u043E\u0433\u043E \u043F\u0440\u0438\u043C\u0435\u0440\u043E\u0432.",sk:"Vybral som si t\xFAto knihu, ___ obsahuje ve\u013Ea pr\xEDkladov.",options:["preto","napriek","preto\u017Ee","hoci"],answer:"preto\u017Ee"},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0432 \u043F\u0440\u043E\u043F\u0443\u0441\u043A.",explanation:"S\xFAhlasi\u0165 s + \u0442\u0432\u043E\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043F\u0430\u0434\u0435\u0436: s n\xE1zorom.",sk:"S tvoj\xEDm ___ s\xFAhlas\xEDm.",options:["n\xE1zor","n\xE1zoru","n\xE1zore","n\xE1zorom"],answer:"n\xE1zorom"},{type:"choice",prompt:"\u041A\u0430\u043A\u0430\u044F \u0440\u0435\u043F\u043B\u0438\u043A\u0430 \u0432\u0435\u0436\u043B\u0438\u0432\u043E \u0432\u044B\u0440\u0430\u0436\u0430\u0435\u0442 \u043D\u0435\u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0435 \u0438 \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442 \u0435\u0433\u043E?",explanation:"\u0420\u0435\u043F\u043B\u0438\u043A\u0430 \u043F\u0440\u0438\u0437\u043D\u0430\u0451\u0442 \u0447\u0443\u0436\u0443\u044E \u043F\u043E\u0437\u0438\u0446\u0438\u044E \u0438 \u043F\u0440\u0438\u0432\u043E\u0434\u0438\u0442 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u0443\u044E \u043B\u0438\u0447\u043D\u0443\u044E \u043F\u0440\u0438\u0447\u0438\u043D\u0443 \u043D\u0435\u0441\u043E\u0433\u043B\u0430\u0441\u0438\u044F.",options:["Nem\xE1\u0161 pravdu a hotovo.","Rozumiem tvojmu n\xE1zoru, ale osobn\xE9 stretnutie mi pom\xE1ha lep\u0161ie sa s\xFAstredi\u0165.","V\u0161etci si myslia to ist\xE9.","O tejto t\xE9me sa nikdy nebav\xEDm."],answer:"Rozumiem tvojmu n\xE1zoru, ale osobn\xE9 stretnutie mi pom\xE1ha lep\u0161ie sa s\xFAstredi\u0165."},{type:"order",prompt:"\u0421\u043E\u0431\u0435\u0440\u0438 \u0444\u0440\u0430\u0437\u0443 \xAB\u042F \u0434\u0443\u043C\u0430\u044E, \u0447\u0442\u043E \u044D\u0442\u043E \u043F\u043E\u043B\u0435\u0437\u043D\u043E\xBB, \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 Mysl\xEDm.",explanation:"\u0412\u043E\u0437\u0432\u0440\u0430\u0442\u043D\u043E\u0435 si \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u043A mysl\xEDm; \u043F\u0435\u0440\u0435\u0434 \u043F\u0440\u0438\u0434\u0430\u0442\u043E\u0447\u043D\u044B\u043C \u0441 \u017Ee \u0441\u0442\u0430\u0432\u0438\u0442\u0441\u044F \u0437\u0430\u043F\u044F\u0442\u0430\u044F.",answer:["Mysl\xEDm","si,","\u017Ee","je","to","u\u017Eito\u010Dn\xE9."],acceptedOrders:[["Mysl\xEDm","si,","\u017Ee","to","je","u\u017Eito\u010Dn\xE9."]]},{type:"typing",prompt:"\u041D\u0430\u043F\u0438\u0448\u0438 \u043F\u043E-\u0441\u043B\u043E\u0432\u0430\u0446\u043A\u0438 \xAB\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440\xBB \u0438\u0437 \u0441\u043B\u043E\u0432\u0430\u0440\u044F \u043C\u0438\u0441\u0441\u0438\u0438.",explanation:"Napr\xEDklad \u0432\u0432\u043E\u0434\u0438\u0442 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0439 \u043F\u0440\u0438\u043C\u0435\u0440, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u043E\u0431\u0449\u0435\u0435 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0435.",answer:"napr\xEDklad"},{type:"speaking",prompt:"\u0421\u0440\u0430\u0432\u043D\u0438 \u0437\u0430\u043D\u044F\u0442\u0438\u044F \u0434\u043E\u043C\u0430 \u0438 \u0432 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0435. \u041D\u0430\u0437\u043E\u0432\u0438 \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443 \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0443 \u0438 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043A\u0443, \u0437\u0430\u0442\u0435\u043C \u043E\u0431\u044A\u044F\u0441\u043D\u0438 \u0441\u0432\u043E\u0439 \u0432\u044B\u0431\u043E\u0440.",explanation:"\u042D\u0442\u043E \u0443\u0441\u0442\u043D\u0430\u044F \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0430 \u0441 \u0441\u0430\u043C\u043E\u043E\u0446\u0435\u043D\u043A\u043E\u0439. \u041E\u0446\u0435\u043D\u0438 \u043F\u043E\u043D\u044F\u0442\u043D\u043E\u0441\u0442\u044C, \u0441\u0432\u044F\u0437\u043D\u043E\u0441\u0442\u044C \u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u044F; \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u043E\u0446\u0435\u043D\u043A\u0430 \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0448\u0435\u043D\u0438\u044F \u0437\u0434\u0435\u0441\u044C \u043D\u0435 \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u0430\u0433\u0430\u0435\u0442\u0441\u044F.",answer:"",targetSeconds:60,model:"Pod\u013Ea m\u0148a z\xE1vis\xED vhodn\xE9 miesto od \xFAlohy. Doma m\xE1m pohodlie a nemus\xEDm cestova\u0165. Nev\xFDhodou je, \u017Ee ma \u010Dasto vyru\u0161uje telef\xF3n alebo dom\xE1ce povinnosti. V kni\u017Enici sa mi lep\u0161ie s\xFAstred\xED, preto\u017Ee ostatn\xED \u013Eudia tie\u017E \u0161tuduj\xFA. Na druhej strane sa mus\xEDm prisp\xF4sobi\u0165 otv\xE1rac\xEDm hodin\xE1m. Kr\xE1tke opakovanie rob\xEDm doma, ale na dlh\u0161ie \u010D\xEDtanie si vyber\xE1m kni\u017Enicu. Takto vyu\u017E\xEDvam v\xFDhody oboch mo\u017Enost\xED.",checklist:["\u0421\u0440\u0430\u0432\u043D\u0435\u043D\u044B \u043E\u0431\u0430 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0430.","\u0415\u0441\u0442\u044C \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0430, \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043A\u0438 \u0438 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439 \u0432\u044B\u0431\u043E\u0440.","Preto \u0438 preto\u017Ee \u0443\u043F\u043E\u0442\u0440\u0435\u0431\u043B\u0435\u043D\u044B \u043F\u043E \u0441\u043C\u044B\u0441\u043B\u0443.","\u041C\u043D\u0435\u043D\u0438\u0435 \u043F\u043E\u0434\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u043E \u0445\u043E\u0442\u044F \u0431\u044B \u043E\u0434\u043D\u0438\u043C \u043F\u0440\u0438\u043C\u0435\u0440\u043E\u043C."]}]},{id:"b1-07",level:"B1",title:"\u041F\u043E\u0435\u0437\u0434\u043A\u0430 \u0441 \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u0435\u043C",location:"\u0416\u0435\u043B\u0435\u0437\u043D\u043E\u0434\u043E\u0440\u043E\u0436\u043D\u0430\u044F \u0441\u0442\u0430\u043D\u0446\u0438\u044F",scene:"\u0412 \u0443\u0447\u0435\u0431\u043D\u043E\u0439 \u043F\u043E\u0435\u0437\u0434\u043A\u0435 \u0432\u043E\u0437\u043D\u0438\u043A\u043B\u0430 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0430. \u041D\u0443\u0436\u043D\u043E \u043F\u043E\u043D\u044F\u0442\u044C \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u0435 \u0438 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0443, \u043A\u0430\u043A\u0430\u044F \u043F\u043E\u043C\u043E\u0449\u044C \u0442\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u0430.",goal:"\u041F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B \u0438 \u0441\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043F\u043E\u043D\u044F\u0442\u043D\u043E\u0435 \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u0435.",grammar:{title:"\u0412\u0435\u0436\u043B\u0438\u0432\u0430\u044F \u0436\u0430\u043B\u043E\u0431\u0430 \u0438 \u043F\u0440\u0438\u0447\u0438\u043D\u0430 \u0441 kv\xF4li",body:"\u041E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u0435 \u043E \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0435 \u043B\u0435\u0433\u0447\u0435 \u043F\u043E\u043D\u044F\u0442\u044C, \u043A\u043E\u0433\u0434\u0430 \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u043E\u043F\u0438\u0441\u0430\u043D\u043E \u0441\u043E\u0431\u044B\u0442\u0438\u0435, \u0437\u0430\u0442\u0435\u043C \u0435\u0433\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0435 \u0438 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u0430\u044F \u043F\u0440\u043E\u0441\u044C\u0431\u0430. \u0412\u043C\u0435\u0441\u0442\u043E \u043E\u0431\u0432\u0438\u043D\u0435\u043D\u0438\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u0442\u043E\u0447\u043D\u0443\u044E \u0444\u0440\u0430\u0437\u0443: Vlak me\u0161kal a nestihol som pr\xEDpoj. Kv\xF4li \u043E\u0431\u044B\u0447\u043D\u043E \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0434\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043F\u0430\u0434\u0435\u0436\u0430: kv\xF4li me\u0161kaniu. \u0421\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0435 po\u017Eiada\u0165 o \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0432\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E: po\u017Eiada\u0165 o inform\xE1ciu. \u0414\u043B\u044F \u0441\u043C\u044F\u0433\u0447\u0451\u043D\u043D\u043E\u0439 \u043F\u0440\u043E\u0441\u044C\u0431\u044B \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 Chcel by som po\u017Eiada\u0165 o pomoc. \u041E\u0442\u043B\u0438\u0447\u0430\u0439 \u0444\u0430\u043A\u0442 \u043E\u0442 \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u044F: \xAB\u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A \u043E\u0431\u0435\u0449\u0430\u043B \u043E\u0442\u0432\u0435\u0442\xBB \u0438 \xAB\u044F \u043D\u0430\u0434\u0435\u044E\u0441\u044C \u043D\u0430 \u043E\u0442\u0432\u0435\u0442\xBB \u2014 \u0440\u0430\u0437\u043D\u044B\u0435 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u044F. \u0412 \u044D\u0442\u043E\u0439 \u043C\u0438\u0441\u0441\u0438\u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u0430 \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u043A\u0438 \u0432\u044B\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u044B\u0435; \u044F\u0437\u044B\u043A\u043E\u0432\u044B\u0435 \u0444\u043E\u0440\u043C\u0443\u043B\u044B \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442 \u0437\u0430\u0434\u0430\u0442\u044C \u0432\u043E\u043F\u0440\u043E\u0441, \u043D\u043E \u0441\u0430\u043C\u0438 \u043F\u043E \u0441\u0435\u0431\u0435 \u043D\u0435 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044E\u0442 \u043F\u0440\u0430\u0432\u043E \u043D\u0430 \u0432\u044B\u043F\u043B\u0430\u0442\u0443 \u0438\u043B\u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0442.",examples:[{sk:"Kv\xF4li me\u0161kaniu som nestihol pr\xEDpoj.",ru:"\u0418\u0437-\u0437\u0430 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0438 \u044F \u043D\u0435 \u0443\u0441\u043F\u0435\u043B \u043D\u0430 \u043F\u0435\u0440\u0435\u0441\u0430\u0434\u043A\u0443."},{sk:"Chcel by som po\u017Eiada\u0165 o vysvetlenie.",ru:"\u042F \u0445\u043E\u0442\u0435\u043B \u0431\u044B \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0440\u0430\u0437\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0435."}]},words:[{sk:"me\u0161kanie",ru:"\u043E\u043F\u043E\u0437\u0434\u0430\u043D\u0438\u0435; \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0430",example:"Vlak m\xE1 kr\xE1tke me\u0161kanie.",translation:"\u041F\u043E\u0435\u0437\u0434 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043E\u043F\u0430\u0437\u0434\u044B\u0432\u0430\u0435\u0442."},{sk:"n\xE1hradn\xFD spoj",ru:"\u0437\u0430\u043C\u0435\u043D\u044F\u044E\u0449\u0438\u0439 \u0440\u0435\u0439\u0441",example:"Kedy odch\xE1dza n\xE1hradn\xFD spoj?",translation:"\u041A\u043E\u0433\u0434\u0430 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0437\u0430\u043C\u0435\u043D\u044F\u044E\u0449\u0438\u0439 \u0440\u0435\u0439\u0441?"},{sk:"prestup",ru:"\u043F\u0435\u0440\u0435\u0441\u0430\u0434\u043A\u0430",example:"Na prestup m\xE1me desa\u0165 min\xFAt.",translation:"\u041D\u0430 \u043F\u0435\u0440\u0435\u0441\u0430\u0434\u043A\u0443 \u0443 \u043D\u0430\u0441 \u0434\u0435\u0441\u044F\u0442\u044C \u043C\u0438\u043D\u0443\u0442."},{sk:"cestovn\xFD poriadok",ru:"\u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u0435 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F",example:"Pozrite si aktu\xE1lny cestovn\xFD poriadok.",translation:"\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u0430\u043A\u0442\u0443\u0430\u043B\u044C\u043D\u043E\u0435 \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u0435."},{sk:"reklam\xE1cia",ru:"\u043F\u0440\u0435\u0442\u0435\u043D\u0437\u0438\u044F \u043F\u043E \u0443\u0441\u043B\u0443\u0433\u0435 \u0438\u043B\u0438 \u0442\u043E\u0432\u0430\u0440\u0443",example:"Chcel by som poda\u0165 reklam\xE1ciu.",translation:"\u042F \u0445\u043E\u0442\u0435\u043B \u0431\u044B \u043F\u043E\u0434\u0430\u0442\u044C \u043F\u0440\u0435\u0442\u0435\u043D\u0437\u0438\u044E."},{sk:"n\xE1hrada",ru:"\u0437\u0430\u043C\u0435\u043D\u0430; \u0432\u043E\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u0435",example:"P\xFDtam sa na mo\u017En\xFA n\xE1hradu.",translation:"\u042F \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u044E \u043E \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0439 \u0437\u0430\u043C\u0435\u043D\u0435 \u0438\u043B\u0438 \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0430\u0446\u0438\u0438."},{sk:"nefunk\u010Dn\xFD",ru:"\u043D\u0435\u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0449\u0438\u0439",example:"Automat na l\xEDstky je nefunk\u010Dn\xFD.",translation:"\u0410\u0432\u0442\u043E\u043C\u0430\u0442 \u043F\u043E \u043F\u0440\u043E\u0434\u0430\u0436\u0435 \u0431\u0438\u043B\u0435\u0442\u043E\u0432 \u043D\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442."},{sk:"ozn\xE1mi\u0165",ru:"\u0441\u043E\u043E\u0431\u0449\u0438\u0442\u044C; \u043E\u0431\u044A\u044F\u0432\u0438\u0442\u044C",example:"Pros\xEDm, ozn\xE1mte n\xE1m zmenu.",translation:"\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0441\u043E\u043E\u0431\u0449\u0438\u0442\u0435 \u043D\u0430\u043C \u043E\u0431 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0438."},{sk:"vyrie\u0161i\u0165",ru:"\u0440\u0435\u0448\u0438\u0442\u044C \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0443",example:"Chcel by som probl\xE9m vyrie\u0161i\u0165 pokojne.",translation:"\u042F \u0445\u043E\u0442\u0435\u043B \u0431\u044B \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E \u0440\u0435\u0448\u0438\u0442\u044C \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0443."},{sk:"ospravedlnenie",ru:"\u0438\u0437\u0432\u0438\u043D\u0435\u043D\u0438\u0435",example:"\u010Eakujem za vysvetlenie a ospravedlnenie.",translation:"\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0437\u0430 \u0440\u0430\u0437\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0435 \u0438 \u0438\u0437\u0432\u0438\u043D\u0435\u043D\u0438\u0435."}],exercises:[{type:"listening",prompt:"\u041A\u0443\u0434\u0430 \u0434\u043E\u043B\u0436\u043D\u044B \u043F\u043E\u0439\u0442\u0438 \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u044B \u0432 \u0443\u0447\u0435\u0431\u043D\u043E\u043C \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u0438?",explanation:"\u0417\u0430\u043C\u0435\u043D\u044F\u044E\u0449\u0438\u0439 \u0430\u0432\u0442\u043E\u0431\u0443\u0441 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043F\u0435\u0440\u0435\u0434 \u0433\u043B\u0430\u0432\u043D\u044B\u043C \u0432\u0445\u043E\u0434\u043E\u043C: spred hlavn\xE9ho vchodu.",audio:"V\xE1\u017Een\xED cestuj\xFAci, v na\u0161om cvi\u010Dnom pr\xEDbehu je vlak do Nitry odrieknut\xFD. N\xE1hradn\xFD autobus odch\xE1dza spred hlavn\xE9ho vchodu o dvadsa\u0165 min\xFAt. Ne\u010Dakajte na n\xE1stupi\u0161ti. Ak potrebujete pomoc, obr\xE1\u0165te sa na pracovn\xEDka pri informa\u010Dnej tabuli.",options:["Na p\xF4vodn\xE9 n\xE1stupi\u0161te.","Pred hlavn\xFD vchod.","Do in\xE9ho vlaku bez ot\xE1zok.","Do \u0161tudovne."],answer:"Pred hlavn\xFD vchod."},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0432 \u043F\u0440\u043E\u043F\u0443\u0441\u043A.",explanation:"\u041F\u043E\u0441\u043B\u0435 kv\xF4li \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u0434\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043F\u0430\u0434\u0435\u0436: kv\xF4li me\u0161kaniu.",sk:"Kv\xF4li ___ som nestihol \u010Fal\u0161\xED vlak.",options:["me\u0161kanie","me\u0161kania","me\u0161kaniu","me\u0161kan\xEDm"],answer:"me\u0161kaniu"},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0432 \u043F\u0440\u043E\u043F\u0443\u0441\u043A.",explanation:"Po\u017Eiada\u0165 o + \u0432\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043F\u0430\u0434\u0435\u0436: o inform\xE1ciu.",sk:"Chcel by som po\u017Eiada\u0165 o ___.",options:["inform\xE1cia","inform\xE1ciou","inform\xE1cii","inform\xE1ciu"],answer:"inform\xE1ciu"},{type:"reading",prompt:"\u041A\u0430\u043A\u043E\u0432\u0430 \u043E\u0441\u043D\u043E\u0432\u043D\u0430\u044F \u043F\u0440\u043E\u0441\u044C\u0431\u0430 \u0433\u043E\u0441\u0442\u044F?",explanation:"\u0413\u043E\u0441\u0442\u044C \u043F\u0440\u043E\u0441\u0438\u0442 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0442\u044C \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435 \u043F\u0435\u0440\u0435\u0434 \u043F\u0440\u0438\u0435\u0437\u0434\u043E\u043C \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0445 \u0433\u043E\u0441\u0442\u0435\u0439; \u043F\u0435\u0440\u0435\u0441\u0435\u043B\u0435\u043D\u0438\u0435 \u043E\u043D \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442.",text:"V ubytovan\xED nefungovalo svetlo nad pracovn\xFDm stolom. Hos\u0165 probl\xE9m ozn\xE1mil ve\u010Der. Pracovn\xED\u010Dka mu pon\xFAkla in\xFA lampu, ale hos\u0165 u\u017E odi\u0161iel do kni\u017Enice. Na druh\xFD de\u0148 nap\xEDsal, \u017Ee by ocenil kontrolu vybavenia pred pr\xEDchodom \u010Fal\u0161\xEDch host\xED. Nepo\u017Eadoval pres\u0165ahovanie, preto\u017Ee zvy\u0161ok izby bol v poriadku.",options:["Pres\u0165ahova\u0165 v\u0161etk\xFDch host\xED.","Zatvori\u0165 kni\u017Enicu.","Skontrolova\u0165 vybavenie pred \u010Fal\u0161\xEDm pobytom.","Vymeni\u0165 cel\xFD n\xE1bytok."],answer:"Skontrolova\u0165 vybavenie pred \u010Fal\u0161\xEDm pobytom."},{type:"choice",prompt:"\u041A\u0430\u043A\u0430\u044F \u0444\u0440\u0430\u0437\u0430 \u0442\u043E\u0447\u043D\u043E \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0443 \u0431\u0435\u0437 \u043D\u0435\u043E\u0431\u043E\u0441\u043D\u043E\u0432\u0430\u043D\u043D\u044B\u0445 \u043E\u0431\u0432\u0438\u043D\u0435\u043D\u0438\u0439?",explanation:"\u0423\u043A\u0430\u0437\u0430\u043D\u044B \u0432\u0440\u0435\u043C\u044F \u0438 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u0430\u044F \u043D\u0435\u0438\u0441\u043F\u0440\u0430\u0432\u043D\u043E\u0441\u0442\u044C; \u043D\u0430\u043C\u0435\u0440\u0435\u043D\u0438\u044F \u0440\u0430\u0431\u043E\u0442\u043D\u0438\u043A\u043E\u0432 \u043D\u0435 \u0432\u044B\u0434\u0443\u043C\u044B\u0432\u0430\u044E\u0442\u0441\u044F.",options:["Nikto tu nikdy ni\u010D nerob\xED.","V\u010Dera ve\u010Der nefungovalo svetlo nad stolom.","V\u0161etko je v\u017Edy hrozn\xE9.","Ur\u010Dite ste to pokazili \xFAmyselne."],answer:"V\u010Dera ve\u010Der nefungovalo svetlo nad stolom."},{type:"order",prompt:"\u0421\u043E\u0431\u0435\u0440\u0438 \u0432\u0435\u0436\u043B\u0438\u0432\u044B\u0439 \u0432\u043E\u043F\u0440\u043E\u0441 \xAB\u041D\u0435 \u043C\u043E\u0433\u043B\u0438 \u0431\u044B \u0432\u044B \u043C\u043D\u0435 \u043F\u043E\u043C\u043E\u0447\u044C?\xBB, \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 Mohli.",explanation:"Mohli by ste \u2014 \u0432\u0435\u0436\u043B\u0438\u0432\u0430\u044F \u0444\u043E\u0440\u043C\u0430; mi \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442, \u043A\u043E\u043C\u0443 \u043D\u0443\u0436\u043D\u0430 \u043F\u043E\u043C\u043E\u0449\u044C.",answer:["Mohli","by","ste","mi","pom\xF4c\u0165?"]},{type:"typing",prompt:"\u041D\u0430\u043F\u0438\u0448\u0438 \u043F\u043E-\u0441\u043B\u043E\u0432\u0430\u0446\u043A\u0438 \xAB\u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u0435 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F\xBB \u0438\u0437 \u0441\u043B\u043E\u0432\u0430\u0440\u044F.",explanation:"Cestovn\xFD poriadok \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u043A \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u044E \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u0430.",answer:"cestovn\xFD poriadok"},{type:"writing",prompt:"\u041D\u0430\u043F\u0438\u0448\u0438 120\u2013160 \u0441\u043B\u043E\u0432 \u043E\u0431 \u0443\u0447\u0435\u0431\u043D\u043E\u0439 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438: \u0432 \u0437\u0430\u0431\u0440\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439 \u043A\u043E\u043C\u043D\u0430\u0442\u0435 \u043D\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0441\u0432\u0435\u0442 \u043D\u0430\u0434 \u0441\u0442\u043E\u043B\u043E\u043C. \u041E\u043F\u0438\u0448\u0438 \u0444\u0430\u043A\u0442, \u043D\u0435\u0443\u0434\u043E\u0431\u0441\u0442\u0432\u043E, \u0443\u0436\u0435 \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u043D\u044F\u0442\u044B\u0439 \u0448\u0430\u0433 \u0438 \u0440\u0430\u0437\u0443\u043C\u043D\u0443\u044E \u043F\u0440\u043E\u0441\u044C\u0431\u0443.",explanation:"\u042D\u0442\u043E \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u043F\u0438\u0441\u044C\u043C\u0435\u043D\u043D\u0430\u044F \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0430: \u0441\u0440\u0430\u0432\u043D\u0438 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435 \u0438 \u044F\u0437\u044B\u043A \u0441 \u043E\u0431\u0440\u0430\u0437\u0446\u043E\u043C. \u041E\u0431\u044A\u0451\u043C \u0442\u0435\u043A\u0441\u0442\u0430 \u0441\u0430\u043C \u043F\u043E \u0441\u0435\u0431\u0435 \u043D\u0435 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442 \u0443\u0440\u043E\u0432\u0435\u043D\u044C CEFR.",answer:"",minWords:120,model:"Dobr\xFD de\u0148, obraciam sa na v\xE1s v s\xFAvislosti s moj\xEDm ned\xE1vnym pobytom vo va\u0161om ubytovan\xED. V izbe nefungovalo svetlo nad pracovn\xFDm stolom, hoci ostatn\xE9 osvetlenie bolo v poriadku. Ve\u010Der som si potreboval pripravi\u0165 pozn\xE1mky na nasleduj\xFAci de\u0148, preto mi t\xE1to porucha sp\xF4sobila nepr\xEDjemnosti. Probl\xE9m som ozn\xE1mil pracovn\xED\u010Dke, ktor\xE1 mi pon\xFAkla in\xFA lampu. V tom \u010Dase som v\u0161ak u\u017E odi\u0161iel \u0161tudova\u0165 do kni\u017Enice. Oce\u0148ujem, \u017Ee sa pracovn\xED\u010Dka sna\u017Eila n\xE1js\u0165 rie\u0161enie. Chcel by som v\xE1s po\u017Eiada\u0165, aby ste pred pr\xEDchodom \u010Fal\u0161\xEDch host\xED skontrolovali vybavenie pracovn\xE9ho stola. Pros\xEDm tie\u017E o kr\xE1tku odpove\u010F, \u010Di sa u\u017E podarilo poruchu odstr\xE1ni\u0165. Ne\u017Eiadam pres\u0165ahovanie, preto\u017Ee ostatn\xE9 podmienky mi vyhovovali. Moj\xEDm cie\u013Eom je upozorni\u0165 na konkr\xE9tny probl\xE9m a prispie\u0165 k tomu, aby sa nezopakoval. \u010Eakujem za pochopenie. Ver\xEDm, \u017Ee jednoduch\xE1 kontrola pom\xF4\u017Ee pred\xEDs\u0165 podobnej situ\xE1cii pri \u010Fal\u0161om pobyte.",checklist:["\u0423\u043A\u0430\u0437\u0430\u043D\u044B \u0444\u0430\u043A\u0442\u044B \u0431\u0435\u0437 \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0439 \u043E \u0447\u0443\u0436\u0438\u0445 \u043D\u0430\u043C\u0435\u0440\u0435\u043D\u0438\u044F\u0445.","\u041E\u043F\u0438\u0441\u0430\u043D\u043E \u0432\u043B\u0438\u044F\u043D\u0438\u0435 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B \u043D\u0430 \u0433\u043E\u0441\u0442\u044F.","\u0415\u0441\u0442\u044C \u0443\u0436\u0435 \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u043D\u044F\u0442\u043E\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0438 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u0430\u044F \u043F\u0440\u043E\u0441\u044C\u0431\u0430.","\u041F\u0438\u0441\u044C\u043C\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u0438 \u0432\u0435\u0436\u043B\u0438\u0432\u043E."]}]},{id:"b1-08",level:"B1",title:"\u041D\u043E\u0432\u043E\u0441\u0442\u044C \u0438\u043B\u0438 \u043C\u043D\u0435\u043D\u0438\u0435",location:"\u0421\u0442\u0443\u0434\u0435\u043D\u0447\u0435\u0441\u043A\u0430\u044F \u0440\u0435\u0434\u0430\u043A\u0446\u0438\u044F",scene:"\u041D\u0438\u043D\u0430 \u0433\u043E\u0442\u043E\u0432\u0438\u0442 \u0437\u0430\u043C\u0435\u0442\u043A\u0443 \u043E \u043D\u043E\u0432\u043E\u043C \u0447\u0438\u0442\u0430\u043B\u044C\u043D\u043E\u043C \u0437\u0430\u043B\u0435. \u041F\u043E\u043C\u043E\u0433\u0438 \u043E\u0442\u0434\u0435\u043B\u0438\u0442\u044C \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u043C\u044B\u0435 \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043E\u0442 \u043E\u0446\u0435\u043D\u043E\u043A.",goal:"\u041F\u043E\u043D\u0438\u043C\u0430\u0442\u044C \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u044F \u0438 \u0442\u043E\u0447\u043D\u043E \u043F\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0442\u044C \u0447\u0443\u0436\u0438\u0435 \u0441\u043B\u043E\u0432\u0430.",grammar:{title:"\u041A\u043E\u0441\u0432\u0435\u043D\u043D\u0430\u044F \u0440\u0435\u0447\u044C \u0441 \u017Ee",body:"\u0427\u0443\u0436\u043E\u0435 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0435 \u0447\u0430\u0441\u0442\u043E \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442\u0441\u044F \u0447\u0435\u0440\u0435\u0437 povedal, \u017Ee\u2026 \u0438\u043B\u0438 uviedla, \u017Ee\u2026. \u041F\u043E\u0441\u043B\u0435 \u0432\u0432\u043E\u0434\u043D\u043E\u0433\u043E \u0433\u043B\u0430\u0433\u043E\u043B\u0430 \u0441\u0442\u0430\u0432\u0438\u0442\u0441\u044F \u0437\u0430\u043F\u044F\u0442\u0430\u044F. \u041C\u0435\u0441\u0442\u043E\u0438\u043C\u0435\u043D\u0438\u044F \u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F \u0432 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0438 \u0441 \u0442\u0435\u043C, \u043E \u043A\u043E\u043C \u0442\u0435\u043F\u0435\u0440\u044C \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442: Nina: \xABM\xE1m ot\xE1zku.\xBB \u2192 Nina povedala, \u017Ee m\xE1 ot\xE1zku. \u0412 \u0441\u043B\u043E\u0432\u0430\u0446\u043A\u043E\u043C \u043D\u0435\u0442 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u0430\u043D\u0433\u043B\u0438\u0439\u0441\u043A\u043E\u0433\u043E \u0441\u0434\u0432\u0438\u0433\u0430 \u0432\u0440\u0435\u043C\u0451\u043D \u043F\u043E\u0441\u043B\u0435 \u043F\u0440\u043E\u0448\u0435\u0434\u0448\u0435\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438: \u0432\u044B\u0431\u043E\u0440 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0441\u043E\u0431\u044B\u0442\u0438\u044F \u0438 \u043A\u043E\u043D\u0442\u0435\u043A\u0441\u0442\u0430. \u0414\u043B\u044F \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0439 \u0441\u0442\u0435\u043F\u0435\u043D\u044C \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u0438: mo\u017Eno \u043D\u0435 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u0432 ur\u010Dite, \u0430 niektor\xED \u2014 \u0432\u043E v\u0161etci. \u0424\u0430\u043A\u0442 \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u043F\u043E \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0443; \u043E\u0446\u0435\u043D\u043A\u0430 \u0432\u0440\u043E\u0434\u0435 najlep\u0161\xED \u043E\u0442\u0440\u0430\u0436\u0430\u0435\u0442 \u043C\u043D\u0435\u043D\u0438\u0435 \u0438 \u043D\u0443\u0436\u0434\u0430\u0435\u0442\u0441\u044F \u0432 \u043A\u0440\u0438\u0442\u0435\u0440\u0438\u0438. \u0421\u0441\u044B\u043B\u043A\u0430 \xAB\u043A\u0442\u043E-\u0442\u043E \u0441\u043A\u0430\u0437\u0430\u043B\xBB \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u044F, \u043D\u043E \u0435\u0449\u0451 \u043D\u0435 \u0434\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0435\u0433\u043E \u0438\u0441\u0442\u0438\u043D\u043D\u043E\u0441\u0442\u044C.",examples:[{sk:"Nina povedala, \u017Ee potrebuje nov\xFD slovn\xEDk.",ru:"\u041D\u0438\u043D\u0430 \u0441\u043A\u0430\u0437\u0430\u043B\u0430, \u0447\u0442\u043E \u0435\u0439 \u043D\u0443\u0436\u0435\u043D \u043D\u043E\u0432\u044B\u0439 \u0441\u043B\u043E\u0432\u0430\u0440\u044C."},{sk:"Autor uv\xE1dza, \u017Ee v\xFDsledok e\u0161te nie je ist\xFD.",ru:"\u0410\u0432\u0442\u043E\u0440 \u0441\u043E\u043E\u0431\u0449\u0430\u0435\u0442, \u0447\u0442\u043E \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u043F\u043E\u043A\u0430 \u043D\u0435 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D."}]},words:[{sk:"spr\xE1va",ru:"\u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435; \u043D\u043E\u0432\u043E\u0441\u0442\u044C",example:"Pre\u010D\xEDtal som si kr\xE1tku spr\xE1vu.",translation:"\u042F \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043B \u043A\u043E\u0440\u043E\u0442\u043A\u0443\u044E \u043D\u043E\u0432\u043E\u0441\u0442\u044C."},{sk:"titulok",ru:"\u0437\u0430\u0433\u043E\u043B\u043E\u0432\u043E\u043A",example:"Titulok nezodpoved\xE1 cel\xE9mu textu.",translation:"\u0417\u0430\u0433\u043E\u043B\u043E\u0432\u043E\u043A \u043D\u0435 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u0432\u0441\u0435\u043C\u0443 \u0442\u0435\u043A\u0441\u0442\u0443."},{sk:"zdroj",ru:"\u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A",example:"Ak\xFD je zdroj tejto inform\xE1cie?",translation:"\u041A\u0430\u043A\u043E\u0432 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u044D\u0442\u043E\u0439 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438?"},{sk:"rozhovor",ru:"\u0431\u0435\u0441\u0435\u0434\u0430; \u0438\u043D\u0442\u0435\u0440\u0432\u044C\u044E",example:"Pripravujeme rozhovor so \u0161tudentkou.",translation:"\u041C\u044B \u0433\u043E\u0442\u043E\u0432\u0438\u043C \u0438\u043D\u0442\u0435\u0440\u0432\u044C\u044E \u0441\u043E \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043A\u043E\u0439."},{sk:"tvrdi\u0165",ru:"\u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0442\u044C",example:"Autor tvrd\xED, \u017Ee zmena pom\xF4\u017Ee.",translation:"\u0410\u0432\u0442\u043E\u0440 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442, \u0447\u0442\u043E \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0435 \u043F\u043E\u043C\u043E\u0436\u0435\u0442."},{sk:"overi\u0165",ru:"\u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C; \u0443\u0434\u043E\u0441\u0442\u043E\u0432\u0435\u0440\u0438\u0442\u044C",example:"Najprv si mus\xEDm overi\u0165 \xFAdaj.",translation:"\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u0434\u0430\u043D\u043D\u044B\u0435."},{sk:"\xFAdaj",ru:"\u0441\u0432\u0435\u0434\u0435\u043D\u0438\u0435; \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C",example:"Tento \xFAdaj je uveden\xFD v spr\xE1ve.",translation:"\u042D\u0442\u043E\u0442 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C \u0443\u043A\u0430\u0437\u0430\u043D \u0432 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0438."},{sk:"skuto\u010Dnos\u0165",ru:"\u0444\u0430\u043A\u0442; \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C",example:"Rozli\u0161ujme n\xE1zor a skuto\u010Dnos\u0165.",translation:"\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0440\u0430\u0437\u043B\u0438\u0447\u0430\u0442\u044C \u043C\u043D\u0435\u043D\u0438\u0435 \u0438 \u0444\u0430\u043A\u0442."},{sk:"pochybova\u0165",ru:"\u0441\u043E\u043C\u043D\u0435\u0432\u0430\u0442\u044C\u0441\u044F",example:"O tomto tvrden\xED pochybujem.",translation:"\u042F \u0441\u043E\u043C\u043D\u0435\u0432\u0430\u044E\u0441\u044C \u0432 \u044D\u0442\u043E\u043C \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0438."},{sk:"zverejni\u0165",ru:"\u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u0442\u044C",example:"\u010Cl\xE1nok chceme zverejni\u0165 zajtra.",translation:"\u041C\u044B \u0445\u043E\u0442\u0438\u043C \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u0442\u044C \u0441\u0442\u0430\u0442\u044C\u044E \u0437\u0430\u0432\u0442\u0440\u0430."}],exercises:[{type:"reading",prompt:"\u041A\u0430\u043A\u0430\u044F \u0444\u0440\u0430\u0437\u0430 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043B\u0438\u0447\u043D\u043E\u0439 \u043E\u0446\u0435\u043D\u043A\u043E\u0439, \u0430 \u043D\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u043C\u044B\u043C \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u0435\u043C?",explanation:"\xAB\u041B\u0443\u0447\u0448\u0438\u0439\xBB \u0431\u0435\u0437 \u043A\u0440\u0438\u0442\u0435\u0440\u0438\u0435\u0432 \u2014 \u043E\u0446\u0435\u043D\u043A\u0430 \u041D\u0438\u043D\u044B. \u0414\u0430\u0442\u0430 \u0438 \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u043E\u0442\u043D\u043E\u0441\u044F\u0442\u0441\u044F \u043A \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u043C\u043E\u043C\u0443 \u043F\u043B\u0430\u043D\u0443 \u043C\u0435\u0440\u043E\u043F\u0440\u0438\u044F\u0442\u0438\u044F.",text:"V hern\xFDch \u0161tudentsk\xFDch novin\xE1ch sa p\xED\u0161e, \u017Ee nov\xFD \u010Ditate\u013Esk\xFD klub sa prv\xFDkr\xE1t stretne v utorok. Stretnutie m\xE1 trva\u0165 hodinu. Organiz\xE1torka Nina povedala: Pod\u013Ea m\u0148a to bude najlep\u0161\xED klub na univerzite. Dodala v\u0161ak, \u017Ee program sa m\xF4\u017Ee zmeni\u0165 pod\u013Ea z\xE1ujmu \xFA\u010Dastn\xEDkov. Redaktor chce pred vydan\xEDm skontrolova\u0165 d\xE1tum u spr\xE1vcu miestnosti a Ninin n\xE1zor jasne ozna\u010Di\u0165 ako osobn\xE9 hodnotenie.",options:["Prv\xE9 stretnutie je pl\xE1novan\xE9 na utorok.","Stretnutie m\xE1 trva\u0165 hodinu.","Bude to najlep\u0161\xED klub na univerzite.","Program sa m\xF4\u017Ee zmeni\u0165."],answer:"Bude to najlep\u0161\xED klub na univerzite."},{type:"choice",prompt:"\u041D\u0438\u043D\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u0442: \xABM\xE1m nov\xFA knihu.\xBB \u041A\u0430\u043A \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C \u044D\u0442\u043E \u043E\u0442 \u0442\u0440\u0435\u0442\u044C\u0435\u0433\u043E \u043B\u0438\u0446\u0430?",explanation:"\u041F\u0440\u0438 \u043F\u0435\u0440\u0435\u0441\u043A\u0430\u0437\u0435 \u043E\u0442 \u0442\u0440\u0435\u0442\u044C\u0435\u0433\u043E \u043B\u0438\u0446\u0430 m\xE1m \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u043D\u0430 m\xE1: \u043A\u043D\u0438\u0433\u0430 \u0443 \u041D\u0438\u043D\u044B.",options:["Nina povedala, \u017Ee m\xE1m nov\xFA knihu.","Nina povedala, \u017Ee m\xE1 nov\xFA knihu.","Nina povedala, aby ma\u0165 knihu.","Nina povedala, \u010Di knihu."],answer:"Nina povedala, \u017Ee m\xE1 nov\xFA knihu."},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0432 \u043F\u0440\u043E\u043F\u0443\u0441\u043A.",explanation:"\u0423\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0435 \u0432 \u043A\u043E\u0441\u0432\u0435\u043D\u043D\u043E\u0439 \u0440\u0435\u0447\u0438 \u0432\u0432\u043E\u0434\u0438\u0442\u0441\u044F \u0441\u043E\u044E\u0437\u043E\u043C \u017Ee.",sk:"Redaktor uviedol, ___ d\xE1tum e\u0161te overuje.",options:["aby","preto","\u017Ee","ktor\xFD"],answer:"\u017Ee"},{type:"choice",prompt:"\u0418\u0441\u0445\u043E\u0434\u043D\u0438\u043A: \xABNiektor\xED \u0161tudenti uprednost\u0148uj\xFA online kurz.\xBB \u041A\u0430\u043A\u043E\u0439 \u043F\u0435\u0440\u0435\u0441\u043A\u0430\u0437 \u0442\u043E\u0447\u0435\u043D?",explanation:"Niektor\xED \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u0447\u0430\u0441\u0442\u044C \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043E\u0432, \u0430 \u043D\u0435 \u0432\u0441\u0435\u0445. \u0422\u043E\u0447\u043D\u044B\u0439 \u043F\u0435\u0440\u0435\u0441\u043A\u0430\u0437 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442 \u043E\u0431\u044A\u0451\u043C \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u044F.",options:["V\u0161etci \u0161tudenti odmietaj\xFA u\u010Debne.","\u017Diadny \u0161tudent nechce online kurz.","\u010Cas\u0165 \u0161tudentov d\xE1va prednos\u0165 online kurzu.","Univerzita zru\u0161ila v\u0161etky u\u010Debne."],answer:"\u010Cas\u0165 \u0161tudentov d\xE1va prednos\u0165 online kurzu."},{type:"order",prompt:"\u0421\u043E\u0431\u0435\u0440\u0438 \u0444\u0440\u0430\u0437\u0443 \xAB\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u044F \u0445\u043E\u0447\u0443 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\xBB, \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 Najprv.",explanation:"Overi\u0165 si \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u0434\u043B\u044F \u0441\u0435\u0431\u044F; \u043A\u0440\u0430\u0442\u043A\u043E\u0435 si \u0441\u0442\u043E\u0438\u0442 \u0432 \u043D\u0430\u0447\u0430\u043B\u0435 \u0433\u0440\u0443\u043F\u043F\u044B \u0441\u043A\u0430\u0437\u0443\u0435\u043C\u043E\u0433\u043E.",answer:["Najprv","si","chcem","overi\u0165","zdroj."],acceptedOrders:[["Najprv","si","chcem","zdroj","overi\u0165."]]},{type:"typing",prompt:"\u041D\u0430\u043F\u0438\u0448\u0438 \u0441\u043B\u043E\u0432\u0430\u0446\u043A\u043E\u0435 \u0441\u043B\u043E\u0432\u043E \xAB\u0437\u0430\u0433\u043E\u043B\u043E\u0432\u043E\u043A\xBB \u0438\u0437 \u0441\u043B\u043E\u0432\u0430\u0440\u044F.",explanation:"Titulok \u0434\u043E\u043B\u0436\u0435\u043D \u0441\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C\u0441\u044F \u0441 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435\u043C \u0442\u0435\u043A\u0441\u0442\u0430, \u0430 \u043D\u0435 \u0437\u0430\u043C\u0435\u043D\u044F\u0442\u044C \u0435\u0433\u043E.",answer:"titulok"},{type:"listening",prompt:"\u041D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D \u043F\u0435\u0440\u0435\u043D\u043E\u0441?",explanation:"Mo\u017Eno \u0438 zatia\u013E nepotvrdil \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442 \u043D\u0435\u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u043E\u0441\u0442\u044C. \u041D\u0435\u043B\u044C\u0437\u044F \u043F\u0435\u0440\u0435\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C \u044D\u0442\u043E \u043A\u0430\u043A \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435.",audio:"Organiz\xE1tor povedal, \u017Ee stretnutie mo\u017Eno presun\xFA na \u0161tvrtok. Zatia\u013E to v\u0161ak nepotvrdil a po\u017Eiadal \xFA\u010Dastn\xEDkov, aby sledovali \u010Fal\u0161iu spr\xE1vu.",options:["Je u\u017E \xFAplne potvrden\xFD.","Je mo\u017En\xFD, ale e\u0161te nepotvrden\xFD.","Je zak\xE1zan\xFD.","U\u017E sa uskuto\u010Dnil."],answer:"Je mo\u017En\xFD, ale e\u0161te nepotvrden\xFD."},{type:"speaking",prompt:"\u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0438 \u043E \u0432\u044B\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u043E\u0439 \u0441\u0442\u0443\u0434\u0435\u043D\u0447\u0435\u0441\u043A\u043E\u0439 \u043D\u043E\u0432\u043E\u0441\u0442\u0438. \u041E\u0442\u0434\u0435\u043B\u0438 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430 \u043E\u0442 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E \u043C\u043D\u0435\u043D\u0438\u044F \u0438 \u043D\u0430\u0437\u043E\u0432\u0438 \u043E\u0434\u0438\u043D \u0444\u0430\u043A\u0442, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0435\u0449\u0451 \u043D\u0443\u0436\u043D\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C.",explanation:"\u042D\u0442\u043E \u0443\u0441\u0442\u043D\u0430\u044F \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0430 \u0441 \u0441\u0430\u043C\u043E\u043E\u0446\u0435\u043D\u043A\u043E\u0439. \u041E\u0446\u0435\u043D\u0438 \u043F\u043E\u043D\u044F\u0442\u043D\u043E\u0441\u0442\u044C, \u0441\u0432\u044F\u0437\u043D\u043E\u0441\u0442\u044C \u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u044F; \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u043E\u0446\u0435\u043D\u043A\u0430 \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0448\u0435\u043D\u0438\u044F \u0437\u0434\u0435\u0441\u044C \u043D\u0435 \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u0430\u0433\u0430\u0435\u0442\u0441\u044F.",answer:"",targetSeconds:60,model:"V \u0161tudentsk\xFDch novin\xE1ch som \u010D\xEDtal, \u017Ee na univerzite pl\xE1nuj\xFA nov\xFD diskusn\xFD klub. Organiz\xE1torka uviedla, \u017Ee by sa mal stret\xE1va\u0165 raz za dva t\xFD\u017Edne. Presn\xFD term\xEDn e\u0161te nie je potvrden\xFD, preto by som ho pred n\xE1v\u0161tevou overil. Pod\u013Ea m\u0148a m\xF4\u017Ee by\u0165 klub u\u017Eito\u010Dn\xFD pre \u013Eud\xED, ktor\xED si chc\xFA precvi\u010Di\u0165 sloven\u010Dinu. To je v\u0161ak m\xF4j n\xE1zor, nie v\xFDsledok v\xFDskumu. Chcel by som tie\u017E vedie\u0165, kto bude diskusie vies\u0165.",checklist:["\u0415\u0441\u0442\u044C \u0442\u043E\u0447\u043D\u0430\u044F \u0441\u0441\u044B\u043B\u043A\u0430 \u043D\u0430 \u0433\u043E\u0432\u043E\u0440\u044F\u0449\u0435\u0433\u043E \u0438\u043B\u0438 \u0442\u0435\u043A\u0441\u0442.","\u041F\u0440\u0435\u0434\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u043D\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u044B \u043A\u0430\u043A \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0451\u043D\u043D\u044B\u0435 \u0444\u0430\u043A\u0442\u044B.","\u041B\u0438\u0447\u043D\u043E\u0435 \u043C\u043D\u0435\u043D\u0438\u0435 \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0435\u043D\u043E \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E.","\u041D\u0430\u0437\u0432\u0430\u043D \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0439 \u0432\u043E\u043F\u0440\u043E\u0441 \u0434\u043B\u044F \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438."]}]},{id:"b1-09",level:"B1",title:"\u041D\u0435\u0434\u0435\u043B\u044F \u0431\u0435\u0437 \u0430\u0432\u0440\u0430\u043B\u0430",location:"\u0421\u0442\u0443\u0434\u0435\u043D\u0447\u0435\u0441\u043A\u0438\u0439 \u043A\u0430\u043C\u043F\u0443\u0441",scene:"\u0414\u043E \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0441\u0435\u043C\u0438\u043D\u0430\u0440\u0430 \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u043D\u0435\u0434\u0435\u043B\u044F. \u041D\u0438\u043D\u0430 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u0441\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u043C\u044B\u0439 \u043F\u043B\u0430\u043D \u0438 \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0432\u0440\u0435\u043C\u044F \u0434\u043B\u044F \u043F\u043E\u0432\u0442\u043E\u0440\u0435\u043D\u0438\u044F.",goal:"\u041E\u0431\u044A\u044F\u0441\u043D\u044F\u0442\u044C \u0446\u0435\u043B\u044C \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439 \u0438 \u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0443\u0447\u0451\u0431\u0443.",grammar:{title:"\u0426\u0435\u043B\u044C \u0441 aby \u0438 \u0432\u0440\u0435\u043C\u044F \u0441 k\xFDm",body:"\u0426\u0435\u043B\u044C \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0443\u0434\u043E\u0431\u043D\u043E \u0432\u044B\u0440\u0430\u0436\u0430\u0442\u044C \u043F\u0440\u0438\u0434\u0430\u0442\u043E\u0447\u043D\u044B\u043C \u0441 aby: Rob\xEDm si pozn\xE1mky, aby som si zapam\xE4tal nov\xE9 slov\xE1. \u041F\u043E\u0441\u043B\u0435 aby \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u0444\u043E\u0440\u043C\u0430 \u043D\u0430 -l \u0438 \u043F\u0440\u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438 som, si, sme, ste; \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u0430\u044F \u0447\u0430\u0441\u0442\u0438\u0446\u0430 by \u043D\u0435 \u043D\u0443\u0436\u043D\u0430. \u0412 \u044D\u0442\u043E\u0439 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438 \u0444\u043E\u0440\u043C\u0430 \u043F\u043E\u0445\u043E\u0436\u0430 \u043D\u0430 \u043F\u0440\u043E\u0448\u0435\u0434\u0448\u0435\u0435 \u0432\u0440\u0435\u043C\u044F, \u043D\u043E \u0446\u0435\u043B\u044C \u043C\u043E\u0436\u0435\u0442 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u044C\u0441\u044F \u043A \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u043C\u0443 \u0438\u043B\u0438 \u0431\u0443\u0434\u0443\u0449\u0435\u043C\u0443. \u0415\u0441\u043B\u0438 \u0441\u0443\u0431\u044A\u0435\u043A\u0442 \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F, \u0443\u043A\u0430\u0436\u0438 \u0435\u0433\u043E: Poslal som Nine pl\xE1n, aby vedela, kedy pr\xEDdem. \u0421\u043E\u044E\u0437 k\xFDm \u043C\u043E\u0436\u0435\u0442 \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0430\u0442\u044C \xAB\u043F\u043E\u043A\u0430\xBB: K\xFDm \u010Dak\xE1m, opakujem si slov\xED\u010Dka. \u0412 \u043F\u043B\u0430\u043D\u0435 \u043F\u043E\u043B\u0435\u0437\u043D\u043E \u0440\u0430\u0437\u043B\u0438\u0447\u0430\u0442\u044C \u0440\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u044B\u0439 \u043F\u0440\u043E\u0446\u0435\u0441\u0441 \u0438 \u0440\u0430\u0437\u043E\u0432\u044B\u0439 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442: ka\u017Ed\xFD de\u0148 \u010D\xEDta\u0165, \u043D\u043E do piatka pre\u010D\xEDta\u0165 \u010Dl\xE1nok. \u0420\u0435\u0430\u043B\u0438\u0441\u0442\u0438\u0447\u043D\u044B\u0435 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u043B\u0435\u0433\u0447\u0435 \u0441\u0432\u044F\u0437\u0430\u0442\u044C \u0441 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u043C\u043E\u0439 \u0446\u0435\u043B\u044C\u044E.",examples:[{sk:"Rozdelil som si \xFAlohy, aby som v\u0161etko stihol.",ru:"\u042F \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u043B \u0437\u0430\u0434\u0430\u043D\u0438\u044F, \u0447\u0442\u043E\u0431\u044B \u0432\u0441\u0451 \u0443\u0441\u043F\u0435\u0442\u044C."},{sk:"K\xFDm \u010Dak\xE1m na autobus, opakujem si slov\xED\u010Dka.",ru:"\u041F\u043E\u043A\u0430 \u044F \u0436\u0434\u0443 \u0430\u0432\u0442\u043E\u0431\u0443\u0441, \u044F \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u044E \u0441\u043B\u043E\u0432\u0430."}]},words:[{sk:"rozvrh",ru:"\u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u0435 \u0437\u0430\u043D\u044F\u0442\u0438\u0439",example:"Pozrel som si nov\xFD rozvrh.",translation:"\u042F \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B \u043D\u043E\u0432\u043E\u0435 \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u0435 \u0437\u0430\u043D\u044F\u0442\u0438\u0439."},{sk:"povinnos\u0165",ru:"\u043E\u0431\u044F\u0437\u0430\u043D\u043D\u043E\u0441\u0442\u044C; \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u0434\u0435\u043B\u043E",example:"Najprv si zap\xED\u0161em svoje povinnosti.",translation:"\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u044F \u0437\u0430\u043F\u0438\u0448\u0443 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u0434\u0435\u043B\u0430."},{sk:"s\xFAstredi\u0165 sa",ru:"\u0441\u043E\u0441\u0440\u0435\u0434\u043E\u0442\u043E\u0447\u0438\u0442\u044C\u0441\u044F",example:"V tichej miestnosti sa lep\u0161ie s\xFAstred\xEDm.",translation:"\u0412 \u0442\u0438\u0445\u043E\u043C \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0438 \u044F \u043B\u0443\u0447\u0448\u0435 \u0441\u043E\u0441\u0440\u0435\u0434\u043E\u0442\u0430\u0447\u0438\u0432\u0430\u044E\u0441\u044C."},{sk:"opakova\u0165",ru:"\u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0442\u044C",example:"Potrebujem si opakova\u0165 nov\xE9 slov\xE1.",translation:"\u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0442\u044C \u043D\u043E\u0432\u044B\u0435 \u0441\u043B\u043E\u0432\u0430."},{sk:"dokon\u010Di\u0165",ru:"\u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u044C",example:"Dnes chcem dokon\u010Di\u0165 prv\xFD n\xE1vrh.",translation:"\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u0445\u043E\u0447\u0443 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u044C \u043F\u0435\u0440\u0432\u044B\u0439 \u0432\u0430\u0440\u0438\u0430\u043D\u0442."},{sk:"odlo\u017Ei\u0165",ru:"\u043E\u0442\u043B\u043E\u0436\u0438\u0442\u044C",example:"Nechcem v\u0161etko odlo\u017Ei\u0165 na ve\u010Der.",translation:"\u042F \u043D\u0435 \u0445\u043E\u0447\u0443 \u0432\u0441\u0451 \u043E\u0442\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0442\u044C \u043D\u0430 \u0432\u0435\u0447\u0435\u0440."},{sk:"vopred",ru:"\u0437\u0430\u0440\u0430\u043D\u0435\u0435",example:"Text si pre\u010D\xEDtam vopred.",translation:"\u042F \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u044E \u0442\u0435\u043A\u0441\u0442 \u0437\u0430\u0440\u0430\u043D\u0435\u0435."},{sk:"pravidelne",ru:"\u0440\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u043E",example:"Sna\u017E\xEDm sa cvi\u010Di\u0165 pravidelne.",translation:"\u042F \u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044C \u0437\u0430\u043D\u0438\u043C\u0430\u0442\u044C\u0441\u044F \u0440\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u043E."},{sk:"prest\xE1vka",ru:"\u043F\u0435\u0440\u0435\u0440\u044B\u0432",example:"Po hodine si d\xE1m prest\xE1vku.",translation:"\u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441 \u044F \u0441\u0434\u0435\u043B\u0430\u044E \u043F\u0435\u0440\u0435\u0440\u044B\u0432."},{sk:"pokrok",ru:"\u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441",example:"Mal\xFD pokrok je tie\u017E d\xF4le\u017Eit\xFD.",translation:"\u041D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441 \u0442\u043E\u0436\u0435 \u0432\u0430\u0436\u0435\u043D."}],exercises:[{type:"reading",prompt:"\u041A\u0430\u043A \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u0441\u044F \u043A\u0440\u0438\u0442\u0435\u0440\u0438\u0439 \u0443\u0441\u043F\u0435\u0448\u043D\u043E\u0433\u043E \u0437\u0430\u043D\u044F\u0442\u0438\u044F?",explanation:"\u041D\u043E\u0432\u044B\u0439 \u043F\u043B\u0430\u043D \u0441\u0442\u0430\u0432\u0438\u0442 \u043D\u0430 \u043F\u0435\u0440\u0432\u043E\u0435 \u043C\u0435\u0441\u0442\u043E \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u0438 \u043A\u0440\u0430\u0442\u043A\u043E\u0435 \u0438\u0437\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0441\u0432\u043E\u0438\u043C\u0438 \u0441\u043B\u043E\u0432\u0430\u043C\u0438, \u0430 \u043D\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0441\u0442\u0440\u0430\u043D\u0438\u0446.",text:"Andrej si najprv napl\xE1noval \u010D\xEDta\u0165 cel\xE9 popoludnie bez prest\xE1vky. Po prvom dni zistil, \u017Ee si z poslednej hodiny takmer ni\u010D nepam\xE4t\xE1. Nina mu navrhla rozdeli\u0165 text na men\u0161ie \u010Dasti a po ka\u017Edej si nap\xEDsa\u0165 dve vety vlastn\xFDmi slovami. Ve\u010Der si m\xE1 zopakova\u0165 iba slov\xE1, pri ktor\xFDch urobil chybu. Cie\u013Eom nie je pre\u010D\xEDta\u0165 \u010Do najviac str\xE1n, ale porozumie\u0165 tomu, \u010Do bude potrebova\u0165 na semin\xE1ri.",options:["D\xF4le\u017Eit\xFD je iba po\u010Det str\xE1n.","D\xF4le\u017Eit\xE9 je porozumenie a vlastn\xE9 zhrnutie.","Treba sa u\u010Di\u0165 bez prest\xE1vok.","V\u0161etky slov\xE1 sa musia opakova\u0165 rovnako dlho."],answer:"D\xF4le\u017Eit\xE9 je porozumenie a vlastn\xE9 zhrnutie."},{type:"cloze",prompt:"\u0412\u044B\u0440\u0430\u0437\u0438 \u0446\u0435\u043B\u044C \u0432\u0435\u0434\u0435\u043D\u0438\u044F \u0437\u0430\u043F\u0438\u0441\u0435\u0439: \xAB\u0447\u0442\u043E\u0431\u044B \u043B\u0443\u0447\u0448\u0435 \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u044C \u0442\u0435\u043A\u0441\u0442\xBB.",explanation:"\u041F\u043E\u0441\u043B\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442\u0441\u044F \u0435\u0433\u043E \u0446\u0435\u043B\u044C: \u0447\u0442\u043E\u0431\u044B \u043B\u0443\u0447\u0448\u0435 \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u044C.",sk:"Rob\xEDm si pozn\xE1mky, ___ som si lep\u0161ie zapam\xE4tal text.",options:["preto","ktor\xFD","aby","hoci"],answer:"aby"},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0432 \u043F\u0440\u043E\u043F\u0443\u0441\u043A.",explanation:"\u041F\u043E\u0434\u043B\u0435\u0436\u0430\u0449\u0435\u0435 \u043F\u0440\u0438\u0434\u0430\u0442\u043E\u0447\u043D\u043E\u0433\u043E \u2014 \u041C\u0430\u0442\u0435\u0439, \u0442\u0440\u0435\u0442\u044C\u0435 \u043B\u0438\u0446\u043E: aby sa vedel pripravi\u0165. \u0414\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435 by \u043D\u0435 \u043D\u0443\u0436\u043D\u043E.",sk:"Poslala som Matejovi pl\xE1n, aby ___ vedel pripravi\u0165.",options:["som sa","sa","by sa","si by"],answer:"sa"},{type:"cloze",prompt:"\u0412\u044B\u0440\u0430\u0437\u0438 \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0441\u0442\u044C: \xAB\u041F\u043E\u043A\u0430 \u044F \u0436\u0434\u0443 \u0430\u0432\u0442\u043E\u0431\u0443\u0441, \u044F \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u044E \u0441\u043B\u043E\u0432\u0430\xBB.",explanation:"K\xFDm \u0432\u044B\u0440\u0430\u0436\u0430\u0435\u0442 \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0441\u0442\u044C: \u043F\u043E\u043A\u0430 \u0436\u0434\u0443 \u0430\u0432\u0442\u043E\u0431\u0443\u0441, \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u044E \u0441\u043B\u043E\u0432\u0430.",sk:"___ \u010Dak\xE1m na autobus, opakujem si slov\xE1.",options:["K\xFDm","Preto","Napriek","Aby"],answer:"K\xFDm"},{type:"choice",prompt:"\u041A\u0430\u043A\u043E\u0439 \u043F\u043B\u0430\u043D \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0439 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u043C\u044B\u0439 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442?",explanation:"\u0415\u0441\u0442\u044C \u0441\u0440\u043E\u043A \u0438 \u0434\u0432\u0430 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0430: \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043D\u043D\u0430\u044F \u0441\u0442\u0430\u0442\u044C\u044F \u0438 \u0435\u0451 \u043F\u0438\u0441\u044C\u043C\u0435\u043D\u043D\u043E\u0435 \u0440\u0435\u0437\u044E\u043C\u0435.",options:["Budem lep\u0161\xED vo v\u0161etkom.","Niekedy sa budem u\u010Di\u0165.","Do piatka pre\u010D\xEDtam \u010Dl\xE1nok a nap\xED\u0161em jeho zhrnutie.","Urob\xEDm \u010Do najviac vec\xED."],answer:"Do piatka pre\u010D\xEDtam \u010Dl\xE1nok a nap\xED\u0161em jeho zhrnutie."},{type:"order",prompt:"\u0421\u043E\u0431\u0435\u0440\u0438 \u0444\u0440\u0430\u0437\u0443 \xAB\u042F \u0445\u043E\u0447\u0443 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u044C \u0442\u0435\u043A\u0441\u0442 \u0437\u0430\u0440\u0430\u043D\u0435\u0435\xBB, \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 Chcem.",explanation:"Dokon\u010Di\u0165 \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435 \u0440\u0430\u0431\u043E\u0442\u044B, vopred \u2014 \u0437\u0430\u0440\u0430\u043D\u0435\u0435.",answer:["Chcem","dokon\u010Di\u0165","text","vopred."],acceptedOrders:[["Chcem","text","dokon\u010Di\u0165","vopred."],["Chcem","vopred","dokon\u010Di\u0165","text."],["Chcem","text","vopred","dokon\u010Di\u0165."],["Chcem","dokon\u010Di\u0165","vopred","text."]]},{type:"typing",prompt:"\u0412\u043F\u0438\u0448\u0438 \u0441\u043E\u044E\u0437 \u0446\u0435\u043B\u0438: \xAB\u0160tudujem sloven\u010Dinu, ___ som rozumel predn\xE1\u0161kam.\xBB",explanation:"Aby som rozumel \u2014 \xAB\u0447\u0442\u043E\u0431\u044B \u044F \u043F\u043E\u043D\u0438\u043C\u0430\u043B\xBB; \u0444\u043E\u0440\u043C\u0430 rozumel \u0437\u0434\u0435\u0441\u044C \u043D\u0435 \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u043F\u0440\u043E\u0448\u043B\u043E\u0435.",answer:"aby"},{type:"speaking",prompt:"\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438 \u043F\u043B\u0430\u043D \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0438 \u043A \u0441\u0435\u043C\u0438\u043D\u0430\u0440\u0443 \u043D\u0430 \u0442\u0440\u0438 \u0434\u043D\u044F. \u0414\u043B\u044F \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u043E\u0431\u044A\u044F\u0441\u043D\u0438 \u0446\u0435\u043B\u044C \u0441 aby. \u0414\u043E\u0431\u0430\u0432\u044C \u0432\u0440\u0435\u043C\u044F \u0434\u043B\u044F \u043E\u0442\u0434\u044B\u0445\u0430.",explanation:"\u042D\u0442\u043E \u0443\u0441\u0442\u043D\u0430\u044F \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0430 \u0441 \u0441\u0430\u043C\u043E\u043E\u0446\u0435\u043D\u043A\u043E\u0439. \u041E\u0446\u0435\u043D\u0438 \u043F\u043E\u043D\u044F\u0442\u043D\u043E\u0441\u0442\u044C, \u0441\u0432\u044F\u0437\u043D\u043E\u0441\u0442\u044C \u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u044F; \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u043E\u0446\u0435\u043D\u043A\u0430 \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0448\u0435\u043D\u0438\u044F \u0437\u0434\u0435\u0441\u044C \u043D\u0435 \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u0430\u0433\u0430\u0435\u0442\u0441\u044F.",answer:"",targetSeconds:60,model:"Prv\xFD de\u0148 si pre\u010D\xEDtam z\xE1kladn\xFD text, aby som pochopil hlavn\xFA t\xE9mu. Nezn\xE1me slov\xE1 si zap\xED\u0161em, ale nebudem h\u013Eada\u0165 ka\u017Ed\xE9 slovo, ktor\xE9 nie je d\xF4le\u017Eit\xE9. Druh\xFD de\u0148 nap\xED\u0161em kr\xE1tke zhrnutie, aby som si overil, \u010Domu rozumiem. Potom si d\xE1m prest\xE1vku a p\xF4jdem na prech\xE1dzku. Tret\xED de\u0148 si priprav\xEDm dve ot\xE1zky, aby som sa vedel zapoji\u0165 do diskusie. Ve\u010Der u\u017E nebudem prid\xE1va\u0165 nov\xE9 \xFAlohy.",checklist:["\u0423 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0434\u043D\u044F \u0435\u0441\u0442\u044C \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0438 \u0446\u0435\u043B\u044C.","Aby \u0443\u043F\u043E\u0442\u0440\u0435\u0431\u043B\u0435\u043D\u043E \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0435\u0433\u043E by.","\u041F\u043B\u0430\u043D \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442 \u043F\u043E\u043D\u044F\u0442\u043D\u044B\u0435 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B.","\u041F\u0440\u0435\u0434\u0443\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u044B \u043F\u0435\u0440\u0435\u0440\u044B\u0432\u044B \u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u0435\u043D\u0438\u0435."]}]},{id:"b1-10",level:"B1",title:"\u041F\u0435\u0440\u0432\u044B\u0439 \u0441\u0435\u043C\u0438\u043D\u0430\u0440",location:"\u0423\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0441\u043A\u0430\u044F \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u044F",scene:"\u041F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440 \u0415\u0432\u0430 \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u0435\u0442 \u043F\u0440\u043E\u0435\u043A\u0442 \u0441\u0442\u0443\u0434\u0435\u043D\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u043A\u043B\u0443\u0431\u0430. \u0422\u044B \u0443\u0442\u043E\u0447\u043D\u044F\u0435\u0448\u044C \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u043E\u0435, \u043F\u0435\u0440\u0435\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0448\u044C \u0438\u0434\u0435\u044E \u0438 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0448\u044C \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0448\u0430\u0433.",goal:"\u041E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0442\u044C \u043D\u0430\u0432\u044B\u043A\u0438 B1 \u0432 \u0443\u0447\u0435\u0431\u043D\u043E\u043C \u043E\u0431\u0449\u0435\u043D\u0438\u0438.",grammar:{title:"\u0423\u0442\u043E\u0447\u043D\u0435\u043D\u0438\u0435, \u043F\u0435\u0440\u0435\u0441\u043A\u0430\u0437 \u0438 \u043F\u0440\u043E\u0441\u044C\u0431\u0430",body:"\u041D\u0435\u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u043F\u043E\u043D\u0438\u043C\u0430\u0442\u044C \u043A\u0430\u0436\u0434\u043E\u0435 \u0441\u043B\u043E\u0432\u043E, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440. \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043D\u0430\u0437\u043E\u0432\u0438, \u0447\u0442\u043E \u0442\u044B \u043F\u043E\u043D\u044F\u043B: Ak som spr\xE1vne porozumel, navrhujete\u2026. \u0417\u0430\u0442\u0435\u043C \u0443\u0442\u043E\u0447\u043D\u0438 \u043E\u0434\u043D\u0443 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u0443\u044E \u0434\u0435\u0442\u0430\u043B\u044C: Znamen\xE1 to, \u017Ee\u2026?. \u0414\u043B\u044F \u043F\u0440\u043E\u0441\u044C\u0431\u044B \u043E \u043F\u043E\u0432\u0442\u043E\u0440\u0435\u043D\u0438\u0438 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0442 Mohli by ste to zopakova\u0165? \u0438 Mohli by ste uvies\u0165 pr\xEDklad?. \u0412 \u043F\u0435\u0440\u0435\u0441\u043A\u0430\u0437\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0439 \u0433\u043B\u0430\u0432\u043D\u0443\u044E \u043C\u044B\u0441\u043B\u044C \u0438 \u043D\u0435 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0439 \u043D\u043E\u0432\u044B\u0435 \u043E\u0431\u0435\u0449\u0430\u043D\u0438\u044F. Hlavn\xE1 my\u0161lienka textu je\u2026 \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u043D\u0430\u0447\u0430\u0442\u044C \u043A\u0440\u0430\u0442\u043A\u043E\u0435 \u0438\u0437\u043B\u043E\u0436\u0435\u043D\u0438\u0435. \u041F\u0440\u0438 \u043F\u0440\u043E\u0441\u044C\u0431\u0435 \u043E\u0431\u0440\u0430\u0449\u0430\u0439 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u043D\u0430 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435: po\u017Eiada\u0165 o vysvetlenie, porozumie\u0165 ot\xE1zke. \u0412 \u043A\u043E\u043D\u0446\u0435 \u043E\u0431\u0441\u0443\u0436\u0434\u0435\u043D\u0438\u044F \u043F\u043E\u043B\u0435\u0437\u043D\u043E \u043E\u0442\u0434\u0435\u043B\u0438\u0442\u044C \u0441\u043E\u0433\u043B\u0430\u0441\u043E\u0432\u0430\u043D\u043D\u043E\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u043E\u0442 \u0435\u0449\u0451 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0433\u043E \u0432\u043E\u043F\u0440\u043E\u0441\u0430: dohodli sme sa\u2026; e\u0161te mus\xEDme zisti\u0165\u2026. \u042D\u0442\u0438 \u0444\u043E\u0440\u043C\u0443\u043B\u044B \u0434\u0435\u043B\u0430\u044E\u0442 \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C \u0434\u0430\u0436\u0435 \u043F\u0440\u0438 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u043E\u043C \u0441\u043B\u043E\u0432\u0430\u0440\u0435.",examples:[{sk:"Ak som spr\xE1vne porozumel, najprv m\xE1me porovna\u0165 dva texty.",ru:"\u0415\u0441\u043B\u0438 \u044F \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E \u043F\u043E\u043D\u044F\u043B, \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u043C\u044B \u0434\u043E\u043B\u0436\u043D\u044B \u0441\u0440\u0430\u0432\u043D\u0438\u0442\u044C \u0434\u0432\u0430 \u0442\u0435\u043A\u0441\u0442\u0430."},{sk:"Mohli by ste uvies\u0165 konkr\xE9tny pr\xEDklad?",ru:"\u041D\u0435 \u043C\u043E\u0433\u043B\u0438 \u0431\u044B \u0432\u044B \u043F\u0440\u0438\u0432\u0435\u0441\u0442\u0438 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0439 \u043F\u0440\u0438\u043C\u0435\u0440?"}]},words:[{sk:"predn\xE1\u0161ka",ru:"\u043B\u0435\u043A\u0446\u0438\u044F",example:"Po predn\xE1\u0161ke m\xE1m jednu ot\xE1zku.",translation:"\u041F\u043E\u0441\u043B\u0435 \u043B\u0435\u043A\u0446\u0438\u0438 \u0443 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u043E\u0434\u0438\u043D \u0432\u043E\u043F\u0440\u043E\u0441."},{sk:"semin\xE1r",ru:"\u0441\u0435\u043C\u0438\u043D\u0430\u0440",example:"Na semin\xE1ri budeme diskutova\u0165.",translation:"\u041D\u0430 \u0441\u0435\u043C\u0438\u043D\u0430\u0440\u0435 \u043C\u044B \u0431\u0443\u0434\u0435\u043C \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u0442\u044C."},{sk:"ot\xE1zka",ru:"\u0432\u043E\u043F\u0440\u043E\u0441",example:"T\xE1to ot\xE1zka s\xFAvis\xED s textom.",translation:"\u042D\u0442\u043E\u0442 \u0432\u043E\u043F\u0440\u043E\u0441 \u0441\u0432\u044F\u0437\u0430\u043D \u0441 \u0442\u0435\u043A\u0441\u0442\u043E\u043C."},{sk:"odpove\u010F",ru:"\u043E\u0442\u0432\u0435\u0442",example:"\u010Eakujem za jasn\xFA odpove\u010F.",translation:"\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0437\u0430 \u043F\u043E\u043D\u044F\u0442\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442."},{sk:"pozn\xE1mka",ru:"\u0437\u0430\u043C\u0435\u0442\u043A\u0430; \u0437\u0430\u043C\u0435\u0447\u0430\u043D\u0438\u0435",example:"Zap\xEDsal som si kr\xE1tku pozn\xE1mku.",translation:"\u042F \u0437\u0430\u043F\u0438\u0441\u0430\u043B \u043A\u043E\u0440\u043E\u0442\u043A\u0443\u044E \u0437\u0430\u043C\u0435\u0442\u043A\u0443."},{sk:"zhrn\xFA\u0165",ru:"\u043F\u043E\u0434\u044B\u0442\u043E\u0436\u0438\u0442\u044C; \u043A\u0440\u0430\u0442\u043A\u043E \u0438\u0437\u043B\u043E\u0436\u0438\u0442\u044C",example:"Sk\xFAsim zhrn\xFA\u0165 hlavn\xFA my\u0161lienku.",translation:"\u042F \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u044E \u043A\u0440\u0430\u0442\u043A\u043E \u0438\u0437\u043B\u043E\u0436\u0438\u0442\u044C \u0433\u043B\u0430\u0432\u043D\u0443\u044E \u043C\u044B\u0441\u043B\u044C."},{sk:"hlavn\xE1 my\u0161lienka",ru:"\u0433\u043B\u0430\u0432\u043D\u0430\u044F \u043C\u044B\u0441\u043B\u044C",example:"Hlavn\xE1 my\u0161lienka textu je jasn\xE1.",translation:"\u0413\u043B\u0430\u0432\u043D\u0430\u044F \u043C\u044B\u0441\u043B\u044C \u0442\u0435\u043A\u0441\u0442\u0430 \u044F\u0441\u043D\u0430."},{sk:"uvies\u0165",ru:"\u043F\u0440\u0438\u0432\u0435\u0441\u0442\u0438; \u0443\u043A\u0430\u0437\u0430\u0442\u044C",example:"M\xF4\u017Eete uvies\u0165 \u010Fal\u0161\xED pr\xEDklad?",translation:"\u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0440\u0438\u0432\u0435\u0441\u0442\u0438 \u0435\u0449\u0451 \u043E\u0434\u0438\u043D \u043F\u0440\u0438\u043C\u0435\u0440?"},{sk:"po\u017Eiada\u0165",ru:"\u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C",example:"Chcel by som po\u017Eiada\u0165 o vysvetlenie.",translation:"\u042F \u0445\u043E\u0442\u0435\u043B \u0431\u044B \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0440\u0430\u0437\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0435."},{sk:"porozumie\u0165",ru:"\u043F\u043E\u043D\u044F\u0442\u044C",example:"Chcem lep\u0161ie porozumie\u0165 tejto t\xE9me.",translation:"\u042F \u0445\u043E\u0447\u0443 \u043B\u0443\u0447\u0448\u0435 \u043F\u043E\u043D\u044F\u0442\u044C \u044D\u0442\u0443 \u0442\u0435\u043C\u0443."}],exercises:[{type:"reading",prompt:"\u041A\u0430\u043A\u043E\u0439 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0448\u0430\u0433 \u0433\u0440\u0443\u043F\u043F\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0441\u043E\u0433\u043B\u0430\u0441\u043E\u0432\u0430\u043B\u0430?",explanation:"\u0410\u043D\u043A\u0435\u0442\u0430 \u0434\u043E\u043B\u0436\u043D\u0430 \u0432\u044B\u044F\u0441\u043D\u0438\u0442\u044C \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u044B \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u043E\u0432; \u0433\u043E\u0441\u0442\u044C \u0435\u0449\u0451 \u043D\u0435 \u0432\u044B\u0431\u0440\u0430\u043D.",text:"Profesorka Eva navrhla, aby \u0161tudenti pripravili diskusn\xFD klub. Najprv maj\xFA zisti\u0165, ktor\xE9 t\xE9my spolu\u017Eiakov zauj\xEDmaj\xFA. A\u017E potom vyber\xFA prv\xE9ho hos\u0165a. Nina by rada pozvala novin\xE1rku, Matej navrhuje \u010Dloveka z miestnej kni\u017Enice. Eva ich upozornila, \u017Ee oba n\xE1vrhy m\xF4\u017Eu by\u0165 dobr\xE9, ale v\xFDber m\xE1 vych\xE1dza\u0165 zo z\xE1ujmu \xFA\u010Dastn\xEDkov. Do bud\xFAceho semin\xE1ra preto pripravia kr\xE1tku anketu.",options:["Hne\u010F pozva\u0165 novin\xE1rku.","Pripravi\u0165 kr\xE1tku anketu.","Zru\u0161i\u0165 oba n\xE1vrhy.","Vybra\u0165 hos\u0165a bez ot\xE1zok."],answer:"Pripravi\u0165 kr\xE1tku anketu."},{type:"listening",prompt:"\u0427\u0442\u043E \u0431\u0443\u0434\u0435\u0442 \u0441\u0434\u0435\u043B\u0430\u043D\u043E \u043F\u0435\u0440\u0435\u0434 \u0440\u0430\u0441\u0441\u044B\u043B\u043A\u043E\u0439 \u0430\u043D\u043A\u0435\u0442\u044B?",explanation:"\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F \u0433\u0440\u0443\u043F\u043F\u0430 \u043E\u043F\u0440\u043E\u0431\u0443\u0435\u0442 \u0430\u043D\u043A\u0435\u0442\u0443. \u041F\u043E\u043A\u0430 \u0435\u0451 \u043D\u0435 \u0440\u0430\u0441\u0441\u044B\u043B\u0430\u044E\u0442.",audio:"Ak som spr\xE1vne porozumela, ka\u017Ed\xFD priprav\xED jednu ot\xE1zku do ankety. Potom ich spolo\u010Dne uprav\xEDme, aby neboli pr\xEDli\u0161 dlh\xE9. Hotov\xFA anketu zatia\u013E nebudeme posiela\u0165. Najprv ju vysk\xFA\u0161ame na malej skupine.",options:["Ot\xE1zky sa vyma\u017E\xFA.","Anketa sa vysk\xFA\u0161a na malej skupine.","Hos\u0165 dostane pozvanie.","Ka\u017Ed\xFD po\u0161le in\xFA verziu."],answer:"Anketa sa vysk\xFA\u0161a na malej skupine."},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0432 \u043F\u0440\u043E\u043F\u0443\u0441\u043A.",explanation:"Porozumie\u0165 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0434\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043F\u0430\u0434\u0435\u0436\u0430: porozumie\u0165 ot\xE1zke.",sk:"Chcel by som lep\u0161ie porozumie\u0165 tejto ___.",options:["ot\xE1zku","ot\xE1zkou","ot\xE1zke","ot\xE1zka"],answer:"ot\xE1zke"},{type:"choice",prompt:"\u0422\u044B \u043F\u043E\u043D\u044F\u043B \u0438\u0434\u0435\u044E, \u043D\u043E \u043D\u0435 \u043F\u043E\u043D\u044F\u043B \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0439 \u0442\u0435\u0440\u043C\u0438\u043D. \u041A\u0430\u043A\u0430\u044F \u0440\u0435\u043F\u043B\u0438\u043A\u0430 \u043D\u0430\u0438\u0431\u043E\u043B\u0435\u0435 \u043F\u043E\u043B\u0435\u0437\u043D\u0430?",explanation:"\u0420\u0435\u043F\u043B\u0438\u043A\u0430 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043F\u043E\u043D\u044F\u0442\u043E\u0435 \u0438 \u0442\u043E\u0447\u043D\u043E \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0438\u0432\u0430\u0435\u0442, \u0447\u0442\u043E \u043D\u0443\u0436\u043D\u043E \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C.",options:["Ni\u010D neviem a kon\u010D\xEDm.","Rozumiem n\xE1vrhu, ale mohli by ste vysvetli\u0165 tento pojem?","V\u0161etko je jasn\xE9, hoci nerozumiem.","Nem\xE1m \u017Eiadne ot\xE1zky."],answer:"Rozumiem n\xE1vrhu, ale mohli by ste vysvetli\u0165 tento pojem?"},{type:"order",prompt:"\u0421\u043E\u0431\u0435\u0440\u0438 \u043F\u0440\u043E\u0441\u044C\u0431\u0443 \xAB\u041D\u0435 \u043C\u043E\u0433\u043B\u0438 \u0431\u044B \u0432\u044B \u043F\u0440\u0438\u0432\u0435\u0441\u0442\u0438 \u043F\u0440\u0438\u043C\u0435\u0440?\xBB, \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 Mohli.",explanation:"\u0412\u0435\u0436\u043B\u0438\u0432\u0430\u044F \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F Mohli by ste \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u0437\u0430\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u0438\u0437\u0430\u0446\u0438\u044E.",answer:["Mohli","by","ste","uvies\u0165","pr\xEDklad?"],acceptedOrders:[["Mohli","by","ste","pr\xEDklad","uvies\u0165?"]]},{type:"typing",prompt:"\u041D\u0430\u043F\u0438\u0448\u0438 \u0441\u043B\u043E\u0432\u043E\u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0435 \xAB\u0433\u043B\u0430\u0432\u043D\u0430\u044F \u043C\u044B\u0441\u043B\u044C\xBB \u0438\u0437 \u0441\u043B\u043E\u0432\u0430\u0440\u044F.",explanation:"\u0412 \u043A\u0440\u0430\u0442\u043A\u043E\u043C \u043F\u0435\u0440\u0435\u0441\u043A\u0430\u0437\u0435 \u0432\u044B\u0434\u0435\u043B\u044F\u0435\u0442\u0441\u044F hlavn\xE1 my\u0161lienka, \u0430 \u043D\u0435 \u043A\u0430\u0436\u0434\u043E\u0435 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0438\u0441\u0445\u043E\u0434\u043D\u0438\u043A\u0430.",answer:"hlavn\xE1 my\u0161lienka"},{type:"writing",prompt:"\u041D\u0430\u043F\u0438\u0448\u0438 120\u2013160 \u0441\u043B\u043E\u0432 \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u0430\u043C \u0443\u0447\u0435\u0431\u043D\u043E\u0433\u043E \u043A\u043B\u0443\u0431\u0430: \u043F\u0435\u0440\u0435\u0441\u043A\u0430\u0436\u0438 \u043E\u0431\u0441\u0443\u0436\u0434\u0435\u043D\u0438\u0435, \u043D\u0430\u0437\u043E\u0432\u0438 \u0441\u043E\u0433\u043B\u0430\u0441\u043E\u0432\u0430\u043D\u043D\u043E\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0438 \u0434\u0432\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0445 \u0432\u043E\u043F\u0440\u043E\u0441\u0430. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u0442\u0435\u043A\u0441\u0442 \u043C\u0438\u0441\u0441\u0438\u0438 \u043A\u0430\u043A \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A.",explanation:"\u042D\u0442\u043E \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u043F\u0438\u0441\u044C\u043C\u0435\u043D\u043D\u0430\u044F \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0430: \u0441\u0440\u0430\u0432\u043D\u0438 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435 \u0438 \u044F\u0437\u044B\u043A \u0441 \u043E\u0431\u0440\u0430\u0437\u0446\u043E\u043C. \u041E\u0431\u044A\u0451\u043C \u0442\u0435\u043A\u0441\u0442\u0430 \u0441\u0430\u043C \u043F\u043E \u0441\u0435\u0431\u0435 \u043D\u0435 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442 \u0443\u0440\u043E\u0432\u0435\u043D\u044C CEFR.",answer:"",minWords:120,model:"Dobr\xFD de\u0148, posielam kr\xE1tke zhrnutie n\xE1\u0161ho posledn\xE9ho semin\xE1ra. Hovorili sme o pr\xEDprave diskusn\xE9ho klubu, ktor\xFD by reagoval na z\xE1ujmy \u0161tudentov. Nina navrhla pozva\u0165 novin\xE1rku a Matej spomenul \u010Dloveka z miestnej kni\u017Enice. Zatia\u013E sme v\u0161ak \u017Eiadneho hos\u0165a nevybrali. Profesorka Eva odporu\u010Dila, aby sme najprv zistili, ktor\xE9 t\xE9my spolu\u017Eiakov zauj\xEDmaj\xFA. Dohodli sme sa preto na pr\xEDprave kr\xE1tkej ankety. Ka\u017Ed\xFD priprav\xED jednu ot\xE1zku a potom ot\xE1zky spolo\u010Dne uprav\xEDme. Pred \u0161ir\u0161\xEDm posielan\xEDm chceme anketu vysk\xFA\u0161a\u0165 na malej skupine. Otvoren\xE9 zost\xE1va, ko\u013Eko \u013Eud\xED chceme oslovi\u0165 a kto bude odpovede sprac\xFAva\u0165. Navrhujem, aby sme sa na t\xFDchto dvoch bodoch dohodli na za\u010Diatku \u010Fal\u0161ieho stretnutia. Pros\xEDm, opravte ma, ak som niektor\xFA \u010Das\u0165 na\u0161ej dohody pochopil nespr\xE1vne. \u010Eakujem v\u0161etk\xFDm za n\xE1vrhy a za spolupr\xE1cu. Ak m\xE1te \u010Fal\u0161\xED n\xE1vrh, nap\xED\u0161te ho, pros\xEDm, e\u0161te pred na\u0161\xEDm bud\xFAcim stretnut\xEDm.",checklist:["\u0421\u043E\u0445\u0440\u0430\u043D\u0451\u043D \u0441\u043C\u044B\u0441\u043B \u0438\u0441\u0445\u043E\u0434\u043D\u044B\u0445 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0439.","\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u0435 \u0433\u043E\u0441\u0442\u0438 \u043D\u0435 \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u044B \u0443\u0436\u0435 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u044B\u043C\u0438.","\u0415\u0441\u0442\u044C \u0441\u043E\u0433\u043B\u0430\u0441\u043E\u0432\u0430\u043D\u043D\u043E\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0438 \u0434\u0432\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0445 \u0432\u043E\u043F\u0440\u043E\u0441\u0430.","\u0422\u0435\u043A\u0441\u0442 \u0441\u0432\u044F\u0437\u0430\u043D \u0438 \u043F\u043E\u043D\u044F\u0442\u0435\u043D \u0430\u0434\u0440\u0435\u0441\u0430\u0442\u0430\u043C."]},{type:"speaking",prompt:"\u0417\u0430 90 \u0441\u0435\u043A\u0443\u043D\u0434 \u043E\u0431\u044A\u044F\u0441\u043D\u0438 \u043E\u0434\u043D\u043E\u0433\u0440\u0443\u043F\u043F\u043D\u0438\u043A\u0443 \u0446\u0435\u043B\u044C \u043A\u043B\u0443\u0431\u0430 \u0438 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0448\u0430\u0433. \u0417\u0430\u0442\u0435\u043C \u0441\u0444\u043E\u0440\u043C\u0443\u043B\u0438\u0440\u0443\u0439 \u0432\u043E\u043F\u0440\u043E\u0441 \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u044E, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u043E\u0434\u0432\u0438\u043D\u0443\u0442\u044C \u043F\u0440\u043E\u0435\u043A\u0442.",explanation:"\u042D\u0442\u043E \u0443\u0441\u0442\u043D\u0430\u044F \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0430 \u0441 \u0441\u0430\u043C\u043E\u043E\u0446\u0435\u043D\u043A\u043E\u0439. \u041E\u0446\u0435\u043D\u0438 \u043F\u043E\u043D\u044F\u0442\u043D\u043E\u0441\u0442\u044C, \u0441\u0432\u044F\u0437\u043D\u043E\u0441\u0442\u044C \u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u044F; \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u043E\u0446\u0435\u043D\u043A\u0430 \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0448\u0435\u043D\u0438\u044F \u0437\u0434\u0435\u0441\u044C \u043D\u0435 \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u0430\u0433\u0430\u0435\u0442\u0441\u044F.",answer:"",targetSeconds:90,model:"Chceme pripravi\u0165 diskusn\xFD klub, ktor\xFD bude pre \u0161tudentov u\u017Eito\u010Dn\xFD. Zatia\u013E m\xE1me dva n\xE1vrhy na hos\u0165a, ale najprv potrebujeme zisti\u0165 z\xE1ujem \xFA\u010Dastn\xEDkov. Preto priprav\xEDme kr\xE1tku anketu. Ot\xE1zky by mali by\u0165 jednoduch\xE9 a nemali by nazna\u010Dova\u0165 spr\xE1vnu odpove\u010F. Po malej sk\xFA\u0161ke m\xF4\u017Eeme znenie upravi\u0165. Pani profesorka, mohli by ste n\xE1m odporu\u010Di\u0165, ako vybra\u0165 skupinu na prv\xE9 vysk\xFA\u0161anie ankety? Chceme toti\u017E vedie\u0165, \u010Di s\xFA na\u0161e ot\xE1zky zrozumite\u013En\xE9 aj pre \u013Eud\xED, ktor\xED na semin\xE1ri neboli.",checklist:["\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0446\u0435\u043B\u044C, \u0437\u0430\u0442\u0435\u043C \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0438 \u043F\u0440\u0438\u0447\u0438\u043D\u0430.","\u0415\u0441\u0442\u044C \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u0443\u0442\u043E\u0447\u043D\u044F\u044E\u0449\u0438\u0439 \u0432\u043E\u043F\u0440\u043E\u0441.","\u0420\u0435\u0447\u044C \u043D\u0435 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u043E\u0442 \u0447\u0442\u0435\u043D\u0438\u044F \u0442\u0435\u043A\u0441\u0442\u0430.","\u041E\u0442\u043C\u0435\u0447\u0435\u043D\u044B \u043F\u0430\u0443\u0437\u044B \u0438 \u0441\u043B\u043E\u0432\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u044C."]}]},{id:"b2-01",level:"B2",title:"\u0410\u0440\u0433\u0443\u043C\u0435\u043D\u0442 \u0438 \u0432\u043E\u0437\u0440\u0430\u0436\u0435\u043D\u0438\u0435",location:"\u0414\u0438\u0441\u043A\u0443\u0441\u0441\u0438\u043E\u043D\u043D\u044B\u0439 \u043A\u043B\u0443\u0431",scene:"\u0421\u0442\u0443\u0434\u0435\u043D\u0447\u0435\u0441\u043A\u0438\u0439 \u0441\u043E\u0432\u0435\u0442 \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u0435\u0442 \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442 \u0434\u043E \u043A\u0430\u043C\u043F\u0443\u0441\u0430. \u041F\u0440\u043E\u0444\u0435\u0441\u0441\u043E\u0440 \u0415\u0432\u0430 \u043F\u0440\u043E\u0441\u0438\u0442 \u043E\u0446\u0435\u043D\u0438\u0442\u044C \u043F\u043E\u043B\u044C\u0437\u0443, \u0440\u0430\u0441\u0445\u043E\u0434\u044B \u0438 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u0440\u043E\u043C\u0438\u0441\u0441.",goal:"\u0412\u044B\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u0430\u0440\u0433\u0443\u043C\u0435\u043D\u0442, \u043E\u0442\u0432\u0435\u0442\u0438\u0442\u044C \u043D\u0430 \u0432\u043E\u0437\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u0438 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0438\u0442\u044C \u0432\u044B\u0432\u043E\u0434.",grammar:{title:"\u041F\u043E\u0437\u0438\u0446\u0438\u044F \u2192 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0435 \u2192 \u043E\u0433\u043E\u0432\u043E\u0440\u043A\u0430",body:"\u0410\u0440\u0433\u0443\u043C\u0435\u043D\u0442 \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u0435\u0442 \u043F\u043E\u0437\u0438\u0446\u0438\u044E \u0441 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0435\u043C \u0438 \u043F\u0440\u0438\u043C\u0435\u0440\u043E\u043C, \u0430 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u0435\u0442 \u043E\u0446\u0435\u043D\u043A\u0443 \u0441\u043B\u043E\u0432\u0430\u043C\u0438 ve\u013Emi \u0438\u043B\u0438 ur\u010Dite. \u041F\u0440\u0438\u0447\u0438\u043D\u0443 \u0432\u0432\u043E\u0434\u044F\u0442 ke\u010F\u017Ee \u0438\u043B\u0438 preto\u017Ee, \u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0435 \u2014 preto \u0438\u043B\u0438 v d\xF4sledku toho. \u0414\u043B\u044F \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u043F\u0440\u0438\u0433\u043E\u0434\u044F\u0442\u0441\u044F av\u0161ak \u0438 na druhej strane. \u041E\u0433\u043E\u0432\u043E\u0440\u043A\u0430 \u0432\u0440\u043E\u0434\u0435 za ur\u010Dit\xFDch podmienok \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043F\u0440\u0435\u0434\u0435\u043B \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u043C\u043E\u0441\u0442\u0438 \u0432\u044B\u0432\u043E\u0434\u0430. \u041D\u0435 \u043F\u0443\u0442\u0430\u0439 \xAB\u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u043C\u043E\u0447\u044C\xBB \u0438 \xAB\u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u0440\u0435\u0448\u0438\u0442\xBB: m\xF4\u017Ee zlep\u0161i\u0165 \u0441\u043B\u0430\u0431\u0435\u0435, \u0447\u0435\u043C ur\u010Dite vyrie\u0161i. \u0412 \u043E\u0442\u0432\u0435\u0442\u0435 \u043D\u0430 \u0432\u043E\u0437\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u0442\u043E\u0447\u043D\u043E \u043F\u0435\u0440\u0435\u0434\u0430\u0439 \u0447\u0443\u0436\u0443\u044E \u043C\u044B\u0441\u043B\u044C: Rozumiem n\xE1mietke, \u017Ee\u2026. \u0417\u0430\u0442\u0435\u043C \u0443\u043A\u0430\u0436\u0438, \u043A\u0430\u043A\u0430\u044F \u0447\u0430\u0441\u0442\u044C \u0430\u0440\u0433\u0443\u043C\u0435\u043D\u0442\u0430 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442\u0441\u044F. \u0412\u0437\u0432\u0435\u0448\u0435\u043D\u043D\u0430\u044F \u043F\u043E\u0437\u0438\u0446\u0438\u044F \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C \u043F\u0440\u043E\u0431\u043D\u044B\u0439 \u043F\u0440\u043E\u0435\u043A\u0442, \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u0442\u0440\u0435\u0431\u0443\u044F \u0438\u0437\u043C\u0435\u0440\u0438\u0442\u044C \u0437\u0430\u0442\u0440\u0430\u0442\u044B \u0438 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442. \u0422\u0430\u043A\u043E\u0439 \u043E\u0442\u0432\u0435\u0442 \u0442\u043E\u0447\u043D\u0435\u0435 \u0431\u0435\u0437\u0443\u0441\u043B\u043E\u0432\u043D\u043E\u0433\u043E \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u044F.",examples:[{sk:"N\xE1vrh m\xF4\u017Ee pom\xF4c\u0165, av\u0161ak treba pos\xFAdi\u0165 n\xE1klady.",ru:"\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u043C\u043E\u0447\u044C, \u043E\u0434\u043D\u0430\u043A\u043E \u043D\u0443\u0436\u043D\u043E \u043E\u0446\u0435\u043D\u0438\u0442\u044C \u0440\u0430\u0441\u0445\u043E\u0434\u044B."},{sk:"Rozumiem n\xE1mietke, \u017Ee v\xFDsledok nie je zaru\u010Den\xFD.",ru:"\u042F \u043F\u043E\u043D\u0438\u043C\u0430\u044E \u0432\u043E\u0437\u0440\u0430\u0436\u0435\u043D\u0438\u0435, \u0447\u0442\u043E \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u043D\u0435 \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D."}]},words:[{sk:"d\xF4sledok",ru:"\u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0435",example:"Mus\xEDme zv\xE1\u017Ei\u0165 aj nepriamy d\xF4sledok zmeny.",translation:"\u041C\u044B \u0434\u043E\u043B\u0436\u043D\u044B \u0443\u0447\u0435\u0441\u0442\u044C \u0438 \u043A\u043E\u0441\u0432\u0435\u043D\u043D\u043E\u0435 \u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0435 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F."},{sk:"n\xE1mietka",ru:"\u0432\u043E\u0437\u0440\u0430\u0436\u0435\u043D\u0438\u0435",example:"T\xE1to n\xE1mietka sa t\xFDka n\xE1kladov.",translation:"\u042D\u0442\u043E \u0432\u043E\u0437\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u043A\u0430\u0441\u0430\u0435\u0442\u0441\u044F \u0440\u0430\u0441\u0445\u043E\u0434\u043E\u0432."},{sk:"stanovisko",ru:"\u043F\u043E\u0437\u0438\u0446\u0438\u044F; \u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435",example:"Chcel by som vysvetli\u0165 svoje stanovisko.",translation:"\u042F \u0445\u043E\u0442\u0435\u043B \u0431\u044B \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C \u0441\u0432\u043E\u044E \u043F\u043E\u0437\u0438\u0446\u0438\u044E."},{sk:"od\xF4vodni\u0165",ru:"\u043E\u0431\u043E\u0441\u043D\u043E\u0432\u0430\u0442\u044C",example:"Ka\u017Ed\xFD n\xE1vrh treba od\xF4vodni\u0165.",translation:"\u041A\u0430\u0436\u0434\u043E\u0435 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u043D\u0443\u0436\u043D\u043E \u043E\u0431\u043E\u0441\u043D\u043E\u0432\u0430\u0442\u044C."},{sk:"presved\u010Div\xFD",ru:"\u0443\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439",example:"Pr\xEDklad rob\xED argument presved\u010Divej\u0161\xEDm.",translation:"\u041F\u0440\u0438\u043C\u0435\u0440 \u0434\u0435\u043B\u0430\u0435\u0442 \u0430\u0440\u0433\u0443\u043C\u0435\u043D\u0442 \u0443\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u0435\u0435."},{sk:"predpoklad",ru:"\u043F\u0440\u0435\u0434\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435; \u043F\u0440\u0435\u0434\u043F\u043E\u0441\u044B\u043B\u043A\u0430",example:"Tento predpoklad mus\xEDme overi\u0165.",translation:"\u042D\u0442\u0443 \u043F\u0440\u0435\u0434\u043F\u043E\u0441\u044B\u043B\u043A\u0443 \u043D\u0443\u0436\u043D\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C."},{sk:"opatrenie",ru:"\u043C\u0435\u0440\u0430; \u043C\u0435\u0440\u043E\u043F\u0440\u0438\u044F\u0442\u0438\u0435",example:"Opatrenie m\xE1 pom\xF4c\u0165 \u0161tudentom.",translation:"\u041C\u0435\u0440\u0430 \u0434\u043E\u043B\u0436\u043D\u0430 \u043F\u043E\u043C\u043E\u0447\u044C \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u0430\u043C."},{sk:"n\xE1klady",ru:"\u0440\u0430\u0441\u0445\u043E\u0434\u044B; \u0438\u0437\u0434\u0435\u0440\u0436\u043A\u0438",example:"Porovnajme n\xE1klady a v\xFDsledky.",translation:"\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0441\u0440\u0430\u0432\u043D\u0438\u043C \u0440\u0430\u0441\u0445\u043E\u0434\u044B \u0438 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B."},{sk:"pr\xEDnos",ru:"\u043F\u043E\u043B\u044C\u0437\u0430; \u0432\u043A\u043B\u0430\u0434",example:"Ak\xFD pr\xEDnos o\u010Dak\xE1vame od projektu?",translation:"\u041A\u0430\u043A\u043E\u0439 \u043F\u043E\u043B\u044C\u0437\u044B \u043C\u044B \u043E\u0436\u0438\u0434\u0430\u0435\u043C \u043E\u0442 \u043F\u0440\u043E\u0435\u043A\u0442\u0430?"},{sk:"zoh\u013Eadni\u0165",ru:"\u0443\u0447\u0435\u0441\u0442\u044C",example:"Treba zoh\u013Eadni\u0165 potreby v\u0161etk\xFDch skup\xEDn.",translation:"\u041D\u0443\u0436\u043D\u043E \u0443\u0447\u0435\u0441\u0442\u044C \u043F\u043E\u0442\u0440\u0435\u0431\u043D\u043E\u0441\u0442\u0438 \u0432\u0441\u0435\u0445 \u0433\u0440\u0443\u043F\u043F."}],exercises:[{type:"reading",prompt:"\u0417\u0430\u0447\u0435\u043C \u041D\u0438\u043D\u0430 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u044B\u0439 \u043F\u0440\u043E\u0431\u043D\u044B\u0439 \u0437\u0430\u043F\u0443\u0441\u043A?",explanation:"\u0412 \u0442\u0435\u043A\u0441\u0442\u0435 \u043D\u0430\u0437\u0432\u0430\u043D\u044B \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0439 \u0438 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0434\u043E\u043B\u0433\u043E\u0441\u0440\u043E\u0447\u043D\u043E\u0433\u043E \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430. \u0423\u0441\u043F\u0435\u0445 \u043F\u0440\u043E\u0435\u043A\u0442\u0430 \u0435\u0449\u0451 \u043D\u0435 \u0434\u043E\u043A\u0430\u0437\u0430\u043D.",text:"\u0160tudentsk\xE1 rada v na\u0161om pr\xEDbehu diskutuje o n\xE1vrhu zavies\u0165 bezplatn\xFA dopravu medzi intern\xE1tom a univerzitou. Jeho podporovatelia tvrdia, \u017Ee by \u0161tudenti menej pou\u017E\xEDvali aut\xE1 a \u013Eah\u0161ie sa z\xFA\u010Dast\u0148ovali ve\u010Dern\xFDch podujat\xED. Odporcovia nepopieraj\xFA tieto v\xFDhody, ale upozor\u0148uj\xFA na n\xE1klady. Peniaze by potom mohli ch\xFDba\u0165 na opravu \u0161tudovn\xED. Jeden \u010Dlen rady navrhol, aby sa slu\u017Eba najprv sk\xFA\u0161ala iba v \u010Dase najv\xE4\u010D\u0161ieho z\xE1ujmu. Po troch mesiacoch by sa porovnal po\u010Det cestuj\xFAcich s n\xE1kladmi a rozhodlo by sa o \u010Fal\u0161om pokra\u010Dovan\xED. Nina tento n\xE1vrh podporuje, preto\u017Ee umo\u017E\u0148uje overi\u0165 predpoklady bez dlhodob\xE9ho z\xE1v\xE4zku. Matej dod\xE1va, \u017Ee treba sledova\u0165 aj \u013Eud\xED, ktor\xED slu\u017Ebu nevyu\u017Eij\xFA, aby sa nezabudlo na ich potreby. Diskusia teda nekon\u010D\xED jednoduch\xFDm s\xFAhlasom alebo odmietnut\xEDm. Jej v\xFDsledkom je n\xE1vrh sk\xFA\u0161obn\xE9ho rie\u0161enia s vopred ur\u010Den\xFDmi ot\xE1zkami.",options:["Preto\u017Ee u\u017E pozn\xE1 presn\xFD v\xFDsledok.","Aby sa overili predpoklady a obmedzil dlhodob\xFD z\xE1v\xE4zok.","Aby sa prestali sledova\u0165 n\xE1klady.","Preto\u017Ee v\u0161etci \u0161tudenti u\u017E s\xFAhlasia."],answer:"Aby sa overili predpoklady a obmedzil dlhodob\xFD z\xE1v\xE4zok."},{type:"cloze",prompt:"\u0414\u043E\u0431\u0430\u0432\u044C \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0435: \u0443 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u0435\u0441\u0442\u044C \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0430, \u043E\u0434\u043D\u0430\u043A\u043E \u043D\u0443\u0436\u043D\u043E \u0443\u0447\u0435\u0441\u0442\u044C \u0440\u0430\u0441\u0445\u043E\u0434\u044B.",explanation:"\u0412\u0442\u043E\u0440\u0430\u044F \u0447\u0430\u0441\u0442\u044C \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E \u043E\u0446\u0435\u043D\u043A\u0443: \xAB\u043E\u0434\u043D\u0430\u043A\u043E \u043D\u0443\u0436\u043D\u043E \u0443\u0447\u0435\u0441\u0442\u044C \u0440\u0430\u0441\u0445\u043E\u0434\u044B\xBB.",sk:"N\xE1vrh m\xE1 viacero v\xFDhod, ___ treba zoh\u013Eadni\u0165 aj n\xE1klady.",options:["preto\u017Ee","av\u0161ak","aby","ke\u010F\u017Ee"],answer:"av\u0161ak"},{type:"choice",prompt:"\u041A\u0430\u043A\u043E\u0439 \u0432\u044B\u0432\u043E\u0434 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442 \u043D\u0435\u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u043E\u0441\u0442\u044C \u0438\u0441\u0445\u043E\u0434\u043D\u043E\u0433\u043E \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F?",explanation:"M\xF4\u017Ee \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C, \u0430 \u043D\u0435 \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u0434\u043B\u044F \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u0430.",options:["Doprava m\xF4\u017Ee u\u013Eah\u010Di\u0165 \xFA\u010Das\u0165 na podujatiach.","Doprava ur\u010Dite vyrie\u0161i v\u0161etky probl\xE9my.","Ka\u017Ed\xFD \u0161tudent prestane pou\u017E\xEDva\u0165 auto.","N\xE1klady nemaj\xFA \u017Eiadny v\xFDznam."],answer:"Doprava m\xF4\u017Ee u\u013Eah\u010Di\u0165 \xFA\u010Das\u0165 na podujatiach."},{type:"order",prompt:"\u0421\u043E\u0431\u0435\u0440\u0438 \u0444\u0440\u0430\u0437\u0443 \xAB\u0421 \u043E\u0434\u043D\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u043C\u044B \u0441\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043C \u0432\u0440\u0435\u043C\u044F, \u0441 \u0434\u0440\u0443\u0433\u043E\u0439 \u0432\u043E\u0437\u043D\u0438\u043A\u043D\u0443\u0442 \u0440\u0430\u0441\u0445\u043E\u0434\u044B\xBB.",explanation:"\u041F\u0430\u0440\u043D\u044B\u0435 \u0441\u0432\u044F\u0437\u043A\u0438 \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442 \u0441\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0434\u0432\u0430 \u0430\u0441\u043F\u0435\u043A\u0442\u0430 \u043E\u0434\u043D\u043E\u0439 \u043C\u0435\u0440\u044B.",answer:["Na","jednej","strane","u\u0161etr\xEDme","\u010Das,","na","druhej","strane","vznikn\xFA","n\xE1klady."],acceptedOrders:[["Na","jednej","strane","\u010Das","u\u0161etr\xEDme,","na","druhej","strane","vznikn\xFA","n\xE1klady."],["Na","jednej","strane","u\u0161etr\xEDme","\u010Das,","na","druhej","strane","n\xE1klady","vznikn\xFA."],["Na","jednej","strane","\u010Das","u\u0161etr\xEDme,","na","druhej","strane","n\xE1klady","vznikn\xFA."]]},{type:"typing",prompt:"\u041D\u0430\u043F\u0438\u0448\u0438 \u0438\u043D\u0444\u0438\u043D\u0438\u0442\u0438\u0432 \xAB\u0443\u0447\u0435\u0441\u0442\u044C\xBB \u0438\u0437 \u0441\u043B\u043E\u0432\u0430\u0440\u044F \u043C\u0438\u0441\u0441\u0438\u0438.",explanation:"Zoh\u013Eadni\u0165 potreby \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u043F\u0440\u0438\u043D\u044F\u0442\u044C \u043F\u043E\u0442\u0440\u0435\u0431\u043D\u043E\u0441\u0442\u0438 \u0432\u043E \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u043F\u0440\u0438 \u0440\u0435\u0448\u0435\u043D\u0438\u0438.",answer:"zoh\u013Eadni\u0165"},{type:"choice",prompt:"\u041A\u0430\u043A \u043B\u0443\u0447\u0448\u0435 \u043E\u0442\u0432\u0435\u0442\u0438\u0442\u044C \u043D\u0430 \u0432\u043E\u0437\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u043E \u0431\u044E\u0434\u0436\u0435\u0442\u0435?",explanation:"\u0412\u043E\u0437\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u043F\u0440\u0438\u0437\u043D\u0430\u043D\u043E, \u0430 \u043E\u0442\u0432\u0435\u0442 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u043C\u043E\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435, \u0430 \u043D\u0435 \u043E\u0442\u0440\u0438\u0446\u0430\u0435\u0442 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0443.",options:["O peniazoch sa nesmie hovori\u0165.","Kto nes\xFAhlas\xED, ni\u010Domu nerozumie.","N\xE1klady s\xFA d\xF4le\u017Eit\xE9, preto navrhujem \u010Dasovo obmedzen\xFA sk\xFA\u0161ku s vyhodnoten\xEDm.","V\xFDhody existuj\xFA, tak\u017Ee v\u0161etky n\xE1klady s\xFA nulov\xE9."],answer:"N\xE1klady s\xFA d\xF4le\u017Eit\xE9, preto navrhujem \u010Dasovo obmedzen\xFA sk\xFA\u0161ku s vyhodnoten\xEDm."},{type:"writing",prompt:"\u041D\u0430\u043F\u0438\u0448\u0438 160\u2013210 \u0441\u043B\u043E\u0432 \u0434\u043B\u044F \u0441\u0442\u0443\u0434\u0435\u043D\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u0441\u043E\u0432\u0435\u0442\u0430: \u0441\u0442\u043E\u0438\u0442 \u043B\u0438 \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u044C \u043F\u0440\u043E\u0431\u043D\u044B\u0439 \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u043D\u044B\u0439 \u043F\u0440\u043E\u0435\u043A\u0442? \u0414\u0430\u0439 \u043F\u043E\u0437\u0438\u0446\u0438\u044E, \u0434\u0432\u0430 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F, \u0432\u043E\u0437\u0440\u0430\u0436\u0435\u043D\u0438\u0435, \u043E\u0442\u0432\u0435\u0442 \u043D\u0430 \u043D\u0435\u0433\u043E \u0438 \u0443\u0441\u043B\u043E\u0432\u0438\u0435 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0435\u043D\u0438\u044F.",explanation:"\u0421\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u043F\u0438\u0441\u044C\u043C\u0435\u043D\u043D\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430: \u043F\u0440\u043E\u0432\u0435\u0440\u044C \u0441\u043C\u044B\u0441\u043B, \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0443, \u0441\u0432\u044F\u0437\u043A\u0438 \u0438 \u044F\u0437\u044B\u043A\u043E\u0432\u0443\u044E \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C \u043F\u043E \u043A\u0440\u0438\u0442\u0435\u0440\u0438\u044F\u043C. \u0421\u0447\u0451\u0442\u0447\u0438\u043A \u0441\u043B\u043E\u0432 \u043D\u0435 \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0435\u0442 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E \u0430\u0440\u0433\u0443\u043C\u0435\u043D\u0442\u0430\u0446\u0438\u0438 \u0438 \u043D\u0435 \u0432\u044B\u0434\u0430\u0451\u0442 \u0441\u0435\u0440\u0442\u0438\u0444\u0438\u043A\u0430\u0442 B2.",answer:"",minWords:160,model:"Podporujem n\xE1vrh, aby sa doprava medzi intern\xE1tom a univerzitou najprv zaviedla na sk\xFA\u0161obn\xE9 obdobie. Mohla by u\u013Eah\u010Di\u0165 \xFA\u010Das\u0165 na ve\u010Dern\xFDch podujatiach a pom\xF4c\u0165 \u013Eu\u010Fom, ktor\xED nemaj\xFA vlastn\xE9 auto. Z\xE1rove\u0148 by sme z\xEDskali konkr\xE9tne \xFAdaje o skuto\u010Dnom z\xE1ujme. Bez nich by rozhodnutie vych\xE1dzalo iba z odhadov. Rozumiem v\u0161ak n\xE1mietke, \u017Ee peniaze mo\u017Eno potrebujeme aj na opravu \u0161tudovn\xED. Preto nepova\u017Eujem za rozumn\xE9 s\u013E\xFAbi\u0165 slu\u017Ebu natrvalo e\u0161te pred jej overen\xEDm. Navrhujem obmedzi\u0165 sk\xFA\u0161ku na obdobie a \u010Dasy, v ktor\xFDch o\u010Dak\xE1vame najv\xE4\u010D\u0161\xED z\xE1ujem. Vopred by sme mali ur\u010Di\u0165, ktor\xE9 n\xE1klady budeme sledova\u0165 a ako zist\xEDme spokojnos\u0165 pou\u017E\xEDvate\u013Eov. D\xF4le\u017Eit\xE9 je oslovi\u0165 aj \u0161tudentov, ktor\xED autobus nevyu\u017Eij\xFA. M\xF4\u017Eu ma\u0165 in\xE9 potreby alebo im nemus\xED vyhovova\u0165 trasa. Po skon\u010Den\xED sk\xFA\u0161ky by rada mala v\xFDsledky zverejni\u0165 a porovna\u0165 ich s in\xFDmi mo\u017Enos\u0165ami vyu\u017Eitia rozpo\u010Dtu. Ak bude pr\xEDnos primeran\xFD n\xE1kladom, m\xF4\u017Eeme diskutova\u0165 o pokra\u010Dovan\xED. Ak nie, projekt treba upravi\u0165 alebo ukon\u010Di\u0165. Podpora sk\xFA\u0161ky teda neznamen\xE1 bezpodmiene\u010Dn\xFD s\xFAhlas s ka\u017Edou bud\xFAcou podobou slu\u017Eby. Je to sp\xF4sob, ako sa rozhodova\u0165 na z\xE1klade sk\xFAsenosti.",checklist:["\u042F\u0441\u043D\u043E \u0441\u0444\u043E\u0440\u043C\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u0430 \u043F\u043E\u0437\u0438\u0446\u0438\u044F \u0438 \u0434\u0432\u0430 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F.","\u0412\u043E\u0437\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u043F\u0435\u0440\u0435\u0434\u0430\u043D\u043E \u0447\u0435\u0441\u0442\u043D\u043E \u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E \u043E\u0442\u0432\u0435\u0442.","\u0420\u0430\u0437\u043B\u0438\u0447\u0435\u043D\u044B \u043E\u0436\u0438\u0434\u0430\u0435\u043C\u044B\u0439 \u044D\u0444\u0444\u0435\u043A\u0442 \u0438 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0451\u043D\u043D\u044B\u0439 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442.","\u0415\u0441\u0442\u044C \u0443\u0441\u043B\u043E\u0432\u0438\u0435 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0435\u043D\u0438\u044F, \u0441\u0432\u044F\u0437\u043A\u0438 \u0438 160+ \u0441\u043B\u043E\u0432."]},{type:"speaking",prompt:"\u0417\u0430 90 \u0441\u0435\u043A\u0443\u043D\u0434 \u0437\u0430\u0449\u0438\u0442\u0438 \u043F\u0440\u043E\u0431\u043D\u044B\u0439 \u043F\u0440\u043E\u0435\u043A\u0442. \u0417\u0430\u0442\u0435\u043C \u043E\u0442\u0432\u0435\u0442\u044C \u043D\u0430 \u0432\u043E\u0437\u0440\u0430\u0436\u0435\u043D\u0438\u0435: \xAB\u0420\u0430\u0437\u0432\u0435 \u0440\u0435\u043C\u043E\u043D\u0442 \u0447\u0438\u0442\u0430\u043B\u044C\u043D\u044B\u0445 \u0437\u0430\u043B\u043E\u0432 \u043D\u0435 \u0432\u0430\u0436\u043D\u0435\u0435?\xBB",explanation:"\u0423\u0441\u0442\u043D\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430 \u0434\u043B\u044F \u0441\u0430\u043C\u043E\u043E\u0446\u0435\u043D\u043A\u0438. \u0421\u0440\u0430\u0432\u043D\u0438 \u0437\u0430\u043F\u0438\u0441\u044C \u0438\u043B\u0438 \u0443\u0441\u0442\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442 \u0441 \u043A\u0440\u0438\u0442\u0435\u0440\u0438\u044F\u043C\u0438; \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0448\u0435\u043D\u0438\u044F \u0438 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0435 B2 \u043D\u0435 \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u044E\u0442\u0441\u044F.",answer:"",targetSeconds:90,model:"Podporujem kr\xE1tku sk\xFA\u0161ku, preto\u017Ee n\xE1m umo\u017En\xED overi\u0165, \u010Di je o dopravu skuto\u010Dn\xFD z\xE1ujem. Neznamen\xE1 to, \u017Ee oprava \u0161tudovn\xED je menej d\xF4le\u017Eit\xE1. Rozpo\u010Det je obmedzen\xFD, a preto potrebujeme porovna\u0165 mo\u017Enosti. Navrhol by som vopred ur\u010Di\u0165 maxim\xE1lne n\xE1klady a ukazovatele \xFAspechu. Ak sa uk\xE1\u017Ee, \u017Ee slu\u017Ebu vyu\u017E\xEDva m\xE1lo \u013Eud\xED, nemali by sme v nej pokra\u010Dova\u0165 iba preto, \u017Ee u\u017E vznikla. Naopak, ak v\xFDrazne pom\xF4\u017Ee \u0161tudentom za primeran\xFA cenu, bude to d\xF4vod na \u010Fal\u0161iu diskusiu. Bez \xFAdajov by sme sa rozhodovali najm\xE4 pod\u013Ea dojmu.",checklist:["\u041F\u043E\u0437\u0438\u0446\u0438\u044F \u043D\u0430\u0437\u0432\u0430\u043D\u0430 \u0432 \u043D\u0430\u0447\u0430\u043B\u0435.","\u0412\u043E\u0437\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E \u043F\u0440\u044F\u043C\u043E\u0439 \u043E\u0442\u0432\u0435\u0442.","\u0415\u0441\u0442\u044C \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u043E\u0435 \u0443\u0441\u043B\u043E\u0432\u0438\u0435 \u0438 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u0435.","\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u044B \u0441\u0432\u044F\u0437\u043A\u0438 \u0438 \u043F\u043E\u043D\u044F\u0442\u043D\u0430\u044F \u0430\u0440\u0433\u0443\u043C\u0435\u043D\u0442\u0430\u0446\u0438\u044F."]}]},{id:"b2-02",level:"B2",title:"\u0423\u0441\u0442\u0443\u043F\u043A\u0430 \u0438 \u043A\u043E\u043C\u043F\u0440\u043E\u043C\u0438\u0441\u0441",location:"\u0413\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439 \u043F\u0430\u0440\u043A",scene:"\u0416\u0438\u0442\u0435\u043B\u0438 \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u044E\u0442 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435 \u043F\u0430\u0440\u043A\u0430. \u041D\u0443\u0436\u043D\u043E \u043F\u0440\u0438\u0437\u043D\u0430\u0442\u044C \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u044F \u043F\u0440\u043E\u0435\u043A\u0442\u0430 \u0438 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u043C\u043E\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435.",goal:"\u0412\u044B\u0440\u0430\u0437\u0438\u0442\u044C \u0443\u0441\u0442\u0443\u043F\u043A\u0443 \u0438 \u0441\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043A\u0440\u0430\u0442\u043A\u043E\u0441\u0440\u043E\u0447\u043D\u044B\u0439 \u0438 \u0434\u043E\u043B\u0433\u043E\u0441\u0440\u043E\u0447\u043D\u044B\u0439 \u044D\u0444\u0444\u0435\u043A\u0442.",grammar:{title:"Hoci, napriek, napriek tomu",body:"Hoci \u0432\u0432\u043E\u0434\u0438\u0442 \u0443\u0441\u0442\u0443\u043F\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u043F\u0440\u0438\u0434\u0430\u0442\u043E\u0447\u043D\u043E\u0435 \u0441 \u043B\u0438\u0447\u043D\u043E\u0439 \u0444\u043E\u0440\u043C\u043E\u0439 \u0433\u043B\u0430\u0433\u043E\u043B\u0430: Hoci je rozpo\u010Det mal\xFD, projekt m\xF4\u017Ee pokra\u010Dova\u0165. Napriek \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043F\u0440\u0435\u0434\u043B\u043E\u0433\u043E\u043C \u0438 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0434\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043F\u0430\u0434\u0435\u0436\u0430: napriek mal\xE9mu rozpo\u010Dtu. \u041A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F napriek tomu, \u017Ee \u0442\u043E\u0436\u0435 \u0432\u044B\u0440\u0430\u0436\u0430\u0435\u0442 \u0443\u0441\u0442\u0443\u043F\u043A\u0443, \u043D\u043E \u043F\u043E\u0441\u043B\u0435 \u017Ee \u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435. \u0423\u0441\u0442\u0443\u043F\u043A\u0430 \u043F\u0440\u0438\u0437\u043D\u0430\u0451\u0442 \u0444\u0430\u043A\u0442, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043C\u043E\u0433 \u0431\u044B \u043F\u0440\u0438\u0432\u0435\u0441\u0442\u0438 \u043A \u0434\u0440\u0443\u0433\u043E\u043C\u0443 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0443, \u043E\u0434\u043D\u0430\u043A\u043E \u043D\u0435 \u043E\u0442\u043C\u0435\u043D\u044F\u0435\u0442 \u043E\u0441\u043D\u043E\u0432\u043D\u0443\u044E \u043C\u044B\u0441\u043B\u044C. \u041F\u043E\u044D\u0442\u043E\u043C\u0443 hoci \u043D\u0435\u043B\u044C\u0437\u044F \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438 \u0437\u0430\u043C\u0435\u043D\u0438\u0442\u044C \u043D\u0430 preto\u017Ee: \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0441\u0432\u044F\u0437\u044C. \u0412 \u0430\u0440\u0433\u0443\u043C\u0435\u043D\u0442\u0430\u0446\u0438\u0438 \u043E\u0442\u043B\u0438\u0447\u0430\u0439 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u0435 \u043E\u0442 \u043F\u043E\u043B\u043D\u043E\u0433\u043E \u0437\u0430\u043F\u0440\u0435\u0442\u0430. \u0424\u0440\u0430\u0437\u0430 \xAB\u043F\u0440\u043E\u0435\u043A\u0442 \u0434\u043E\u0440\u043E\u0433\u043E\u0439\xBB \u0435\u0449\u0451 \u043D\u0435 \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \xAB\u0435\u0433\u043E \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u044C\xBB: \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u044D\u0442\u0430\u043F\u044B, \u0438\u043D\u043E\u0439 \u043E\u0431\u044A\u0451\u043C \u0438\u043B\u0438 \u0443\u0441\u043B\u043E\u0432\u0438\u044F. \u041F\u0440\u043E\u0432\u0435\u0440\u044F\u0439, \u0447\u0442\u043E \u043A\u043E\u043C\u043F\u0440\u043E\u043C\u0438\u0441\u0441 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0443\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442 \u043D\u0430\u0437\u0432\u0430\u043D\u043D\u044B\u0435 \u043F\u043E\u0442\u0440\u0435\u0431\u043D\u043E\u0441\u0442\u0438.",examples:[{sk:"Hoci je priestor mal\xFD, m\xF4\u017Ee by\u0165 u\u017Eito\u010Dn\xFD.",ru:"\u0425\u043E\u0442\u044F \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0435, \u043E\u043D\u043E \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u043C."},{sk:"Napriek obmedzen\xE9mu rozpo\u010Dtu sa na\u0161lo rie\u0161enie.",ru:"\u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u044B\u0439 \u0431\u044E\u0434\u0436\u0435\u0442, \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u043D\u0430\u0448\u043B\u043E\u0441\u044C."}]},words:[{sk:"obmedzenie",ru:"\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u0435",example:"Mus\xEDme po\u010D\xEDta\u0165 s t\xFDmto obmedzen\xEDm.",translation:"\u041C\u044B \u0434\u043E\u043B\u0436\u043D\u044B \u0443\u0447\u0438\u0442\u044B\u0432\u0430\u0442\u044C \u044D\u0442\u043E \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u0435."},{sk:"dostupnos\u0165",ru:"\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E\u0441\u0442\u044C",example:"Dostupnos\u0165 slu\u017Eby sa m\xF4\u017Ee zlep\u0161i\u0165.",translation:"\u0414\u043E\u0441\u0442\u0443\u043F\u043D\u043E\u0441\u0442\u044C \u0443\u0441\u043B\u0443\u0433\u0438 \u043C\u043E\u0436\u0435\u0442 \u0443\u043B\u0443\u0447\u0448\u0438\u0442\u044C\u0441\u044F."},{sk:"rozpo\u010Det",ru:"\u0431\u044E\u0434\u0436\u0435\u0442",example:"Rozpo\u010Det nesta\u010D\xED na v\u0161etky n\xE1vrhy.",translation:"\u0411\u044E\u0434\u0436\u0435\u0442\u0430 \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u043D\u0430 \u0432\u0441\u0435 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F."},{sk:"verejn\xFD priestor",ru:"\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E",example:"Park je d\xF4le\u017Eit\xFD verejn\xFD priestor.",translation:"\u041F\u0430\u0440\u043A \u2014 \u0432\u0430\u0436\u043D\u043E\u0435 \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E."},{sk:"zachova\u0165",ru:"\u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C",example:"Chceme zachova\u0165 star\xE9 stromy.",translation:"\u041C\u044B \u0445\u043E\u0442\u0438\u043C \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u0441\u0442\u0430\u0440\u044B\u0435 \u0434\u0435\u0440\u0435\u0432\u044C\u044F."},{sk:"uprednostni\u0165",ru:"\u043E\u0442\u0434\u0430\u0442\u044C \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0442\u0435\u043D\u0438\u0435",example:"M\xF4\u017Eeme uprednostni\u0165 jednoduch\u0161ie rie\u0161enie.",translation:"\u041C\u044B \u043C\u043E\u0436\u0435\u043C \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0435\u0441\u0442\u044C \u0431\u043E\u043B\u0435\u0435 \u043F\u0440\u043E\u0441\u0442\u043E\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435."},{sk:"dlhodob\xFD",ru:"\u0434\u043E\u043B\u0433\u043E\u0441\u0440\u043E\u0447\u043D\u044B\u0439",example:"Treba pos\xFAdi\u0165 dlhodob\xFD \xFA\u010Dinok.",translation:"\u041D\u0443\u0436\u043D\u043E \u043E\u0446\u0435\u043D\u0438\u0442\u044C \u0434\u043E\u043B\u0433\u043E\u0441\u0440\u043E\u0447\u043D\u044B\u0439 \u044D\u0444\u0444\u0435\u043A\u0442."},{sk:"kr\xE1tkodob\xFD",ru:"\u043A\u0440\u0430\u0442\u043A\u043E\u0441\u0440\u043E\u0447\u043D\u044B\u0439",example:"Kr\xE1tkodob\xFD \xFAspech e\u0161te nemus\xED sta\u010Di\u0165.",translation:"\u041A\u0440\u0430\u0442\u043A\u043E\u0441\u0440\u043E\u0447\u043D\u043E\u0433\u043E \u0443\u0441\u043F\u0435\u0445\u0430 \u0435\u0449\u0451 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E."},{sk:"uskuto\u010Dnite\u013En\xFD",ru:"\u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u043C\u044B\u0439",example:"H\u013Ead\xE1me uskuto\u010Dnite\u013En\xFD n\xE1vrh.",translation:"\u041C\u044B \u0438\u0449\u0435\u043C \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u043C\u043E\u0435 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435."},{sk:"kompromis",ru:"\u043A\u043E\u043C\u043F\u0440\u043E\u043C\u0438\u0441\u0441",example:"Dohodli sme sa na kompromise.",translation:"\u041C\u044B \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438\u0441\u044C \u043E \u043A\u043E\u043C\u043F\u0440\u043E\u043C\u0438\u0441\u0441\u0435."}],exercises:[{type:"reading",prompt:"\u041F\u043E\u0447\u0435\u043C\u0443 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442\u0441\u044F \u043D\u0430\u0447\u0430\u0442\u044C \u0441 \u0434\u043E\u0440\u043E\u0436\u0435\u043A \u0438 \u0443\u0445\u043E\u0434\u0430 \u0437\u0430 \u043F\u0430\u0440\u043A\u043E\u043C?",explanation:"\u041E \u0434\u043E\u0440\u043E\u0436\u043A\u0430\u0445 \u0438 \u0443\u0445\u043E\u0434\u0435 \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u0438 \u0441\u043E\u0433\u043B\u0430\u0441\u043D\u044B. \u0422\u0430\u043A\u043E\u0435 \u043D\u0430\u0447\u0430\u043B\u043E \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u043E\u0431\u0449\u0435\u0439 \u043F\u043E\u0442\u0440\u0435\u0431\u043D\u043E\u0441\u0442\u0438 \u043F\u0440\u0438 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u044B\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u0430\u0445.",text:"Obyvatelia vymyslenej mestskej \u0161tvrte diskutuj\xFA o obnove parku. Jedna skupina \u017Eiada nov\xE9 \u0161portov\xE9 vybavenie, druh\xE1 chce zachova\u0165 pokojn\xE9 miesto na \u010D\xEDtanie a prech\xE1dzky. Rozpo\u010Det nesta\u010D\xED na v\u0161etko, \u010Do bolo navrhnut\xE9. Hoci sa n\xE1zory l\xED\u0161ia, \xFA\u010Dastn\xEDci sa zhoduj\xFA, \u017Ee park potrebuje bezpe\u010Dn\xE9 chodn\xEDky a pravideln\xFA \xFAdr\u017Ebu. Architektka preto odpor\xFA\u010Da za\u010Da\u0165 t\xFDmito spolo\u010Dn\xFDmi potrebami. \u0160portov\xE9 prvky by sa mohli prida\u0165 nesk\xF4r na okraji parku, aby neru\u0161ili tich\xFA \u010Das\u0165. Niektor\xED obyvatelia pova\u017Euj\xFA postupn\xE9 rie\u0161enie za pr\xEDli\u0161 pomal\xE9. In\xED v\u0161ak upozor\u0148uj\xFA, \u017Ee jednorazov\xE1 drah\xE1 \xFAprava bez pe\u0148az\xED na \xFAdr\u017Ebu by nemusela dlho sl\xFA\u017Ei\u0165. Nina navrhuje zverejni\u0165 pl\xE1n jednotliv\xFDch et\xE1p aj o\u010Dak\xE1van\xE9 n\xE1klady. Tak by \u013Eudia mohli pos\xFAdi\u0165, \u010Do sa uskuto\u010Dn\xED hne\u010F a \u010Do zostane podmienen\xE9 \u010Fal\u0161\xEDmi zdrojmi. Kompromis teda neznamen\xE1, \u017Ee ka\u017Ed\xFD dostane v\u0161etko, ale \u017Ee spolo\u010Dn\xFD z\xE1klad umo\u017En\xED pokra\u010Dova\u0165.",options:["Preto\u017Ee \u0161port je v parku zak\xE1zan\xFD.","Preto\u017Ee ide o spolo\u010Dn\xFA potrebu r\xF4znych skup\xEDn.","Preto\u017Ee v\u0161etci odmietli tich\xFA z\xF3nu.","Preto\u017Ee na \xFAdr\u017Ebu netreba \u017Eiadne peniaze."],answer:"Preto\u017Ee ide o spolo\u010Dn\xFA potrebu r\xF4znych skup\xEDn."},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443 \u0438\u043B\u0438 \u0441\u0432\u044F\u0437\u043A\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0432 \u043F\u0440\u043E\u043F\u0443\u0441\u043A.",explanation:"\u0414\u0430\u043B\u0435\u0435 \u0438\u0434\u0451\u0442 \u043F\u043E\u043B\u043D\u043E\u0435 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435 je rozpo\u010Det mal\xFD, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043D\u0443\u0436\u0435\u043D \u0441\u043E\u044E\u0437 hoci.",sk:"___ je rozpo\u010Det mal\xFD, m\xF4\u017Eeme opravi\u0165 najnebezpe\u010Dnej\u0161\xED chodn\xEDk.",options:["Hoci","Napriek","Preto","V\u010Faka"],answer:"Hoci"},{type:"cloze",prompt:"\u0412\u044B\u0431\u0435\u0440\u0438 \u0444\u043E\u0440\u043C\u0443 \u0438\u043B\u0438 \u0441\u0432\u044F\u0437\u043A\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0432 \u043F\u0440\u043E\u043F\u0443\u0441\u043A.",explanation:"\u041F\u043E\u0441\u043B\u0435 napriek \u043D\u0443\u0436\u0435\u043D \u0434\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043F\u0430\u0434\u0435\u0436: obmedzen\xE9mu rozpo\u010Dtu.",sk:"Napriek obmedzen\xE9mu ___ sa na\u0161lo \u010Diasto\u010Dn\xE9 rie\u0161enie.",options:["rozpo\u010Dtu","rozpo\u010Det","rozpo\u010Dtom","rozpo\u010Dte"],answer:"rozpo\u010Dtu"},{type:"order",prompt:"\u0421\u043E\u0431\u0435\u0440\u0438 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \xAB\u0425\u043E\u0442\u044F \u043F\u0440\u043E\u0435\u043A\u0442 \u0434\u043E\u0440\u043E\u0433\u043E\u0439, \u043C\u044B \u043D\u0435 \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u043C\u0441\u044F \u043E\u0442 \u043D\u0435\u0433\u043E\xBB.",explanation:"\u0423\u0441\u0442\u0443\u043F\u043A\u0430 \u043F\u0440\u0438\u0437\u043D\u0430\u0451\u0442 \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C, \u043D\u043E \u0441\u043E\u043E\u0431\u0449\u0430\u0435\u0442 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442, \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u043E\u043B\u043E\u0436\u043D\u044B\u0439 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u043C\u0443 \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u044E.",answer:["Hoci","je","projekt","drah\xFD,","nevzd\xE1vame","sa","ho."],acceptedOrders:[["Hoci","projekt","je","drah\xFD,","nevzd\xE1vame","sa","ho."]]},{type:"typing",prompt:"\u041D\u0430\u043F\u0438\u0448\u0438 \u0441\u043B\u043E\u0432\u043E \xAB\u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u043C\u044B\u0439\xBB \u0438\u0437 \u0441\u043B\u043E\u0432\u0430\u0440\u044F \u043C\u0438\u0441\u0441\u0438\u0438 \u0432 \u0444\u043E\u0440\u043C\u0435 \u043C\u0443\u0436\u0441\u043A\u043E\u0433\u043E \u0440\u043E\u0434\u0430.",explanation:"Uskuto\u010Dnite\u013En\xFD \u2014 \u0442\u0430\u043A\u043E\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043C\u043E\u0436\u043D\u043E \u0440\u0435\u0430\u043B\u044C\u043D\u043E \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u0442\u044C: uskuto\u010Dnite\u013En\xFD n\xE1vrh \u2014 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u043C\u043E\u0435 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435.",answer:"uskuto\u010Dnite\u013En\xFD"},{type:"choice",prompt:"\u041A\u0430\u043A\u043E\u0439 \u0432\u0430\u0440\u0438\u0430\u043D\u0442 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442 \u0441\u043C\u044B\u0441\u043B \xABHoci je projekt drah\xFD, podporujeme ho\xBB?",explanation:"\u0412\u044B\u0441\u043E\u043A\u0430\u044F \u0446\u0435\u043D\u0430 \u043F\u0440\u0438\u0437\u043D\u0430\u043D\u0430 \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u0435\u043C, \u043D\u043E \u043D\u0435 \u043F\u0440\u0438\u0447\u0438\u043D\u043E\u0439 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0438 \u0438 \u043D\u0435 \u043F\u0440\u0438\u0447\u0438\u043D\u043E\u0439 \u043E\u0442\u043A\u0430\u0437\u0430.",options:["Podporujeme ho, preto\u017Ee je drah\xFD.","Podporujeme ho napriek vysokej cene.","Podporujeme iba bezplatn\xE9 projekty.","Projekt je drah\xFD, a preto ho odmietame."],answer:"Podporujeme ho napriek vysokej cene."},{type:"writing",prompt:"\u041D\u0430\u043F\u0438\u0448\u0438 160\u2013200 \u0441\u043B\u043E\u0432 \u043E \u043A\u043E\u043C\u043F\u0440\u043E\u043C\u0438\u0441\u0441\u0435 \u043F\u0440\u0438 \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0438 \u043F\u0430\u0440\u043A\u0430. \u041F\u043E\u043A\u0430\u0436\u0438 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u044B \u0434\u0432\u0443\u0445 \u0433\u0440\u0443\u043F\u043F, \u0431\u044E\u0434\u0436\u0435\u0442\u043D\u043E\u0435 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u0435, \u044D\u0442\u0430\u043F\u044B \u0438 \u0441\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0430.",explanation:"\u0421\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u043F\u0438\u0441\u044C\u043C\u0435\u043D\u043D\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430: \u043F\u0440\u043E\u0432\u0435\u0440\u044C \u0441\u043C\